# Anybuild recipe for building php-symfony-starter from the repository root (`--subdir php-symfony-starter`),
# which is how the Wasmer templates catalog deploys it.
#
# The stock PHP recipe does not handle `app_subdir` yet: it bind-mounts composer.json and composer.lock from
# the repository root (failing with "/composer.lock: not found") and copies the whole repository into /app.
# So this recipe turns the stock Composer step off, keeps only this directory in /app, and runs Composer there.
# Standalone builds of the directory need no recipe; Anybuild detects Symfony on its own.

load("//anybuild/tools:php.bzl", "php_build", "php_commands", "php_config", "php_serve")

app_subdir = "php-symfony-starter"

config = php_config(
    schema = 1,
    php_framework = "symfony",
    composer_enable = False,
    php_version = "8.3.29",
    php_public_dir = "public",
)

build = php_build(
    config,
    extra_use_deps = [dep("composer")],
    after_build = [
        run("find . -mindepth 1 -maxdepth 1 ! -name {0} -exec rm -rf {{}} + && cp -a {0}/. . && rm -rf {0}".format(app_subdir), group = "build"),
        env(COMPOSER_HOME = "/tmp", COMPOSER_FUND = "0", COMPOSER_ALLOW_SUPERUSER = "1"),
        run("composer install --no-dev --optimize-autoloader --ignore-platform-reqs --no-scripts --no-interaction", group = "install"),
    ],
    extra_ignore = ["vendor", "var"],
)

php_serve(config, build, name = "symfony-starter", commands = php_commands(config, build.app))
