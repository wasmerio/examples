---
import { Icon } from 'astro-icon/components';
---

<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  class="pointer-events-none fixed right-6 bottom-6 z-40 flex h-10 w-10 translate-y-12 items-center justify-center rounded-full border border-(--global-border-color) bg-(--global-bg-color)/90 text-(--global-text-color) opacity-0 shadow-lg backdrop-blur-xs transition-all duration-300 hover:scale-105 hover:bg-(--global-footer-bg-color) focus:outline-none"
>
  <Icon name="fa6-solid:arrow-up" class="h-4 w-4" />
</button>

<script>
  let isScrollListenerAttached = false;

  function updateBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;

    const shouldShow = window.scrollY > 300;
    const isVisible = btn.classList.contains('opacity-100');
    if (shouldShow === isVisible) return;

    if (shouldShow) {
      btn.classList.remove(
        'opacity-0',
        'translate-y-12',
        'pointer-events-none'
      );
      btn.classList.add('opacity-100', 'translate-y-0');
    } else {
      btn.classList.add('opacity-0', 'translate-y-12', 'pointer-events-none');
      btn.classList.remove('opacity-100', 'translate-y-0');
    }
  }

  function setupBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;

    updateBackToTop();

    if (!isScrollListenerAttached) {
      window.addEventListener('scroll', updateBackToTop, { passive: true });
      isScrollListenerAttached = true;
    }

    btn.onclick = () => {
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      window.scrollTo({
        top: 0,
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
      });
    };
  }

  document.addEventListener('astro:page-load', setupBackToTop);
</script>
