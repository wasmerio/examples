---
import { siteConfig } from '@data/siteConfig';
import { resolveUrl, stripBasePath } from '@utils/url';

export interface Props {
  crumbs?: { title: string; href?: string }[];
}

const { crumbs = [] } = Astro.props;

// If crumbs not explicitly provided, deduce from current path relative to base
const segments = stripBasePath(Astro.url.pathname).split('/').filter(Boolean);

const breadcrumbs =
  crumbs.length > 0
    ? crumbs.map((c) => ({
        ...c,
        href: c.href ? resolveUrl(c.href) : undefined,
      }))
    : [
        { title: 'Home', href: resolveUrl('/') },
        ...segments.map((seg, idx) => {
          const href = resolveUrl(
            '/' + segments.slice(0, idx + 1).join('/') + '/'
          );
          const isLast = idx === segments.length - 1;
          const acronyms: Record<string, string> = {
            cv: 'CV',
            rss: 'RSS',
            api: 'API',
            faq: 'FAQ',
            pdf: 'PDF',
            html: 'HTML',
            json: 'JSON',
            xml: 'XML',
          };
          const cleanSeg = seg.toLowerCase();
          const formatted =
            acronyms[cleanSeg] ||
            seg
              .replace(/[-_]+/g, ' ')
              .trim()
              .replace(/\b\w/g, (c) => c.toUpperCase());

          return { title: formatted, href: isLast ? undefined : href };
        }),
      ];
---

{
  siteConfig.breadcrumbs && breadcrumbs.length > 1 && (
    <nav
      aria-label="Breadcrumbs"
      class="mb-4 text-xs text-(--global-text-color-light)"
    >
      <ol
        class="flex flex-wrap items-center gap-1.5"
        itemscope
        itemtype="http://schema.org/BreadcrumbList"
      >
        {breadcrumbs.map((crumb, idx) => {
          const isLast = idx === breadcrumbs.length - 1;

          return (
            <li
              class="flex items-center gap-1.5"
              itemprop="itemListElement"
              itemscope
              itemtype="http://schema.org/ListItem"
            >
              {isLast || !crumb.href ? (
                <span
                  class="font-medium text-(--global-text-color)"
                  aria-current="page"
                >
                  {crumb.title}
                </span>
              ) : (
                <a
                  href={crumb.href}
                  class="text-(--global-text-color-light) hover:text-(--global-base-color) hover:underline"
                  itemprop="item"
                >
                  <span itemprop="name">{crumb.title}</span>
                </a>
              )}
              {!isLast && (
                <span class="text-(--global-text-color-light)/60">/</span>
              )}
              <meta itemprop="position" content={(idx + 1).toString()} />
            </li>
          );
        })}
      </ol>
    </nav>
  )
}
