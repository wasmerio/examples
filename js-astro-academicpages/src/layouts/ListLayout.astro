---
import { fade } from 'astro:transitions';

import BaseLayout from '@layouts/BaseLayout.astro';
import AuthorProfile from '@components/AuthorProfile.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';

import { parseInline } from '@utils/marked';

export interface Props {
  title: string;
  description?: string;
  authorProfile?: boolean;
}

const { title, description, authorProfile = true } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      {
        authorProfile && (
          <aside class="lg:col-span-3" aria-label="Author profile">
            <div class="sticky top-24">
              <AuthorProfile />
            </div>
          </aside>
        )
      }

      <main
        class:list={[
          authorProfile ? 'lg:col-span-9' : 'lg:col-span-12',
          'min-w-0',
        ]}
        transition:animate={fade({ duration: '0.08s' })}
      >
        <Breadcrumbs />

        <header class="mb-6 border-b border-(--global-border-color) pb-3">
          <h1
            class="text-2xl font-bold tracking-tight text-(--global-text-color) sm:text-3xl"
            set:html={parseInline(title)}
          />
          {
            description && (
              <p
                class="mt-2 text-sm text-(--global-text-color-light)"
                set:html={parseInline(description)}
              />
            )
          }
        </header>

        <section class="archive-content">
          <slot />
        </section>
      </main>
    </div>
  </div>
</BaseLayout>
