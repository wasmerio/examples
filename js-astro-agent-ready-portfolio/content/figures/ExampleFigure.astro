---
// BlogFigure wraps this in a <figure> with a pause button. autoplay() advances the
// highlight while the figure is on screen, and does nothing when the reader prefers
// reduced motion, so the figure stays still.
const steps = ["Write", "Check", "Ship"];
---

<div class="example" data-example-figure>
  {steps.map((step) => <p class="example-step">{step}</p>)}
</div>

<script>
  import { autoplay } from "$lib/utils/autoplay";

  for (const root of document.querySelectorAll<HTMLElement>("[data-example-figure]")) {
    const steps = [...root.querySelectorAll(".example-step")];
    let ticks = 0;
    const light = () =>
      steps.forEach((step, i) => step.classList.toggle("lit", i === ticks % steps.length));
    if (autoplay(root, 1200, () => (ticks += 1, light()))) light();
  }
</script>

<style>
  .example {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    padding: 1.5rem 1rem;
  }
  .example-step {
    border: 1px solid #27272a;
    border-radius: 0.5rem;
    color: #a1a1aa;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    transition: border-color 0.3s, color 0.3s;
  }
  .example-step.lit {
    border-color: #a1a1aa;
    color: #fafafa;
  }
</style>
