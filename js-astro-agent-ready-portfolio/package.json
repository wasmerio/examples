{
  "name": "astro-agent-ready-portfolio",
  "private": true,
  "version": "0.0.1",
  "description": "An Astro portfolio theme AI agents can read: Ask AI about me, llms.txt and a Markdown copy of every post. Your coding agent can set it up. Builds to static files.",
  "keywords": [
    "astro",
    "astro-theme",
    "portfolio",
    "typescript",
    "tailwindcss",
    "coding-agents"
  ],
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check && tsc -p scripts",
    "check-content": "node scripts/check-content.ts",
    "new:post": "node scripts/new-post.ts",
    "new:project": "node scripts/new-project.ts",
    "test": "node --no-warnings --test \"scripts/test/*.test.ts\"",
    "verify": "pnpm check && pnpm test && pnpm check-content --ignore-starter && pnpm build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@lucide/astro": "^1.74.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/rehype": "^4.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "marked": "^18.1.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-code-group": "^2.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satori": "^0.63.2",
    "simple-icons": "^16.24.1",
    "tailwindcss": "^4.3.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
