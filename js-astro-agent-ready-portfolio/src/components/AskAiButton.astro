---
import { Sparkles } from "@lucide/astro";

// Opens the Ask AI dialog (AskAiDialog.astro wires every [data-ask-ai-open] button).
type Props = { class?: string };
---

<button
  type="button"
  class={`ask-ai inline-flex cursor-pointer items-center gap-1.5 rounded-md text-[#fafafa] ${Astro.props.class ?? ""}`}
  data-ask-ai-open
  aria-haspopup="dialog"
>
  <Sparkles class="size-3.5" />
  Ask AI
</button>
