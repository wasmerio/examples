---
import { ArrowUpRight, FileText } from "@lucide/astro";
import type { BlogPost } from "$lib/types/portfolio";

type Props = { posts: BlogPost[] };
const { posts } = Astro.props;
---

<section id="blog" class="scroll-mt-24 border-b border-[#27272a] py-16 lg:py-18">
  <div class="grid gap-5 lg:grid-cols-[14rem_1fr]">
    <div class="flex items-baseline justify-between gap-4 lg:block">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#a1a1aa]">Blog</p>
      <a
        class="text-sm font-medium text-[#a1a1aa] transition hover:text-[#fafafa] lg:mt-3 lg:inline-block"
        href="/blog">All posts →</a
      >
    </div>
    <div class="grid gap-4">
      {
        posts.map((post) => (
          <a
            class="group rounded-lg border border-[#27272a] bg-[#0a0a0a] p-5 transition hover:border-[#52525b] hover:bg-[#111111]"
            href={`/blog/${post.slug}`}
          >
            <div class="mb-5 inline-flex items-center gap-2 rounded-md border border-[#27272a] bg-[#111111] px-3 py-2 text-sm font-semibold text-[#e4e4e7]">
              <FileText class="size-4 text-[#a1a1aa]" />
              {post.published} · {post.readingMinutes} min read
            </div>
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">{post.title}</h3>
              <ArrowUpRight class="size-5 shrink-0 text-[#a1a1aa] transition group-hover:text-[#fafafa]" />
            </div>
            <p class="mt-4 max-w-2xl text-sm leading-7 text-[#a1a1aa]">{post.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
