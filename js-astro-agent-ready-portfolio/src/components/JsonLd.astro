---
// `<` is escaped so the JSON cannot close its own script tag.
type Props = { data: Record<string, unknown> | Record<string, unknown>[] };
const blocks = [Astro.props.data].flat();
const json = (block: Record<string, unknown>) => JSON.stringify(block).replace(/</g, "\\u003c");
---

{blocks.map((block) => <script type="application/ld+json" set:html={json(block)} />)}
