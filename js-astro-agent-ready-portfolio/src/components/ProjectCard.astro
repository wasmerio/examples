---
import { ArrowUpRight, Download, Star } from "@lucide/astro";
import { projectLink } from "$lib/content/project-link";
import type { GithubProject } from "$lib/types/portfolio";

// The wide card: an optional screenshot beside the details. The first project
// uses it with `featured`, which loads the image eagerly and shows an Active badge.
type Props = { project: GithubProject; featured?: boolean };
const { project, featured = false } = Astro.props;
---

<a
  class="group grid overflow-hidden rounded-lg border border-[#27272a] bg-[#0a0a0a] transition hover:border-[#52525b] hover:bg-[#111111] lg:grid-cols-[16rem_minmax(0,1fr)]"
  {...projectLink(project)}
>
  {
    project.image && (
      <div class="flex items-center border-b border-[#27272a] bg-[#050505] p-2.5 sm:p-3 lg:border-r lg:border-b-0">
        <div
          class="overflow-hidden rounded-md border border-[#27272a] bg-[#000000]"
          style={`aspect-ratio: ${project.image.width} / ${project.image.height};`}
        >
          <img
            class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.015]"
            src={project.image.src}
            alt={project.image.alt}
            width={project.image.width}
            height={project.image.height}
            loading={featured ? "eager" : "lazy"}
            decoding="async"
          />
        </div>
      </div>
    )
  }

  <div class="flex min-w-0 flex-col p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-3">
          <h3 class="text-xl font-semibold tracking-tight text-[#fafafa]">{project.name}</h3>
          {
            project.language && (
              <span class="rounded-md border border-[#27272a] bg-[#111111] px-2 py-1 text-xs font-semibold text-[#d4d4d8]">
                {project.language}
              </span>
            )
          }
          {
            featured ? (
              <span class="rounded-md border border-[#3f3f46] bg-[#151515] px-2 py-1 text-xs font-semibold text-green-500">
                Active
              </span>
            ) : (
              project.updated && (
                <span class="rounded-md border border-[#3f3f46] bg-[#151515] px-2 py-1 text-xs font-semibold text-[#d4d4d8]">
                  {project.updated}
                </span>
              )
            )
          }
        </div>

        <p class="mt-3 max-w-2xl text-sm leading-7 text-[#a1a1aa]">{project.description}</p>
      </div>

      <ArrowUpRight class="size-5 shrink-0 text-[#a1a1aa] transition group-hover:text-[#fafafa]" />
    </div>

    <div class="mt-auto flex flex-wrap items-end justify-between gap-4 pt-4">
      <div class="flex flex-wrap gap-2">
        {
          project.topics.map((topic) => (
            <span class="rounded-md border border-[#27272a] px-2.5 py-1 text-xs font-semibold text-[#a1a1aa]">
              {topic}
            </span>
          ))
        }
      </div>

      {
        project.metrics && (
          <div class="ml-auto flex flex-wrap justify-end gap-x-4 gap-y-2 text-xs text-[#8b8b94]">
            {project.metrics.map((metric) => (
              <span class="flex items-center gap-1.5">
                {metric.icon === "downloads" ? <Download class="size-3.5" /> : <Star class="size-3.5" />}
                <strong class="font-semibold text-[#e4e4e7]">{metric.value}</strong>
                <span>{metric.label}</span>
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</a>
