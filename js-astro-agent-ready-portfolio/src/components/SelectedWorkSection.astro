---
import { copy } from "$content/copy";
import SectionHeading from "./SectionHeading.astro";
import Tags from "./Tags.astro";
import WorkLink from "./WorkLink.astro";
import type { SelectedWork } from "$lib/types/portfolio";

type Props = { work: SelectedWork[] };

const [featured, ...rest] = Astro.props.work;
---

<section id="work" class="scroll-mt-24 border-b border-[#27272a] py-16 lg:py-18">
  <SectionHeading
    eyebrow="Selected work"
    title={copy.selectedWork.title}
    description={copy.selectedWork.description}
  />

  <div class="grid gap-4">
    {
      featured && (
        <article class="grid overflow-hidden rounded-lg border border-[#27272a] bg-[#0a0a0a] lg:grid-cols-[minmax(0,1fr)_15rem]">
          <div class="flex flex-col gap-5 p-5 sm:p-7">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#a1a1aa]">
                {featured.context}
              </p>
              <h3 class="mt-2 text-2xl font-semibold tracking-tight text-[#fafafa]">
                {featured.name}
              </h3>
            </div>
            <p class="max-w-2xl text-sm leading-7 text-[#a1a1aa]">{featured.description}</p>
            <div class="mt-auto flex flex-wrap items-center justify-between gap-4">
              <Tags stack={featured.stack} />
              <WorkLink item={featured} />
            </div>
          </div>

          <dl class="grid grid-cols-2 gap-px border-t border-[#27272a] bg-[#27272a] lg:grid-cols-1 lg:border-t-0 lg:border-l">
            {featured.metrics.map((metric) => (
              <div class="flex flex-col-reverse justify-center bg-[#0d0d0d] p-5 sm:p-6">
                <dt class="mt-1 text-xs leading-5 text-[#a1a1aa]">{metric.label}</dt>
                <dd class="text-2xl font-semibold tracking-tight text-[#fafafa] sm:text-3xl">
                  {metric.value}
                </dd>
              </div>
            ))}
          </dl>
        </article>
      )
    }

    <div class="divide-y divide-[#27272a] overflow-hidden rounded-lg border border-[#27272a] bg-[#0a0a0a]">
      {
        rest.map((item) => (
          <article class="grid gap-4 p-5 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6 sm:p-6">
            <dl>
              {item.metrics.map((metric) => (
                <div class="flex flex-col-reverse">
                  <dt class="text-xs leading-5 text-[#a1a1aa]">{metric.label}</dt>
                  <dd class="text-3xl font-semibold tracking-tight text-[#fafafa]">{metric.value}</dd>
                </div>
              ))}
            </dl>

            <div class="min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="text-lg font-semibold tracking-tight text-[#fafafa]">{item.name}</h3>
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#8b8b94]">
                  {item.context}
                </p>
              </div>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-[#a1a1aa]">{item.description}</p>
              <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                <Tags stack={item.stack} />
                <WorkLink item={item} />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
