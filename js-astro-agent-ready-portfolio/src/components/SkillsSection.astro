---
import IconMark from "./IconMark.astro";
import { copy } from "$content/copy";
import SectionHeading from "./SectionHeading.astro";
import { skillIcons } from "$lib/icons/portfolioIcons";
import type { SkillSummary } from "$lib/types/portfolio";

type Props = { skills: SkillSummary };
const { skills } = Astro.props;
---

<section id="skills" class="scroll-mt-24 border-b border-[#27272a] py-16 lg:py-18">
  <SectionHeading
    eyebrow="Skills"
    title={copy.skills.title}
    description={copy.skills.description}
    compact
  />

  <div class="space-y-6">
    <div class="flex flex-wrap gap-2">
      {
        skills.primary.map((skill) => (
          <span class="inline-flex px-3 py-2 items-center gap-2 rounded-md border border-[#27272a] bg-[#0a0a0a] text-sm font-medium whitespace-nowrap text-[#e4e4e7] transition hover:border-[#52525b] hover:bg-[#111111]">
            <IconMark icon={skillIcons[skill]} label={skill} brandColor class="size-4" />
            <span>{skill}</span>
          </span>
        ))
      }
    </div>

    <div class="border-t border-[#27272a] pt-5">
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-3">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#a1a1aa]">Additional skills</p>
        <span class="font-mono text-xs text-[#8b8b94]">{skills.total} total</span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {
          skills.secondary.map((skill) => (
            <span class="inline-flex px-2.5 py-2 items-center gap-2 rounded-md border border-[#27272a] bg-[#050505] text-xs font-medium whitespace-nowrap text-[#d4d4d8]">
              <IconMark icon={skillIcons[skill]} label={skill} brandColor class="size-3" />
              {skill}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
