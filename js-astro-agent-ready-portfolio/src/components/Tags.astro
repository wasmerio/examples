---
type Props = { stack: string[] };
---

<div class="flex flex-wrap gap-2">
  {
    Astro.props.stack.map((tag) => (
      <span class="inline-flex min-h-7 items-center rounded-md border border-[#27272a] bg-[#111111] px-2.5 text-xs font-medium text-[#d4d4d8]">
        {tag}
      </span>
    ))
  }
</div>
