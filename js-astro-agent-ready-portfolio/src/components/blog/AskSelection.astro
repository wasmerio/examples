---
import { Check, Copy, Sparkles } from "@lucide/astro";
import { aiTargets } from "$lib/ai/links";

// Select any passage in the post to ask an AI about it. The prompt carries
// the passage, the post title and its URL. `root` is a selector for the
// element whose text counts as the post.
type Props = { root: string; post: { title: string; url: string } };
const { root, post } = Astro.props;
---

<div
  class="ask-selection"
  role="group"
  aria-label="Ask an AI about the selected text"
  tabindex="-1"
  hidden
  data-ask-selection={root}
  data-title={post.title}
  data-url={post.url}
>
  <span class="ask-selection-label"><Sparkles class="size-3.5" aria-hidden="true" /> Ask</span>
  {
    aiTargets.map((target) => (
      <a href="#" target="_blank" rel="noopener noreferrer" data-target={target.id}>
        <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true">
          <path fill="currentColor" d={target.path} />
        </svg>
        {target.label}
      </a>
    ))
  }
  <button type="button" aria-label="Copy as a prompt">
    <Copy class="size-3.5" data-state="idle" />
    <Check class="size-3.5" data-state="done" style="display: none" />
  </button>
</div>

<script>
  import { chatUrl, selectionPrompt, type AiTarget } from "$lib/ai/links";
  import { copyText } from "$lib/utils/clipboard";

  // Selecting inside these is interaction with the widget, not reading.
  const IGNORE = ".prompt-box, .blog-figure, .post-actions";

  const popup = document.querySelector<HTMLElement>("[data-ask-selection]");
  const root = popup && document.querySelector<HTMLElement>(popup.dataset.askSelection!);

  if (popup && root) {
    const post = { title: popup.dataset.title!, url: popup.dataset.url! };
    const button = popup.querySelector("button")!;
    const idle = button.querySelector<SVGElement>("[data-state=idle]")!;
    const done = button.querySelector<SVGElement>("[data-state=done]")!;
    let prompt = "";

    const hide = () => {
      popup.hidden = true;
    };

    const update = () => {
      const selection = window.getSelection();
      if (!selection || selection.isCollapsed || !selection.rangeCount) return hide();
      const range = selection.getRangeAt(0);
      const node = range.commonAncestorContainer;
      const element = node instanceof Element ? node : node.parentElement;
      const selected = selection.toString().trim();
      if (!element || !root.contains(element) || element.closest(IGNORE) || selected.length < 3) return hide();

      prompt = selectionPrompt(post, selected);
      for (const link of popup.querySelectorAll<HTMLAnchorElement>("a[data-target]")) {
        link.href = chatUrl(link.dataset.target as AiTarget, prompt);
      }

      const rect = range.getBoundingClientRect();
      // Touch browsers draw their own menu above the selection, so go below it.
      const below = window.matchMedia("(pointer: coarse)").matches || rect.top < 72;
      popup.style.top = `${below ? rect.bottom + 10 : rect.top - 10}px`;
      popup.style.left = `${Math.min(Math.max(rect.left + rect.width / 2, 120), window.innerWidth - 120)}px`;
      popup.classList.toggle("ask-selection-below", below);
      popup.hidden = false;
    };

    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    };

    document.addEventListener("selectionchange", schedule);
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") hide();
    });
    popup.addEventListener("pointerdown", (event) => event.preventDefault());

    let timer: ReturnType<typeof setTimeout> | undefined;
    const showCopied = (copied: boolean) => {
      idle.style.display = copied ? "none" : "";
      done.style.display = copied ? "" : "none";
    };
    button.addEventListener("click", async () => {
      showCopied(await copyText(prompt));
      clearTimeout(timer);
      timer = setTimeout(() => showCopied(false), 1600);
    });
  }
</script>
