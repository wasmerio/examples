---
import { Pause, Play } from "@lucide/astro";
import { figureComponents, figures } from "$content/figures";

type Props = { id: string };
const { id } = Astro.props;

const Figure = figureComponents[id];
const meta = figures[id];
---

{
  Figure && meta && (
    <figure id={`figure-${id}`} class="blog-figure" aria-labelledby={`caption-${id}`} data-blog-figure>
      <div data-figure-visual>
        <Figure />
      </div>
      <p class="sr-only" hidden data-figure-description>
        {meta.description}
      </p>
      <button type="button" class="figure-pause" aria-pressed="false" aria-label="Pause animation" hidden>
        <Pause class="size-3.5" aria-hidden="true" data-icon="pause" />
        <Play class="size-3.5" aria-hidden="true" data-icon="play" style="display: none" />
      </button>
      <figcaption id={`caption-${id}`}>{meta.caption}</figcaption>
    </figure>
  )
}

<script>
  // Animated visuals change on a timer, so screen readers get the description
  // instead. Without motion the figure stays still, so it needs neither the
  // description swap nor the pause button.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const figure of document.querySelectorAll<HTMLElement>("[data-blog-figure]")) {
      const button = figure.querySelector<HTMLButtonElement>(".figure-pause")!;
      const pause = button.querySelector<SVGElement>("[data-icon=pause]")!;
      const play = button.querySelector<SVGElement>("[data-icon=play]")!;
      figure.querySelector("[data-figure-visual]")!.setAttribute("aria-hidden", "true");
      figure.querySelector<HTMLElement>("[data-figure-description]")!.hidden = false;
      button.hidden = false;
      button.addEventListener("click", () => {
        const paused = figure.classList.toggle("is-paused");
        button.ariaPressed = String(paused);
        button.ariaLabel = paused ? "Play animation" : "Pause animation";
        pause.style.display = paused ? "none" : "";
        play.style.display = paused ? "" : "none";
      });
    }
  }
</script>
