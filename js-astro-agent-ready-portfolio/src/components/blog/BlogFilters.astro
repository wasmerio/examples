---
import { Search, SlidersHorizontal, X } from "@lucide/astro";
import type { TagSummary } from "$lib/content/blog-queries";

// Markup only: the blog page's script shows it, wires the chips and filters the cards.
type Props = { tags: TagSummary[]; projects: string[] };
const { tags, projects } = Astro.props;

// Chips switch between these with aria-pressed, so no script has to swap classes.
const chip =
  "rounded-md border px-2.5 py-1 text-xs font-semibold transition hover:border-[#52525b] border-[#27272a] bg-[#111111] text-[#d4d4d8] aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-accent";
---

<div class="mt-6 grid gap-3 sm:mt-8 sm:gap-4" role="search" data-blog-filters hidden>
  <div class="flex gap-2">
    <div class="relative min-w-0 flex-1">
      <label class="sr-only" for="blog-search">Search posts</label>
      <Search
        class="pointer-events-none absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-[#8a8a93]"
        aria-hidden="true"
      />
      <input
        id="blog-search"
        type="search"
        placeholder="Search posts"
        autocomplete="off"
        class="w-full rounded-lg border border-[#27272a] bg-[#0a0a0a] py-2.5 pl-10 pr-3 text-sm text-[#fafafa] placeholder:text-[#8a8a93] transition hover:border-[#52525b]"
      />
    </div>
    <!-- On phones the chips fold away behind this toggle; from sm up they are always visible. -->
    <button
      type="button"
      class="inline-flex shrink-0 items-center gap-2 rounded-lg border border-[#27272a] bg-[#0a0a0a] px-3.5 text-sm font-medium text-[#d4d4d8] transition hover:border-[#52525b] sm:hidden"
      aria-expanded="false"
      aria-controls="blog-filter-chips"
      data-toggle-chips
    >
      <SlidersHorizontal class="size-4" aria-hidden="true" />
      Filters
      <span class="rounded-full bg-accent px-1.5 text-xs font-semibold text-[#000000]" data-active-count hidden></span>
    </button>
  </div>

  <div id="blog-filter-chips" class="hidden gap-3 sm:grid sm:gap-4">
    <div class="flex flex-wrap items-center gap-2" aria-label="Filter by topic" role="group">
      {
        tags.map(({ tag, slug, count }) => (
          <button type="button" class={chip} aria-pressed="false" data-tag={slug}>
            {tag} <span class="opacity-70">{count}</span>
          </button>
        ))
      }
    </div>

    {
      projects.length > 0 && (
        <div class="flex flex-wrap items-center gap-2" aria-label="Filter by project" role="group">
          <span class="text-xs font-semibold uppercase tracking-[0.12em] text-[#8a8a93]">Project</span>
          {projects.map((project) => (
            <button type="button" class={chip} aria-pressed="false" data-project={project}>
              {project}
            </button>
          ))}
        </div>
      )
    }
  </div>

  <!-- Only takes space while a filter is active; the live region stays mounted so changes are announced. -->
  <div class="sr-only items-center justify-between gap-3 text-sm text-[#a1a1aa]" data-filter-status>
    <p aria-live="polite"></p>
    <button
      type="button"
      class="inline-flex items-center gap-1 font-medium text-[#d4d4d8] transition hover:text-[#fafafa]"
      data-clear-filters
      hidden
    >
      <X class="size-3.5" aria-hidden="true" /> Clear
    </button>
  </div>
</div>
