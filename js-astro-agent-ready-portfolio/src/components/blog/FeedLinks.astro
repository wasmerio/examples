---
import { Check, Copy, Rss } from "@lucide/astro";

type Props = { origin: string };
const { origin } = Astro.props;

const link = "font-medium text-[#d4d4d8] transition hover:text-[#fafafa]";
---

<!-- The links work without JavaScript; the copy button needs the clipboard API, so it
     only appears once the script runs and only where that API exists. -->
<p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-[#a1a1aa]">
  <a class={`inline-flex items-center gap-1.5 ${link}`} href="/rss.xml">
    <Rss class="size-3.5" aria-hidden="true" /> RSS feed
  </a>
  <button type="button" class={`inline-flex items-center gap-1.5 ${link}`} data-copy-feed={`${origin}/rss.xml`} hidden>
    <span class="inline-flex items-center gap-1.5" data-state="idle"><Copy class="size-3.5" aria-hidden="true" /> Copy feed URL</span>
    <span class="hidden items-center gap-1.5" data-state="done"><Check class="size-3.5 text-accent" aria-hidden="true" /> Copied</span>
  </button>
  <span class="sr-only" aria-live="polite" data-copy-feed-status></span>
  <a class={link} href="/feed.json">JSON Feed</a>
</p>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-feed]")) {
    if (!navigator.clipboard?.writeText) continue;
    button.hidden = false;
    const idle = button.querySelector<HTMLElement>("[data-state=idle]")!;
    const done = button.querySelector<HTMLElement>("[data-state=done]")!;
    const status = button.parentElement!.querySelector<HTMLElement>("[data-copy-feed-status]")!;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const show = (copied: boolean) => {
      idle.classList.toggle("hidden", copied);
      idle.classList.toggle("inline-flex", !copied);
      done.classList.toggle("hidden", !copied);
      done.classList.toggle("inline-flex", copied);
      status.textContent = copied ? "Feed URL copied" : "";
    };
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyFeed!);
      } catch {
        return;
      }
      show(true);
      clearTimeout(timer);
      timer = setTimeout(() => show(false), 2000);
    });
  }
</script>
