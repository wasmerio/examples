---
import { ArrowUpRight } from "@lucide/astro";
import { tagSlug } from "$lib/content/blog-queries";
import type { BlogPost } from "$lib/types/portfolio";
import { formatDate } from "$lib/utils/date";

type Props = { post: BlogPost; level?: 2 | 3; stacked?: boolean; hidden?: boolean };
const { post, level = 2, stacked = false, hidden } = Astro.props;
const Heading = `h${level}` as const;
---

<article
  class={`post-card group relative flex flex-col gap-4 rounded-lg border border-[#27272a] bg-[#0a0a0a] p-5 transition hover:border-[#52525b] hover:bg-[#111111] sm:p-6 ${stacked ? "post-card--stacked" : "sm:flex-row sm:items-center sm:gap-8"}`}
  data-slug={post.slug}
  hidden={hidden}
>
  {
    post.cover && (
      <img
        class={`post-card-cover ${stacked ? "" : "sm:order-2"}`}
        src={post.cover}
        alt=""
        width="1200"
        height="630"
        loading="lazy"
      />
    )
  }
  <div class="min-w-0 flex-1">
    <p class="text-sm text-[#a1a1aa]">
      <time datetime={post.published}>{formatDate(post.published)}</time> · {post.readingMinutes} min read
    </p>
    <div class="mt-3 flex items-start justify-between gap-4">
      <Heading class="text-xl font-semibold leading-snug tracking-tight sm:text-2xl">
        <a class="after:absolute after:inset-0" href={`/blog/${post.slug}`}>{post.title}</a>
      </Heading>
      <ArrowUpRight
        class="size-5 shrink-0 text-[#a1a1aa] transition duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-[#fafafa]"
        aria-hidden="true"
      />
    </div>
    <p class="mt-3 max-w-2xl text-sm leading-7 text-[#a1a1aa]">{post.description}</p>
    {
      post.tags.length > 0 && (
        <ul class="relative mt-4 flex flex-wrap gap-2">
          {post.tags.map((tag) => (
            <li>
              <a
                class="rounded-md border border-[#27272a] bg-[#111111] px-2 py-1 text-xs font-semibold text-[#d4d4d8] transition hover:border-[#52525b]"
                href={`/tags/${tagSlug(tag)}`}
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
