---
import type { TocItem } from "$lib/content/markdown";

type Props = { items: TocItem[]; variant: "inline" | "sidebar" };
const { items, variant } = Astro.props;
const link = "block leading-snug text-[#8a8a93] transition hover:text-[#fafafa] aria-[current]:text-[#fafafa]";
---

{
  items.length > 1 &&
    (variant === "inline" ? (
      <details class="rounded-lg border border-[#27272a] bg-[#0a0a0a] p-4" data-toc>
        <summary class="cursor-pointer text-sm font-semibold text-[#d4d4d8]">On this page</summary>
        <ol class="mt-3 space-y-2 text-sm">
          {items.map((item) => (
            <li class={item.depth === 3 ? "pl-4" : ""}>
              <a class={link} href={`#${item.id}`}>
                {item.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    ) : (
      <nav aria-label="On this page" data-toc>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-[#a1a1aa]">On this page</p>
        <ol class="space-y-2 text-sm">
          {items.map((item) => (
            <li class={item.depth === 3 ? "pl-4" : ""}>
              <a class={link} href={`#${item.id}`}>
                {item.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    ))
}

<script>
  // One observer serves both variants, so the inline and sidebar lists stay in step.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc] a[href^='#']")];
  const idOf = (link: HTMLAnchorElement) => decodeURIComponent(link.hash.slice(1));
  const headings = [...new Set(links.map(idOf))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);
  if (headings.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (!visible) return;
        for (const link of links) {
          if (idOf(link) === visible.target.id) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        }
      },
      { rootMargin: "-80px 0px -70% 0px" },
    );
    headings.forEach((heading) => observer.observe(heading));
  }
</script>
