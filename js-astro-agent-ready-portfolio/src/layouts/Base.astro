---
import "../styles.css";
import { site } from "$lib/site";
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {site.accent && <style set:html={`:root{--accent:${site.accent}}`} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
