---
import Seo from "../components/blog/Seo.astro";
import BlogShell from "../layouts/BlogShell.astro";
import { site } from "$lib/site";
---

<BlogShell>
  <Seo slot="head" title="Page not found" description={`This page does not exist on ${site.name}'s site.`} path="/404" noindex />

  <section class="blog-reveal">
    <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[#a1a1aa]">404</p>
    <h1 class="blog-title mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">Page not found</h1>
    <p class="mt-4 text-lg leading-8 text-[#a1a1aa]">
      The link may be old, or the page has moved. Try the <a class="text-accent underline underline-offset-4" href="/"
        >portfolio</a
      >
      or the <a class="text-accent underline underline-offset-4" href="/blog">blog</a>.
    </p>
  </section>
</BlogShell>
