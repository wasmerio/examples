---
import { ArrowLeft, ArrowUpRight } from "@lucide/astro";
import type { GetStaticPaths } from "astro";
import { marked } from "marked";
import JsonLd from "../../components/JsonLd.astro";
import Base from "../../layouts/Base.astro";
import { site } from "$lib/site";
import { projectPages, type ProjectPage } from "$lib/content/projects";

export const getStaticPaths = (() =>
  projectPages.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }))) satisfies GetStaticPaths;

type Props = { entry: ProjectPage };
const { body, ...project } = Astro.props.entry;
const html = marked.parse(body, { async: false });

const url = `${site.url}/projects/${project.slug}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: project.title,
  description: project.description,
  codeRepository: project.repo,
  dateModified: project.updated,
  url,
  image: `${site.url}${site.image.path}`,
  author: { "@type": "Person", name: site.name, url: site.url },
};
---

<Base>
  <Fragment slot="head">
    <title>{project.title} | {site.name}</title>
    <meta name="description" content={project.description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={project.title} />
    <meta property="og:description" content={project.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${site.url}${site.image.path}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={project.title} />
    <meta name="twitter:description" content={project.description} />
    <JsonLd data={jsonLd} />
  </Fragment>

  <div class="project-page min-h-screen bg-[#000000] text-[#fafafa]">
    <header class="border-b border-[#27272a]">
      <div class="mx-auto flex min-h-16 max-w-3xl items-center justify-between px-4">
        <a
          class="inline-flex items-center gap-2 text-sm font-medium text-[#a1a1aa] transition hover:text-[#fafafa]"
          href="/#projects"
        >
          <ArrowLeft class="size-4" />
          {site.name}
        </a>
        <a
          class="inline-flex items-center gap-1.5 text-sm font-medium text-[#a1a1aa] transition hover:text-[#fafafa]"
          href={project.repo}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
          <ArrowUpRight class="size-4" />
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
      <article class="reveal">
        <h1 class="title-gradient text-3xl font-semibold leading-tight tracking-tight sm:text-5xl">
          {project.title}
        </h1>
        <p class="mt-4 text-lg leading-8 text-[#a1a1aa]">{project.description}</p>

        <div class="prose-post mt-10" set:html={html} />
      </article>
    </main>
  </div>
</Base>
