---
import type { GetStaticPaths } from "astro";
import PostCard from "../../components/blog/PostCard.astro";
import Seo from "../../components/blog/Seo.astro";
import BlogShell from "../../layouts/BlogShell.astro";
import { site } from "$lib/site";
import { allTags, postsWithTag, type TagSummary } from "$lib/content/blog-queries";

export const getStaticPaths = (() =>
  allTags().map((summary) => ({ params: { tag: summary.slug }, props: { summary } }))) satisfies GetStaticPaths;

type Props = { summary: TagSummary };
const { tag, slug } = Astro.props.summary;
const posts = postsWithTag(slug);
const description = `${posts.length} ${posts.length === 1 ? "post" : "posts"} tagged ${tag} by ${site.name}.`;
---

<BlogShell>
  <Seo slot="head" title={`${tag} posts`} description={description} path={`/tags/${slug}`} noindex={posts.length < 2} />

  <section class="blog-reveal">
    <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[#a1a1aa]">
      <a class="transition hover:text-[#fafafa]" href="/blog">Blog</a> / Tag
    </p>
    <h1 class="blog-title mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">
      {tag}
    </h1>
    <p class="mt-4 text-lg leading-8 text-[#a1a1aa]">{description}</p>

    <div class="mt-10 grid gap-4">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BlogShell>
