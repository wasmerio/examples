---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PaginatedMapsSearch from "$lib/components/paginated-maps-search.svelte";
import PageTitle from "$lib/components/PageTitle.astro";
import { projectFromId, type Crumb } from "$lib/content-utils";
import { getTranslations } from "$lib/i18n";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: {
            project: project.id,
        },
        props: {
            project: project,
        },
    }));
}

const { project } = Astro.props;

const maps = await getCollection("maps", (m) => {
    return projectFromId(m.id) == project.id;
});

const translations = getTranslations(project.data.language);
const crumbs: Crumb[] = [
    {
        label: project.data.title,
        href: `/${project.id}`,
    },
    {
        label: translations.common.maps,
        href: `/${project.id}/maps`,
    },
];
---

<Layout
    title={`${project.data.title} - ${translations.common.maps}`}
    {crumbs}
    {project}
>
    <PageTitle>{translations.common.maps}</PageTitle>
    <PaginatedMapsSearch
        {maps}
        placeholder={translations.search.placeholder}
        client:idle
    />
</Layout>
