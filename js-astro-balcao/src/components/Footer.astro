---
import { site, type Locale } from '../site.config';
import { t } from '../i18n';
interface Props { locale: Locale }
const dict = t(Astro.props.locale);
const year = new Date().getFullYear();
---
<footer class="border-t border-slate-200 py-10 text-sm text-slate-600 dark:border-slate-800 dark:text-slate-400">
  <div class="container-x flex flex-col items-center justify-between gap-3 sm:flex-row">
    <p>© {year} {site.name}. {dict.footer.rights}</p>
    <p>{dict.footer.made}</p>
  </div>
</footer>
