---
import Icon from './Icon.astro';
import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site, type Locale } from '../site.config';
import { localeHome } from '../lib/paths';
import { t } from '../i18n';

interface Props { locale: Locale; alternates: Partial<Record<Locale, string>> }
const { locale, alternates } = Astro.props;
const dict = t(locale);
const home = localeHome(locale);
const links = [
  { href: `${home}#services`, label: dict.nav.services },
  { href: `${home}#about`, label: dict.nav.about },
  { href: `${home}#pricing`, label: dict.nav.pricing },
  { href: `${home}#faq`, label: dict.nav.faq },
];
---
<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/85 backdrop-blur dark:border-slate-800 dark:bg-slate-950/85">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href={home} class="flex items-center gap-2 font-bold text-slate-900 dark:text-white">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-700 text-sm text-white dark:bg-brand-500 dark:text-slate-950" aria-hidden="true">{site.name.charAt(0)}</span>
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main" class="hidden items-center gap-6 text-sm font-medium md:flex">
      {links.map((l) => <a href={l.href} class="text-slate-600 hover:text-brand-700 dark:text-slate-300 dark:hover:text-brand-100">{l.label}</a>)}
      <a href={`${home}#contact`} class="btn-primary py-2!">{dict.nav.contact}</a>
    </nav>
    <div class="flex items-center gap-1">
      <LanguageToggle locale={locale} alternates={alternates} />
      <ThemeToggle label={dict.a11y.theme} />
      <details class="group relative md:hidden">
        <summary class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-full text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800 [&::-webkit-details-marker]:hidden">
          <span class="sr-only">{dict.a11y.menu}</span>
          <Icon name="menu" class="h-5 w-5" />
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-2 w-56 rounded-2xl border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-800 dark:bg-slate-900">
          {[...links, { href: `${home}#contact`, label: dict.nav.contact }].map((l) => (
            <a href={l.href} class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800">{l.label}</a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  // Close the mobile menu after choosing a link.
  document.querySelectorAll('header details nav a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>
