---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './sections/Hero.astro';
import Services from './sections/Services.astro';
import About from './sections/About.astro';
import Pricing from './sections/Pricing.astro';
import Testimonials from './sections/Testimonials.astro';
import Faq from './sections/Faq.astro';
import Contact from './sections/Contact.astro';
import { site, type Locale } from '../site.config';
import { localeHome } from '../lib/paths';
import { t } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const alternates = Object.fromEntries(site.locales.map((l) => [l, localeHome(l)]));
---
<BaseLayout locale={locale} alternates={alternates}>
  <Hero dict={dict} />
  <Services dict={dict} />
  <About dict={dict} />
  <Pricing dict={dict} />
  <Testimonials dict={dict} />
  <Faq dict={dict} />
  <Contact dict={dict} />
</BaseLayout>
