---
import Icon from './Icon.astro';
import { site, type Locale } from '../site.config';
import { localeHome } from '../lib/paths';
import { localeNames, localeShort, t } from '../i18n';

interface Props { locale: Locale; alternates: Partial<Record<Locale, string>> }
const { locale, alternates } = Astro.props;
const others = site.locales.filter((l) => l !== locale);
---
<div class="flex items-center" role="group" aria-label={t(locale).a11y.language}>
  {others.map((l) => (
    <a
      href={alternates[l] ?? localeHome(l)}
      hreflang={l === 'pt-br' ? 'pt-BR' : 'en'}
      lang={l === 'pt-br' ? 'pt-BR' : 'en'}
      title={localeNames[l]}
      class="inline-flex h-10 items-center gap-1.5 rounded-full px-3 text-sm font-semibold text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
    >
      <Icon name="globe" class="h-4 w-4" />
      <span>{localeShort[l]}</span>
      <span class="sr-only">{localeNames[l]}</span>
    </a>
  ))}
</div>
