---
import { site, type Locale } from '../site.config';
import { langTag } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Map of locale → path (base-prefixed) of this same page in each language. */
  alternates: Partial<Record<Locale, string>>;
  image?: string;
  type?: 'website' | 'article';
}
const { title, description, locale, alternates, image = 'og.png', type = 'website' } = Astro.props;
const siteUrl = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${image}`, siteUrl).href;
const ogLocale = locale === 'pt-br' ? 'pt_BR' : 'en_US';
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{Object.entries(alternates).map(([l, href]) => (
  <link rel="alternate" hreflang={langTag(l as Locale)} href={new URL(href as string, siteUrl).href} />
))}
{alternates[site.defaultLocale] && (
  <link rel="alternate" hreflang="x-default" href={new URL(alternates[site.defaultLocale] as string, siteUrl).href} />
)}
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:site_name" content={site.name} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="sitemap" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sitemap-index.xml`} />
