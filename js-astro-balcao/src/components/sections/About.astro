---
import type { Dict } from '../../i18n';
interface Props { dict: Dict }
const { about } = Astro.props.dict;
---
<section id="about" class="bg-slate-50 py-20 dark:bg-slate-900/40">
  <div class="container-x grid gap-12 lg:grid-cols-5">
    <div class="lg:col-span-3">
      <h2 class="section-title">{about.title}</h2>
      {about.text.map((p) => <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">{p}</p>)}
    </div>
    <dl class="card grid content-start gap-5 lg:col-span-2">
      {about.facts.map((f) => (
        <div>
          <dt class="text-sm font-semibold uppercase tracking-wide text-brand-700 dark:text-brand-100">{f.label}</dt>
          <dd class="mt-1 text-slate-800 dark:text-slate-200">{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
