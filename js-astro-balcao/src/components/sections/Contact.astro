---
import Icon from '../Icon.astro';
import type { Dict } from '../../i18n';
import { site } from '../../site.config';
import { waLink } from '../../lib/paths';
interface Props { dict: Dict }
const { contact, hero } = Astro.props.dict;
const mailto = `mailto:${site.contact.email}?subject=${encodeURIComponent(contact.emailSubject)}`;
---
<section id="contact" class="py-20">
  <div class="container-x">
    <div class="rounded-3xl bg-brand-900 px-6 py-14 text-center text-white sm:px-12">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{contact.title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white/85">{contact.text}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={waLink(hero.waMessage)} target="_blank" rel="noopener" class="btn bg-white text-brand-900 hover:bg-brand-50"><Icon name="whatsapp" class="h-5 w-5" />{contact.whatsapp}</a>
        <a href={mailto} class="btn border border-white/50 text-white hover:bg-white/10"><Icon name="mail" class="h-5 w-5" />{contact.email}</a>
      </div>
      <p class="mt-6 text-sm text-white/80">{site.contact.phoneDisplay} · {site.contact.email}</p>
    </div>
  </div>
</section>
