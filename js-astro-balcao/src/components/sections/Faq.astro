---
import type { Dict } from '../../i18n';
interface Props { dict: Dict }
const { faq } = Astro.props.dict;
---
<section id="faq" class="py-20">
  <div class="container-x max-w-3xl">
    <h2 class="section-title">{faq.title}</h2>
    <div class="mt-8 divide-y divide-slate-200 rounded-2xl border border-slate-200 dark:divide-slate-800 dark:border-slate-800">
      {faq.items.map((item) => (
        <details class="group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-900 dark:text-white [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="text-brand-700 transition-transform group-open:rotate-45 dark:text-brand-100" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-slate-600 dark:text-slate-400">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
