---
import Icon from '../Icon.astro';
import type { Dict } from '../../i18n';
import { waLink } from '../../lib/paths';
interface Props { dict: Dict }
const { hero } = Astro.props.dict;
---
<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60rem_30rem_at_80%_-10%,var(--brand-100),transparent)] dark:bg-[radial-gradient(60rem_30rem_at_80%_-10%,color-mix(in_oklab,var(--brand-900)_70%,transparent),transparent)]"></div>
  <div class="container-x grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-2">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-900 dark:bg-brand-900/40 dark:text-brand-100">{hero.badge}</p>
      <h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl lg:text-6xl dark:text-white">{hero.title}</h1>
      <p class="mt-5 max-w-xl text-lg text-slate-600 dark:text-slate-300">{hero.subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={waLink(hero.waMessage)} class="btn-primary" rel="noopener" target="_blank"><Icon name="whatsapp" class="h-5 w-5" />{hero.primary}</a>
        <a href="#services" class="btn-ghost">{hero.secondary}</a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-600 dark:text-slate-300">
        {hero.points.map((p) => <li class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-brand-600 dark:text-brand-500" />{p}</li>)}
      </ul>
    </div>
    <div class="relative" aria-hidden="true">
      <div class="aspect-[4/3] w-full rounded-3xl bg-gradient-to-br from-brand-100 via-white to-brand-50 p-6 shadow-xl ring-1 ring-slate-200 dark:from-brand-900 dark:via-slate-900 dark:to-slate-950 dark:ring-slate-800">
        <div class="grid h-full grid-cols-3 grid-rows-3 gap-3">
          <div class="col-span-2 row-span-2 rounded-2xl bg-white/80 p-4 shadow-sm dark:bg-slate-900/80">
            <div class="h-3 w-24 rounded-full bg-brand-500/70"></div>
            <div class="mt-3 h-2 w-40 rounded-full bg-slate-200 dark:bg-slate-700"></div>
            <div class="mt-2 h-2 w-32 rounded-full bg-slate-200 dark:bg-slate-700"></div>
            <div class="mt-6 grid grid-cols-3 gap-2">
              {Array.from({ length: 6 }).map((_, i) => <div class={`h-10 rounded-lg ${i === 2 ? 'bg-brand-600' : 'bg-slate-100 dark:bg-slate-800'}`}></div>)}
            </div>
          </div>
          <div class="rounded-2xl bg-brand-700 p-3 text-white dark:bg-brand-500"><Icon name="calendar" class="h-6 w-6" /></div>
          <div class="rounded-2xl bg-white/80 p-3 text-brand-700 dark:bg-slate-900/80 dark:text-brand-100"><Icon name="heart" class="h-6 w-6" /></div>
          <div class="col-span-3 flex items-center gap-3 rounded-2xl bg-white/80 p-3 dark:bg-slate-900/80">
            <div class="h-9 w-9 rounded-full bg-brand-100 dark:bg-brand-900"></div>
            <div class="flex-1"><div class="h-2 w-2/3 rounded-full bg-slate-200 dark:bg-slate-700"></div><div class="mt-2 h-2 w-1/3 rounded-full bg-slate-200 dark:bg-slate-700"></div></div>
            <div class="h-8 w-20 rounded-full bg-brand-600"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
