---
import Icon from '../Icon.astro';
import type { Dict } from '../../i18n';
import { waLink } from '../../lib/paths';
interface Props { dict: Dict }
const { pricing, hero } = Astro.props.dict;
---
<section id="pricing" class="py-20">
  <div class="container-x">
    <h2 class="section-title">{pricing.title}</h2>
    <p class="section-sub">{pricing.subtitle}</p>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {pricing.plans.map((p) => (
        <article class={`card relative flex flex-col ${p.featured ? 'ring-2 ring-brand-600 dark:ring-brand-500' : ''}`}>
          {p.featured && <span class="absolute -top-3 left-6 rounded-full bg-brand-700 px-3 py-1 text-xs font-semibold text-white dark:bg-brand-500 dark:text-slate-950">{pricing.popular}</span>}
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{p.name}</h3>
          <p class="mt-4"><span class="text-4xl font-extrabold text-slate-900 dark:text-white">{p.price}</span> <span class="text-slate-600 dark:text-slate-400">{p.period}</span></p>
          <ul class="mt-6 flex-1 space-y-3">
            {p.features.map((f) => <li class="flex gap-2 text-slate-700 dark:text-slate-300"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-brand-600 dark:text-brand-500" />{f}</li>)}
          </ul>
          <a href={waLink(`${hero.waMessage} (${p.name})`)} target="_blank" rel="noopener" class={`mt-8 ${p.featured ? 'btn-primary' : 'btn-ghost'}`}>{pricing.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>
