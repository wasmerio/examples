---
import Icon from '../Icon.astro';
import type { Dict } from '../../i18n';
interface Props { dict: Dict }
const { services } = Astro.props.dict;
---
<section id="services" class="py-20">
  <div class="container-x">
    <h2 class="section-title">{services.title}</h2>
    <p class="section-sub">{services.subtitle}</p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.items.map((s) => (
        <article class="card">
          <div class="grid h-11 w-11 place-items-center rounded-xl bg-brand-50 text-brand-700 dark:bg-brand-900/50 dark:text-brand-100"><Icon name={s.icon} /></div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">{s.title}</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-400">{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
