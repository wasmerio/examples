---
import Icon from '../Icon.astro';
import type { Dict } from '../../i18n';
interface Props { dict: Dict }
const { testimonials } = Astro.props.dict;
---
<section id="testimonials" class="bg-slate-50 py-20 dark:bg-slate-900/40">
  <div class="container-x">
    <h2 class="section-title">{testimonials.title}</h2>
    <p class="section-sub">{testimonials.note}</p>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {testimonials.items.map((item) => (
        <figure class="card border-dashed">
          <Icon name="quote" class="h-7 w-7 text-brand-600 dark:text-brand-500" />
          <blockquote class="mt-3 text-slate-700 italic dark:text-slate-300">“{item.quote}”</blockquote>
          <figcaption class="mt-4 text-sm"><span class="font-semibold text-slate-900 dark:text-white">{item.name}</span> · <span class="text-slate-600 dark:text-slate-400">{item.role}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
