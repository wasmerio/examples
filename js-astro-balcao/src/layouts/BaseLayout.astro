---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, type Locale } from '../site.config';
import { langTag, withBase } from '../lib/paths';
import { t } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  alternates: Partial<Record<Locale, string>>;
}
const { locale, alternates } = Astro.props;
const dict = t(locale);
const title = Astro.props.title ?? dict.meta.title;
const description = Astro.props.description ?? dict.meta.description;
const c = site.colors;
const brandVars = `--brand-50:${c.brand50};--brand-100:${c.brand100};--brand-500:${c.brand500};--brand-600:${c.brand600};--brand-700:${c.brand700};--brand-900:${c.brand900};`;
---
<!doctype html>
<html lang={langTag(locale)} style={brandVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={c.brand700} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} locale={locale} alternates={alternates} />
    <script is:inline>
      // Apply the saved or system colour scheme before paint (prevents a flash).
      (function () {
        try {
          var s = localStorage.getItem('theme');
          var dark = s ? s === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-slate-900">{dict.a11y.skip}</a>
    <Header locale={locale} alternates={alternates} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
