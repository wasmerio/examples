---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { localeHome } from '../lib/paths';
const alternates = Object.fromEntries(site.locales.map((l) => [l, localeHome(l)]));
---
<BaseLayout locale={site.defaultLocale} title={`404 – ${site.name}`} description="Page not found / Página não encontrada" alternates={alternates}>
  <section class="container-x py-32 text-center">
    <p class="text-sm font-semibold text-brand-700 dark:text-brand-100">404</p>
    <h1 class="mt-2 text-4xl font-bold text-slate-900 dark:text-white">Page not found · Página não encontrada</h1>
    <div class="mt-8 flex justify-center gap-3">
      {site.locales.map((l) => <a class="btn-ghost" href={localeHome(l)}>{l === 'pt-br' ? 'Voltar ao início' : 'Back to home'}</a>)}
    </div>
  </section>
</BaseLayout>
