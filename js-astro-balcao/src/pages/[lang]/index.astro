---
// Home page for every non-default language, e.g. "/pt-br/".
import HomePage from '../../components/HomePage.astro';
import { site, type Locale } from '../../site.config';

export function getStaticPaths() {
  return site.locales.filter((l) => l !== site.defaultLocale).map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
---
<HomePage locale={locale} />
