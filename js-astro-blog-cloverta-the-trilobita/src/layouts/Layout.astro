---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import { getTranslations, getLangFromUrl } from "../i18n";
import Icon from "../components/Icon.astro";
import Stripes from "../components/Stripes.astro";
import BuildHashBlocks from "../components/BuildHashBlocks.astro";
import ImagePreview from "../components/ImagePreview.astro";
import Spinner from "../components/Spinner.astro";
import SidebarNavigation from "../components/SidebarNavigation.astro";
import { ClientRouter, fade } from "astro:transitions";
interface Props {
  title?: string;
  description?: string;
  active?: string;
  alternatePath?: string;
  image?: string;
}
const {
  title,
  description = "Half Price! 半价便当同好会！",
  active = "home",
  alternatePath,
  image = "/images/HP!.png",
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const otherLang = lang === "zh" ? "en" : "zh";
const alternate =
  alternatePath ??
  Astro.url.pathname.replace(/^\/(zh|en)(?=\/|$)/, `/${otherLang}`);
const canonical = new URL(Astro.url.pathname, Astro.site);
const displayFontUrl = `https://fonts.googleapis.com/css2?family=ZCOOL+QingKe+HuangYou&display=swap&text=${encodeURIComponent(t.backgroundTitle + t.backgroundText)}`;
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..900;1,8..60,300..900&display=swap"
    />
    <link rel="stylesheet" href={displayFontUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} · ${t.siteTitle}` : t.siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang={otherLang === "zh" ? "zh-CN" : "en"}
      href={new URL(alternate, Astro.site)}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.rss}
      href={lang === "zh" ? "/rss.xml" : `/${lang}/rss.xml`}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.columnRss}
      href={`/${lang}/series/rss.xml`}
    />
    <meta property="og:title" content={title ?? t.siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline data-astro-rerun>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        document.documentElement.classList.toggle(
          "dark",
          theme
            ? theme === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches,
        );
      })();
    </script>
  </head>
  <body>
    <Spinner />
    <a class="skip-link" href="#main-content"
      >{lang === "zh" ? "跳至正文" : "Skip to content"}</a
    >
    <div
      class="background-word"
      aria-hidden="true"
      transition:name="site-background"
      transition:animate="none"
    >
      {t.backgroundText}
    </div>
    <div class="site-shell">
      <header
        class="masthead flex items-start justify-between gap-4"
        transition:name="site-header"
        transition:animate="none"
      >
        <div class="brand">
          <span class="brand-watermark" aria-hidden="true"
            >{t.backgroundTitle}</span
          >
          <a class="brand-title" href={`/${lang}/`}>{t.siteTitle}</a>
          <Stripes large />
        </div>
        <div class="header-controls flex items-center gap-2">
          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle"
            aria-label={t.theme}
            title={t.theme}
            aria-pressed="false"
            ><Icon name="moon" class="moon-icon" /><Icon
              name="sun"
              class="sun-icon"
            /></button
          >
          <a
            class="language-switch"
            href={alternate}
            lang={otherLang}
            aria-label={otherLang === "en" ? "Switch to English" : "切换为中文"}
            >{t.language}</a
          >
        </div>
      </header>
      <div class="workspace">
        <aside
          class="sidebar"
          transition:name="site-sidebar"
          transition:animate="none"
        >
          <a
            class="avatar-link"
            href={`https://cloverta.top/`}
            aria-label={t.nav.about}
            ><img
              class="avatar"
              src="/images/avatar.jpg"
              width="110"
              height="110"
              alt="Cloverta"
            /><svg class="avatar-progress" viewBox="0 0 100 100" aria-hidden="true">
              <circle cx="50" cy="50" r="49" pathLength="100" />
            </svg></a
          >
          <SidebarNavigation {lang} {active} />
        </aside>
        <main
          id="main-content"
          class="min-w-0"
          transition:name="page-content"
          transition:animate={fade({ duration: "0.24s" })}
        >
          <slot />
        </main>
      </div>
      <footer
        class="site-footer"
        transition:name="site-footer"
        transition:animate="none"
      >
        <Stripes large class="footer-stripes" />
        <div class="social-links flex justify-center items-center gap-6">
          <a
            href="https://github.com/ClovertaTheTrilobita/"
            aria-label="GitHub"
            target="_blank"
            rel="me noopener noreferrer"><Icon name="github" /></a
          >
          <a
            href="mailto:cloverta@petalmail.com"
            aria-label={lang === "zh" ? "发送邮件" : "Email"}
            ><Icon name="mail" /></a
          >
        </div>
        <p class="footer-content-pc">
          © {new Date().getUTCFullYear()} ClovertaTheTrilobita · <a
            href="https://github.com/ClovertaTheTrilobita/astro-blog-template"
            target="_blank"
            rel="noopener noreferrer">Source code</a
          >
          {t.license}
          {t.footer}
        </p>
        <div class="footer-content-mobile">
          <p>© {new Date().getUTCFullYear()} ClovertaTheTrilobita</p>
          <p>{t.footer}</p>
        </div>
        <BuildHashBlocks />
      </footer>
    </div>
    <ImagePreview lang={lang} />
    <script>
      const activeNavIndex = (page: Document) =>
        Array.from(page.querySelectorAll("#site-navigation .nav-link"))
          .findIndex((link) => link.getAttribute("aria-current") === "page");

      document.addEventListener("astro:before-preparation", (event) => {
        const load = event.loader;
        event.loader = async () => {
          await load();
          if (
            event.signal.aborted ||
            event.defaultPrevented ||
            document.documentElement.lang !== event.newDocument.documentElement.lang
          ) return;

          const from = activeNavIndex(document);
          const to = activeNavIndex(event.newDocument);
          if (from < 0 || to < 0 || from === to) return;

          event.direction = to > from ? "nav-next" : "nav-previous";
        };
      });

      let avatarController: AbortController | undefined;
      let resetAvatar: (() => void) | undefined;
      function initAvatarWelcome() {
        avatarController?.abort();
        resetAvatar?.();
        const avatar = document.querySelector<HTMLAnchorElement>(".avatar-link");
        const circle = avatar?.querySelector<SVGCircleElement>("circle");
        const image = avatar?.querySelector<HTMLImageElement>(".avatar");
        if (!avatar || !circle || !image) return;
        avatarController = new AbortController();
        const { signal } = avatarController;
        const audio = new Audio("/audio/lawson_welcome.mp3");
        audio.preload = "none";
        let progress: Animation | undefined;
        let complete = false;
        let playbackRequested = false;
        let completedPlays = 0;
        let spinFrame = 0;
        let returnRotation: Animation | undefined;
        const updateRotation = () => {
          if (complete && Number.isFinite(audio.duration) && audio.duration > 0) {
            const turns = Math.min(completedPlays + audio.currentTime / audio.duration, 2) * 1.5;
            image.style.setProperty("--avatar-rotation", `${turns * 360}deg`);
          }
        };
        const pauseSpinning = () => {
          cancelAnimationFrame(spinFrame);
          spinFrame = 0;
          avatar.removeAttribute("data-playing");
          updateRotation();
        };
        const stopSpinning = (returnHome = false) => {
          pauseSpinning();
          const angle = parseFloat(getComputedStyle(image).rotate) || 0;
          returnRotation?.cancel();
          returnRotation = undefined;
          const target = Math.round(angle / 360) * 360;
          const distance = Math.abs(target - angle);
          if (!returnHome || distance < 0.1 || matchMedia("(prefers-reduced-motion: reduce)").matches) {
            image.style.removeProperty("--avatar-rotation");
            return;
          }
          // Use the shortest direction, at least three times the playback speed.
          const playbackSpeed = Number.isFinite(audio.duration) && audio.duration > 0
            ? 1080 / (audio.duration * 2 * 1000) : 0;
          image.style.setProperty("--avatar-rotation", `${target}deg`);
          const animation = image.animate(
            [{ rotate: `${angle}deg` }, { rotate: `${target}deg` }],
            { duration: distance / Math.max(0.72, playbackSpeed * 3), easing: "linear" },
          );
          returnRotation = animation;
          void animation.finished.then(() => {
            if (returnRotation !== animation) return;
            returnRotation = undefined;
            image.style.removeProperty("--avatar-rotation");
          }, () => {});
        };
        const spin = () => {
          updateRotation();
          spinFrame = requestAnimationFrame(spin);
        };
        audio.addEventListener("playing", () => {
          if (complete && !audio.paused && !audio.ended) {
            cancelAnimationFrame(spinFrame);
            avatar.setAttribute("data-playing", "");
            spin();
          }
        }, { signal });
        for (const event of ["pause", "waiting"]) {
          audio.addEventListener(event, pauseSpinning, { signal });
        }
        for (const event of ["emptied", "error"]) {
          audio.addEventListener(event, () => {
            if (complete) stopSpinning();
          }, { signal });
        }
        const playWelcome = () => {
          if (!complete || playbackRequested || completedPlays >= 2) return;
          playbackRequested = true;
          const currentProgress = progress;
          void audio.play().catch((error: DOMException) => {
            if (progress === currentProgress && error.name === "NotAllowedError") {
              // Retry during the next user gesture if autoplay was blocked.
              playbackRequested = false;
            }
          });
        };
        audio.addEventListener("ended", () => {
          if (!complete) return;
          completedPlays += 1;
          if (completedPlays < 2) {
            playbackRequested = false;
            audio.currentTime = 0;
            playWelcome();
          } else {
            stopSpinning();
          }
        }, { signal });
        const resetInteraction = (returnHome = false) => {
          progress?.cancel();
          progress = undefined;
          stopSpinning(returnHome);
          complete = false;
          playbackRequested = false;
          completedPlays = 0;
          avatar.removeAttribute("data-welcoming");
          audio.pause();
          audio.currentTime = 0;
        };
        resetAvatar = () => resetInteraction();
        const banner = document.querySelector<HTMLElement>(".brand");
        banner?.addEventListener("click", (event) => {
          if (!matchMedia("(max-width: 700px)").matches
            || !/^\/(zh|en)\/?$/.test(location.pathname)
            || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          resetInteraction();
          void audio.play().catch(() => {});
        }, { signal });
        avatar.addEventListener("pointerenter", (event) => {
          if (event.pointerType !== "mouse") return;
          resetInteraction(true);
          avatar.setAttribute("data-welcoming", "");
          audio.preload = "auto";
          audio.load();
          const animation = circle.animate(
            [{ strokeDashoffset: "100", opacity: 1 }, { strokeDashoffset: "0", opacity: 1 }],
            { duration: 1200, easing: "cubic-bezier(0.7, 0, 0.3, 1)", fill: "forwards" },
          );
          progress = animation;
          void animation.finished.then(() => {
            if (progress !== animation) return;
            complete = true;
            playWelcome();
          }, () => {});
        }, { signal });
        avatar.addEventListener("pointerleave", () => resetInteraction(true), { signal });
        avatar.addEventListener("pointercancel", () => resetInteraction(true), { signal });
        window.addEventListener("blur", resetAvatar, { signal });
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) resetAvatar?.();
        }, { signal });
        document.addEventListener("pointerdown", playWelcome, { signal });
        document.addEventListener("keydown", playWelcome, { signal });
      }
      document.addEventListener("astro:page-load", initAvatarWelcome);
      document.addEventListener("astro:before-swap", () => {
        avatarController?.abort();
        resetAvatar?.();
      });
      let titleShadowController: AbortController | undefined;
      let clearTitleShadow: (() => void) | undefined;
      function initTitleShadow() {
        titleShadowController?.abort();
        clearTitleShadow?.();
        const title = document.querySelector<HTMLElement>(".brand-title");
        if (!title) return;
        titleShadowController = new AbortController();
        const { signal } = titleShadowController;
        clearTitleShadow = () => title.removeAttribute("data-light-source");
        const updateShadow = (event: PointerEvent) => {
          if (event.pointerType !== "mouse") return;
          const bounds = title.getBoundingClientRect();
          const dx = bounds.left + bounds.width / 2 - event.clientX;
          const dy = bounds.top + bounds.height / 2 - event.clientY;
          const distance = Math.hypot(dx, dy);
          const radius = Math.hypot(bounds.width / 2, bounds.height / 2);
          const proximity = 1 - Math.min(distance / Math.max(radius, 1), 1);
          // Keep the shadow opposite the light source without exceeding 14px.
          const scale = Math.min(distance * 0.12, 14) / (distance || 1);
          title.style.setProperty("--title-shadow-x", `${dx * scale}px`);
          title.style.setProperty("--title-shadow-y", `${dy * scale}px`);
          title.style.setProperty(
            "--title-shadow-blur",
            `${10 - proximity * 4}px`,
          );
          title.style.setProperty(
            "--title-shadow-opacity",
            String(0.12 + proximity * 0.3),
          );
          title.setAttribute("data-light-source", "");
        };
        title.addEventListener("pointerenter", updateShadow, { signal });
        title.addEventListener("pointermove", updateShadow, { signal });
        title.addEventListener("pointerleave", clearTitleShadow, { signal });
        title.addEventListener("pointercancel", clearTitleShadow, { signal });
        window.addEventListener("blur", clearTitleShadow, { signal });
      }
      document.addEventListener("astro:page-load", initTitleShadow);
      document.addEventListener("astro:before-swap", () => {
        titleShadowController?.abort();
        clearTitleShadow?.();
      });
      const updateButton = () =>
        document
          .querySelector("#theme-toggle")
          ?.setAttribute(
            "aria-pressed",
            String(document.documentElement.classList.contains("dark")),
          );
      const applyTheme = () => {
        let stored;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        document.documentElement.classList.toggle(
          "dark",
          stored
            ? stored === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches,
        );
        updateButton();
      };
      document.addEventListener("astro:after-swap", applyTheme);
      let themeTransition: ViewTransition | undefined;
      const toggleTheme = () => {
        if (themeTransition) return;

        const root = document.documentElement;
        const dark = !root.classList.contains("dark");
        const theme = dark ? "dark" : "light";
        const updateTheme = () => {
          root.classList.toggle("dark", dark);
          try {
            localStorage.setItem("theme", theme);
          } catch {}
          updateButton();
        };

        if (
          !document.startViewTransition ||
          matchMedia("(prefers-reduced-motion: reduce)").matches ||
          root.hasAttribute("data-astro-transition")
        ) {
          updateTheme();
          return;
        }

        root.dataset.themeTransition = theme;
        themeTransition = document.startViewTransition(updateTheme);
        // Navigation or a viewport resize can skip the animation.
        void themeTransition.ready.catch(() => {});
        const clearThemeTransition = () => {
          delete root.dataset.themeTransition;
          themeTransition = undefined;
        };
        void themeTransition.finished.then(clearThemeTransition, clearThemeTransition);
      };
      document.addEventListener("astro:page-load", () => {
        updateButton();
        document
          .querySelector("#theme-toggle")
          ?.addEventListener("click", toggleTheme);
      });
      matchMedia("(prefers-color-scheme: dark)").addEventListener(
        "change",
        (event) => {
          let stored;
          try {
            stored = localStorage.getItem("theme");
          } catch {}
          if (!stored) {
            document.documentElement.classList.toggle("dark", event.matches);
            updateButton();
          }
        },
      );
    </script>
  </body>
</html>
