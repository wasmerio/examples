---
// The newsletter signup. Shown on the home page and under every post.
// The form address lives in src/forms.ts.
import { NEWSLETTER_FORM } from '../forms';

interface Props {
  /** Makes the input id unique if the form appears twice on a page. */
  id?: string;
}

const { id = 'newsletter' } = Astro.props;
---

<aside class="newsletter" aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="newsletter-copy">
      <p class="meta">By email</p>
      <h2 id={`${id}-title`}>Get the next note when it is ready.</h2>
      <p>One short email whenever a new post goes up, a couple of times a month. No tracking, and you can leave whenever you like.</p>
    </div>

    <form
      class="form"
      action={NEWSLETTER_FORM}
      method="POST"
      data-contact
      data-success="You are on the list. Thanks for reading!"
    >
      <div class="field">
        <label for={`${id}-email`}>Email address</label>
        <div class="field-row">
          <input
            id={`${id}-email`}
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
          />
          <button class="button" type="submit">Subscribe</button>
        </div>
      </div>
      <input class="gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
      <p data-status role="status" hidden></p>
    </form>
  </div>
</aside>
