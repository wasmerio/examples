---
// The decorative "printer's proof" beside the lead post: crop marks,
// a registration target and the issue number. Pure SVG, no image files.
interface Props {
  number: string;
}

const { number } = Astro.props;
---

<div class="plate" aria-hidden="true">
  <svg viewBox="0 0 320 380" role="presentation">
    <g fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M24 0v16M0 24h16M296 0v16M320 24h-16M24 380v-16M0 356h16M296 380v-16M320 356h-16"></path>
      <rect x="24" y="24" width="272" height="332"></rect>
      <path d="M48 262h224M48 282h224M48 302h224M48 322h150" stroke-width="5" opacity="0.28"></path>
      <circle cx="252" cy="68" r="15"></circle>
      <path d="M229 68h46M252 45v46"></path>
    </g>
    <rect x="48" y="48" width="64" height="8" fill="var(--accent)"></rect>
    <text x="42" y="226" font-size="176" letter-spacing="-10" fill="var(--accent)">{number}</text>
  </svg>
</div>
