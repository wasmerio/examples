---
// A numbered list of posts. Used on the home page and on tag pages.
import { link } from '../lib/url';
import { formatDate, pad, postPath, readingTime, type Post } from '../lib/posts';

interface Props {
  posts: Array<Post & { number: number }>;
  /** Heading level for post titles, so each page keeps a tidy outline. */
  level?: 2 | 3;
}

const { posts, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<ol class="entries" reversed>
  {
    posts.map((post) => (
      <li class="entry">
        <span class="entry-number" aria-hidden="true">
          {pad(post.number)}
        </span>
        <article>
          <Heading>
            <a href={link(postPath(post))}>{post.data.title}</a>
          </Heading>
          <p>{post.data.description}</p>
          <p class="meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <span class="dot" aria-hidden="true">/</span>
            {readingTime(post.body)}
          </p>
        </article>
      </li>
    ))
  }
</ol>
