---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { link } from '../lib/url';
---

<Base title="Page not found" description="That page is not here.">
  <div class="wrap">
    <header class="page-head">
      <p class="meta">Error 404</p>
      <h1>This page was never set.</h1>
      <p class="standfirst">The address may be mistyped, or the page may have moved.</p>
    </header>
    <div class="page-body">
      <p>
        <a class="more" href={link('/')}>
          Back to the latest notes
          <Arrow />
        </a>
      </p>
    </div>
  </div>
</Base>
