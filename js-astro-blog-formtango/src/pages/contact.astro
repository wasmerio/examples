---
// The contact page. The form address lives in src/forms.ts.
import Base from '../layouts/Base.astro';
import { CONTACT_FORM } from '../forms';
import { link } from '../lib/url';
---

<Base title="Contact" description="Send Odette a note: questions, corrections and new projects are all welcome.">
  <div class="wrap">
    <header class="page-head">
      <p class="meta">Contact</p>
      <h1>Write to me.</h1>
      <p class="standfirst">Questions, corrections and new projects are all welcome.</p>
    </header>

    <div class="page-body split">
      <div class="prose">
        <p>
          The form goes straight to my inbox. I read everything and reply to most of it within a couple of days, a
          little slower around deadlines.
        </p>
        <p>
          If you are writing about a project, a sentence or two on what the site is for is more useful than a budget.
          We can get to the rest later.
        </p>
        <p>
          Prefer to follow quietly? There is an <a href={link('/rss.xml')}>RSS feed</a>, and the{' '}
          <a href={link('/')}>home page</a> has a newsletter signup.
        </p>
      </div>

      <form
        class="form"
        action={CONTACT_FORM}
        method="POST"
        data-contact
        data-success="Thanks! Your message is on its way. I will reply soon."
      >
        <div class="field">
          <label for="contact-name">Your name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="contact-email">Email address</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="7" required></textarea>
        </div>
        <input class="gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
        <div>
          <button class="button" type="submit">Send message</button>
        </div>
        <p data-status role="status" hidden></p>
      </form>
    </div>
  </div>
</Base>
