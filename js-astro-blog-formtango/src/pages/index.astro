---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Newsletter from '../components/Newsletter.astro';
import Plate from '../components/Plate.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../site';
import { link } from '../lib/url';
import { formatDate, getPosts, getTags, pad, postPath, readingTime } from '../lib/posts';

const posts = await getPosts();
const tags = await getTags();
const [lead, ...rest] = posts;
---

<Base>
  <div class="wrap">
    <header class="masthead">
      <p class="meta">A notebook by {SITE.author}</p>
      <h1>Notes on making websites <em>by hand.</em></h1>
      <div class="masthead-rule meta">
        <span>Typography, forms and plain HTML</span>
        <span>{posts.length} notes so far</span>
      </div>
    </header>

    {
      lead && (
        <article class="lead" aria-labelledby="lead-title">
          <div>
            <p class="meta">
              Latest
              <span class="dot" aria-hidden="true">/</span>
              <time datetime={lead.data.date.toISOString()}>{formatDate(lead.data.date)}</time>
              <span class="dot" aria-hidden="true">/</span>
              {readingTime(lead.body)}
            </p>
            <h2 id="lead-title">
              <a href={link(postPath(lead))}>{lead.data.title}</a>
            </h2>
            <p class="lead-text dropcap">{lead.data.description}</p>
            <a class="more" href={link(postPath(lead))}>
              Read the note<span class="visually-hidden">: {lead.data.title}</span>
              <Arrow />
            </a>
          </div>
          <Plate number={pad(lead.number)} />
        </article>
      )
    }

    <div class="columns">
      <section aria-labelledby="earlier-title">
        <h2 class="section-label" id="earlier-title">Earlier notes</h2>
        <PostList posts={rest} level={3} />
      </section>

      <aside class="margin-notes" aria-label="About this site">
        <div class="note">
          <h2>Who writes this</h2>
          <p>{SITE.authorBio}</p>
          <p><a href={link('/about/')}>More about Odette</a></p>
        </div>
        <div class="note">
          <h2>Filed under</h2>
          <ul class="tag-list">
            {
              tags.map((tag) => (
                <li>
                  <a class="tag" href={link(`/tags/${tag.slug}/`)}>
                    {tag.name} <small>{tag.posts.length}</small>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="note">
          <h2>Follow along</h2>
          <p>
            Subscribe by email below, or point your reader at the <a href={link('/rss.xml')}>RSS feed</a>.
          </p>
        </div>
      </aside>
    </div>
  </div>

  <Newsletter slot="after-main" />
</Base>
