---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { SITE } from '../../site';
import { link } from '../../lib/url';
import { formatDate, getPosts, pad, postPath, readingTime, tagPath } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} type="article">
  <article class="wrap">
    <header class="post-head">
      <p class="meta">
        Note {pad(post.number)}
        <span class="dot" aria-hidden="true">/</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </p>
      <h1>{post.data.title}</h1>
      <p class="standfirst">{post.data.description}</p>
    </header>

    <div class="post-body">
      <aside class="post-margin" aria-label="About this note">
        <dl>
          <div>
            <dt class="meta">Written by</dt>
            <dd><a href={link('/about/')}>{SITE.author}</a></dd>
          </div>
          <div>
            <dt class="meta">Published</dt>
            <dd>{formatDate(post.data.date)}</dd>
          </div>
          <div>
            <dt class="meta">Length</dt>
            <dd>{readingTime(post.body)}</dd>
          </div>
          {
            post.data.tags.length > 0 && (
              <div>
                <dt class="meta">Filed under</dt>
                <dd>
                  <ul class="tag-list">
                    {post.data.tags.map((tag) => (
                      <li>
                        <a class="tag" href={link(tagPath(tag))}>
                          {tag}
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="post-nav" aria-label="More notes">
      {
        older && (
          <p class="prev">
            <span class="meta">Earlier</span>
            <a href={link(postPath(older))}>{older.data.title}</a>
          </p>
        )
      }
      {
        newer && (
          <p class="next">
            <span class="meta">Later</span>
            <a href={link(postPath(newer))}>{newer.data.title}</a>
          </p>
        )
      }
    </nav>
  </article>

  <Newsletter slot="after-main" />
</Base>
