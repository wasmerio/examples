---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import PostList from '../../components/PostList.astro';
import { link } from '../../lib/url';
import { getTags } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props;
const count = tag.posts.length;
---

<Base title={`Notes on ${tag.name}`} description={`Every note filed under ${tag.name}.`}>
  <div class="wrap">
    <header class="page-head">
      <p class="meta">Filed under</p>
      <h1>{tag.name}</h1>
      <p class="standfirst">{count} {count === 1 ? 'note' : 'notes'} on this topic.</p>
    </header>

    <div class="page-body">
      <PostList posts={tag.posts} level={2} />
      <p>
        <a class="more" href={link('/tags/')}>
          <Arrow flip />
          All topics
        </a>
      </p>
    </div>
  </div>
</Base>
