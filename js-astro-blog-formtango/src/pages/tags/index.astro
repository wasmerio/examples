---
import Base from '../../layouts/Base.astro';
import { link } from '../../lib/url';
import { getTags } from '../../lib/posts';

const tags = await getTags();
---

<Base title="Tags" description="Every topic covered in the notebook, with the notes filed under each.">
  <div class="wrap">
    <header class="page-head">
      <p class="meta">Index</p>
      <h1>Filed under</h1>
      <p class="standfirst">{tags.length} topics so far. Pick one to see its notes.</p>
    </header>

    <div class="page-body">
      <ul class="tag-index">
        {
          tags.map((tag) => (
            <li>
              <a href={link(`/tags/${tag.slug}/`)}>
                {tag.name}
                <span class="meta">
                  {tag.posts.length} {tag.posts.length === 1 ? 'note' : 'notes'}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>
