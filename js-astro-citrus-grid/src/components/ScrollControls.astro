---
import '@/styles/ScrollControls.css'
import Icon from '@/components/Icon.astro'
import { defaultLang, type Lang, useTranslations } from '@/i18n/ui'
import {
  mdiArrowUp,
  mdiBookOpen,
  mdiMagnify,
  mdiMenu,
  mdiTableOfContents,
  mdiWeatherNight,
} from '@/lib/icons'

interface Props {
  lang?: Lang
  showTocButton?: boolean
  /** 仅文章阅读页显示「纯净阅读」入口（BaseLayout 按 seoType === 'article' 传入） */
  showReadingToggle?: boolean
}

const { lang = defaultLang, showTocButton = false, showReadingToggle = false } = Astro.props
const t = useTranslations(lang)
---

<nav class="scroll-control-nav fixed right-5 bottom-8 z-[90] max-md:right-3 max-md:bottom-16">
  <div class="scroll-control-pop">
    <button
      type="button"
      id="toc-fab"
      class="scroll-control-btn toc-btn"
      title={t('post.toc')}
      hidden={!showTocButton}
    >
      <Icon d={mdiTableOfContents} />
    </button>
    <button type="button" data-theme-toggle class="scroll-control-btn" title={t('header.switchToDark')}>
      <Icon d={mdiWeatherNight} />
    </button>
    <button
      type="button"
      data-reading-toggle
      class="scroll-control-btn"
      title={t('reading.enter')}
      aria-pressed="false"
      hidden={!showReadingToggle}
      data-title-enter={t('reading.enter')}
      data-title-exit={t('reading.exit')}
    >
      <Icon d={mdiBookOpen} />
    </button>
    <button type="button" data-open-search class="scroll-control-btn" title={t('search.open')}>
      <Icon d={mdiMagnify} />
    </button>
    <button type="button" data-backtop class="scroll-control-btn" title={t('misc.backToTop')}>
      <Icon d={mdiArrowUp} />
    </button>
  </div>
  <button
    type="button"
    data-scroll-menu
    class="scroll-control-btn scroll-control-trigger"
    title={t('misc.menu')}
    aria-expanded="false"
    data-title-menu={t('misc.menu')}
    data-title-exit={t('reading.exit')}
  >
    <Icon d={mdiMenu} class="icon-menu" />
    <Icon d={mdiBookOpen} class="icon-reading" />
  </button>
</nav>

