{
  "name": "astro-constructivist",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "nano-staged": {
    "*": "eslint --fix --no-warn-ignored"
  },
  "description": "Constructa: a constructivist Astro portfolio theme with section-driven motion and single-file configuration.",
  "author": "MiraHikari",
  "license": "MIT",
  "homepage": "https://mirahikari.github.io/astro-constructivist/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiraHikari/astro-constructivist.git"
  },
  "bugs": {
    "url": "https://github.com/MiraHikari/astro-constructivist/issues"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "astro-template",
    "portfolio",
    "constructivist",
    "typescript",
    "gsap",
    "static-site"
  ],
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run check-config && astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint --cache",
    "typecheck": "astro check",
    "knip": "knip",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "ci": "pnpm run schema:check && pnpm run check-config && pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test",
    "prepare": "node scripts/prepare.mjs",
    "deploy:cloudflare": "pnpm run build && wrangler pages deploy ./dist",
    "schema": "tsx scripts/generate-schema.mjs",
    "schema:check": "tsx scripts/generate-schema.mjs --check",
    "check-config": "tsx scripts/check-config.mjs",
    "hooks:install": "node scripts/prepare.mjs --install-hooks"
  },
  "dependencies": {
    "@astrojs/check": "catalog:prod",
    "@astrojs/sitemap": "catalog:prod",
    "@fontsource-variable/jetbrains-mono": "catalog:prod",
    "@fontsource-variable/space-grotesk": "catalog:prod",
    "@fontsource/anton": "catalog:prod",
    "@fontsource/instrument-serif": "catalog:prod",
    "@iconify-json/mdi": "catalog:prod",
    "@iconify-json/ri": "catalog:prod",
    "@iconify-json/simple-icons": "catalog:prod",
    "@tailwindcss/vite": "catalog:prod",
    "astro": "catalog:prod",
    "gsap": "catalog:prod",
    "lenis": "catalog:prod",
    "sharp": "catalog:prod",
    "tailwindcss": "catalog:prod",
    "typescript": "catalog:prod",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@axe-core/playwright": "catalog:dev",
    "@playwright/test": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-astro": "catalog:dev",
    "eslint-plugin-slop": "catalog:dev",
    "eslint-plugin-sonarjs": "catalog:dev",
    "knip": "catalog:dev",
    "nano-staged": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "tsx": "catalog:dev",
    "vitest": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged && pnpm run ci"
  }
}
