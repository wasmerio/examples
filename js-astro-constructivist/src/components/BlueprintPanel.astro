---
import { text } from '@/data/site'

const columns = Array.from({ length: 12 }, (_, index) => String(index + 1).padStart(2, '0'))
---
<div class="blueprint-overlay print-hide" aria-hidden="true">
  <div class="blueprint-overlay__baseline"></div>
  <div class="blueprint-overlay__shell" data-label={text('blueprint.shell')}>
    <div class="blueprint-overlay__cols">
      {columns.map(column => <span class="blueprint-overlay__col" data-col={column} />)}
    </div>
  </div>
  <span class="blueprint-overlay__axis blueprint-overlay__axis--x"></span>
  <span class="blueprint-overlay__axis blueprint-overlay__axis--y"></span>
</div>

<button
  class="blueprint-tab print-hide"
  type="button"
  data-blueprint-toggle
  aria-pressed="false"
  aria-controls="blueprintPanel"
  aria-keyshortcuts="G"
  aria-describedby="blueprintTabHint"
>
  <span class="blueprint-tab__mark" aria-hidden="true"></span>
  <span class="blueprint-tab__label">{text('blueprint.title')}</span>
  <kbd class="blueprint-tab__key">G</kbd>
</button>
<span id="blueprintTabHint" class="sr-only">{text('blueprint.hint')}</span>

<aside
  id="blueprintPanel"
  class="blueprint-panel print-hide"
  data-blueprint-panel
  aria-labelledby="blueprint-panel-title"
  hidden
>
  <header class="blueprint-panel__head">
    <p class="blueprint-panel__eyebrow">{text('blueprint.heading')}</p>
    <h2 id="blueprint-panel-title" class="blueprint-panel__title">{text('blueprint.title')}</h2>
    <button
      class="blueprint-panel__close"
      type="button"
      data-blueprint-close
      aria-keyshortcuts="Escape"
      aria-label={text('blueprint.closeLabel')}
    >
      <span aria-hidden="true">✕</span>
    </button>
  </header>

  <dl class="blueprint-panel__grid">
    <div class="blueprint-panel__row">
      <dt>{text('blueprint.viewport')}</dt>
      <dd data-bp-viewport>—</dd>
    </div>
    <div class="blueprint-panel__row">
      <dt>{text('blueprint.scroll')}</dt>
      <dd data-bp-scroll>—</dd>
    </div>
    <div class="blueprint-panel__row">
      <dt>{text('blueprint.section')}</dt>
      <dd data-bp-section>—</dd>
    </div>
    <div class="blueprint-panel__row">
      <dt>{text('blueprint.grid')}</dt>
      <dd data-bp-grid>—</dd>
    </div>
    <div class="blueprint-panel__row">
      <dt>{text('blueprint.palette')}</dt>
      <dd>
        <span class="blueprint-panel__swatch" aria-hidden="true"></span>
        <span data-bp-palette>—</span>
      </dd>
    </div>
    <div class="blueprint-panel__row">
      <dt>{text('blueprint.mode')}</dt>
      <dd data-bp-mode>—</dd>
    </div>
    <div class="blueprint-panel__row">
      <dt>{text('blueprint.type')}</dt>
      <dd data-bp-type>—</dd>
    </div>
    <div class="blueprint-panel__row">
      <dt>{text('blueprint.breakpoint')}</dt>
      <dd data-bp-breakpoint>—</dd>
    </div>
  </dl>

  <footer class="blueprint-panel__foot">
    <span><kbd>G</kbd> {text('common.toggle')}</span>
    <span><kbd>Esc</kbd> {text('common.exit')}</span>
  </footer>

  <span class="blueprint-panel__probe" data-bp-probe aria-hidden="true"></span>
</aside>

<script>
  import { initBlueprint } from '@/scripts/blueprint'

  initBlueprint()
</script>

<style is:global>
  @import "../styles/components/blueprint-panel.css";
</style>
