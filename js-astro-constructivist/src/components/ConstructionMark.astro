---
interface Props {
  mode?: 'solid' | 'outline'
  class?: string
  label?: string
}

const { mode = 'solid', class: className, label } = Astro.props
---
<svg class:list={['construction-mark', `construction-mark--${mode}`, className]} viewBox="0 0 240 240" fill="none" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false">
  <circle class="construction-mark__orbit" cx="120" cy="120" r="102" />
  <path class="construction-mark__body" d="M180 48H99L38 192H119L137 150H95L120 90H162L180 48Z" />
  <path class="construction-mark__beam" d="M76 201 162 39H191L105 201H76Z" />
  <rect class="construction-mark__point" x="180" y="150" width="27" height="27" transform="rotate(15 193.5 163.5)" />
  <path class="construction-mark__axes" d="M120 8V25M120 215V232M8 120H25M215 120H232" />
</svg>

<style>
  .construction-mark { display: block; width: 100%; height: auto; color: inherit; overflow: visible; }
  .construction-mark__orbit, .construction-mark__axes { stroke: currentColor; stroke-width: 1; opacity: 0.45; }
  .construction-mark__body { fill: currentColor; }
  .construction-mark__beam { fill: var(--accent, currentColor); }
  .construction-mark__point { fill: currentColor; transform-origin: 193.5px 163.5px; }
  .construction-mark--outline .construction-mark__body { fill: none; stroke: currentColor; stroke-width: 1; }
  .construction-mark--outline .construction-mark__beam { fill: currentColor; opacity: 0.2; }
</style>
