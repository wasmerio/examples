---
import Icon from '@/components/ui/Icon.astro'
import { cv } from '@/data/cv'
import { allSections, sectionLinks, site, text } from '@/data/site'

const { name, email, url, beian, profiles, location } = cv.basics
const year = new Date().getFullYear()
const locationText = [location?.address, location?.region].filter(Boolean).join(', ')
---
<footer class="footer">
  <div class="shell">
    <div class="footer__grid">
      <div class="footer__block">
        <h2 class="meta">{text('footer.contact')}</h2>
        {email && (
          <a class="footer__email" href={`mailto:${email}`}>{email}</a>
        )}
        <p class="footer__muted">{locationText}</p>
      </div>

      <div class="footer__block">
        <h2 class="meta">{text('footer.elsewhere')}</h2>
        <ul class="footer__links">
          {profiles.map(profile => (
            <li>
              <a href={profile.url} target="_blank" rel="noopener noreferrer">
                <Icon name={profile.icon} width={13} height={13} aria-hidden="true" />
                <span>{profile.network}</span>
                <span class="footer__handle">@{profile.username}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__block">
        <h2 class="meta">{text('footer.colophon')}</h2>
        <p class="footer__muted">
          {text('footer.type')}<br />
          {text('footer.build')}<br />
          {text('footer.grid')}
        </p>
        <p class="footer__muted footer__tagline">{text('site.tagline')}</p>
      </div>

      <div class="footer__block">
        <h2 class="meta">{text('footer.index')}</h2>
        <ul class="footer__links footer__links--index">
          {sectionLinks.map(link => (
            <li>
              <a href={`#${link.id}`}>
                <span class="footer__index" aria-hidden="true">{link.index}</span>
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <svg class="footer__watermark" viewBox="0 0 1200 190" aria-hidden="true" focusable="false" role="presentation">
      <text x="0" y="160" textLength="1200" lengthAdjust="spacingAndGlyphs">{name.toUpperCase()}</text>
    </svg>

    <div class="footer__legal">
      <p class="mono">© {site.footer.copyrightStart}{site.footer.copyrightStart !== year
? `–${year}`
: ''} {name} / {text('footer.rights')}</p>
      <div class="footer__legal-links">
        {beian?.mint && (
          <a class="mono" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
            {beian.mint}
          </a>
        )}
        {beian?.police && (
          <a class="mono" href="http://www.beian.gov.cn/portal/registerSystemInfo" target="_blank" rel="noopener noreferrer">
            {beian.police}
          </a>
        )}
        {url && (
          <a class="mono" href={url} target="_blank" rel="noopener noreferrer">
            {url.replace(/^https?:\/\//, '')}
          </a>
        )}
      </div>
    </div>
    {site.footer.showAttribution && <div class="footer__theme"><a href="https://github.com/MiraHikari/astro-constructivist" target="_blank" rel="noopener noreferrer">{text('site.themeCredit')} ↗</a><span>{text('site.attribution')}</span><a href={`#${allSections[0]?.id ?? 'main'}`}>{text('site.backToTop')} ↑</a></div>}
  </div>
</footer>

<style>
  @import "../styles/components/footer.css";
</style>
