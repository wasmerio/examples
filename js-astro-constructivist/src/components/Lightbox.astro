---
import { text } from '@/data/site'
---
<dialog id="lightbox" class="lightbox print-hide" aria-label={text('lightbox.label')}>
  <div class="lightbox__bar">
    <span class="lightbox__series" data-lightbox-series>{text('common.archive')}</span>
    <span class="lightbox__counter" aria-live="polite">
      <span data-lightbox-current>01</span>
      <span aria-hidden="true"> / </span>
      <span data-lightbox-total>01</span>
    </span>
    <button class="lightbox__button lightbox__close" type="button" data-lightbox-close aria-label={text('lightbox.closeLabel')}>
      {text('common.close')} <span aria-hidden="true">✕</span>
    </button>
  </div>

  <figure class="lightbox__figure">
    <img class="lightbox__image" alt="" />
    <figcaption class="lightbox__caption" data-lightbox-caption></figcaption>
  </figure>

  <div class="lightbox__footer">
    <span class="lightbox__hint">{text('lightbox.hint')}</span>
    <div class="lightbox__nav">
      <button class="lightbox__button" type="button" data-lightbox-prev aria-label={text('lightbox.previousLabel')}>
        ← {text('lightbox.previous')}
      </button>
      <button class="lightbox__button" type="button" data-lightbox-next aria-label={text('lightbox.nextLabel')}>
        {text('common.next')} →
      </button>
    </div>
  </div>
</dialog>

<script>
  import { initLightbox } from '@/scripts/lightbox'

  initLightbox()
</script>

<style>
  @import "../styles/components/lightbox.css";
</style>
