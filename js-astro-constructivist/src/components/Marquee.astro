---
interface Props {
  items: string[]
  reverse?: boolean
  tone?: 'accent' | 'ink'
  speed?: number
  className?: string
}

const {
  items,
  reverse = false,
  tone = 'accent',
  speed = 28,
  className,
} = Astro.props

const groups = [0, 1]
---
<div
  class:list={[
    'marquee',
    'print-hide',
    tone === 'ink' && 'marquee--ink',
    reverse && 'marquee--reverse',
    className,
  ]}
  style={`--marquee-duration: ${speed}s`}
  aria-hidden="true"
>
  <div class="marquee__track">
    {
      groups.map(() => (
        <div class="marquee__group">
          {items.map(item => (
            <>
              <span>{item}</span>
              <span class="marquee__mark">✳</span>
            </>
          ))}
        </div>
      ))
    }
  </div>
</div>
