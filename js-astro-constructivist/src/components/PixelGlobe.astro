---
import { cv } from '@/data/cv'
import { text } from '@/data/site'
import { globePoints } from '@/utils/globe'

const globe = cv.hero.globe
const rotation = -globe.longitude * Math.PI / 180
const points = globePoints.map(point => ({
  ...point,
  x: point.x * Math.cos(rotation) + point.z * Math.sin(rotation),
  z: point.z * Math.cos(rotation) - point.x * Math.sin(rotation),
})).filter(point => point.z > 0)
---
<div class="pixel-globe" role="group" aria-label={text('hero.globe')} data-pixel-globe data-auto-rotate={String(globe.autoRotate)} data-speed={globe.speed} data-dot-size={globe.dotSize} data-longitude={globe.longitude} data-latitude={globe.latitude}>
  <div class="pixel-globe__surface">
    <svg class="pixel-globe__fallback" viewBox="0 0 320 320" aria-hidden="true">
      <circle cx="160" cy="160" r="141" fill="none" stroke="currentColor" stroke-opacity="0.24" />
      {points.map(point => <rect x={160 + point.x * 138} y={160 + point.y * 138} width={globe.dotSize} height={globe.dotSize} fill="currentColor" opacity={point.land ? 0.9 : 0.16} />)}
    </svg>
    <canvas class="pixel-globe__canvas" width="320" height="320" aria-hidden="true" data-globe-canvas></canvas>
    <span class="pixel-globe__axis pixel-globe__axis--x" aria-hidden="true"></span>
    <span class="pixel-globe__axis pixel-globe__axis--y" aria-hidden="true"></span>
  </div>
  <div class="pixel-globe__caption">
    <span>{globe.label}</span>
    <button type="button" class="pixel-globe__pause" data-globe-toggle aria-label={text('hero.pause')} aria-pressed="false"><span data-globe-symbol aria-hidden="true">Ⅱ</span></button>
  </div>
  <span class="pixel-globe__hint">{text('hero.globeHint')}</span>
</div>

<script>
  import { initPixelGlobe } from '@/scripts/pixel-globe'

  initPixelGlobe()
</script>

<style>
  .pixel-globe { position: relative; width: 100%; color: var(--fg); }
  .pixel-globe__surface { position: relative; width: 100%; aspect-ratio: 1; touch-action: pan-y; }
  .pixel-globe__canvas, .pixel-globe__fallback { display: block; width: 100%; height: 100%; }
  .pixel-globe__canvas { position: absolute; inset: 0; opacity: 0; image-rendering: pixelated; }
  [data-globe-ready] .pixel-globe__canvas { opacity: 1; }
  [data-globe-ready] .pixel-globe__fallback { visibility: hidden; }
  [data-globe-ready] .pixel-globe__surface { cursor: grab; }
  [data-globe-ready] .pixel-globe__surface:active { cursor: grabbing; }
  .pixel-globe__axis { position: absolute; background: currentColor; opacity: 0.15; pointer-events: none; }
  .pixel-globe__axis--x { top: 50%; left: 0; width: 100%; height: 1px; }
  .pixel-globe__axis--y { left: 50%; top: 0; width: 1px; height: 100%; }
  .pixel-globe__caption { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; font-family: var(--font-mono); font-size: 0.56rem; line-height: 1.5; }
  .pixel-globe__pause { display: none; border: 1px solid var(--fg); background: transparent; min-width: 2.75rem; min-height: 2.75rem; }
  [data-globe-ready] .pixel-globe__pause { display: block; }
  .pixel-globe__pause:hover { background: var(--fg); color: var(--bg); }
  .pixel-globe__hint { display: block; margin-top: 0.25rem; font-family: var(--font-mono); font-size: 0.6rem; color: var(--fg); }
  :global(html:not(.js)) .pixel-globe__hint { display: none; }
  @media (prefers-reduced-motion: reduce) { .pixel-globe__pause, .pixel-globe__hint { display: none !important; } }
</style>
