---
import Icon from '@/components/ui/Icon.astro'
import { cv } from '@/data/cv'
import { section, text } from '@/data/site'

const { name, label, summary, email, url, location } = cv.basics

const posterJson = JSON.stringify({
  name,
  nameLines: cv.hero.nameLines,
  label,
  summary: summary ?? '',
  email: email ?? '',
  url: url?.replace(/^https?:\/\//, '').replace(/\/$/, '') ?? '',
  location: [location?.city, location?.countryCode].filter(Boolean).join(' · '),
  facts: cv.hero.metrics,
  projects: section('projects').enabled
? cv.projects.map(project => project.name)
: [],
  year: new Date().getFullYear(),
}).replace(/</g, '\\u003c')
---

<dialog
  id="posterStudio"
  class="poster-studio print-hide"
  aria-labelledby="posterStudioTitle"
  aria-describedby="posterStudioHelp"
  data-poster-data={posterJson}
>
  <div class="poster-studio__frame">
    <header class="poster-studio__bar">
      <div class="poster-studio__heading">
        <p class="mono poster-studio__eyebrow">{text('poster.eyebrow')}</p>
        <h2 id="posterStudioTitle" class="poster-studio__title">{text('poster.title')}</h2>
      </div>
      <p class="mono poster-studio__meta">{text('poster.meta')}</p>
      <button class="poster-studio__close" type="button" data-poster-close aria-label={text('poster.closeLabel')}>
        <Icon name="mdi:close" width={15} height={15} aria-hidden="true" />
        <span>{text('common.close')}</span>
      </button>
    </header>

    <div class="poster-studio__body">
      <figure class="poster-studio__figure">
        <div class="poster-studio__canvas" data-poster-canvas>
          <p class="mono poster-studio__pending">{text('poster.pending')}</p>
        </div>
        <figcaption id="posterStudioHelp" class="mono poster-studio__hint">
          <span>{text('poster.seedHint')}</span>
          <span>{text('poster.formatHint')}</span>
        </figcaption>
      </figure>
    </div>

    <div class="poster-studio__controls">
      <button class="btn btn--solid poster-studio__action" type="button" data-poster-reprint>
        <Icon name="mdi:refresh" width={16} height={16} aria-hidden="true" />
        <span>{text('poster.reprint')}</span>
      </button>
      <button class="btn poster-studio__action" type="button" data-poster-svg>
        <Icon name="mdi:vector-square" width={15} height={15} aria-hidden="true" />
        <span>{text('poster.downloadSvg')}</span>
      </button>
      <button class="btn poster-studio__action" type="button" data-poster-png>
        <Icon name="mdi:image-outline" width={16} height={16} aria-hidden="true" />
        <span>{text('poster.downloadPng')}</span>
      </button>
    </div>

    <p class="sr-only" role="status" data-poster-status></p>
  </div>
</dialog>

<script>
  import { initPosterStudio } from '@/scripts/poster-studio'

  initPosterStudio()
</script>

<style>
  @import "../styles/components/poster-studio.css";
</style>
