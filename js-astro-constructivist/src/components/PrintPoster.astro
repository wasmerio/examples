---
import { cv } from '@/data/cv'
import { asset, section, text } from '@/data/site'

const { name, label, summary, email, phone, url, profiles, location, image } = cv.basics
const locationText = [location?.address, location?.region, location?.countryCode].filter(Boolean).join(', ')
const nameParts = cv.hero.nameLines.length
? cv.hero.nameLines
: name.replace(/([a-z])([A-Z])/g, '$1 $2').split(/\s+/).filter(Boolean)
const nameSize = Math.min(101, 610 / Math.max(...nameParts.map(part => part.length), 1))
const year = new Date().getFullYear()
const metrics = cv.hero.metrics
const metricColumns = metrics.length > 4
? 3
: Math.max(1, metrics.length)
const projects = section('projects').enabled
? cv.projects
: []
---
<section class="print-poster" aria-hidden="true">
  <div class="print-poster__inner">
    <div class="print-poster__top">
      <span>{text('print.issue')}</span>
      <span>{locationText} — {year}</span>
    </div>

    <div class="print-poster__name" style={`font-size: ${nameSize}pt`}>
      {nameParts.map((part, index) => <span class:list={[index > 0 && 'print-poster__tail']}>{part}</span>)}
    </div>

    <div class="print-poster__role">{label}</div>

    {image && (
<div class="print-poster__portrait">
      <img src={asset(image)} alt="" />
    </div>
)}

    <div class="print-poster__bottom">
      <div class="print-poster__copy">
        <p class="print-poster__summary">{summary}</p>
        <div class="print-poster__metrics" style={`grid-template-columns: repeat(${metricColumns}, minmax(0, 1fr))`}>
          {metrics.map(metric => (
            <div><b>{metric.value}</b><span>{metric.label}</span></div>
          ))}
        </div>
        {projects.length > 0 && (
<div class="print-poster__projects">
          <span class="print-poster__label">{text('projects.selected')}</span>
          {projects.map(project => <span>{project.name}</span>)}
        </div>
)}
      </div>

      <div class="print-poster__contact">
        <span class="print-poster__label">{section('contact').label}</span>
        {email && <p>{email}</p>}
        {phone && <p>{phone}</p>}
        {url && <p>{url.replace(/^https?:\/\//, '')}</p>}
        {profiles.map(profile => <p>{profile.network} / @{profile.username}</p>)}
      </div>
    </div>

    <div class="print-poster__foot">
      <span>{text('print.tagline')}</span>
      <span>{text('print.colophon')}</span>
    </div>
  </div>
</section>

<style>
  @import "../styles/components/print-poster.css";
</style>
