---
import ProjectCasePanel from '@/components/projects/ProjectCasePanel.astro'
import { cv } from '@/data/cv'
import { section, text } from '@/data/site'

const projects = cv.projects
---
<dialog
  id="projectCase"
  class="case-dialog print-hide"
  aria-labelledby={projects.length > 0
? 'case-title-1'
: undefined}
  aria-label={projects.length
? undefined
: text('index.cases')}
  data-project-case
>
  <div class="case-dialog__frame">
    <header class="case-dialog__bar">
      <p class="mono case-dialog__eyebrow">{section('projects').kicker}</p>
      <p class="mono case-dialog__hint">{text('case.hint')}</p>
      <button class="case-dialog__close" type="button" data-case-close aria-label={text('case.closeLabel')}>
        <span>{text('common.close')}</span>
        <span aria-hidden="true">✕</span>
      </button>
    </header>

    <div class="case-dialog__panels" data-case-scroll>
      {
        projects.map((project, index) => <ProjectCasePanel project={project} index={index} projects={projects} />)
      }
    </div>
  </div>
</dialog>

<script>
  import { initProjectCase } from '@/scripts/project-case'

  initProjectCase()
</script>

<style is:global>
  @import "../styles/components/project-case.css";
</style>
