---
import { section, text } from '@/data/site'

interface Props {
  id: string
  meta?: string
  className?: string
}

const {
  id,
  meta,
  className,
} = Astro.props
const config = section(id)
const { index, title, label, kicker, tone } = config
const characters = [...title]
const metaLines = (config.meta ?? meta)?.split('·').map(part => part.trim()).filter(Boolean) ?? []
const toneClass = {
  'paper': '',
  'paper-2': 'tone-paper-2',
  'ink': 'tone-ink',
  'accent': 'tone-accent',
}[tone]
---
<section
  id={id}
  class:list={['plate', toneClass, className]}
  aria-labelledby={`${id}-title`}
  data-scroll-section
  data-section-index={index}
  data-section-label={label}
>
  <span class="plate__watermark" aria-hidden="true" data-section-watermark>{index}</span>
  <header class="plate-head shell">
    <span class="plate-head__index" aria-hidden="true">{index}</span>
    <div class="plate-head__main">
      <div>
        {kicker && <p class="kicker">{kicker}</p>}
        <h2
          id={`${id}-title`}
          class="plate-head__title"
          aria-label={label}
          data-title
        >
          <span aria-hidden="true">
            {
              characters.map((character, i) => (
                <span class="char" style={`--i: ${i}`}>
                  {character === ' '
? '\u00A0'
: character}
                </span>
              ))
            }
          </span>
        </h2>
      </div>
      {
        metaLines.length > 0 && (
          <div class="plate-head__meta">
            {metaLines.map(line => <span>{line}</span>)}
          </div>
        )
      }
    </div>
  </header>
  <div class="plate-body shell">
    <slot />
  </div>
  <div class="plate__end shell" aria-hidden="true">
    <span>{index} / {label}</span>
    <span class="plate__end-rule"><span data-section-line></span></span>
    <span>{text('section.continue')}</span>
  </div>
</section>
