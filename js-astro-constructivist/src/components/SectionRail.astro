---
import { allSections, text } from '@/data/site'
---
<nav class="rail print-hide" aria-label={text('site.sectionIndex')}>
  <ol class="rail__list">
    {
      allSections.map(link => (
        <li>
          <a class="rail__link" href={`#${link.id}`} aria-label={`${link.index} ${link.label}`} data-rail-link>
            <span class="rail__num" aria-hidden="true">{link.index}</span>
            <span class="rail__label">{link.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
