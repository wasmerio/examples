---
import ConstructionMark from '@/components/ConstructionMark.astro'
import { text } from '@/data/site'

interface Props {
  target: string
  index: string
  label: string
}

const { target, index, label } = Astro.props
const forms: Record<string, string> = {
  about: 'unfold',
  experience: 'track',
  projects: 'frame',
  education: 'orbit',
  skills: 'matrix',
  gallery: 'scatter',
  contact: 'gather',
}
const form = forms[target] ?? 'unfold'
---
<div class:list={['chapter-transition', `chapter-transition--${form}`]} data-chapter-transition data-transition-target={target}>
  <div class="chapter-transition__content shell">
    <div class="chapter-transition__graphic" aria-hidden="true">
      <span class="chapter-transition__plane chapter-transition__plane--a"></span>
      <span class="chapter-transition__plane chapter-transition__plane--b"></span>
      <span class="chapter-transition__plane chapter-transition__plane--c"></span>
      <div class="chapter-transition__mark"><ConstructionMark mode="outline" /></div>
    </div>
    <span class="chapter-transition__thought">{text(`story.${target}`)}</span>
    <span class="chapter-transition__destination" aria-hidden="true"><span>{index}</span>{label}<span>↘</span></span>
  </div>
</div>

<style>
  @import "../styles/chapter-transitions.css";
</style>
