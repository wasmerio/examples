---
import ConstructionMark from '@/components/ConstructionMark.astro'
import { site, text } from '@/data/site'
import '../styles/loader.css'

const { colors, label, minimumDuration, maxWait } = site.loader
const plates = [
  ...colors.slice(1),
  colors[0]!,
]
const positions = [
  {
    x: 33,
    y: 43,
    angle: -12,
    width: 39,
    height: 39,
  },
  {
    x: 61,
    y: 38,
    angle: 9,
    width: 36,
    height: 38,
  },
  {
    x: 42,
    y: 64,
    angle: -6,
    width: 44,
    height: 29,
  },
  {
    x: 67,
    y: 61,
    angle: 13,
    width: 30,
    height: 33,
  },
  {
    x: 49,
    y: 51,
    angle: -3,
    width: 40,
    height: 36,
  },
  {
    x: 53,
    y: 57,
    angle: 7,
    width: 34,
    height: 37,
  },
]

const expanded = colors[0]!.slice(1).replace(/^([\da-f])([\da-f])([\da-f])$/i, '$1$1$2$2$3$3')
const [r, g, b] = [0, 2, 4].map(index => Number.parseInt(expanded.slice(index, index + 2), 16) / 255)
const luminance = [r!, g!, b!].map(channel => channel <= 0.04045
  ? channel / 12.92
  : ((channel + 0.055) / 1.055) ** 2.4)
const lightness = luminance[0]! * 0.2126 + luminance[1]! * 0.7152 + luminance[2]! * 0.0722
const onFinal = (lightness + 0.05) / 0.05 >= 1.05 / (lightness + 0.05)
  ? '#121110'
  : '#fffdf7'
---
<div
  class="site-loader print-hide"
  data-site-loader
  data-loader-minimum={minimumDuration}
  data-loader-max-wait={maxWait}
  style={`--loader-on-final: ${onFinal}; --loader-final: ${colors[0]}`}
>
  <div class="site-loader__grid" aria-hidden="true"></div>
  <div class="site-loader__plates" aria-hidden="true">
    {plates.map((color, index) => {
      const position = positions[index]!
      return (
        <div
          class="site-loader__plate"
          data-loader-plate
          data-loader-angle={position.angle}
          style={`--plate-color: ${color}; --plate-x: ${position.x}%; --plate-y: ${position.y}%; --plate-width: ${position.width}vw; --plate-height: ${position.height}svh; --plate-angle: ${position.angle}deg; --plate-order: ${index}`}
        ><span class="site-loader__plate-number">{String(index + 1).padStart(2, '0')}</span></div>
      )
    })}
  </div>
  <div class="site-loader__masthead">
    <span class="site-loader__brand">{label}</span>
    <span class="site-loader__register" aria-hidden="true">01 / {String(plates.length).padStart(2, '0')}</span>
  </div>
  <div class="site-loader__wordmark" aria-hidden="true"><span class="site-loader__signature"><ConstructionMark /></span><span>{label}</span></div>
  <div class="site-loader__footer">
    <p class="site-loader__status" role="status" aria-live="polite" data-loader-status>{text('loader.loading')}</p>
    <span class="site-loader__marks" aria-hidden="true">{plates.map((color, index) => <span style={`--mark-color: ${color}; --mark-index: ${index}`}></span>)}</span>
    <button class="site-loader__skip" type="button" data-loader-skip>{text('loader.enter')}<span aria-hidden="true">↗</span></button>
  </div>
</div>
