---
import ConstructionMark from '@/components/ConstructionMark.astro'
import ThemeSwitch from '@/components/ui/ThemeSwitch.astro'
import { cv } from '@/data/cv'
import { allSections, sectionLinks, site, text } from '@/data/site'

const { name } = cv.basics
const [firstName, ...rest] = name.trim().split(/\s+|(?<=[a-z])(?=[A-Z])/)
const lastName = rest.join('')
const navigation = sectionLinks.filter(link => link.nav)
---
<header class="topbar print-hide" data-dock data-dock-state="top" data-nav-layout="split">
  <div class="topbar__inner">
    <a class="topbar__brand" href={`#${allSections[0]?.id ?? 'main'}`}>
      <span class="topbar__brand-mark" aria-hidden="true"><ConstructionMark /></span>
      <span class="topbar__brand-text">
        {firstName ?? name}<span class="topbar__brand-slash" aria-hidden="true">/</span>{lastName}
      </span>
      <span class="sr-only"> — {text('site.backToTop')}</span>
    </a>

    <nav class="topbar__nav" aria-label={text('site.navigation')} data-dock-nav>
      <span class="topbar__indicator" data-dock-indicator aria-hidden="true"></span>
      {
        navigation.map(link => (
          <a href={`#${link.id}`} data-dock-link>
            <span class="topbar__nav-index" aria-hidden="true">{link.index}</span>
            <span class="topbar__word"><span class="topbar__word-front">{link.label}</span><span class="topbar__word-back" aria-hidden="true">{link.label}</span></span>
          </a>
        ))
      }
    </nav>
    {site.features.themeSwitch && <div class="topbar__tools topbar__appearance"><ThemeSwitch /></div>}

      {site.features.commandPalette && (
<button
  class="topbar__tool topbar__tool--index topbar__index-tile"
  type="button"
  aria-haspopup="dialog"
  aria-controls="indexDialog"
  aria-label={text('site.openIndex')}
  data-index-open
>
        <span class="topbar__index-glyph" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </span>
        <span class="topbar__tool-label">{text('site.index')}</span>
        <span class="topbar__tool-arrow" aria-hidden="true">↗</span>
      </button>
)}
  </div>

  <noscript><nav class="topbar__fallback shell" aria-label={text('site.sectionIndex')}>{sectionLinks.map(link => <a href={`#${link.id}`}>{link.label}</a>)}</nav></noscript>

  <div class="scroll-progress" aria-hidden="true"></div>
</header>

<script>
  import { initFloatingNav } from '@/scripts/floating-nav'

  initFloatingNav()
</script>

<style>
  @reference "../globals.css";

  .topbar__brand-text {
    display: inline-flex;
    align-items: baseline;
  }

  .topbar__fallback { display: flex; gap: 1rem; overflow-x: auto; padding-block: 0.6rem; background: var(--bg); font-size: 0.75rem; pointer-events: auto; }

  :global(html:not(.js)) [data-index-open] { display: none; }

  .topbar__brand-slash {
    color: var(--accent);
    margin-inline: 0.12em;
  }

  .topbar__index-glyph {
    display: grid;
    grid-template-columns: repeat(2, 0.32rem);
    grid-template-rows: repeat(2, 0.32rem);
    gap: 0.14rem;
  }

  .topbar__index-glyph span {
    background: currentColor;
  }

  @media (max-width: 23.99rem) {
    .topbar__brand-text {
      display: none;
    }
  }
</style>
