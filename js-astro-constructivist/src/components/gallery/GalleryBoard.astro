---
import type { GalleryEntry } from './types'
import { text } from '@/data/site'
import GalleryFrame from './GalleryFrame.astro'
import { placements } from './layout'

interface Props {
  frames: GalleryEntry[]
}

const { frames } = Astro.props
---
<div class="gallery__panel gallery__panel--board" id="gallery-board" data-gallery-mode-panel="board" role="group" aria-label={text('gallery.boardLabel')}>
  <div class="board" data-board>
    <span class="board__word" aria-hidden="true">{text('gallery.boardFirst')}<br />{text('gallery.boardLast')}</span>
    {['tl', 'tr', 'bl', 'br'].map(corner => <span class={`board__reg board__reg--${corner}`} aria-hidden="true"></span>)}
    {frames.slice(0, placements.length).map((frame, index) => <GalleryFrame frame={frame} index={index} variant="board" />)}
  </div>
  <div class="board__foot">
    <p class="mono board__hint">{text('gallery.boardHint')}</p>
    <button class="gallery__reset" type="button" data-board-reset>{text('gallery.reset')}</button>
    <p class="sr-only" role="status" data-board-status></p>
  </div>
</div>
