---
import { text } from '@/data/site'

interface Props {
  total: number
}

const { total } = Astro.props
---
<div class="gallery__controls">
  <div class="gallery__modes" role="group" aria-label={text('gallery.viewLabel')}>
    <button class="gallery__mode" type="button" data-gallery-mode="board" aria-pressed="true" aria-controls="gallery-board">{text('gallery.board')}</button>
    <button class="gallery__mode" type="button" data-gallery-mode="strip" aria-pressed="false" aria-controls="gallery-strip">{text('gallery.strip')}</button>
  </div>
  <div class="gallery__meta" data-strip-tools>
    <p class="gallery__counter mono" aria-live="polite"><span data-strip-current>01</span><span aria-hidden="true"> / </span><span data-strip-total>{String(total).padStart(2, '0')}</span></p>
    <div class="gallery__buttons">
      <button class="gallery__button" type="button" data-strip-prev aria-label={text('gallery.previous')}><span aria-hidden="true">←</span></button>
      <button class="gallery__button" type="button" data-strip-next aria-label={text('gallery.next')}><span aria-hidden="true">→</span></button>
    </div>
  </div>
</div>
