---
import type { GalleryEntry, GalleryPresentation } from './types'
import { Image } from 'astro:assets'
import { asset, text } from '@/data/site'
import { placements, ratios, rotations } from './layout'

interface Props {
  frame: GalleryEntry
  index: number
  variant: GalleryPresentation
}

const { frame, index, variant } = Astro.props
const board = variant === 'board'
const number = String(index + 1).padStart(2, '0')
const caption = frame.desc ?? frame.alt ?? ''
const ratio = ratios[index % ratios.length]!
const placement = placements[index % placements.length]!
const rotation = rotations[index % rotations.length]!
const position = board
  ? `--x: ${placement.x}; --y: ${placement.y}; --w: ${placement.w}; --x-sm: ${placement.smX}; --y-sm: ${placement.smY}; --w-sm: ${placement.smW}; --rot: ${rotation}; --print-ratio: ${ratio}`
  : undefined
---
<figure class={board ? 'print' : 'shot__figure'} data-board-print={board || undefined} style={position}>
  {board && <span class="print__tape" aria-hidden="true"></span>}
  <a
    class={board ? 'print__link' : 'shot__link'}
    href={asset(frame.image)}
    data-lightbox="gallery"
    data-caption={caption}
    data-cursor={text(board ? 'cursor.drag' : 'cursor.view')}
    draggable={board ? 'false' : undefined}
  >
    <Image
      src={asset(frame.image)}
      alt={frame.alt ?? caption}
      width={1400}
      height={1050}
      class={board ? 'print__image' : 'shot__image'}
      loading="lazy"
    />
    <span class="shot__number display" aria-hidden="true">{number}</span>
    {!board && <><span class="shot__hint mono" aria-hidden="true">{text('gallery.enlarge')} ↗</span><span class="shot__corner" aria-hidden="true"></span></>}
    <span class="sr-only"> — {text('common.viewImage')}</span>
  </a>
  <figcaption class={board ? 'print__caption' : 'shot__caption'}>
    <span
      class:list={[
        'mono',
        board ? 'print__no' : 'shot__caption-no',
      ]}
      aria-hidden="true"
    >{number}</span>
    <span class={board ? 'print__caption-text' : 'shot__caption-text'}>{caption}</span>
  </figcaption>
</figure>
