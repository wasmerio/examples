---
import type { GalleryEntry } from './types'
import { text } from '@/data/site'
import GalleryFrame from './GalleryFrame.astro'
import { ratios } from './layout'

interface Props {
  frames: GalleryEntry[]
}

const { frames } = Astro.props
---
<div class="gallery__panel gallery__panel--strip" id="gallery-strip" data-gallery-mode-panel="strip">
  <div class="gallery__scroller" tabindex="0" role="region" aria-label={text('gallery.stripLabel')} data-cursor={text('cursor.drag')}>
    <ol class="gallery__track">
      {frames.map((frame, index) => (
        <li class:list={['shot', index % 2 === 1 && 'shot--offset']} style={`--shot-ratio: ${ratios[index % ratios.length]}; --shot-i: ${index}`} data-strip-frame>
          <GalleryFrame frame={frame} index={index} variant="strip" />
        </li>
      ))}
    </ol>
  </div>
  <div class="gallery__foot">
    <div class="gallery__progress" aria-hidden="true"><span data-strip-progress></span></div>
    <p class="mono gallery__hint">{text('gallery.stripHint')}</p>
  </div>
</div>
