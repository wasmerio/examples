---
import type { ProjectPresentation, ProjectRecord } from './types'
import { Image } from 'astro:assets'
import { asset, text } from '@/data/site'

interface Props {
  image: NonNullable<ProjectRecord['image']>
  name: string
  variant: ProjectPresentation
}

const { image, name, variant } = Astro.props
const alt = variant === 'case'
? text('common.previewLabel').replace('{name}', name)
: ''
const classes = variant === 'project'
  ? ['project__image', image.dark && 'project__image--light']
  : ['case-file__image', image.position === 'container' && 'case-file__image--contain']
---
<Image
  src={asset(image.url)}
  alt={alt}
  width={1600}
  height={1000}
  class:list={classes}
  loading="lazy"
  decoding="async"
/>
{variant === 'project' && image.dark && (
  <Image
    src={asset(image.dark)}
    alt=""
    width={1600}
    height={1000}
    class="project__image project__image--dark"
    loading="lazy"
    decoding="async"
  />
)}
