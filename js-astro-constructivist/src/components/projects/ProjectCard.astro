---
import type { ProjectRecord } from './types'
import ConstructionMark from '@/components/ConstructionMark.astro'
import Icon from '@/components/ui/Icon.astro'
import { asset, text } from '@/data/site'
import { stripLeadingEmoji } from '@/utils/text'
import ProjectArtwork from './ProjectArtwork.astro'
import ProjectLinks from './ProjectLinks.astro'
import StatusStamp from './StatusStamp.astro'

interface Props {
  project: ProjectRecord
  index: number
  total: number
}

const { project, index, total } = Astro.props
const isLive = project.isActive !== false
const number = String(index + 1).padStart(2, '0')
const { image } = project
const mediaClass = image?.position === 'container'
? 'project__media--contain'
: 'project__media--cover'
const flipped = index % 2 === 1
const titleSize = Math.min(7.5, 85 / Math.max(project.name.length, 8))
---
<article
  id={`project-${index + 1}`}
  class:list={['project', flipped && 'project--flip']}
  style={`--project-title-size: ${titleSize}rem`}
  aria-labelledby={`project-title-${index + 1}`}
  data-project
  tabindex="-1"
>
  <header class="project__head">
    <span class="project__case mono">{text('common.case')} {number} / {String(total).padStart(2, '0')}</span>
    <span class="project__index" aria-hidden="true">{number}</span>
    <h3 id={`project-title-${index + 1}`} class="project__title" data-project-title>{project.name}</h3>
    <StatusStamp live={isLive} archiveClass="project__stamp-archive" />
  </header>

  <div class="project__spread">
    <div class="project__media-wrap">
      <div class="project__media-shadow" aria-hidden="true"></div>
      {image
        ? (
            <a
              class:list={[
                'project__media',
                mediaClass,
              ]}
              href={asset(image.url)}
              data-lightbox="projects"
              data-caption={project.name}
              data-cursor={text('cursor.view')}
              aria-label={text('common.imageLabel').replace('{name}', project.name)}
              data-scroll="media"
            >
              <ProjectArtwork image={image} name={project.name} variant="project" />
              <span class="project__open" aria-hidden="true"><span>{text('common.openImage')}</span><span>↗</span></span>
              <span class="project__corner project__corner--tl" aria-hidden="true"></span>
              <span class="project__corner project__corner--br" aria-hidden="true"></span>
            </a>
          )
        : <div class="project__media project__media--empty" aria-hidden="true"><span class="mono">{text('common.noPreview')}</span></div>}
      <span class="project__media-label mono" aria-hidden="true">{text('case.figure')} {number} / {project.name}</span>
    </div>

    <div class="project__body">
      <div class="project__symbol" aria-hidden="true"><ConstructionMark mode={flipped ? 'outline' : 'solid'} /></div>
      <p class="project__description">{project.description}</p>
      {project.highlights && project.highlights.length > 0 && (
        <ul class="project__highlights">
          {project.highlights.map(highlight => <li><span class="project__bullet" aria-hidden="true"></span><span>{stripLeadingEmoji(highlight)}</span></li>)}
        </ul>
      )}
      <footer class="project__footer">
        <button class="btn" type="button" data-case-open data-case-index={index} aria-haspopup="dialog" aria-controls="projectCase" aria-label={text('common.caseLabel').replace('{name}', project.name)}>
          <Icon name="mdi:file-document-outline" width={15} height={15} aria-hidden="true" />
          {text('common.caseFile')}
        </button>
        <ProjectLinks project={project} variant="project" />
      </footer>
    </div>
  </div>
</article>
