---
import type { ProjectRecord } from './types'
import Icon from '@/components/ui/Icon.astro'
import { text } from '@/data/site'
import { stripLeadingEmoji } from '@/utils/text'
import ProjectArtwork from './ProjectArtwork.astro'
import ProjectLinks from './ProjectLinks.astro'
import StatusStamp from './StatusStamp.astro'

interface Props {
  project: ProjectRecord
  index: number
  projects: ProjectRecord[]
}

const { project, index, projects } = Astro.props
const total = String(projects.length).padStart(2, '0')
const number = String(index + 1).padStart(2, '0')
const isLive = project.isActive !== false
const previous = projects[(index - 1 + projects.length) % projects.length]
const following = projects[(index + 1) % projects.length]
const { image } = project
const url = project.url
const repo = project.github
---
<article
  id={`case-file-${index + 1}`}
  class="case-file"
  data-case-panel
  data-case-index={index}
  aria-labelledby={`case-title-${index + 1}`}
  hidden
>
  <header class="case-file__head">
    <span class="mono case-file__number">
      {text('common.case')} {number} <span aria-hidden="true">/</span> {total}
    </span>
    <StatusStamp live={isLive} archiveClass="case-file__stamp-archive" />
  </header>

  <h2
    id={`case-title-${index + 1}`}
    class="case-file__title display"
    data-case-title
    tabindex="-1"
  >
    {project.name}
  </h2>

  <div class="case-file__grid">
    <div class="case-file__body">
      <p class="case-file__description">{project.description}</p>

      {project.highlights && project.highlights.length > 0 && (
        <div class="case-file__block">
          <h3 class="mono case-file__label">{text('common.highlights')}</h3>
          <ul class="case-file__highlights">
            {project.highlights.map(highlight => (
              <li>
                <span class="case-file__bullet" aria-hidden="true" />
                <span>{stripLeadingEmoji(highlight)}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {(url || repo) && (
        <div class="case-file__links">
          <ProjectLinks project={project} variant="case" />
        </div>
      )}
    </div>

    <figure class="case-file__figure">
      {image
        ? (
            <div
              class:list={[
                'case-file__media',
                image.position === 'container' && 'case-file__media--contain',
              ]}
            >
              <ProjectArtwork image={image} name={project.name} variant="case" />
            </div>
          )
        : (
            <div class="case-file__media case-file__media--empty" aria-hidden="true">
              <span class="mono">{text('common.noPreview')}</span>
            </div>
          )}
      <figcaption class="mono case-file__caption">
        <span>{text('case.figure')} {number}</span>
        <span>{project.name}</span>
      </figcaption>
    </figure>
  </div>

  <footer class="case-file__foot">
    <button
      class="case-file__nav"
      type="button"
      data-case-prev
      aria-label={text('case.previousLabel').replace('{name}', previous?.name ?? project.name)}
      disabled={projects.length < 2}
    >
      <Icon name="mdi:arrow-left" width={16} height={16} aria-hidden="true" />
      <span>{text('case.previous')}</span>
    </button>
    <span class="mono case-file__position" aria-hidden="true">{number} / {total}</span>
    <button
      class="case-file__nav"
      type="button"
      data-case-next
      aria-label={text('case.nextLabel').replace('{name}', following?.name ?? project.name)}
      disabled={projects.length < 2}
    >
      <span>{text('case.next')}</span>
      <Icon name="mdi:arrow-right" width={16} height={16} aria-hidden="true" />
    </button>
  </footer>
</article>
