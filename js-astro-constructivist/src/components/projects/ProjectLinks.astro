---
import type { ProjectPresentation, ProjectRecord } from './types'
import Icon from '@/components/ui/Icon.astro'
import { text } from '@/data/site'

interface Props {
  project: ProjectRecord
  variant: ProjectPresentation
}

const { project, variant } = Astro.props
const cursor = variant === 'project'
? text('cursor.visit')
: undefined
const sourceClass = variant === 'project'
? 'project__repo'
: 'case-file__source'
---
{project.url && (
  <a
    class="btn btn--solid"
    href={project.url}
    target="_blank"
    rel="noopener noreferrer"
    data-cursor={cursor}
  >
    {text('common.visitProject')}
    <Icon name="mdi:open-in-new" width={15} height={15} aria-hidden="true" />
  </a>
)}
{project.github && (
  <a
    class:list={[
      sourceClass,
      'arrow-link',
    ]}
    href={project.github}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={text('common.sourceLabel').replace('{name}', project.name)}
  >
    <Icon name="mdi:github" width={16} height={16} aria-hidden="true" />
    <span>{text('common.source')}</span>
    <span aria-hidden="true">↗</span>
  </a>
)}
