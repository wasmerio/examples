---
import { text } from '@/data/site'

interface Props {
  live: boolean
  archiveClass: string
}

const { live, archiveClass } = Astro.props
---
<span class:list={[
  'stamp',
  live ? 'stamp--solid' : archiveClass,
]}
>
  <span class="status-dot" aria-hidden="true"></span>
  {text(live ? 'common.live' : 'common.archived')}
</span>
