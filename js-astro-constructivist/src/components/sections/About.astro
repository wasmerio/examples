---
import Section from '@/components/Section.astro'
import { cv } from '@/data/cv'
import { text } from '@/data/site'

const { about, summary } = cv.basics
const personalInfo = about?.personalInfo ?? []
const traits = about?.traits ?? []
const highlights = [
  ...(about?.highlights ?? []),
  ...cv.awards.map(award => ({
text: [
award.title,
award.awarder,
award.date,
award.summary,
].filter(Boolean).join(' / '),
})),
]
const quote = about?.quote
const languages = cv.languages ?? []
const interests = cv.interests ?? []
const references = cv.references ?? []

const meta = [
  `${String(personalInfo.length).padStart(2, '0')} ${text('about.facts')}`,
  `${String(traits.length).padStart(2, '0')} ${text('about.traits')}`,
  `${String(highlights.length).padStart(2, '0')} ${text('common.highlights')}`,
].join(' · ')
---
<Section id="about" meta={meta}>
  <div class="about__top">
    <div class="about__intro" data-scroll>
      <p class="kicker">{text('about.intro')}</p>
      <p class="about__manifesto" data-ink-text>
        {text('about.manifestoFirst').split(/\s+/).map(word => <><span data-ink-word>{word}</span>{' '}</>)}<br />
        <em>{text('about.manifestoMiddle').split(/\s+/).map(word => <><span data-ink-word>{word}</span>{' '}</>)}</em><br />
        {text('about.manifestoLast').split(/\s+/).map(word => <><span data-ink-word>{word}</span>{' '}</>)}
      </p>
      {summary && <p class="about__summary">{summary}</p>}
      <p class="about__note mono">
        {text('about.note')}
      </p>
    </div>

    <dl class="about__facts">
      {
        personalInfo.map((item, i) => (
          <div class="about__fact" data-scroll style={`--i: ${i}`}>
            <dt>
              <span class="about__fact-index mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="about__fact-label mono">{item.label}</span>
            </dt>
            <dd class="about__fact-value display">{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  {
    quote && (
      <figure class="about__quote" data-scroll="left">
        <span class="about__quote-mark display" aria-hidden="true">“</span>
        <blockquote class="about__quote-text">{quote.text}</blockquote>
        <figcaption class="about__quote-foot">
          <span class="stamp stamp--solid">{text('about.principle')}</span>
          <ul class="about__values" aria-label={text('about.values')}>
            {quote.values.map((value, i) => (
              <li>
                <span class="mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span>{value.label}</span>
              </li>
            ))}
          </ul>
        </figcaption>
        <span class="about__quote-grid" aria-hidden="true"></span>
      </figure>
    )
  }

  <div class="about__lower">
    <section class="about__traits" aria-labelledby="about-traits-title" data-scroll>
      <header class="about__block-head">
        <h3 id="about-traits-title" class="about__block-title display">{text('about.traits')}</h3>
        <span class="mono">{String(traits.length).padStart(2, '0')} / {text('about.method')}</span>
      </header>
      <ol class="about__trait-list">
        {
          traits.map((trait, i) => (
            <li class:list={['about__trait', i % 2 === 1 && 'about__trait--offset']}>
              <span class="about__trait-index display" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="about__trait-text">{trait.text}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about__record" aria-labelledby="about-record-title" data-scroll>
      <header class="about__block-head">
        <h3 id="about-record-title" class="about__block-title display">{text('about.record')}</h3>
        <span class="mono">{text('about.signals')}</span>
      </header>
      <ol class="about__record-list">
        {
          highlights.map((highlight, i) => (
            <li>
              <span class="about__record-index mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="about__record-text">{highlight.text}</span>
              <span class="about__record-arrow" aria-hidden="true">↗</span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <div class="about__appendix" data-scroll>
    <div class="about__appendix-block">
      <h3 class="meta">{text('about.languages')}</h3>
      <ul class="about__compact-list">
        {languages.map(language => (
          <li>
            <span class="display about__compact-name">{language.language}</span>
            <span class="mono about__compact-meta">{language.fluency}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="about__appendix-block">
      <h3 class="meta">{text('about.interests')}</h3>
      <ul class="about__compact-list">
        {interests.map(interest => (
          <li>
            <span class="display about__compact-name">{interest.name}</span>
            <span class="mono about__compact-meta">{interest.keywords?.join(' / ')}</span>
          </li>
        ))}
      </ul>
    </div>

    {references.length > 0 && (
<div class="about__appendix-block about__appendix-block--note">
      <h3 class="meta">{text('about.references')}</h3>
      {references.map(reference => <blockquote class="about__reference"><p>{reference.reference}</p><footer>{reference.name}</footer></blockquote>)}
    </div>
)}
    {cv.publications.length > 0 && (
<div class="about__appendix-block">
      <h3 class="meta">{text('about.publications')}</h3>
      <ul class="about__compact-list">
        {cv.publications.map(publication => (
<li>
          {publication.url
? <a class="link-line" href={publication.url} target="_blank" rel="noopener noreferrer">{publication.name}</a>
: <span>{publication.name}</span>}
          <span class="mono about__compact-meta">{[publication.publisher, publication.releaseDate].filter(Boolean).join(' / ')}</span>
          {publication.summary && <p>{publication.summary}</p>}
        </li>
))}
      </ul>
    </div>
)}
  </div>
</Section>

<style>
  @import "../../styles/sections/about.css";
</style>
