---
import Section from '@/components/Section.astro'
import Arrow from '@/components/ui/Arrow.astro'
import Icon from '@/components/ui/Icon.astro'
import { cv } from '@/data/cv'
import { section, site, text } from '@/data/site'

const { email, phone, profiles, location, name } = cv.basics
const locationText = [
...new Set([
location?.address,
location?.city,
location?.region,
location?.postalCode,
location?.countryCode,
].filter(Boolean)),
].join(', ')
const meta = profiles.length > 0
  ? `${String(profiles.length).padStart(2, '0')} ${text('contact.profiles')} · ${text('contact.direct')}`
  : text('contact.direct')
const year = new Date().getFullYear()
---
<Section id="contact" meta={meta}>
  <div class="contact">
    <div class="contact__main">
      <div class="contact__statement-wrap" data-scroll>
        <p class="kicker">{text('contact.intro')}</p>
        <p class="contact__statement display">
          <span data-contact-line>{text('contact.statementFirst')}</span>
          <span class="contact__outline" data-contact-line>{text('contact.statementMiddle')}</span>
          <span data-contact-line>{text('contact.statementLast')}</span>
        </p>
      </div>

      {
        email && (
          <div class="contact__direct" data-scroll>
            <span class="meta contact__label">{text('common.directLine')}</span>
            <a class="contact__email" href={`mailto:${email}`} data-cursor={text('cursor.mail')}>
              {email}
            </a>
            <button
              class="contact__copy"
              type="button"
              data-copy-email={email}
              aria-label={text('contact.copyLabel').replace('{email}', email)}
            >
              <span data-copy-label>{text('common.copy')}</span>
              <Icon name="mdi:content-copy" width={14} height={14} aria-hidden="true" />
            </button>
          </div>
        )
      }

      {phone && (
<div class="contact__direct" data-scroll>
        <span class="meta contact__label">{text('common.phone')}</span>
        <a class="contact__email" href={`tel:${phone.replace(/[^+\d*#;,]/g, '')}`}>{phone}</a>
      </div>
)}

      <p class="contact__note" data-scroll>
        {text('contact.note')}
      </p>
    </div>

    <aside class="contact__aside" aria-label={text('contact.details')}>
      <div class="contact__seal" data-contact-seal aria-hidden="true">
        <svg viewBox="0 0 200 200" fill="none">
          <defs><path id="contact-seal-path" d="M100 100m-77 0a77 77 0 1 1 154 0a77 77 0 1 1-154 0" /></defs>
          <circle cx="100" cy="100" r="96" stroke="currentColor" />
          <text><textPath href="#contact-seal-path">{text('contact.seal').toUpperCase()} / {name.toUpperCase()} / </textPath></text>
          <path d="M62 139 137 64M62 64h75v75" stroke="currentColor" stroke-width="4" />
        </svg>
      </div>
      <div class="contact__panel" data-scroll="right">
        <span class="meta">{text('common.location')}</span>
        <p class="contact__place display">{locationText}</p>
        <div class="contact__clock-line">
          <span class="meta">{text('common.localTime')}</span>
          <time class="contact__clock mono" data-clock data-time-zone={site.timeZone}>--:--</time>
          <span class="meta" data-clock-zone>{site.timeZone}</span>
        </div>
      </div>

      <div class="contact__panel" data-scroll="right">
        <span class="meta">{text('contact.statusLabel')}</span>
        <p class="contact__status">
          <span class="status-dot" aria-hidden="true" />
          {text('contact.status')}
        </p>
        <p class="contact__status-note">
          {text('contact.statusNote')}
        </p>
      </div>

      <span class="contact__year display" aria-hidden="true">{year}</span>
    </aside>
  </div>

  {
    profiles.length > 0 && (
      <div class="contact__profiles" data-scroll>
        <div class="contact__profiles-head">
          <h3 class="mono">{text('contact.elsewhere')}</h3>
          <span class="mono">{String(profiles.length).padStart(2, '0')} {text('contact.channels')}</span>
        </div>
        <ul class="contact__profile-list">
          {profiles.map((profile, index) => (
            <li>
              <a href={profile.url} target="_blank" rel="noopener noreferrer" data-cursor={text('cursor.open')}>
                <span class="contact__profile-index mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="contact__profile-icon" aria-hidden="true">
                  <Icon name={profile.icon} width={20} height={20} />
                </span>
                <span class="contact__profile-name display">{profile.network}</span>
                <span class="contact__profile-handle mono">@{profile.username}</span>
                <Arrow class="contact__profile-arrow" size={24} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <footer class="contact__foot">
    <span class="mono">{text('contact.end')} / {name} — {year}</span>
    {site.features.posterStudio && (
<button class="contact__poster" type="button" data-poster-open aria-haspopup="dialog" aria-controls="posterStudio">
      {text('contact.poster')} <Arrow size={18} />
    </button>
)}
    <a
      class="arrow-link"
      href={section('top').enabled
? '#top'
: '#main'}
    >
      <span>{text('common.backToTop')}</span>
      <Arrow direction="up" size={16} />
    </a>
  </footer>
</Section>

<script>
  import { initCopyEmail } from '@/scripts/copy-email'

  initCopyEmail()
</script>

<style>
  @import "../../styles/sections/contact.css";
</style>
