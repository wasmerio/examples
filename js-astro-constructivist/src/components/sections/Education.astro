---
import Section from '@/components/Section.astro'
import { cv } from '@/data/cv'
import { text } from '@/data/site'
import { formatDateRange, getYear } from '@/utils/date'

const { education, certificates } = cv
const meta = [
  `${String(education.length).padStart(2, '0')} ${text('education.schools')}`,
  `${String(certificates.length).padStart(2, '0')} ${text('education.certificates')}`,
].join(' · ')
const firstYear = [...education]
  .map(item => getYear(item.startDate))
  .filter((year): year is string => Boolean(year))
  .sort()[0]
const lastYear = education.some(item => !item.endDate)
  ? text('common.present')
  : education.map(item => getYear(item.endDate)).filter(Boolean).sort().at(-1)
---
<Section id="education" meta={meta}>
  <div class="education">
    <div class="education__main">
      <header class="education__head" data-scroll>
        <div>
          <p class="kicker">{text('education.intro')}</p>
          <h3 class="education__statement display">{text('education.statementFirst')}<br />{text('education.statementLast')}</h3>
        </div>
        {firstYear && <span class="education__span mono">{firstYear} → {lastYear}</span>}
      </header>

      <ol class="education__list">
        {
          education.map((item, index) => {
            const isCurrent = !item.endDate
            return (
              <li class="school" data-scroll>
                <div class="school__year display" aria-hidden="true">{getYear(item.startDate) ?? '—'}</div>
                <div class="school__body">
                  <div class="school__top">
                    <span class="mono school__index">{String(index + 1).padStart(2, '0')}</span>
                    {isCurrent
                      ? (
                          <span class="stamp stamp--solid">
                            <span class="status-dot" aria-hidden="true" />
                            {text('common.current')}
                          </span>
                        )
                      : <span class="mono school__done">{text('common.completed')}</span>}
                  </div>
                  <h4 class="school__name display">
                    {item.url
                      ? <a class="link-line" href={item.url} target="_blank" rel="noopener noreferrer">{item.institution}</a>
                      : item.institution}
                  </h4>
                  <p class="school__meta">
                    <span>{item.studyType}</span>
                    <span aria-hidden="true"> / </span>
                    <span>{item.area}</span>
                  </p>
                  <p class="mono school__dates">{formatDateRange(item.startDate, item.endDate, text('common.now'))}</p>
                  {item.score && <p class="school__meta"><span class="meta">{text('education.score')}</span> {item.score}</p>}
                  {item.courses && item.courses.length > 0 && <p class="school__meta"><span class="meta">{text('education.courses')}</span> {item.courses.join(' / ')}</p>}
                </div>
              </li>
            )
          })
        }
      </ol>

      <p class="education__note mono" data-scroll>
        {text('education.note')}
      </p>
    </div>

    <aside class="education__aside" aria-label={text('education.certification')}>
      {
        certificates.length > 0 && (
          <div class="certs" data-scroll="right">
            <header class="certs__head">
              <span class="kicker">{text('education.certified')}</span>
              <span class="mono">{String(certificates.length).padStart(2, '0')} {text('education.records')}</span>
            </header>

            {certificates.map((certificate, index) => (
              <article class="cert">
                <div class="cert__seal" aria-hidden="true">
                  <svg viewBox="0 0 160 160" role="presentation">
                    <defs>
                      <path id={`cert-ring-${index}`} d="M80,80 m-61,0 a61,61 0 1,1 122,0 a61,61 0 1,1 -122,0" />
                    </defs>
                    <circle cx="80" cy="80" r="72" fill="none" stroke="currentColor" stroke-width="1" />
                    <circle cx="80" cy="80" r="52" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 4" />
                    <text>
                      <textPath href={`#cert-ring-${index}`} startOffset="0">
                        {`${certificate.issuer.toUpperCase()} • ${text('education.certified').toUpperCase()} • ${getYear(certificate.date) ?? ''} • `}
                      </textPath>
                    </text>
                    <text x="80" y="86" text-anchor="middle" class="cert__seal-mark">{certificate.name.split(' ')[0]}</text>
                  </svg>
                </div>

                <div class="cert__body">
                  <span class="mono cert__label">{text('education.certificate')} {String(index + 1).padStart(2, '0')}</span>
                  <h4 id={`education-cert-title-${index}`} class="cert__name display">{certificate.name}</h4>
                  <dl class="cert__facts">
                    <div>
                      <dt class="meta">{text('education.issuer')}</dt>
                      <dd>{certificate.issuer}</dd>
                    </div>
                    <div>
                      <dt class="meta">{text('education.issued')}</dt>
                      <dd>{certificate.date.slice(0, 7).replace('-', '.')}</dd>
                    </div>
                  </dl>
                  {certificate.url && (
                    <a class="arrow-link cert__link" href={certificate.url} target="_blank" rel="noopener noreferrer">
                      <span>{text('education.verify')}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        )
      }

      <div class="education__aside-note" data-scroll="right">
        <span class="mono">{text('education.asideTitle')}</span>
        <p>
          {text('education.aside')}
        </p>
      </div>
    </aside>
  </div>
</Section>

<style>
  @import "../../styles/sections/education.css";
</style>
