---
import Section from '@/components/Section.astro'
import Icon from '@/components/ui/Icon.astro'
import { cv } from '@/data/cv'
import { text } from '@/data/site'
import { formatPeriod, getYear } from '@/utils/date'
import { stripLeadingEmoji } from '@/utils/text'

const work: typeof cv.work = [
  ...cv.work,
  ...cv.volunteer.map(item => ({
    name: item.organization,
    position: item.position,
    url: item.url,
    startDate: item.startDate,
    endDate: item.endDate,
    summary: item.summary,
    highlights: item.highlights,
  })),
]
const currentCount = work.filter(item => !item.endDate).length
const meta = [
  `${String(work.length).padStart(2, '0')} ${text('experience.roles')}`,
  `${String(currentCount).padStart(2, '0')} ${text('common.current')}`,
].join(' · ')
const years = work.flatMap(item => [
getYear(item.startDate),
getYear(item.endDate),
]).filter((year): year is string => Boolean(year)).sort()
const lastYear = currentCount > 0
? text('common.present')
: years.at(-1)
---
<Section id="experience" meta={meta}>
  <div class="work-intro" data-scroll>
    <p class="kicker">{text('experience.intro')}</p>
    <p class="work-intro__statement">
      {text('experience.statement')}
    </p>
    {years.length > 0 && <span class="mono work-intro__range">{years[0]} → {lastYear}</span>}
  </div>

  <ol class="work-list">
    {
      work.map((item, index) => {
        const isCurrent = !item.endDate
        const detailsId = `work-details-${index}`
        const summaryLines = Array.isArray(item.summary)
          ? item.summary
          : item.summary
            ? [item.summary]
            : []
        const hasDetails = Boolean(
          item.responsibilities?.length
          || item.achievements?.length
          || item.highlights?.length,
        )

        return (
          <li class:list={['work', isCurrent && 'work--current']}>
            <header class="work__period">
              <span class="work__index mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="work__year display" aria-hidden="true">{getYear(item.startDate) ?? '—'}</span>
              <span class="work__range mono">{formatPeriod(item.startDate, item.endDate, text('common.now'))}</span>
              {isCurrent && (
                <span class="work__current stamp">
                  <span class="status-dot" aria-hidden="true" />
                  {text('common.current')}
                </span>
              )}
            </header>

            <div class="work__body" data-scroll>
              <div class="work__heading">
                <div>
                  <h3 class="work__position display">{item.position}</h3>
                  <p class="work__company-line">
                    <span class="work__at" aria-hidden="true">@</span>
                    {item.url
                      ? (
                          <a class="link-line work__company" href={item.url} target="_blank" rel="noopener noreferrer">
                            {item.name}
                          </a>
                        )
                      : <span class="work__company">{item.name}</span>}
                  </p>
                </div>
                {(item.location || item.location_type) && (
                  <p class="mono work__location">
                    {[item.location, item.location_type].filter(Boolean).join(' / ')}
                  </p>
                )}
              </div>

              {summaryLines.map(line => <p class="work__summary">{line}</p>)}

              {hasDetails && (
                <div class="expander" data-expander>
                  <button class="expander__toggle" type="button" aria-expanded="true" aria-controls={detailsId}>
                    <span class="expander__toggle-mark" aria-hidden="true">+</span>
                    <span class="expander__label expander__label-open">{text('experience.closeRecord')}</span>
                    <span class="expander__label expander__label-closed">{text('experience.openRecord')}</span>
                  </button>

                  <div class="expander__body" id={detailsId}>
                    <div class="expander__inner">
                      <div class="work__details">
                        {item.responsibilities?.length
                          ? (
                              <section class="work__detail">
                                <h4 class="mono">{text('experience.responsibilities')}</h4>
                                <ul class="work__bullets">
                                  {item.responsibilities.map(line => <li>{line}</li>)}
                                </ul>
                              </section>
                            )
                          : null}

                        {item.achievements?.length
                          ? (
                              <section class="work__detail">
                                <h4 class="mono">{text('experience.achievements')}</h4>
                                <ul class="work__bullets">
                                  {item.achievements.map(line => <li>{line}</li>)}
                                </ul>
                              </section>
                            )
                          : null}

                        {item.highlights?.length
                          ? (
                              <section class="work__detail">
                                <h4 class="mono">{text('common.highlights')}</h4>
                                <ul class="work__bullets">
                                  {item.highlights.map(line => <li>{stripLeadingEmoji(line)}</li>)}
                                </ul>
                              </section>
                            )
                          : null}
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {item.skills && Object.keys(item.skills).length > 0 && (
                <ul class="work__stack" aria-label={text('experience.stackLabel').replace('{name}', item.name)}>
                  {Object.entries(item.skills).map(([skill, icon]) => (
                    <li class="work__chip">
                      <Icon name={icon} width={13} height={13} aria-hidden="true" />
                      <span>{skill}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        )
      })
    }
  </ol>
</Section>

<style>
  @import "../../styles/sections/experience.css";
</style>
