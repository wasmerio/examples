---
import ConstructionMark from '@/components/ConstructionMark.astro'
import PixelGlobe from '@/components/PixelGlobe.astro'
import Arrow from '@/components/ui/Arrow.astro'
import Icon from '@/components/ui/Icon.astro'
import { cv } from '@/data/cv'
import { allSections, asset, section, site, text } from '@/data/site'
import { seededRandom } from '@/utils/seed'

const { name, label, profiles } = cv.basics
const hero = cv.hero
const settings = section('top')
const lines = hero.nameLines.length
  ? hero.nameLines
  : name.trim().split(/\s+|(?<=[a-z])(?=[A-Z])/)
function letterWidth(letter: string) {
  if (/[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}\p{Extended_Pictographic}\u3000-\u303f\uff00-\uffef]/u.test(letter))
    return 1
  return letter === ' '
    ? 0.25
    : 'MW'.includes(letter.toUpperCase())
      ? 0.76
      : 'IL'.includes(letter.toUpperCase())
        ? 0.44
        : 0.61
}
const nameUnits = Math.max(...lines.map(line => [...line].reduce((total, letter) => total + letterWidth(letter), 0)), 1)
const random = seededRandom(hero.typography.seed)
const next = allSections[allSections.findIndex(item => item.id === 'top') + 1]
const projectTarget = /^#project-(\d+)$/.exec(hero.cta.href)
const canFollow = !hero.cta.href.startsWith('#') || hero.cta.href === '#main'
  || allSections.some(item => `#${item.id}` === hero.cta.href)
  || Boolean(projectTarget && section('projects').enabled && Number(projectTarget[1]) >= 1 && Number(projectTarget[1]) <= cv.projects.length)
---
<section id="top" class="hero" aria-labelledby="hero-title" data-scroll-section data-section-index={settings.index} data-section-label={settings.label}>
  <div class="hero__pin">
    <div class="hero__coordinates shell">
      <span>{hero.location}</span>
      <span class="hero__local"><span class="hero__availability" aria-hidden="true"></span>{hero.availability}</span>
    </div>
    <div class="hero__layout shell" style={`--name-lines: ${lines.length}; --name-units: ${nameUnits}`} data-hero-has-globe={String(hero.globe.enabled)}>
      <div class="hero__plane" data-hero-plane aria-hidden="true"></div>
      <div class="hero__construction" data-hero-construction aria-hidden="true"><ConstructionMark /></div>
      <div class="hero__type">
        <h1 id="hero-title" class="hero__name" aria-label={name} data-type-mix data-type-seed={hero.typography.seed} data-type-mixed={String(hero.typography.mixed)} data-type-shuffle={String(hero.typography.shuffle)}>
          {lines.map((line, lineIndex) => (
            <span
              class:list={['hero__line', lineIndex > 0 && 'hero__name-tail']}
              data-hero-word={lineIndex === 0
? 'first'
: 'last'}
              aria-hidden="true"
            >
              {[...line].map((letter, index) => {
                const variant = hero.typography.mixed
? Math.floor(random() * 4)
: 0
                const width = letterWidth(letter)
                return <span class="hero__letter" data-hero-letter style={`--letter-index: ${index}; --letter-width: ${width}em`}><span class="hero__glyph" data-type-glyph data-type-variant={variant}>{letter}</span></span>
              })}
            </span>
          ))}
        </h1>
        {hero.typography.mixed && hero.typography.shuffle && <button class="hero__remix" type="button" data-type-remix><span class="hero__remix-mark" aria-hidden="true">↔</span>{text('hero.reroll')}</button>}
      </div>
      <div class="hero__side">
        <div class="hero__annotation" data-hero-note>
          <p class="hero__role">{hero.role || label}</p>
          <p class="hero__description">{hero.description}</p>
          {canFollow && <a class="hero__explore" href={asset(hero.cta.href)} data-magnetic><span>{hero.cta.label}</span><Arrow size={27} /></a>}
        </div>
        {hero.globe.enabled && <div class="hero__visual" data-hero-visual><PixelGlobe /></div>}
      </div>
    </div>
    <div class="hero__bottom shell">
      {hero.metrics.length > 0 && <dl class="hero__metrics">{hero.metrics.map(metric => <div class="hero__metric"><dd class="hero__metric-value display">{metric.value}</dd><dt class="hero__metric-label">{metric.label}</dt></div>)}</dl>}
      <div class="hero__utility">
        <ul class="hero__profiles" aria-label={text('site.profiles')}>{profiles.map(profile => <li><a href={profile.url} target="_blank" rel="noopener noreferrer" aria-label={`${profile.network}: ${profile.username}`}><Icon name={profile.icon} width={14} height={14} aria-hidden="true" /><span>{profile.network}</span></a></li>)}</ul>
        {site.features.print && <button class="hero__print mono" type="button" data-print>{text('site.print')} <Arrow size={13} /></button>}
      </div>
    </div>
    <div class="hero__foot shell">
      {next && <a class="hero__scroll mono" href={`#${next.id}`}><span class="hero__scroll-line" aria-hidden="true"></span>{hero.scrollLabel}<Arrow direction="down" size={15} /></a>}
      <span class="hero__issue">{hero.note}</span>
    </div>
  </div>
</section>

<script>
  import { initTypeMix } from '@/scripts/type-mix'

  initTypeMix()
</script>

<style>
  @import "../../styles/sections/hero.css";
</style>
