---
import GalleryBoard from '@/components/gallery/GalleryBoard.astro'
import GalleryControls from '@/components/gallery/GalleryControls.astro'
import GalleryStrip from '@/components/gallery/GalleryStrip.astro'
import Section from '@/components/Section.astro'
import { cv } from '@/data/cv'
import { text } from '@/data/site'

const gallery = cv.images
const frames = gallery?.list ?? []
const meta = `${String(frames.length).padStart(2, '0')} ${text('gallery.frames')}${frames.length
? ` · ${text('cursor.drag')}`
: ''}`
---
<Section id="gallery" meta={meta}>
  {frames.length > 0
? (
    <div class="gallery" data-strip data-gallery>
      <div class="gallery__head" data-scroll>
        <div>
          <p class="kicker">{text('gallery.intro')}</p>
          <p class="gallery__statement">{text('gallery.statementFirst')} <em>{text('gallery.statementLast')}</em></p>
          {gallery?.intro && <p class="gallery__intro">{gallery.intro}</p>}
        </div>
        <GalleryControls total={frames.length} />
      </div>
      <GalleryBoard frames={frames} />
      <GalleryStrip frames={frames} />
    </div>
  )
: <p class="gallery__intro">{text('gallery.empty')}</p>}
</Section>

<script>
  import { initPhotoBoard } from '@/scripts/photo-board'
  import { initStrips } from '@/scripts/strip'

  initStrips()
  initPhotoBoard()
</script>

<style is:global>
  @import "../../styles/sections/images.css";
</style>
