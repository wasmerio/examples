---
import ProjectCase from '@/components/ProjectCase.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import Section from '@/components/Section.astro'
import Arrow from '@/components/ui/Arrow.astro'
import { cv } from '@/data/cv'
import { text } from '@/data/site'

const projects = cv.projects
const liveCount = projects.filter(project => project.isActive !== false).length
const meta = `${String(projects.length).padStart(2, '0')} ${text('projects.cases')} · ${String(liveCount).padStart(2, '0')} ${text('common.live')}`
---
<Section id="projects" meta={meta} className="projects-section">
  <div class="project-index" data-scroll>
    <div class="project-index__head">
      <span class="kicker">{text('projects.index')}</span>
      <span class="mono">{text('projects.select')} ↓</span>
    </div>
    <ol class="project-index__list">
      {
        projects.map((project, index) => (
          <li>
            <a href={`#project-${index + 1}`}>
              <span class="project-index__num mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="project-index__name">{project.name}</span>
              <span class:list={['project-index__status mono', project.isActive === false && 'is-archived']}>
                {project.isActive === false
? text('common.archive')
: text('common.live')}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="project-exhibition" data-project-exhibition>
    <div class="project-exhibition__pin" data-project-pin>
      <div class="project-exhibition__bar" aria-hidden="true">
        <span>{text('projects.selected')}</span>
        <span class="project-exhibition__position"><span data-project-current>01</span><span class="project-exhibition__divider">/</span>{String(projects.length).padStart(2, '0')}</span>
        <span class="project-exhibition__hint">{text('projects.explore')} <Arrow direction="down" size={14} /></span>
      </div>
      <div class="project-exhibition__viewport">
        <div class="projects" data-project-track>
          {projects.map((project, index) => <ProjectCard project={project} index={index} total={projects.length} />)}
        </div>
      </div>
      <nav class="project-exhibition__navigation" aria-label={text('projects.navigation')} style={`grid-template-columns: repeat(${Math.max(1, projects.length)}, minmax(0, 1fr))`}>
        {projects.map((project, index) => (
          <a href={`#project-${index + 1}`} data-project-step aria-label={`${String(index + 1).padStart(2, '0')} ${project.name}`}>
            <span class="project-exhibition__step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}{' '}</span>
            <span>{project.name}</span>
            <Arrow size={14} />
          </a>
        ))}
      </nav>
      <div class="project-exhibition__progress" aria-hidden="true"><span></span></div>
    </div>
  </div>

  <ProjectCase />
</Section>

<style is:global>
  @import "../../styles/sections/projects.css";
</style>
