---
interface Props {
  direction?: 'diagonal' | 'down' | 'up' | 'right' | 'left'
  size?: number
  class?: string
}

const { direction = 'diagonal', size = 20, class: className } = Astro.props
const rotations = {
diagonal: 0,
right: 45,
down: 135,
up: -45,
left: 225,
}
---
<svg class:list={['arrow-icon', className]} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <g transform={`rotate(${rotations[direction]} 12 12)`}>
    <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" />
  </g>
</svg>
