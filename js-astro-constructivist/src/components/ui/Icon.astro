---
import type { HTMLAttributes } from 'astro/types'
import mdi from '@iconify-json/mdi/icons.json'
import ri from '@iconify-json/ri/icons.json'
import simple from '@iconify-json/simple-icons/icons.json'

interface Props extends HTMLAttributes<'svg'> {
  name: string
  width?: number | string
  height?: number | string
}

interface IconSet {
  width: number
  height: number
  icons: Record<string, { body: string, width?: number, height?: number }>
  aliases?: Record<string, { parent: string }>
}

const { name, width = 24, height = width, ...attributes } = Astro.props
const [prefix, key] = name.split(':')
const sets: Record<string, IconSet> = { mdi, ri, 'simple-icons': simple }
const set = sets[prefix ?? '']
const resolved = key && (set?.icons[key] ?? set?.icons[set?.aliases?.[key]?.parent ?? ''])
if (!resolved)
  throw new Error(`Unknown icon "${name}". Use a name from mdi, ri, or simple-icons in cv.json.`)
---
<svg xmlns="http://www.w3.org/2000/svg" width={width} height={height} viewBox={`0 0 ${resolved.width ?? set!.width} ${resolved.height ?? set!.height}`} data-icon={name} aria-hidden="true" focusable="false" {...attributes} set:html={resolved.body} />
