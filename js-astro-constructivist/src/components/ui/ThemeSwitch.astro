---
import Icon from '@/components/ui/Icon.astro'
import { THEMES } from '@/constants'
import { text } from '@/data/site'
---
<div class="topbar__palette">
  <span class="topbar__swatch" aria-hidden="true"></span>
  <label class="sr-only" for="themeSelect">{text('theme.paletteLabel')}</label>
  <div class="topbar__select">
    <select id="themeSelect" autocomplete="off">
      {THEMES.map(theme => <option value={theme}>{text(`theme.${theme}`)}</option>)}
    </select>
  </div>
</div>

<button
  id="themeSwitch"
  class="topbar__tool topbar__tool--theme"
  type="button"
  aria-label={text('theme.darkLabel')}
  aria-pressed="false"
>
  <span class="topbar__theme-icon" aria-hidden="true">
    <Icon name="ri:moon-fill" class="theme-icon theme-icon--moon" width={15} height={15} />
    <Icon name="ri:sun-fill" class="theme-icon theme-icon--sun" width={15} height={15} />
  </span>
</button>

<script>
  import { initTheme } from '@/scripts/theme'

  initTheme()
</script>

<style>
  @reference "../../globals.css";

  .theme-icon--sun {
    display: none;
  }

  :global(.dark) .theme-icon--sun {
    display: block;
  }

  :global(.dark) .theme-icon--moon {
    display: none;
  }

  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
  }

  :global(::view-transition-old(root)) {
    z-index: 1;
  }

  :global(::view-transition-new(root)) {
    z-index: 9999;
  }

  :global(.dark::view-transition-old(root)) {
    z-index: 9999;
  }

  :global(.dark::view-transition-new(root)) {
    z-index: 1;
  }
</style>
