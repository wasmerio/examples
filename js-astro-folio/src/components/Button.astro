---
// Polymorphic button/link. Renders <a> when `href` is set, else <button>.
interface Props {
  href?: string;
  variant?: "primary" | "accent" | "ghost" | "ghost-on-olive" | "link";
  size?: "md" | "sm";
  type?: "button" | "submit";
  class?: string;
  [key: string]: unknown;
}
const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: className,
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-medium rounded-md transition-all duration-200 ease-out focus-visible:outline-2 focus-visible:outline-offset-2";

const sizes = {
  md: "px-5 py-2.5 text-[0.95rem]",
  sm: "px-3.5 py-2 text-sm",
};

const variants = {
  primary:
    "bg-primary text-on-primary hover:bg-primary-hover hover:-translate-y-0.5 shadow-sm hover:shadow-md",
  accent:
    "bg-accent text-[#2b2924] hover:bg-accent-hover hover:-translate-y-0.5 shadow-sm hover:shadow-gold",
  ghost:
    "border border-border-strong text-heading hover:bg-surface hover:-translate-y-0.5",
  "ghost-on-olive":
    "border border-[#fbfaf6]/35 text-[#fbfaf6] hover:bg-[#fbfaf6]/10",
  link: "text-accent-text underline underline-offset-4 decoration-1 hover:decoration-2 px-0 py-0",
};

const cls = [base, variant !== "link" && sizes[size], variants[variant], className]
  .filter(Boolean)
  .join(" ");
const Tag = href ? "a" : "button";
---

<Tag
  class={cls}
  {...href ? { href } : { type }}
  {...rest}
>
  <slot />
</Tag>
