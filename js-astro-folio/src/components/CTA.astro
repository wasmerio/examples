---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { site, content } from "@config";
const { title, body } = content.home.cta;
---

<section class="shell" data-reveal>
  <div
    class="flex flex-col items-start gap-6 rounded-xl bg-olive-600 dark:bg-olive-800 px-7 py-10 sm:px-10 sm:py-12 md:flex-row md:items-center md:justify-between"
  >
    <div class="max-w-xl">
      <h2 class="text-sand-0 text-[clamp(1.6rem,3vw,2.2rem)] font-medium leading-tight">
        {title}
      </h2>
      <p class="mt-3 text-[1.02rem] leading-relaxed text-sand-0/80">{body}</p>
    </div>
    <div class="flex flex-shrink-0 flex-wrap items-center gap-3">
      <Button href="/contact" variant="accent">Get in touch</Button>
      {
        site.features.cvDownload && (
          <Button href={site.cvPath} variant="ghost-on-olive" download>
            <Icon name="download" size={18} />
            Download CV
          </Button>
        )
      }
    </div>
  </div>
</section>
