---
import Button from "./Button.astro";
import { site, content } from "@config";

const id = site.formspreeId?.trim();
const action = id ? `https://formspree.io/f/${id}` : "";
const inputCls =
  "w-full rounded-sm border border-border bg-background px-3.5 py-2.5 text-text transition-colors focus:border-accent focus:outline-2 focus:outline-offset-1 focus:outline-focus";
const labelCls = "flex flex-col gap-1.5 text-sm font-medium text-heading";
---

{
  id ? (
    <form id="contact-form" action={action} method="POST" class="flex flex-col gap-5">
      <label class={labelCls}>
        Name <span class="font-normal text-muted">(required)</span>
        <input class={inputCls} type="text" name="name" autocomplete="name" required />
      </label>

      <label class={labelCls}>
        Email <span class="font-normal text-muted">(required)</span>
        <input class={inputCls} type="email" name="email" autocomplete="email" required />
      </label>

      <label class={labelCls}>
        Message <span class="font-normal text-muted">(required)</span>
        <textarea class={`${inputCls} min-h-36 resize-y`} name="message" rows="5" required></textarea>
      </label>

      {/* honeypot: hidden from people, catches bots */}
      <div class="hidden" aria-hidden="true">
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>

      <div class="flex items-center gap-4">
        <Button type="submit" variant="primary">Send message</Button>
        <p id="form-status" role="status" aria-live="polite" class="text-sm text-muted" />
      </div>
      <p class="text-sm text-muted">{content.contact.formNote}</p>
    </form>
  ) : (
    <div class="rounded-lg border border-border-strong bg-surface p-6">
      <p class="text-[1.02rem] leading-relaxed text-text">
        Email is the fastest way to reach me, and I read everything.
      </p>
      <div class="mt-4">
        <Button href={`mailto:${site.email}`} variant="primary">Email me</Button>
      </div>
      <p class="mt-3 text-sm text-muted">{content.contact.formNote}</p>
    </div>
  )
}

{
  id && (
    <script>
      {`
      const form = document.getElementById("contact-form");
      const status = document.getElementById("form-status");
      if (form && status) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }
          const data = new FormData(form);
          status.textContent = "Sending…";
          status.style.color = "var(--color-muted)";
          try {
            const res = await fetch(form.action, {
              method: "POST",
              body: data,
              headers: { Accept: "application/json" },
            });
            if (res.ok) {
              form.reset();
              status.textContent = "Thanks. I will be in touch.";
              status.style.color = "var(--color-accent-text)";
            } else {
              status.textContent = "Something went wrong. Please email me instead.";
              status.style.color = "var(--color-danger)";
            }
          } catch {
            status.textContent = "Network error. Please email me instead.";
            status.style.color = "var(--color-danger)";
          }
        });
      }
      `}
    </script>
  )
}
