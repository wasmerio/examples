---
import { content } from "@config";
const { experience, education } = content;
---

<ol class="relative flex flex-col gap-8 border-l border-border pl-6" data-reveal>
  {
    experience.map((e) => (
      <li class="relative">
        <span
          class="absolute -left-[1.6rem] top-1.5 h-2.5 w-2.5 rounded-full bg-accent ring-4 ring-background"
          aria-hidden="true"
        />
        <div class="flex flex-col gap-1">
          <div class="flex flex-wrap items-baseline justify-between gap-x-3">
            <h3 class="font-sans text-base font-semibold text-heading">
              {e.role}
              <span class="text-muted"> · {e.org}</span>
            </h3>
            <p class="font-mono text-xs tracking-wide text-muted">{e.period}</p>
          </div>
          <p class="font-mono text-xs tracking-wide text-accent-text">
            {[e.type, e.location].filter(Boolean).join(" · ")}
          </p>
          <p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{e.summary}</p>
        </div>
      </li>
    ))
  }

  <li class="relative">
    <span
      class="absolute -left-[1.6rem] top-1.5 h-2.5 w-2.5 rounded-full bg-border-strong ring-4 ring-background"
      aria-hidden="true"
    ></span>
    <div class="flex flex-wrap items-baseline justify-between gap-x-3">
      <h3 class="font-sans text-base font-semibold text-heading">
        {education.award}
        <span class="text-muted"> · {education.institution}</span>
      </h3>
      <p class="font-mono text-xs tracking-wide text-muted">{education.period}</p>
    </div>
    <p class="font-mono text-xs tracking-wide text-accent-text">{education.location}</p>
  </li>
</ol>
