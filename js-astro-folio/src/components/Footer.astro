---
import { site } from "@config";
import SocialLinks from "./SocialLinks.astro";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="mt-[var(--space-section)] border-t border-border bg-surface">
  <div class="shell grid gap-10 py-14 md:grid-cols-3">
    <div class="flex flex-col gap-3">
      <a href="/" class="font-display text-lg font-medium text-heading">
        {site.name}<span class="text-accent">.</span>
      </a>
      <p class="max-w-xs text-sm leading-relaxed text-muted">{site.tagline}</p>
      <p class="text-sm text-muted">{site.location}</p>
    </div>

    <nav class="flex flex-col gap-2" aria-label="Footer">
      <p class="eyebrow mb-1">Pages</p>
      {
        site.navItems.map((item) => (
          <a href={item.href} class="text-sm text-muted transition-colors hover:text-accent-text">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-col gap-4">
      <p class="eyebrow">Elsewhere</p>
      <SocialLinks variant="list" />
      {
        site.features.cvDownload && (
          <a
            href={site.cvPath}
            download
            class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-accent-text"
          >
            <Icon name="download" size={16} />
            Download CV (PDF)
          </a>
        )
      }
    </div>
  </div>

  <div class="border-t border-border">
    <div
      class="shell flex flex-col items-center justify-between gap-2 py-5 text-xs text-muted sm:flex-row"
    >
      <p>© {year} {site.name}</p>
      <p class="flex items-center gap-3">
        <span>Built with Astro</span>
        {
          site.features.templateCredit && (
            <a
              href={site.templateRepo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 transition-colors hover:text-accent-text"
            >
              Use this template
              <Icon name="arrow-up-right" size={13} />
            </a>
          )
        }
      </p>
    </div>
  </div>
</footer>
