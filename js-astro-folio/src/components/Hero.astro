---
import { Image } from "astro:assets";
import { site, content } from "@config";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";
import portrait from "@/assets/portrait.jpeg";

const { heroName, heroEyebrow, heroHeadline, heroLead } = content.home;
---

<section class="relative overflow-hidden bg-olive-600 dark:bg-olive-800">
  <!-- subtle top-left glow + bottom mustard hairline -->
  <div
    class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full bg-olive-700/60 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-accent/50" aria-hidden="true"></div>

  <div
    class="shell relative grid items-center gap-12 py-20 sm:py-24 lg:grid-cols-12 lg:gap-10 lg:py-28"
  >
    <div class="order-2 lg:order-1 lg:col-span-6">
      <p class="eyebrow !text-gold-300">{heroEyebrow}</p>
      <h1
        class="mt-4 font-display text-[clamp(2.75rem,8vw,4.75rem)] font-medium leading-[1.02] tracking-tight text-accent"
      >
        {heroName}
      </h1>
      <p
        class="mt-3 font-display text-[clamp(1.5rem,3.5vw,2.25rem)] font-medium leading-tight text-sand-0"
      >
        {heroHeadline}
      </p>
      <p class="mt-5 max-w-xl text-[1.05rem] leading-relaxed text-sand-0/85">{heroLead}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href="/work" variant="accent">
          View work
          <Icon name="arrow-right" size={18} />
        </Button>
        {
          site.features.cvDownload && (
            <Button href={site.cvPath} variant="ghost-on-olive" download>
              <Icon name="download" size={18} />
              Download CV
            </Button>
          )
        }
      </div>

      <div class="mt-8">
        <SocialLinks variant="icons" onOlive class="text-sand-0/90" />
      </div>
    </div>

    <div class="order-1 flex justify-center lg:order-2 lg:col-span-6 lg:justify-end">
      <div class="relative w-full max-w-[17rem] lg:max-w-[27rem]">
        <div
          class="absolute -bottom-3 -right-3 h-full w-full rounded-xl bg-accent"
          aria-hidden="true"
        >
        </div>
        <Image
          src={portrait}
          alt={`Portrait of ${site.name}`}
          widths={[280, 400, 560]}
          sizes="(min-width: 1024px) 24rem, 16rem"
          loading="eager"
          fetchpriority="high"
          class="relative aspect-square w-full rounded-xl border border-gold-300/40 object-cover shadow-lg"
        />
      </div>
    </div>
  </div>
</section>
