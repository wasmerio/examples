---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Icon from "./Icon.astro";

interface Props {
  entry: CollectionEntry<"projects">;
}
const { entry } = Astro.props;
const { data } = entry;
const href = `/work/${entry.id}`;
const meta = [data.role, data.period].filter(Boolean).join(" · ");
const tags = data.tags.slice(0, 5);
---

<article
  class="group relative flex flex-col overflow-hidden rounded-lg border border-border-strong bg-surface shadow-sm transition-all duration-200 ease-out hover:-translate-y-1 hover:border-accent/40 hover:shadow-md focus-within:ring-2 focus-within:ring-focus"
  data-reveal
>
  {
    data.cover && (
      <div class="aspect-[16/10] overflow-hidden border-b border-border">
        <Image
          src={data.cover}
          alt={data.coverAlt ?? ""}
          widths={[400, 800]}
          sizes="(min-width: 768px) 40vw, 100vw"
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col gap-3 p-6">
    {meta && <p class="eyebrow">{meta}</p>}

    <h3 class="font-sans text-xl font-semibold text-heading transition-colors group-hover:text-accent-text">
      {data.title}
      <span
        class="ml-0.5 inline-block h-0.5 w-0 bg-accent align-middle transition-all duration-300 ease-out group-hover:w-6"
      ></span>
    </h3>

    <p class="text-[0.97rem] leading-relaxed text-muted">{data.oneLiner}</p>

    {
      tags.length > 0 && (
        <ul class="mt-auto flex flex-wrap gap-1.5 pt-2">
          {tags.map((t) => (
            <li class="rounded-sm bg-surface-2 px-2 py-1 font-mono text-[0.7rem] text-sand-600 dark:text-sand-200">
              {t}
            </li>
          ))}
        </ul>
      )
    }

    <span class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-accent-text">
      View project
      <Icon name="arrow-right" size={16} class="transition-transform duration-200 group-hover:translate-x-1" />
    </span>
  </div>

  <a href={href} class="absolute inset-0 rounded-lg focus-visible:outline-none" aria-label={`View ${data.title}`}>
    <span class="sr-only">View {data.title}</span>
  </a>
</article>
