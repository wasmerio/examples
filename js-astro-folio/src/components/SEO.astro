---
import { site } from "@config";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: "website" | "article";
  /** Emit Person JSON-LD (home/about). */
  person?: boolean;
}
const { title, description, ogImage, type = "website", person = false } = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.seo.title;
const desc = description ?? site.seo.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(ogImage ?? site.seo.ogImage, Astro.site).href;

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.title,
  email: `mailto:${site.email}`,
  url: Astro.site?.href,
  address: { "@type": "PostalAddress", addressLocality: site.location },
  sameAs: [site.socials.github, site.socials.linkedin].filter(Boolean),
};
---

<title>{pageTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:site_name" content={site.name} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={image} />
{site.seo.twitter && <meta name="twitter:creator" content={`@${site.seo.twitter}`} />}

{person && <script is:inline type="application/ld+json" set:html={JSON.stringify(personLd)} />}
