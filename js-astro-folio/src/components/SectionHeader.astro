---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: "left" | "center";
  as?: "h1" | "h2";
  class?: string;
}
const { eyebrow, title, intro, align = "left", as = "h2", class: className } = Astro.props;
const Heading = as;
---

<div
  class:list={[
    "flex flex-col gap-3",
    align === "center" && "items-center text-center",
    className,
  ]}
  data-reveal
>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading class="text-[clamp(1.7rem,3.5vw,2.6rem)] font-medium leading-tight tracking-tight">
    {title}
  </Heading>
  <hr class:list={["accent-rule", align === "center" && "mx-auto"]} />
  {
    intro && (
      <p class="mt-1 max-w-2xl text-[1.05rem] leading-relaxed text-muted">{intro}</p>
    )
  }
</div>
