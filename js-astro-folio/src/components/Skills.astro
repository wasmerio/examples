---
import { content } from "@config";
const { intro, groups, ai } = content.skills;

interface Props {
  showAi?: boolean;
}
const { showAi = true } = Astro.props;
---

<div class="flex flex-col gap-8" data-reveal>
  {intro && <p class="max-w-2xl text-[1.05rem] leading-relaxed text-muted">{intro}</p>}

  <div class="grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-2">
    {
      groups.map((g) => (
        <div class="flex flex-col gap-3">
          <h4 class="font-sans text-sm font-semibold tracking-wide text-heading">{g.title}</h4>
          <ul class="flex flex-wrap gap-1.5">
            {g.items.map((item) => (
              <li class="rounded-sm border border-border bg-surface px-2.5 py-1 font-mono text-[0.78rem] text-sand-600 dark:text-sand-200">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  {
    showAi && (
      <div class="flex flex-col gap-5 rounded-lg border border-border bg-surface p-6">
        <p class="eyebrow">{ai.intro}</p>
        <div class="grid gap-6 md:grid-cols-2">
          {[ai.assisted, ai.features].map((block) => (
            <div class="flex flex-col gap-3 border-l-2 border-accent pl-4">
              <h4 class="font-sans text-sm font-semibold text-heading">{block.label}</h4>
              <ul class="flex flex-wrap gap-1.5">
                {block.items.map((item) => (
                  <li class="rounded-sm bg-surface-2 px-2.5 py-1 font-mono text-[0.78rem] text-sand-600 dark:text-sand-200">
                    {item}
                  </li>
                ))}
              </ul>
              <p class="text-sm leading-relaxed text-muted">{block.note}</p>
            </div>
          ))}
        </div>
      </div>
    )
  }
</div>
