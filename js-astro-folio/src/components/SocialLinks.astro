---
import Icon from "./Icon.astro";
import { site } from "@config";

interface Props {
  /** "icons" = icon buttons; "list" = labelled rows. */
  variant?: "icons" | "list";
  /** Colour treatment for the olive hero band. */
  onOlive?: boolean;
  class?: string;
}
const { variant = "icons", onOlive = false, class: className } = Astro.props;

type Entry = { label: string; href: string; icon: "github" | "linkedin" | "mail" };
const entries: Entry[] = [];
if (site.email) entries.push({ label: "Email", href: `mailto:${site.email}`, icon: "mail" });
if (site.socials.github)
  entries.push({ label: "GitHub", href: site.socials.github, icon: "github" });
if (site.socials.linkedin)
  entries.push({ label: "LinkedIn", href: site.socials.linkedin, icon: "linkedin" });

const isExternal = (href: string) => href.startsWith("http");
const hoverColour = onOlive ? "hover:text-accent" : "hover:text-accent-text";
---

{
  variant === "icons" ? (
    <ul class:list={["flex items-center gap-1.5", className]}>
      {entries.map((e) => (
        <li>
          <a
            href={e.href}
            class:list={[
              "inline-flex h-11 w-11 items-center justify-center rounded-full transition-colors",
              hoverColour,
            ]}
            aria-label={e.label}
            {...isExternal(e.href) ? { target: "_blank", rel: "noopener noreferrer" } : {}}
          >
            <Icon name={e.icon} size={20} />
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <ul class:list={["flex flex-col gap-3", className]}>
      {entries.map((e) => (
        <li>
          <a
            href={e.href}
            class:list={[
              "group inline-flex items-center gap-3 text-base transition-colors",
              hoverColour,
            ]}
            {...isExternal(e.href) ? { target: "_blank", rel: "noopener noreferrer" } : {}}
          >
            <Icon name={e.icon} size={18} class="text-accent-text" />
            <span class="border-b border-transparent group-hover:border-current">
              {e.icon === "mail" ? site.email : e.label}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}
