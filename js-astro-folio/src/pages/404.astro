---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <section class="shell flex min-h-[60vh] flex-col items-center justify-center gap-5 py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="font-display text-[clamp(2rem,5vw,3rem)] font-medium leading-tight">
      This page does not exist
    </h1>
    <p class="max-w-md text-muted">
      The link may be broken, or the page may have moved. Let us get you back on track.
    </p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      <Button href="/" variant="primary">Back home</Button>
      <Button href="/work" variant="ghost">
        See the work
        <Icon name="arrow-right" size={16} />
      </Button>
    </div>
  </section>
</BaseLayout>
