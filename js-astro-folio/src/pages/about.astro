---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Skills from "@/components/Skills.astro";
import Experience from "@/components/Experience.astro";
import CTA from "@/components/CTA.astro";
import { site, content } from "@config";
import portrait from "@/assets/portrait.jpeg";

const { lead, paragraphs, closing, facts } = content.about;
---

<BaseLayout
  title="About"
  description={`About ${site.name}: ${site.title} based in ${site.location}.`}
  person
>
  <section class="shell section-y">
    <SectionHeader eyebrow="About" title="A senior engineer who ships" as="h1" />

    <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- left: photo + facts -->
      <aside class="lg:col-span-4" data-reveal>
        <Image
          src={portrait}
          alt={`Portrait of ${site.name}`}
          widths={[320, 480]}
          sizes="(min-width: 1024px) 20rem, 100vw"
          class="aspect-square w-full rounded-lg border border-border object-cover shadow-md"
        />
        <dl class="mt-6 flex flex-col gap-4">
          {
            facts.map((f) => (
              <div class="flex flex-col gap-0.5 border-l-2 border-accent pl-3">
                <dt class="eyebrow">{f.label}</dt>
                <dd class="text-[0.95rem] text-text">{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>

      <!-- right: bio -->
      <div class="prose lg:col-span-8" data-reveal>
        <p class="text-[1.15rem] leading-relaxed text-heading">{lead}</p>
        {paragraphs.map((p) => <p>{p}</p>)}
        <p>{closing}</p>
      </div>
    </div>
  </section>

  <!-- experience -->
  <section class="shell section-y pt-0">
    <SectionHeader eyebrow="Experience" title="Where I have worked" />
    <div class="mt-10 max-w-3xl">
      <Experience />
    </div>
  </section>

  <!-- skills -->
  <section class="shell section-y pt-0">
    <SectionHeader eyebrow="Skills" title="What I work with" />
    <div class="mt-10">
      <Skills />
    </div>
  </section>

  <CTA />
  <div class="h-4"></div>
</BaseLayout>
