---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title="Blog" description="Notes on building things, including how this site was made.">
  <section class="shell section-y">
    <SectionHeader
      eyebrow="Blog"
      title="Writing"
      intro="The occasional note on how I build things, including this site."
      as="h1"
    />

    {
      posts.length > 0 ? (
        <ul class="mt-12 flex flex-col border-t border-border">
          {posts.map((post) => (
            <li class="border-b border-border">
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col gap-2 py-7 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
                data-reveal
              >
                <div class="sm:flex-1">
                  <h2 class="font-sans text-xl font-semibold text-heading transition-colors group-hover:text-accent-text">
                    {post.data.title}
                  </h2>
                  <p class="mt-1 max-w-2xl text-[0.97rem] leading-relaxed text-muted">
                    {post.data.description}
                  </p>
                </div>
                <time
                  datetime={post.data.date.toISOString()}
                  class="font-mono text-xs tracking-wide text-muted"
                >
                  {fmt(post.data.date)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-12 text-muted">No posts yet. Add markdown files to src/content/blog/.</p>
      )
    }
  </section>
</BaseLayout>
