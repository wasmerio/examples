---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ContactForm from "@/components/ContactForm.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import { site, content } from "@config";

const { lead, body, availability } = content.contact;
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}.`}>
  <section class="shell section-y">
    <SectionHeader eyebrow="Contact" title="Get in touch" intro={lead} as="h1" />

    <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- form -->
      <div class="lg:col-span-7" data-reveal>
        {site.features.contactForm ? <ContactForm /> : null}
      </div>

      <!-- direct channels -->
      <aside class="flex flex-col gap-8 lg:col-span-5" data-reveal>
        <p class="text-[1.02rem] leading-relaxed text-muted">{body}</p>

        <div class="flex flex-col gap-4">
          <p class="eyebrow">Direct</p>
          <SocialLinks variant="list" />
        </div>

        {
          site.features.cvDownload && (
            <div>
              <Button href={site.cvPath} variant="ghost" download>
                <Icon name="download" size={18} />
                Download CV (PDF)
              </Button>
            </div>
          )
        }

        <p class="text-sm text-muted">{availability}</p>
      </aside>
    </div>
  </section>
</BaseLayout>
