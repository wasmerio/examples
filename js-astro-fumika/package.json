{
	"name": "fumika",
	"type": "module",
	"version": "0.1.0",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && pagefind --site dist",
		"preview": "astro preview",
		"astro": "astro",
		"check": "pnpm run astro-check && pnpm run type-check && pnpm run svelte-check",
		"astro-check": "astro check",
		"type-check": "tsc --noEmit",
		"svelte-check": "svelte-check --tsconfig tsconfig.json",
		"new-post": "node scripts/new-post.js",
		"format": "biome format --write ./src",
		"lint": "biome check --write ./src",
		"test": "vitest",
		"test-coverage": "vitest run --coverage",
		"preinstall": "npx only-allow pnpm",
		"postinstall": "playwright install chromium",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.3",
		"@astrojs/partytown": "^2.1.8",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/svelte": "9.1.1",
		"@expressive-code/core": "^0.44.2",
		"@expressive-code/plugin-collapsible-sections": "^0.44.2",
		"@expressive-code/plugin-line-numbers": "^0.44.2",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/roboto": "^5.3.0",
		"@giscus/svelte": "^3.1.0",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/fa6-regular": "^1.2.4",
		"@iconify-json/fa6-solid": "^1.2.4",
		"@iconify-json/material-symbols": "^1.2.95",
		"@iconify/svelte": "^5.2.2",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "7.4.2",
		"astro-expressive-code": "^0.44.2",
		"astro-icon": "^1.2.0",
		"hastscript": "^9.0.1",
		"katex": "^0.19.0",
		"markdown-it": "^15.0.3",
		"mdast-util-to-string": "^4.0.0",
		"overlayscrollbars": "^2.17.0",
		"pagefind": "^1.5.2",
		"photoswipe": "^5.4.4",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-mermaid": "^3.0.0",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^4.0.0",
		"remark-directive-rehype": "^1.0.0",
		"remark-github-admonitions-to-directives": "^2.1.0",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.18.1",
		"sass": "^1.106.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"tailwindcss": "^4.3.3",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/ts-plugin": "^1.10.12",
		"@biomejs/biome": "2.6.3",
		"@rollup/plugin-yaml": "^5.0.0",
		"@types/hast": "^3.0.5",
		"@types/markdown-it": "^14.2.0",
		"@types/mdast": "^4.0.4",
		"@types/sanitize-html": "^2.16.2",
		"@vitest/coverage-v8": "4.1.12",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"playwright": "^1.64.1",
		"svelte-check": "^4.7.7",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	},
	"packageManager": "pnpm@11.25.0"
}
