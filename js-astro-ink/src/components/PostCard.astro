---
import type { CollectionEntry } from 'astro:content'

import { articleLanguage, readingTimeLabel, siteLanguage, ui } from '@/utils/locale'
import { cn, formatDate, withBase } from '@/utils'
import { getPostReadingTime, postUrl } from '@/utils/server'

interface Props {
  post: CollectionEntry<'blog'>
  class?: string
}

const { post, class: className } = Astro.props
const { data } = post
const language = articleLanguage(data.language)
const date = data.updatedDate ?? data.publishDate
const minutesRead = getPostReadingTime(post)
---

<article class={cn('post-row not-prose group relative flex flex-col gap-2', className)}>
  <h2 lang={language}
    class="font-serif text-xl font-semibold leading-snug transition-colors duration-200 group-hover:text-accent"
  >
    <a href={postUrl(post.id)} data-astro-prefetch class="after:absolute after:inset-0">
      {data.draft && <span lang={siteLanguage} class="me-1 text-accent">[{ui('Draft', '草稿')}]</span>}
      {data.title}
    </a>
  </h2>

  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-xs text-ink-soft">
    <time datetime={date.toISOString()} class="tabular-nums">{formatDate(date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTimeLabel(minutesRead)}</span>
  </div>

  <p lang={language} class="line-clamp-2 text-sm leading-relaxed text-ink-body">{data.description}</p>

  {
    data.tags.length > 0 && (
      <div class="relative z-10 flex flex-wrap items-center gap-x-3 gap-y-1 pt-1">
        {data.tags.map((tag) => (
          <a href={withBase(`/tags/${tag}`)} class="tag-link" data-astro-prefetch>
            #{tag}
          </a>
        ))}
      </div>
    )
  }
</article>
