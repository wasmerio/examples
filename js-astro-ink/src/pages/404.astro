---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { withBase } from '@/utils'
---

<BaseLayout title="Page not found" noindex>
  <div class="animate not-prose flex flex-col items-center gap-6 py-20 text-center">
    <p class="font-serif text-7xl font-semibold text-accent">404</p>
    <p class="text-ink-soft">There is nothing you are looking for on this page of paper.</p>
    <a
      href={withBase('/')}
      class="link-ink inline-flex min-h-9 items-center gap-2 text-sm"
      data-astro-prefetch
    >
      <span class="i-lucide-house size-4" aria-hidden="true"></span>
      Back to home
    </a>
  </div>
</BaseLayout>
