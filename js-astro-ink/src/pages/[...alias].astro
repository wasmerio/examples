---
import { getCollection } from 'astro:content'
import { siteLanguage, ui } from '@/utils/locale'
import { getPostAliases } from '@/utils/post-navigation'
import { postUrl } from '@/utils/server'

export async function getStaticPaths() {
  return getPostAliases(await getCollection('blog')).map(({ alias, postId }) => ({
    params: { alias },
    props: { postId }
  }))
}

const target = postUrl(Astro.props.postId)
const title = ui('This article has moved', '文章已迁移')
---
<!doctype html>
<html lang={siteLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site ?? Astro.url)} />
    <script is:inline data-target={target}>
      const destination = new URL(document.currentScript.dataset.target, location.origin)
      destination.search = location.search
      destination.hash = location.hash
      location.replace(destination.href)
    </script>
    <noscript><meta http-equiv="refresh" content={`0;url=${target}`} /></noscript>
  </head>
  <body><a href={target}>{title}</a></body>
</html>
