---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Spoiler from '@/components/Spoiler.astro'
import { config } from '@/site-config'
import { withBase } from '@/utils'
---

<BaseLayout title="About" description={`About ${config.site.author}`}>
  <div class="animate mx-auto max-w-3xl">
    <header class="not-prose mb-8 text-center">
      <h1 class="font-serif text-3xl font-semibold">About</h1>
      <p class="mt-3 text-ink-soft">{config.site.description}</p>
    </header>

    <div class="prose prose-fill">
      <h2>This site</h2>
      <p>
        A personal blog powered by <strong>astro-theme-ink</strong> — a warm paper-feel Astro theme. Ink
        on paper is all it wants to convey.
      </p>
      <blockquote>
        Simple things are often the best. Whitespace is not emptiness — it is breathing.
      </blockquote>

      <h2>About me</h2>
      {
        config.home.hero.about
          .split(/\n\s*\n/)
          .filter(Boolean)
          .map((paragraph) => <p>{paragraph}</p>)
      }

      <h2>Tech stack</h2>
      <ul>
        <li><strong>Astro 7</strong> — the content-driven web framework</li>
        <li>
          <strong>UnoCSS</strong> (presetWind3 + presetTypography + presetIcons) — the instant atomic
          CSS engine
        </li>
        <li><strong>Pure static output</strong> — deploy the build anywhere</li>
      </ul>

      <h2>Contact</h2>
      <p>
        Feel free to reach out via <a href={withBase('/links')}>friend links</a> or the comment section.
        <Spoiler>Hover me to reveal a secret!</Spoiler>
      </p>
    </div>
  </div>
</BaseLayout>
