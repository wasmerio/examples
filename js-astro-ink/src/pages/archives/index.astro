---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { articleLanguage, siteLanguage } from '@/utils/locale'
import { formatDate } from '@/utils'
import { getBlogCollection, groupByYear, postUrl } from '@/utils/server'

const groups = groupByYear(await getBlogCollection())
---

<BaseLayout title="Archives" description="Posts grouped by year">
  <div class="animate not-prose">
    <header class="mb-8">
      <h1 class="font-serif text-3xl font-semibold">Archives</h1>
      <p class="mt-2 text-sm text-ink-soft">
        {[...groups.values()].reduce((n, g) => n + g.length, 0)} posts
      </p>
    </header>

    {
      groups.size === 0 ? (
        <p class="py-12 text-center text-ink-soft">No posts yet.</p>
      ) : (
        <div class="flex flex-col gap-10">
          {[...groups.entries()].map(([year, posts]) => (
            <section aria-label={`${year}`}>
              <h2 class="mb-4 flex items-baseline gap-3 font-serif text-2xl font-semibold">
                {year}
                <span class="font-mono text-sm font-normal text-ink-soft">
                  {posts.length} posts
                </span>
              </h2>
              <ul class="flex flex-col divide-y divide-line border-y border-line">
                {posts.map((post) => (
                  <li>
                    <a
                      href={postUrl(post.id)}
                      class="group flex items-baseline gap-3 py-2.5 transition-colors hover:text-accent sm:gap-4"
                      data-astro-prefetch
                    >
                      <time
                        datetime={post.data.publishDate.toISOString()}
                        class="w-[5ch] shrink-0 whitespace-nowrap font-mono text-xs text-ink-soft sm:w-24"
                      >
                        {formatDate(post.data.publishDate, siteLanguage, {
                          month: '2-digit',
                          day: '2-digit'
                        })}
                      </time>
                      <span lang={articleLanguage(post.data.language)} class="line-clamp-2 min-w-0 break-words font-medium group-hover:underline group-hover:decoration-accent/60 group-hover:underline-offset-4 sm:block sm:truncate">
                        {post.data.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
