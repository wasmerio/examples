{
  "name": "inkfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Inkfolio — an editorial Astro theme for writers and indie builders. Bilingual, config-driven, zero external fonts.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "node scripts/bin.mjs astro dev",
    "start": "node scripts/bin.mjs astro dev",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/bin.mjs astro preview",
    "astro": "node scripts/bin.mjs astro",
    "pagefind": "node scripts/bin.mjs pagefind",
    "format": "node scripts/bin.mjs prettier --write .",
    "format:check": "node scripts/bin.mjs prettier --check .",
    "lint": "node scripts/bin.mjs eslint .",
    "og": "node scripts/build-og.mjs",
    "log": "node scripts/fetch-log.mjs",
    "seo": "node scripts/seo-check.mjs dist"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@shikijs/transformers": "^4.6.0",
    "astro": "^7.4.1",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "pagefind": "^1.6.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=20"
  }
}
