---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { site, social, about, pickI18n, type Lang } from '../lib/config';
import { md, mdInline } from '../lib/md';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang !== 'en';
const altHref = zh ? '/about/' : '/zh/about/';

const aboutIntro = md(pickI18n(about.intro, lang));
const expertise = (about.expertise ?? []).map((e: any) => ({
  icon: e.icon ?? 'box',
  k: pickI18n(e.title, lang),
  v: mdInline(pickI18n(e.text, lang)),
}));
const stack = (about.stack ?? []).map((x: any) => ({
  icon: x.icon ?? 'box',
  label: pickI18n(x.label, lang),
  note: pickI18n(x.note, lang),
}));
const changelog = (about.journey ?? []).map((c: any) => ({
  icon: c.icon ?? 'tag',
  v: c.version,
  when: c.when,
  what: mdInline(pickI18n(c.what, lang)),
}));

const socials = social.map((item: any) => ({
  ...item,
  href:
    item.href.startsWith('http') || item.href.startsWith('mailto:') ? item.href : zh ? `/zh${item.href}` : item.href,
}));
---

<Base title={zh ? '关于' : 'About'} lang={lang} alt={altHref}>
  <article>
    <section class="hero" style="padding-top:56px">
      <h1>{zh ? `关于 ${site.nameZh}` : `About ${site.name}`}</h1>
      <div class="intro-row">
        {site.avatar && (
          <figure class="por">
            <img src={site.avatar} alt={zh ? site.nameZh : site.name} width="336" height="336" />
          </figure>
        )}
        <div class="bio">
          <div class="prose" set:html={aboutIntro}></div>
          <ul class="bio-social">
            {socials.map((item: any) => (
              <li>
                <a class="soc" href={item.href} rel="noopener me">
                  <Icon name={item.icon} size={16} />
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="sec" id="expertise">
      <div class="sec-head">
        <h2>{zh ? '擅长' : 'Expertise'}</h2>
      </div>
      <div class="sec-body">
        <ul class="exp">
          {expertise.map((e: any) => (
            <li>
              <span class="exp-ic">
                <Icon name={e.icon} size={16} />
              </span>
              <div>
                <b>{e.k}</b>
                <p set:html={e.v}></p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="sec" id="stack">
      <div class="sec-head">
        <h2>{zh ? '技术栈' : 'Stack'}</h2>
      </div>
      <div class="sec-body">
        <ul class="tech">
          {stack.map((x: any) => (
            <li>
              <Icon name={x.icon} size={20} />
              <div>
                <b>{x.label}</b>
                <small>{x.note}</small>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="sec" id="changelog">
      <div class="sec-head">
        <h2>{zh ? '更新日志' : 'Changelog'}</h2>
      </div>
      <div class="sec-body">
        <ol class="timeline">
          {changelog.map((c: any) => (
            <li>
              <span class="tl-ic">
                <Icon name={c.icon} size={16} />
              </span>
              <div class="tl-tx">
                <p class="tl-when">
                  {c.v} · {c.when}
                </p>
                <p class="tl-desc" set:html={c.what}></p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <p style="margin-top:60px">
      <a class="backlink" href={zh ? '/zh/' : '/'}>
        ← {zh ? '回首页' : 'Back home'}
      </a>
    </p>
  </article>
</Base>
