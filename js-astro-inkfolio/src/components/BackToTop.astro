---
import Icon from './Icon.astro';
import type { Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<button class="to-top" id="to-top" type="button" aria-label={lang !== 'en' ? '回到顶部' : 'Back to top'}>
  <Icon name="arrow-up" size={16} />
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('to-top');
    if (!btn) return;
    var ticking = false;
    function update() {
      var show = window.scrollY > 600;
      if (show !== btn.classList.contains('on')) btn.classList.toggle('on', show);
      btn.tabIndex = show ? 0 : -1;
      ticking = false;
    }
    window.addEventListener(
      'scroll',
      function () {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
    btn.addEventListener('click', function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  })();
</script>

<style is:global>
  .to-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 50;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 10px 26px rgba(20, 20, 19, 0.1);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .to-top.on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .to-top:hover {
    border-color: var(--ink);
  }
  /* when the consent card is showing, sit above it instead of on top of it */
  .to-top.lifted {
    bottom: 176px;
  }
  @media (prefers-reduced-motion: reduce) {
    .to-top {
      transition: none;
    }
  }
  @media (max-width: 520px) {
    .to-top {
      right: 12px;
      bottom: 12px;
    }
    .to-top.lifted {
      bottom: 190px;
    }
  }
</style>
