---
import { banner, type Lang } from '../lib/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const visible = banner.enabled && banner.text.trim().length > 0;
const text = lang !== 'en' ? banner.textZh || banner.text : banner.text;
const linkText = lang !== 'en' ? banner.linkTextZh || banner.linkText : banner.linkText;
---

{visible && (
  <>
    <div class="promo" id="promo-banner" data-dismissible={banner.dismissible ? 'true' : 'false'} hidden>
      <div class="promo-inner">
        <p class="promo-text">{text}</p>
        {banner.link && (
          <a class="promo-link" href={banner.link} target="_blank" rel="noopener">
            {linkText}
          </a>
        )}
        {banner.dismissible && (
          <button class="promo-close" type="button" aria-label={t(lang, 'bannerDismiss')} data-promo-close>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path
                d="M3 3l10 10M13 3L3 13"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>
          </button>
        )}
      </div>
    </div>
    <script is:inline>
      // The banner starts hidden and is revealed here so a dismissed banner never
      // flickers on reload. Setting `promoBanner.enabled: false` in
      // site.config.yaml removes it from the HTML entirely — no code change needed.
      (function () {
        var el = document.getElementById('promo-banner');
        if (!el) return;
        var key = 'inkfolio-promo-dismissed';
        var dismissible = el.getAttribute('data-dismissible') === 'true';
        var dismissed = false;
        try {
          dismissed = dismissible && localStorage.getItem(key) === '1';
        } catch {}
        if (!dismissed) el.hidden = false;
        var close = el.querySelector('[data-promo-close]');
        if (close) {
          close.addEventListener('click', function () {
            el.hidden = true;
            try {
              localStorage.setItem(key, '1');
            } catch {}
          });
        }
      })();
    </script>
  </>
)}
