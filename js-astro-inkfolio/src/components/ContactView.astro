---
import Base from '../layouts/Base.astro';
import { site, social, type Lang } from '../lib/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang !== 'en';
const altHref = zh ? '/contact/' : '/zh/contact/';
const L = (en: string, z: string) => (zh ? z : en);

// Point this at your form backend (Formspree, a Worker, anything that accepts POST).
// Left empty, the form falls back to a mailto: submission.
const endpoint = site.contactEndpoint || `mailto:${site.email}`;
const socials = social.map((s: any) => ({
  ...s,
  href: s.href.startsWith('http') || s.href.startsWith('mailto:') ? s.href : zh ? `/zh${s.href}` : s.href,
}));
---

<Base title={t(lang, 'contact')} lang={lang} alt={altHref}>
  <article>
    <section class="hero" style="padding-top:56px">
      <h1>{zh ? '打个招呼' : 'Say hi'}</h1>
      <div class="lede" style="max-width:600px;margin-top:14px;font-size:19px;line-height:1.6;color:var(--body)">
        <p>{t(lang, 'contactLede')}</p>
      </div>
    </section>

    <section style="padding-top:40px;max-width:600px">
      <form class="hi-form" action={endpoint} method="POST">
        <label>
          {L('Name', '名字')}
          <input name="name" required autocomplete="name" />
        </label>
        <label>
          {L('Email', '邮箱')}
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <label>
          {L('What is it about?', '关于什么？')}
          <select name="topic">
            <option>{L('Collaboration', '合作')}</option>
            <option>{L('The theme — bugs, ideas', '主题本身——问题或建议')}</option>
            <option>{L('Writing or the newsletter', '文章或订阅')}</option>
            <option>{L('Just saying hi', '就是打个招呼')}</option>
          </select>
        </label>
        <label>
          {L('Message', '内容')}
          <textarea name="message" rows="6" required></textarea>
        </label>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <button class="btn" type="submit">
          {L('Send', '发送')}
        </button>
      </form>
      <p class="reach-note" style="margin-top:28px">
        {L('Prefer email?', '更习惯邮件？')}
        {site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : null}
      </p>
      {socials.length > 0 && (
        <ul class="bio-social" style="margin-top:22px">
          {socials.map((s: any) => (
            <li>
              <a class="soc" href={s.href}>
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </article>
</Base>

<style>
  .hi-form {
    display: grid;
    gap: 18px;
  }
  .hi-form label {
    display: grid;
    gap: 7px;
    font-size: 14px;
    font-weight: 560;
    color: var(--muted);
  }
  .hi-form input,
  .hi-form textarea,
  .hi-form select {
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 11px 13px;
  }
  .hi-form input:focus,
  .hi-form textarea:focus,
  .hi-form select:focus {
    outline: none;
    border-color: var(--accent);
  }
  .hi-form textarea {
    resize: vertical;
  }
  .hi-form .btn {
    justify-self: start;
  }
  .hi-form .hp {
    position: absolute;
    left: -9999px;
  }
</style>
