---
import { consent, type Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang !== 'en';
const text = zh ? consent.textZh : consent.text;
const linkLabel = zh ? consent.linkLabelZh : consent.linkLabel;
---

<div class="consent" id="consent-card" hidden>
  <p class="consent-text">
    {text}{' '}
    {consent.link && linkLabel && <a href={consent.link}>{linkLabel}</a>}
  </p>
  <div class="consent-actions">
    <button type="button" class="btn" data-consent="accepted">
      {zh ? consent.acceptZh : consent.accept}
    </button>
    <button type="button" class="btn tonal" data-consent="rejected">
      {zh ? consent.rejectZh : consent.reject}
    </button>
  </div>
</div>

<script is:inline define:vars={{ key: consent.storageKey, needConsent: consent.enabled }}>
  (function () {
    var card = document.getElementById('consent-card');
    if (!card || !needConsent) return;
    var stored = null;
    try {
      stored = localStorage.getItem(key);
    } catch {}
    if (!stored) card.hidden = false;
    // keep the back-to-top button from sitting on top of the card
    var top = document.getElementById('to-top');
    function lift(on) {
      if (top) top.classList.toggle('lifted', on);
    }
    lift(!card.hidden);
    card.querySelectorAll('[data-consent]').forEach(function (b) {
      b.addEventListener('click', function () {
        var choice = b.getAttribute('data-consent');
        try {
          localStorage.setItem(key, choice);
        } catch {}
        card.hidden = true;
        lift(false);
        window.dispatchEvent(new CustomEvent('inkfolio:consent', { detail: choice }));
      });
    });
  })();
</script>

<style is:global>
  .consent {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 60;
    width: min(340px, calc(100vw - 32px));
    padding: 16px 16px 14px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background:
      radial-gradient(120% 120% at 100% 0%, color-mix(in srgb, var(--accent) 10%, transparent) 0%, transparent 55%),
      var(--card);
    box-shadow:
      0 18px 44px rgba(20, 20, 19, 0.12),
      0 2px 6px rgba(20, 20, 19, 0.06);
  }
  .consent-text {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--body);
  }
  .consent-text a {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-style: wavy;
    text-decoration-color: var(--u);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  .consent-actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }
  .consent-actions .btn {
    height: 36px;
    padding: 0 14px;
    font-size: 13.5px;
  }
  .consent-actions .btn.tonal {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
    color: var(--ink);
  }
  .consent-actions .btn.tonal:hover {
    background: color-mix(in srgb, var(--ink) 12%, transparent);
  }
  @media (max-width: 520px) {
    .consent {
      right: 12px;
      left: 12px;
      bottom: 12px;
      width: auto;
    }
  }
</style>
