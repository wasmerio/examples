---
import Base from '../layouts/Base.astro';
import { type Lang } from '../lib/config';
import type { DocSection } from '../lib/docs';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  sidebar: DocSection[];
  currentId: string;
  toc: { depth: number; slug: string; text: string }[];
  prev?: { title: string; href: string } | null;
  next?: { title: string; href: string } | null;
  alt?: string;
}
const { lang, title, description = '', sidebar, currentId, toc, prev, next, alt } = Astro.props;
const zh = lang !== 'en';
---

<Base title={title} description={description} lang={lang} alt={alt} maxWidth="1240px">
  <div class="docs">
    <aside class="docs-side" aria-label={zh ? '文档导航' : 'Docs navigation'}>
      {sidebar.map((section: any) => (
        <div class="side-sec">
          <p class="side-h">{section.title}</p>
          <ul>
            {section.items.map((item: any) => (
              <li>
                <a href={item.href} aria-current={item.id === currentId ? 'page' : undefined}>
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="side-foot">
        <a href={zh ? '/zh/posts/' : '/posts/'}>{zh ? '教程与笔记' : 'Guides & notes'} →</a>
      </p>
    </aside>

    <article class="docs-main">
      <header class="docs-head">
        <h1>{title}</h1>
        {description && <p class="docs-lede">{description}</p>}
      </header>
      <div class="prose docs-prose">
        <slot />
      </div>
      <nav class="docs-next" aria-label={zh ? '上一篇 / 下一篇' : 'Previous and next'}>
        {prev ? (
          <a class="dn" href={prev.href}>
            <small>{zh ? '上一篇' : 'Previous'}</small>
            <span>← {prev.title}</span>
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a class="dn dn-r" href={next.href}>
            <small>{zh ? '下一篇' : 'Next'}</small>
            <span>{next.title} →</span>
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    </article>

    <aside class="docs-toc" aria-label={zh ? '本页目录' : 'On this page'}>
      {toc.length > 1 && (
        <>
          <p class="toc-h">{zh ? '本页目录' : 'On this page'}</p>
          <ol class="toc-list">
            {toc
              .filter((h: any) => h.depth <= 3)
              .map((h: any) => (
                <li class:list={[{ deep: h.depth === 3 }]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
          </ol>
        </>
      )}
    </aside>
  </div>
</Base>

<script is:inline>
  // Code copy/tabs come from the shared rehype shell; docs no longer inject their own button.
</script>

<style is:global>
  .docs {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 190px;
    column-gap: 48px;
    align-items: start;
    padding-top: 40px;
  }
  .docs-side {
    position: sticky;
    top: 84px;
    max-height: calc(100vh - 110px);
    overflow: auto;
    padding-right: 8px;
    margin-right: -8px;
    overscroll-behavior: contain;
  }
  @supports not selector(::-webkit-scrollbar) {
    .docs-side {
      scrollbar-width: thin;
      scrollbar-color: var(--line) transparent;
    }
  }
  .docs-side::-webkit-scrollbar {
    width: 6px;
  }
  .docs-side::-webkit-scrollbar-track {
    background: transparent;
  }
  .docs-side::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 999px;
  }
  .docs-side:hover::-webkit-scrollbar-thumb,
  .docs-side::-webkit-scrollbar-thumb:hover {
    background: var(--muted);
  }
  .side-sec {
    margin-bottom: 22px;
  }
  .side-h {
    margin: 0 0 8px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .docs-side ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1px;
  }
  .docs-side a {
    display: block;
    padding: 5px 9px;
    border-radius: 7px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--body);
    text-decoration: none;
  }
  .docs-side a:hover {
    background: var(--chip);
    color: var(--ink);
  }
  .docs-side a[aria-current='page'] {
    color: var(--ink);
    font-weight: 580;
    background: var(--chip);
  }
  .side-foot {
    margin: 26px 0 0;
    font-size: 13px;
  }
  .side-foot a {
    padding-left: 9px;
    color: var(--muted);
  }

  .docs-head {
    padding-top: 4px;
  }
  .docs-head h1 {
    margin: 10px 0 0;
    font-size: 34px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 680;
  }
  .docs-lede {
    margin: 12px 0 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--body);
    max-width: 38em;
  }
  .docs-prose {
    margin-top: 28px;
  }
  .docs-prose h2 {
    padding-top: 8px;
  }
  .docs-prose > :first-child {
    margin-top: 0;
  }

  .docs-prose pre {
    position: relative;
  }
  .docs-prose pre [data-copy-code] {
    position: absolute;
    top: 8px;
    right: 8px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--bg);
    color: var(--muted);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .docs-prose pre:hover [data-copy-code],
  .docs-prose pre [data-copy-code]:focus-visible {
    opacity: 1;
  }
  @media (hover: none) {
    .docs-prose pre [data-copy-code] {
      opacity: 1;
    }
  }

  .callout {
    margin: 1.4em 0;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--chip) 55%, transparent);
  }
  .callout > :first-child {
    margin-top: 0;
  }
  .callout > :last-child {
    margin-bottom: 0;
  }
  .callout p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
  }
  .callout.warning {
    border-left-color: #d97706;
  }
  .callout.important {
    border-left-color: #dc2626;
  }

  .docs-toc {
    position: sticky;
    top: 84px;
  }
  .toc-h {
    margin: 0 0 10px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 7px;
  }
  .toc-list a {
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted);
    text-decoration: none;
  }
  .toc-list a:hover {
    color: var(--ink);
  }
  .toc-list li.deep {
    padding-left: 12px;
  }

  .docs-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .dn {
    display: grid;
    gap: 4px;
    text-decoration: none;
  }
  .dn small {
    font-size: 12px;
    color: var(--muted);
  }
  .dn span {
    font-size: 15.5px;
    font-weight: 560;
  }
  .dn-r {
    text-align: right;
  }

  @media (max-width: 1100px) {
    .docs {
      grid-template-columns: 190px minmax(0, 1fr);
      column-gap: 36px;
    }
    .docs-toc {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 24px;
    }
    .docs-side {
      position: static;
      max-height: none;
      border-bottom: 1px solid var(--line);
      padding-right: 0;
      padding-bottom: 16px;
      margin-right: 0;
      margin-bottom: 20px;
    }
    .docs-side ul {
      display: flex;
      flex-wrap: wrap;
      gap: 2px 6px;
    }
    .docs-side a {
      padding: 5px 8px;
      font-size: 13.5px;
    }
    .docs-head h1 {
      font-size: 28px;
    }
    .docs-next {
      grid-template-columns: 1fr;
    }
    .dn-r {
      text-align: left;
    }
  }
</style>
