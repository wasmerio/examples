---
import { pickTrad } from '../lib/trad';
import { toTrad } from '../lib/trad';
import WeatherClock from './WeatherClock.astro';
import { footer, footerColumns, mcp, site, social, type Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang !== 'en';
const path = Astro.url.pathname || '/';
const base = zh ? '/zh' : '';
const to = (href: string) => (href.startsWith('http') ? href : `${base}${href}` || '/');
const cur = (href: string) => {
  const target = to(href);
  return path === target || (target !== '/' && path.startsWith(target)) ? 'page' : undefined;
};
const note = zh ? footer.textZh : footer.text;
const year = new Date().getFullYear();
const copyrightTpl = (zh ? footer.copyrightZh : footer.copyright).trim();
const copyright = (copyrightTpl || '© {year} {name}')
  .replace(/\{year\}/g, String(year))
  .replace(/\{name\}/g, footer.copyrightName);
const socials = social.map((item: any) => ({ ...item, href: to(item.href), external: item.href.startsWith('http') }));

// The MCP page can be switched off in site.config.yaml; its footer link follows.
const columns = footerColumns.map((col: any) => ({
  ...col,
  links: col.links.filter((link: any) => mcp.enabled || link.href !== '/mcp/'),
}));
const art =
  footer.artLight || footer.artDark ? { light: footer.artLight, dark: footer.artDark || footer.artLight } : null;
---

<footer class="foot" data-chrome-s="footer">
  {art && (
    <div class="foot-art" aria-hidden="true">
      <img class="art-light" src={art.light} alt="" width="1600" height="529" loading="lazy" decoding="async" />
      {art.dark !== art.light && (
        <img class="art-dark" src={art.dark} alt="" width="1600" height="529" loading="lazy" decoding="async" />
      )}
    </div>
  )}
  <div class="foot-inner">
    <div class="foot-cols">
      {columns.map((col: any) => (
        <nav>
          <p class="foot-h">{zh ? (lang === 'zh-hant' ? toTrad(col.titleZh) : col.titleZh) : col.title}</p>
          <ul>
            {col.links.map((link: any) => (
              <li>
                <a href={to(link.href)} aria-current={cur(link.href)}>
                  {zh ? (lang === 'zh-hant' ? toTrad(link.labelZh ?? link.label) : (link.labelZh ?? link.label)) : link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="foot-bottom">
      <span class="foot-legal">
        {copyright}
        {footer.authorUrl && (
          <>
            {' '}
            ·{' '}
            <a href={footer.authorUrl} rel="noopener">
              {footer.authorLabel || footer.authorUrl.replace(/^https?:\/\//, '')}
            </a>
          </>
        )}
        {note && <> · {note}</>}
      </span>
      <WeatherClock />
      <span class="foot-soc">
        {socials.map((item: any) => (
          <a
            href={item.href}
            rel={item.external ? 'noopener' : undefined}
            target={item.external ? '_blank' : undefined}
          >
            {item.label}
          </a>
        ))}
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
      </span>
    </div>
    {footer.credit.show && footer.credit.label && (
      <p class="foot-credit">
        {footer.credit.href ? (
          <a href={footer.credit.href} rel="noopener">
            {zh ? footer.credit.labelZh : footer.credit.label}
          </a>
        ) : (
          zh ? footer.credit.labelZh : footer.credit.label
        )}
      </p>
    )}
  </div>
</footer>
<style is:global>
  .foot-legal a {
    color: var(--muted);
  }
  .foot-legal a:hover {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-style: wavy;
    text-decoration-color: var(--u);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }
  .foot-soc {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .foot-soc a {
    color: var(--muted);
    text-decoration: none;
  }
  .foot-soc a:hover {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-style: wavy;
    text-decoration-color: var(--u);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }
  /* Deliberately quiet: a credit, not a badge. */
  .foot-credit {
    margin-top: 20px;
    font-size: 11px;
    line-height: 1.5;
    color: var(--muted);
    opacity: 0.6;
    letter-spacing: 0.01em;
  }
  .foot-credit a {
    color: inherit;
    text-decoration: none;
  }
  .foot-credit a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
