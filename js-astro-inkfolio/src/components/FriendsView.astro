---
import Base from '../layouts/Base.astro';
import friendsRaw from '../data/friends.yaml?raw';
import { parse } from 'yaml';
import { t } from '../i18n/ui';
import type { Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang !== 'en';
const altHref = zh ? '/friends/' : '/zh/friends/';
const friends = parse(friendsRaw) as {
  name: string;
  url: string;
  author: string;
  avatar?: string;
  desc: { en: string; zh: string };
}[];
---

<Base title={t(lang, 'friends')} lang={lang} alt={altHref}>
  <article>
    <section class="hero" style="padding-top:56px">
      <h1>{zh ? '友链' : 'Friends'}</h1>
      <div class="lede" style="max-width:646px;margin-top:14px;font-size:19px;line-height:1.6;color:var(--body)">
        <p>{t(lang, 'friendsLede')}</p>
      </div>
    </section>

    <section style="padding-top:40px;max-width:720px">
      <ul class="friends">
        {friends.map((f: any) => (
          <li>
            <a class="friend" href={f.url} target="_blank" rel="noopener">
              {f.avatar ? (
                <img class="friend-av" src={f.avatar} alt="" width="56" height="56" loading="lazy" decoding="async" />
              ) : (
                <span class="friend-av mono" aria-hidden="true">
                  {f.name.slice(0, 1).toUpperCase()}
                </span>
              )}
              <span class="friend-body">
                <span class="friend-name">{f.name}</span>
                <span class="friend-by">{f.author}</span>
                <span class="friend-desc">{zh ? f.desc.zh : f.desc.en}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="reach-note" style="margin-top:36px">
        {zh ? '想交换友链？' : 'Want to swap links?'}
        <a href={zh ? '/zh/contact/' : '/contact/'}>{zh ? '打个招呼' : 'Say hi'}</a>
      </p>
    </section>
  </article>
</Base>

<style>
  .friends {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
  }
  .friend {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
    height: 100%;
    box-sizing: border-box;
  }
  .friend:hover {
    border-color: var(--ink, currentColor);
    transform: translateY(-2px);
  }
  .friend-av {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    flex: none;
    object-fit: cover;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .friend-av.mono {
    display: grid;
    place-items: center;
    font-size: 22px;
    font-weight: 600;
    color: var(--muted);
  }
  .friend-body {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .friend-name {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
  }
  .friend-by {
    font-size: 13.5px;
    color: var(--muted);
  }
  .friend-desc {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--body);
    margin-top: 4px;
  }
</style>
