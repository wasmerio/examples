---
import { toTrad } from '../lib/trad';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { site, social, langPath, type Lang } from '../lib/config';
import { projects } from '../lib/data';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const postsCollection = lang !== 'en' ? 'postsZh' : 'posts';
const weeklyCollection = lang !== 'en' ? 'weeklyZh' : 'weekly';
const researchCollection = lang !== 'en' ? 'researchZh' : 'research';

const byDate = (a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime();

const posts = (await getCollection(postsCollection as any)).filter((e: any) => !e.data.draft).sort(byDate);
const weekly = (await getCollection(weeklyCollection as any))
  .filter((e: any) => !e.data.draft)
  .sort((a: any, b: any) => b.data.issue - a.data.issue);
const research = (await getCollection(researchCollection as any)).filter((e: any) => !e.data.draft).sort(byDate);

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString(lang !== 'en' ? 'zh-CN' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const greeting =
  (lang !== 'en' ? site.greetingZh : site.greeting) ||
  (lang !== 'en' ? `嗨，我是 ${site.nameZh}。` : `Hey, I'm ${site.name}.`);
const socials = social.map((item: any) => ({
  ...item,
  href:
    item.href.startsWith('http') || item.href.startsWith('mailto:')
      ? item.href
      : lang === 'zh'
        ? `/zh${item.href}`
        : item.href,
}));
const altHref = lang !== 'en' ? '/' : '/zh/';
const liveProjects = projects.filter((p: any) => p.status !== 'archived').slice(0, 2);
---

<Base title={lang !== 'en' ? site.nameZh : site.name} lang={lang} alt={altHref}>
  <section class="home-hero">
    <div>
      <h1>{greeting}</h1>
      <p class="home-sub">{lang === 'zh-hant' ? toTrad(site.taglineZh) : lang !== 'en' ? site.taglineZh : site.tagline}</p>
      <div class="intro prose">
        <p>{lang !== 'en' ? site.descriptionZh : site.description}</p>
      </div>
      <ul class="social">
        {socials.map((item: any) => (
          <li>
            <a class="soc" href={item.href} rel="noopener me">
              <Icon name={item.icon} />
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    {site.avatar && (
      <figure class="portrait">
        <img src={site.avatar} alt={lang !== 'en' ? site.nameZh : site.name} width="208" height="208" />
      </figure>
    )}
  </section>

  <section class="sec">
    <div class="sec-head">
      <h2>{t(lang, 'latestPosts')}</h2>
      <a class="more" href={langPath('/posts/', lang)}>
        {t(lang, 'allPosts')}
      </a>
    </div>
    <div class="sec-body">
      <ul class="rows">
        {posts.slice(0, 5).map((entry: any) => (
          <li>
            <div>
              <a href={langPath(`/posts/${entry.id}/`, lang)}>{entry.data.title}</a>
              {entry.data.description && <p class="tagline">{entry.data.description}</p>}
            </div>
            <time class="meta" datetime={new Date(entry.data.date).toISOString()}>
              {fmt(new Date(entry.data.date))}
            </time>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head">
      <h2>{t(lang, 'weekly')}</h2>
      <a class="more" href={langPath('/weekly/', lang)}>
        {t(lang, 'allPosts')}
      </a>
    </div>
    <div class="sec-body">
      <ul class="rows">
        {weekly.slice(0, 3).map((entry: any) => (
          <li>
            <div>
              <a href={langPath(`/weekly/${entry.id}/`, lang)}>{entry.data.title}</a>
              {entry.data.description && <p class="tagline">{entry.data.description}</p>}
            </div>
            <span class="meta">
              {t(lang, 'issue')} {entry.data.issue}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head">
      <h2>{t(lang, 'research')}</h2>
      <a class="more" href={langPath('/research/', lang)}>
        {t(lang, 'allPosts')}
      </a>
    </div>
    <div class="sec-body">
      <ul class="rows">
        {research.slice(0, 2).map((entry: any) => (
          <li>
            <div>
              <a href={langPath(`/research/${entry.id}/`, lang)}>{entry.data.title}</a>
              {entry.data.description && <p class="tagline">{entry.data.description}</p>}
            </div>
            <time class="meta" datetime={new Date(entry.data.date).toISOString()}>
              {entry.data.type}
            </time>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head">
      <h2>{t(lang, 'projects')}</h2>
      <a class="more" href={langPath('/projects/', lang)}>
        {t(lang, 'allPosts')}
      </a>
    </div>
    <div class="sec-body">
      <div class="build">
        {liveProjects.map((project: any) => (
          <article class="proj">
            <div class="build-top">
              <h3>
                {project.title}
                <small>{project.tag}</small>
              </h3>
            </div>
            <p>{lang !== 'en' ? (project.descZh ?? project.desc) : project.desc}</p>
            <a class="v" href={project.url} target="_blank" rel="noopener">
              {t(lang, 'visit')} →
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head">
      <h2>{t(lang, 'log')}</h2>
      <a class="more" href={langPath('/log/', lang)}>
        {t(lang, 'log')}
      </a>
    </div>
    <div class="sec-body">
      <p class="prose" style="margin-top:0">
        {t(lang, 'logLede')}
      </p>
    </div>
  </section>
</Base>
