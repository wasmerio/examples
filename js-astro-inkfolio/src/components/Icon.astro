---
/**
 * Icons come from Font Awesome Free (solid + brands), bundled locally —
 * no CDN request at runtime. Pass the name without the prefix:
 *   <Icon name="sun" />          → fa-solid fa-sun
 *   <Icon name="github" />       → fa-brands fa-github
 * Anything already starting with "fa-" is passed through untouched.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 16, class: cls = '' } = Astro.props;

const SOLID = new Set([
  'sun',
  'moon',
  'chevron-down',
  'chevron-right',
  'arrow-right',
  'arrow-up',
  'arrow-left',
  'magnifying-glass',
  'search',
  'robot',
  'bot',
  'box',
  'globe',
  'shield',
  'shield-check',
  'coins',
  'flask',
  'link',
  'paper-plane',
  'send',
  'envelope',
  'email',
  'rss',
  'copy',
  'check',
  'xmark',
  'ellipsis',
  'bars',
  'circle-half-stroke',
  'language',
  'pen-nib',
  'terminal',
  'code',
  'database',
  'cloud',
  'clock',
  'calendar',
  'tag',
  'quote-left',
]);

const BRANDS = new Set([
  'github',
  'gitlab',
  'x-twitter',
  'twitter',
  'bluesky',
  'linkedin',
  'mastodon',
  'ethereum',
  'telegram',
  'youtube',
  'reddit',
  'dev',
  'medium',
  'npm',
  'python',
  'js',
  'react',
  'node-js',
  'docker',
  'html5',
  'css3',
  'font-awesome',
  'astro',
]);

const alias: Record<string, string> = {
  search: 'magnifying-glass',
  bot: 'robot',
  send: 'paper-plane',
  email: 'envelope',
  'shield-check': 'shield-halved',
  shield: 'shield-halved',
  x: 'x-twitter',
};

const resolved = alias[name] ?? name;
const classes = name.startsWith('fa-')
  ? name
  : BRANDS.has(resolved)
    ? `fa-brands fa-${resolved}`
    : SOLID.has(resolved)
      ? `fa-solid fa-${resolved}`
      : `fa-solid fa-${resolved}`;
---

<i class={`${classes} ${cls}`.trim()} style={`font-size:${size}px`} aria-hidden="true"></i>
