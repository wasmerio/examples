---
import { pickTrad } from '../lib/trad';
import Base from '../layouts/Base.astro';
import { mcp, site, type Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang !== 'en';
const altHref = zh ? '/mcp/' : '/zh/mcp/';

const endpoint = mcp.endpoint || `https://${new URL(site.url).host}/mcp`;
const total = mcp.sources.reduce((n, s) => n + (s.items ?? 0), 0);

const steps = [
  {
    h: 'Claude Code',
    p: { en: 'One command in your terminal:', zh: '终端里一条命令：' },
    code: `claude mcp add --transport http ${site.name.toLowerCase()} ${endpoint}`,
  },
  {
    h: { en: 'Cursor, Windsurf and other clients', zh: 'Cursor、Windsurf 等客户端' },
    p: {
      en: 'Add this to your MCP config (for Cursor, ~/.cursor/mcp.json):',
      zh: '加进 MCP 配置文件（Cursor 是 ~/.cursor/mcp.json）：',
    },
    code: `{\n  "mcpServers": {\n    "${site.name.toLowerCase()}": { "url": "${endpoint}" }\n  }\n}`,
  },
  {
    h: { en: 'Claude Desktop and claude.ai', zh: 'Claude Desktop 和 claude.ai' },
    p: {
      en: 'Settings → Connectors → Add custom connector, then paste:',
      zh: '设置 → Connectors → Add custom connector，粘贴：',
    },
    code: endpoint,
  },
];

const CURL = `curl ${endpoint} \\\n  -H 'content-type: application/json' \\\n  -H 'accept: application/json, text/event-stream' \\\n  -d '{"jsonrpc":"2.0","id":1,"method":"tools/call",\n       "params":{"name":"search","arguments":{"query":"theme"}}}'`;
---

{mcp.enabled ? (
  <Base title={zh ? pickTrad(lang, '通过 MCP 连接') : 'Connect via MCP'} lang={lang} alt={altHref}>
    <article>
      <section class="hero mcp-hero">
        <h1>{zh ? pickTrad(lang, '通过 MCP 连接') : 'Connect via MCP'}</h1>
        <div class="mcp-lede">
          <p>
            {zh
              ? `${mcp.sources.length} 个内容源共用一个 MCP 端点。接进你的 AI 客户端，agent 就能直接搜索和读取 ${total} 篇内容，不用截图也不用爬页。`
              : `${mcp.sources.length} sources share one MCP endpoint. Add it to your AI client and the agent can search and read ${total} documents directly — no screenshots, no scraping.`}
          </p>
          <p>{zh ? pickTrad(lang, '只读，不用注册，不用 API key。') : 'Read-only. No sign-up, no API key.'}</p>
        </div>
        <div class="cblock end">
          <pre>{endpoint}</pre>
          <button type="button" data-copy>
            {zh ? pickTrad(lang, '复制') : 'Copy'}
          </button>
        </div>
      </section>

      <section class="blk">
        <h2>{zh ? pickTrad(lang, '怎么连接') : 'How to connect'}</h2>
        <ol class="steps">
          {steps.map((s: any) => (
            <li>
              <h3>{typeof s.h === 'string' ? s.h : s.h[zh ? 'zh' : 'en']}</h3>
              <p>{s.p[zh ? 'zh' : 'en']}</p>
              <div class="cblock">
                <pre>{s.code}</pre>
                <button type="button" data-copy>
                  {zh ? pickTrad(lang, '复制') : 'Copy'}
                </button>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="blk">
        <div class="blk-head">
          <h2>{zh ? pickTrad(lang, '可用工具') : 'Available tools'}</h2>
          <span class="note">{mcp.tools.length}</span>
        </div>
        <ul class="rows">
          {mcp.tools.map((tool: any) => (
            <li>
              <h3 class="tname">
                <code>
                  {tool.name}
                  {tool.args ? `(${tool.args})` : '()'}
                </code>
              </h3>
              <p>{zh ? tool.desc.zh : tool.desc.en}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="blk">
        <div class="blk-head">
          <h2>{zh ? pickTrad(lang, '接入的站点') : 'Connected sites'}</h2>
          <span class="note">
            {mcp.sources.length}
            {total ? ` · ${total} ${zh ? pickTrad(lang, '篇') : 'docs'}` : ''}
          </span>
        </div>
        <ul class="rows sites">
          {mcp.sources.map((s: any) => (
            <li>
              <span class="host">{s.host}</span>
              <span class="sdesc">{zh ? s.desc.zh : s.desc.en}</span>
              <span class="num">{s.items ?? '—'}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="blk">
        <h2>{zh ? pickTrad(lang, '先用 curl 试试') : 'Try it with curl'}</h2>
        <div class="cblock">
          <pre>{CURL}</pre>
          <button type="button" data-copy>
            {zh ? pickTrad(lang, '复制') : 'Copy'}
          </button>
        </div>
        <p class="reach-note" style="margin-top:40px">
          {zh ? pickTrad(lang, '想把你的站也接进来，或者发现了问题？') : 'Want your site in the hub, or found a problem?'}
          <a href={zh ? '/zh/contact/' : '/contact/'}>{zh ? pickTrad(lang, '打个招呼') : 'Say hi'}</a>
        </p>
      </section>
    </article>
  </Base>
) : (
  <Base title={zh ? pickTrad(lang, 'MCP 未启用') : 'MCP is not enabled'} lang={lang} noindex>
    <section class="post-head">
      <h1>{zh ? pickTrad(lang, 'MCP 未启用') : 'MCP is not enabled'}</h1>
      <p class="post-lede">
        {zh
          ? '这个站点没有开启 MCP 页面。要打开，在 site.config.yaml 里把 mcp.enabled 改成 true 并填上 endpoint，不需要改代码。'
          : 'This site has not turned the MCP page on. To enable it, set mcp.enabled to true in site.config.yaml and fill in the endpoint — no code changes.'}
      </p>
      <p style="margin-top:20px">
        <a class="btn" href={zh ? '/zh/' : '/'}>
          {zh ? pickTrad(lang, '回首页') : 'Back home'}
        </a>
      </p>
    </section>
  </Base>
)}

<script is:inline>
  document.querySelectorAll('[data-copy]').forEach(function (b) {
    b.addEventListener('click', function () {
      var el = b.previousElementSibling;
      var text = el ? el.textContent || '' : '';
      var done = function () {
        var o = b.textContent;
        b.textContent = '✓';
        setTimeout(function () {
          b.textContent = o;
        }, 1400);
      };
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, function () {});
    });
  });
</script>

<style>
  .mcp-hero {
    padding-top: 88px;
  }
  .mcp-lede {
    display: grid;
    gap: 14px;
    margin-top: 14px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--body);
    max-width: 34em;
  }
  .mcp-lede p {
    margin: 0;
  }
  .cblock {
    position: relative;
    margin-top: 12px;
    max-width: 46em;
  }
  .cblock.end {
    margin-top: 28px;
    max-width: 34em;
  }
  .cblock pre {
    margin: 0;
    padding: 14px 72px 14px 16px;
    font-family: var(--mono);
    font-size: 13.5px;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
    background: var(--chip, color-mix(in srgb, var(--line) 45%, transparent));
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
  }
  .cblock button {
    position: absolute;
    top: 9px;
    right: 9px;
    font: inherit;
    font-size: 12.5px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: inherit;
    cursor: pointer;
  }
  .cblock button:hover {
    border-color: var(--ink);
  }
  .blk {
    padding-top: 96px;
  }
  .blk h2 {
    margin: 0 0 18px;
    font-size: 27px;
    line-height: 1.15;
    font-weight: 640;
    letter-spacing: -0.025em;
  }
  .blk-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 18px;
  }
  .blk-head h2 {
    margin: 0;
  }
  .note {
    font-size: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: s;
  }
  .steps li {
    counter-increment: s;
    position: relative;
    padding: 24px 0 24px 44px;
    border-top: 1px solid var(--line);
  }
  .steps li::before {
    content: counter(s);
    position: absolute;
    left: 0;
    top: 24px;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    font-size: 13.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .steps h3 {
    margin: 0;
    font-size: 19px;
    line-height: 1.35;
    font-weight: 640;
    letter-spacing: -0.015em;
  }
  .steps p {
    margin: 8px 0 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--body);
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows li {
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .rows li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .tname {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
  }
  .tname code {
    font-family: var(--mono);
  }
  .rows p {
    margin: 6px 0 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--body);
    max-width: 38em;
  }
  .sites li {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) auto;
    column-gap: 24px;
    align-items: baseline;
    padding: 16px 0;
  }
  .host {
    font-weight: 600;
    font-size: 16px;
  }
  .sdesc {
    font-size: 15.5px;
    color: var(--body);
  }
  .num {
    font-size: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 900px) {
    .mcp-hero {
      padding-top: 36px;
    }
    .mcp-lede {
      font-size: 17.5px;
    }
    .blk {
      padding-top: 72px;
    }
    .blk h2 {
      font-size: 24px;
    }
    .sites li {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 4px;
    }
    .sdesc {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
