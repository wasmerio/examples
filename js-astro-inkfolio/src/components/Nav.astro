---
import { pickTrad } from '../lib/trad';
import { toTrad } from '../lib/trad';
import { siteText } from '../lib/config';
import { navLabel } from '../lib/config';
import { availableLangs } from '../lib/langs';
import Icon from './Icon.astro';
import { nav, navCta, site, mcp, type Lang, type NavLeaf } from '../lib/config';

interface Props {
  lang: Lang;
  /** counterpart page path, when one exists */
  alt?: string;
}
const { lang, alt } = Astro.props;

const zh = lang !== 'en';
const hant = lang === 'zh-hant';
const zhLabel = (v?: string | null) => (v ? (hant ? toTrad(v) : v) : null);
const currentHreflang = lang === 'zh-hant' ? 'zh-Hant' : lang === 'zh' ? 'zh-Hans' : 'en';
const path = Astro.url.pathname || '/';
const base = zh ? '/zh' : '';
const to = (href: string) => (href.startsWith('http') ? href : `${base}${href}` || '/');
const cur = (href: string) => {
  const target = to(href);
  return path === target || (target !== '/' && path.startsWith(target)) ? 'page' : undefined;
};
const label = (item: NavLeaf) => navLabel(item as any, lang);
const sub = (item: NavLeaf) => (zh ? (item.subZh ?? item.sub ?? null) : (item.sub ?? null));

// Hide a whole group when none of its children has a Chinese label.
const items = nav
  .map((item: any) => {
    if (item.items) {
      const children = item.items
        .map((child: any) => ({ ...child, shown: label(child) !== null && (mcp.enabled || child.href !== '/mcp/') }))
        .filter((child: any) => child.shown);
      return { ...item, children };
    }
    return { ...item, children: null };
  })
  .filter((item: any) =>
    item.children
      ? item.children.length > 0 && label(item) !== null
      : label(item) !== null && (mcp.enabled || item.href !== '/mcp/'),
  );

const groupActive = (children: { href: string }[] | null) =>
  !!children?.some((child) => path.startsWith(to(child.href)));
const altHref = alt && alt !== path ? alt : null;
---

<nav class="nav" data-chrome-s="nav">
  <div class="nav-inner" style="position:relative">
    <a href={zh ? '/zh/' : '/'} class="brand" aria-label={siteText('name', lang)}>
      <svg class="brand-mark" viewBox="0 0 64 64" width="26" height="26" aria-hidden="true">
        <rect width="64" height="64" rx="14" />
        <path d="M25 44V24M34 44V18M43 44V30" />
        <circle cx="43" cy="19" r="4.6" />
      </svg>
      <span>{siteText('name', lang)}</span>
    </a>

    <div class="nav-links">
      {items.map((item: any) =>
        item.children ? (
          <details>
            <summary aria-current={groupActive(item.children) ? 'page' : undefined}>
              {label(item)} <Icon name="chevron-down" size={13} class="chev" />
            </summary>
            <ul class="dd">
              {item.children.map((child: any) => (
                <li>
                  <a href={to(child.href)} aria-current={cur(child.href)}>
                    <b>{label(child)}</b>
                    {sub(child) && <small>{sub(child)}</small>}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ) : (
          <a href={to(item.href)} aria-current={cur(item.href)}>
            {label(item)}
          </a>
        ),
      )}
    </div>

    {altHref && (
      <details class="lang-menu">
        <summary class="icon-btn lang-toggle" aria-label={zh ? pickTrad(lang, '切换语言') : 'Language'} title={zh ? pickTrad(lang, '切换语言') : 'Language'}>
          <i class="fa-solid fa-language" style="font-size:17px" aria-hidden="true"></i>
        </summary>
        <ul class="lang-list">
          {availableLangs().map((l) => (
            l.hreflang === currentHreflang ? (
              <li><a class="is-current" href={Astro.url.pathname} aria-current="page">{zh ? l.label : l.labelEn}</a></li>
            ) : (
              <li>
                <a
                  href={l.prefix}
                  data-switch-lang={l.hreflang}
                  data-prefix={l.prefix}
                  data-home={l.prefix}
                  hreflang={l.hreflang}
                  lang={l.hreflang}
                >{zh ? l.label : l.labelEn}</a>
              </li>
            )
          ))}
        </ul>
      </details>
    )}
    <a
      class="icon-btn search-btn"
      href={zh ? '/zh/search/' : '/search/'}
      aria-label={zh ? pickTrad(lang, '搜索') : 'Search'}
      title={zh ? pickTrad(lang, '搜索') : 'Search'}
    >
      <Icon name="magnifying-glass" size={16} />
    </a>
    <button class="icon-btn theme-toggle" id="themeToggle" aria-label={zh ? pickTrad(lang, '切换主题') : 'Toggle theme'}>
      <Icon name="sun" size={17} class="ic-sun" />
      <Icon name="moon" size={17} class="ic-moon" />
    </button>
    {navCta.href && (
      <a class="nav-cta" href={to(navCta.href)}>
        {zh ? zhLabel(navCta.labelZh) : navCta.label}
      </a>
    )}
    <button class="icon-btn menu-btn" id="menuBtn" aria-label={zh ? pickTrad(lang, '菜单') : 'Menu'}>
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <ul class="m-panel" id="mPanel" hidden>
      {items.map((item: any) =>
        item.children ? (
          <>
            <li>
              <span class="grp">{label(item)}</span>
            </li>
            {item.children.map((child: any) => (
              <li class="m-sub">
                <a href={to(child.href)}>{label(child)}</a>
              </li>
            ))}
          </>
        ) : (
          <li>
            <a href={to(item.href)}>{label(item)}</a>
          </li>
        ),
      )}
      {navCta.href && (
        <li>
          <a href={to(navCta.href)} class="m-cta">
            {zh ? zhLabel(navCta.labelZh) : navCta.label}
          </a>
        </li>
      )}
    </ul>
  </div>
</nav>
<style is:global>
  .theme-toggle .ic-sun {
    display: none;
  }
  .theme-toggle .ic-moon {
    display: block;
  }
  :root[data-theme='dark'] .theme-toggle .ic-sun {
    display: block;
  }
  :root[data-theme='dark'] .theme-toggle .ic-moon {
    display: none;
  }
  .lang-toggle {
    font-size: 12.5px;
    font-weight: 640;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .nav-links .chev {
    transition: transform 0.25s ease;
  }
  .nav-links details[open] .chev {
    transform: rotate(180deg);
  }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 15px;
    border-radius: 10px;
    background: var(--btn);
    color: var(--btn-ink);
    font-size: 13.5px;
    font-weight: 580;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-cta:hover {
    background: var(--accent);
  }
  @media (max-width: 1020px) {
    .nav-cta {
      display: none;
    }
  }
  .m-panel .m-cta {
    font-weight: 600;
    color: var(--accent);
  }
  @media (min-width: 861px) {
    .m-panel .m-cta {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .lang-toggle {
      display: none;
    }
  }
  .lang-menu { position: relative; }
  .lang-menu summary { list-style: none; cursor: pointer; }
  .lang-menu summary::-webkit-details-marker { display: none; }
  .lang-list { position: absolute; right: 0; top: calc(100% + 10px); min-width: 156px; z-index: 60;
    margin: 0; padding: 5px; list-style: none; background: var(--bg); border: 1px solid var(--line);
    border-radius: 10px; box-shadow: 0 8px 24px rgb(0 0 0 / .10); }
  .lang-list a { display: block; text-decoration: none; padding: 7px 10px; border-radius: 7px; font-size: 13.5px; color: var(--ink); }
  .lang-list a:hover, .lang-list a:focus-visible { background: var(--chip); }
  .lang-list a.is-current { color: var(--accent, #ff6b01); text-decoration: underline wavy var(--accent, #ff6b01); text-decoration-thickness: 1.5px; text-underline-offset: 4px; }
</style>
<script is:inline>
  (function () {
    var root = document.documentElement;
    var t = document.getElementById('themeToggle');
    function setTheme(mode) {
      if (mode === 'dark') root.setAttribute('data-theme', 'dark');
      else root.removeAttribute('data-theme');
      try {
        localStorage.setItem('inkfolio-theme', mode);
      } catch {}
    }
    if (t)
      t.addEventListener('click', function () {
        setTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      });
    var mb = document.getElementById('menuBtn'),
      mp = document.getElementById('mPanel');
    if (mb && mp)
      mb.addEventListener('click', function (e) {
        e.stopPropagation();
        mp.hidden = !mp.hidden;
      });
    document.addEventListener('click', function (e) {
      if (mp && !mp.hidden && !mp.contains(e.target) && e.target !== mb) mp.hidden = true;
    });
    document.querySelectorAll('.nav-links details').forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (d.open)
          document.querySelectorAll('.nav-links details').forEach(function (o) {
            if (o !== d) o.open = false;
          });
      });
    });
    document.addEventListener('click', function (e) {
      document.querySelectorAll('.nav-links details').forEach(function (d) {
        if (d.open && !d.contains(e.target)) d.open = false;
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape')
        document.querySelectorAll('.nav-links details').forEach(function (d) {
          d.open = false;
        });
    });
  })();

  // Language switch keeps you on the same page when that page exists in the
  // target language, and falls back to that language's home when it does not.
  document.querySelectorAll('[data-switch-lang]').forEach((a) => {
    a.addEventListener('click', async (event) => {
      const el = a;
      const prefix = el.dataset.prefix || '/';
      const here = location.pathname;
      let rest = here.replace(/^\/(zh|zh-Hant)(?=\/)/, '');
      if (!rest.startsWith('/')) rest = '/' + rest;
      const candidate = prefix === '/' ? rest : prefix.replace(/\/$/, '') + rest;
      if (candidate === here) return;
      event.preventDefault();
      try {
        const res = await fetch(candidate, { method: 'HEAD' });
        location.href = res.ok ? candidate : (el.dataset.home || prefix);
      } catch {
        location.href = el.dataset.home || prefix;
      }
    });
  });
</script>
