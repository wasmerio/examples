---
import { pickTrad } from '../lib/trad';
import Base from '../layouts/Base.astro';
import { covers } from '../lib/config';
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../lib/config';

interface Props {
  lang: Lang;
  page: number;
  totalPages: number;
  entries: { id: string; title: string; description: string; date: Date; tags: string[] }[];
  total: number;
}
const { lang, page, totalPages, entries, total } = Astro.props;
const zh = lang !== 'en';
const base = zh ? '/zh/posts/' : '/posts/';
const hrefFor = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
const altHref = zh ? '/posts/' : '/zh/posts/';
const fmt = (d: Date) =>
  new Date(d).toLocaleDateString(zh ? 'zh-CN' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

// Page numbers with ellipses: 1 … 4 5 6 … 12
const numbers: (number | '…')[] = [];
for (let n = 1; n <= totalPages; n++) {
  if (n === 1 || n === totalPages || Math.abs(n - page) <= 1) numbers.push(n);
  else if (numbers[numbers.length - 1] !== '…') numbers.push('…');
}
---

<Base
  title={page > 1 ? `${t(lang, 'allPosts')} — ${page}` : t(lang, 'posts')}
  lang={lang}
  alt={page === 1 ? altHref : undefined}
>
  <section class="art-head">
    <h1>{zh ? pickTrad(lang, '文章') : 'Posts'}</h1>
    <p class="meta">
      <span class="pf-count">
        {total} {zh ? pickTrad(lang, '篇') : 'posts'}
      </span>
      {zh
        ? '关于建站、SEO、Cloudflare 和 AI agent 的长文与笔记。'
        : 'Build notes and essays on SEO, Cloudflare, self-hosting and AI agents.'}
    </p>
  </section>

  <h2 class="pf-sr">{zh ? pickTrad(lang, '全部文章') : 'All posts'}</h2>

  <ul class="pf-list">
    {entries.map((entry: any) => (
      <li class={`pf-row${entry.pinned ? ' pf-row-pin' : ''}`}>
        <article class={`pf-item${entry.cover ? '' : ' noimg'}${entry.pinned ? ' pf-item-pin' : ''}`}>
          {covers.list && entry.cover && <img class="pf-cover" src={entry.cover} alt={entry.coverAlt ?? ''} loading="lazy" decoding="async" />}
          <div class="pf-body">
            <h3 class="pf-rt">
              {entry.pinned && (
                <span class="pf-pin" title={zh ? '置顶' : 'Pinned'} aria-label={zh ? '置顶' : 'Pinned'}>
                  <i class="fa-solid fa-thumbtack" style="font-size:15px" aria-hidden="true"></i>
                </span>
              )}
              <a href={`${base}${entry.id}/`}>{entry.title}</a>
            </h3>
            {entry.description && <p class="pf-desc">{entry.description}</p>}
            <p class="pf-meta">
              {fmt(entry.date)}
              {entry.tags.length > 0 && <> · {entry.tags[0]}</>}
            </p>
          </div>
        </article>
      </li>
    ))}
  </ul>

  {totalPages > 1 && (
    <nav class="pf-pager" aria-label={zh ? pickTrad(lang, '分页') : 'Pagination'}>
      {page > 1 && (
        <a class="pg-step" href={hrefFor(page - 1)} rel="prev" aria-label={zh ? pickTrad(lang, '上一页') : 'Previous page'}>
          <Icon name="arrow-left" size={14} />
        </a>
      )}
      {numbers.map((n: any) =>
        n === '…' ? (
          <span class="pg-gap">…</span>
        ) : (
          <a class="pg-num" href={hrefFor(n)} aria-current={n === page ? 'page' : undefined}>
            {n}
          </a>
        ),
      )}
      {page < totalPages && (
        <a class="pg-step" href={hrefFor(page + 1)} rel="next" aria-label={zh ? pickTrad(lang, '下一页') : 'Next page'}>
          <Icon name="arrow-right" size={14} />
        </a>
      )}
    </nav>
  )}
</Base>

<style is:global>
  .pf-list {
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .pf-row {
    border-top: 1px solid var(--line);
  }
  .pf-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .pf-item {
    display: block;
    padding: 20px 0;
  }
  .pf-rt {
    margin: 0;
    font-size: 19px;
    line-height: 1.35;
    font-weight: 620;
    letter-spacing: -0.01em;
  }
  .pf-rt a {
    color: var(--ink);
  }
  .pf-desc {
    margin: 6px 0 0;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--body);
    max-width: 40em;
  }
  .pf-meta {
    margin: 8px 0 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .pf-pager {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 44px;
  }
  .pf-pager a {
    display: inline-grid;
    place-items: center;
    min-width: 34px;
    height: 34px;
    padding: 0 8px;
    border-radius: 9px;
    font-size: 14px;
    color: var(--body);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .pf-pager a:hover {
    background: var(--chip);
    color: var(--ink);
  }
  .pf-pager a[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
    font-weight: 580;
  }
  .pg-gap {
    color: var(--faint);
    padding: 0 4px;
  }
.pf-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
:global(.pf-cover) { display:block; width:100%; max-width:100%; height:auto; max-height:260px; object-fit:contain;
  background:var(--chip); border-radius:10px; margin:0 0 16px; }
</style>
