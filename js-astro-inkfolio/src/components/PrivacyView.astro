---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { type Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang !== 'en';
const entry = await getEntry('pages', zh ? 'privacy-zh' : 'privacy');
if (!entry) throw new Error('Missing privacy page content (src/content/pages/privacy(-zh).md)');
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description} lang={lang} alt={zh ? '/privacy/' : '/zh/privacy/'}>
  <article>
    <header class="post-head">
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p class="post-lede">{entry.data.description}</p>}
    </header>
    <div class="post-body">
      <div class="post-main prose">
        <Content />
      </div>
    </div>
    <div class="post-end">
      <a class="backlink" href={zh ? '/zh/' : '/'}>
        ← {zh ? '回首页' : 'Back home'}
      </a>
    </div>
  </article>
</Base>
