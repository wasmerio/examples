---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang !== 'en';
const altHref = zh ? '/projects/' : '/zh/projects/';

// Demo content — swap the three arrays below for your own.
const products = [
  {
    name: 'Pocket Ledger',
    tag: zh ? '副业项目' : 'Side project',
    url: 'https://example.com/pocket-ledger',
    host: 'example.com',
    desc: zh
      ? '给自由职业者的极简复式记账工具。一个 SQLite 文件、可导出 CSV，从不要求银行登录。'
      : 'A tiny double-entry bookkeeping app for freelancers. One SQLite file, CSV export, never asks for a bank login.',
    out: zh ? '里面有什么' : 'What it ships',
    items: zh
      ? ['复式记账，离线优先', 'CSV 导入导出', '单文件数据库']
      : ['Double-entry, offline first', 'CSV import and export', 'Single-file database'],
  },
  {
    name: 'Field Notes',
    tag: zh ? '邮件通讯' : 'Newsletter',
    url: 'https://example.com/field-notes',
    host: 'example.com',
    desc: zh
      ? '每周一封，记录做小产品的过程：什么有用、什么坏了，以及对应的数字。'
      : 'Weekly notes on shipping small software — what worked, what broke, and the numbers behind both.',
    out: zh ? '里面有什么' : 'What it ships',
    items: zh ? ['每周一封', '真实数据', '不卖课'] : ['One email a week', 'Real numbers', 'No course upsell'],
  },
];

const oss = [
  {
    name: 'inkfolio',
    url: 'https://github.com/respectevery01/inkfolio',
    stars: null,
    desc: zh ? '这个主题本身。GPL-3.0，可直接拿去改。' : 'This theme. GPL-3.0, fork it and change it.',
    tags: ['Astro', 'GPL-3.0', 'Theme'],
  },
];

const fun = [
  {
    name: 'Valdos',
    tag: zh ? '原创科幻' : 'Original sci-fi',
    url: 'https://valdos.xyz',
    host: 'valdos.xyz',
    desc: zh
      ? '原创科幻小说《褐星》，完结免费，配档案与完整世界观。'
      : 'An original sci-fi novel — complete, free, with a codex and worldbuilding.',
    out: zh ? '里面有什么' : 'What it ships',
    items: zh ? ['19 章完结', '27 条档案', '中英双语'] : ['19 chapters, complete', '27-entry codex', 'Bilingual'],
  },
];

const pages = 45;
const stats = zh
  ? [
      { k: '这个主题构建出的页面', v: String(pages) },
      { k: '语言', v: '2' },
      { k: '配置文件', v: '1' },
      { k: '构建耗时', v: '~1.7s' },
    ]
  : [
      { k: 'Pages this theme builds', v: String(pages) },
      { k: 'Languages', v: '2' },
      { k: 'Config files', v: '1' },
      { k: 'Build time', v: '~1.7s' },
    ];
---

<Base title={t(lang, 'projects')} lang={lang} alt={altHref}>
  <article class="projects">
    <section class="hero" style="padding-top:56px">
      <h1>{zh ? '项目' : 'Projects'}</h1>
      <div class="lede" style="max-width:646px;margin-top:14px;font-size:19px;line-height:1.6;color:var(--body)">
        <p>{t(lang, 'projectsLede')}</p>
      </div>
      <dl class="reach">
        {stats.map((s: any) => (
          <div>
            <dt>{s.k}</dt>
            <dd>{s.v}</dd>
          </div>
        ))}
      </dl>
      <p class="reach-note">
        {zh ? '数字取自本仓库最近一次构建。' : 'Numbers from the last build of this repository.'}
      </p>
      <ul class="contents">
        <li>
          <a href="#run">
            {zh ? '在做的' : 'What I run'}
            <span>{products.length}</span>
          </a>
        </li>
        <li>
          <a href="#oss">
            {zh ? '开源' : 'Open source'}
            <span>{oss.length}</span>
          </a>
        </li>
        <li>
          <a href="#fun">
            {zh ? '玩票' : 'Fun'}
            <span>{fun.length}</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="group" id="run">
      <div class="group-head">
        <h2>{zh ? '在做的' : 'What I run'}</h2>
        <span class="count">{products.length}</span>
      </div>
      {products.map((p: any) => (
        <div class="tool">
          <div>
            <div class="who">
              <span class="logo" style="background:var(--chip)">
                {p.name.slice(0, 1)}
              </span>
              <h3>
                <a href={p.url} target="_blank" rel="noopener">
                  {p.name}
                </a>
                <small>{p.tag}</small>
              </h3>
            </div>
            <p>{p.desc}</p>
            <p class="go">
              <a href={p.url} target="_blank" rel="noopener">
                {p.host}
              </a>
            </p>
          </div>
          <div class="out">
            <p class="out-h">
              {p.out} — <strong>{p.items.length}</strong>
            </p>
            <ul class="tags">
              {p.items.map((i: any) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </section>

    <section class="group" id="oss">
      <div class="group-head">
        <h2>{zh ? '开源' : 'Open source'}</h2>
        <span class="count">{oss.length}</span>
      </div>
      {oss.map((o: any) => (
        <div class="tool">
          <div>
            <div class="who">
              <span class="logo" style="background:var(--chip);color:var(--ink)">
                <Icon name="github" size={22} />
              </span>
              <h3>
                <a href={o.url} target="_blank" rel="noopener">
                  {o.name}
                </a>
                <small>{o.stars != null ? `★ ${o.stars}` : 'GitHub'}</small>
              </h3>
            </div>
            <p>{o.desc}</p>
            <p class="go">
              <a href={o.url} target="_blank" rel="noopener">
                GitHub
              </a>
            </p>
          </div>
          <div class="out">
            <p class="out-h">{zh ? '技术栈' : 'Stack'}</p>
            <ul class="tags">
              {o.tags.map((tag: any) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </section>

    <section class="group" id="fun">
      <div class="group-head">
        <h2>{zh ? '玩票' : 'Fun'}</h2>
        <span class="count">{fun.length}</span>
      </div>
      {fun.map((p: any) => (
        <div class="tool">
          <div>
            <div class="who">
              <span class="logo" style="background:var(--chip)">
                {p.name.slice(0, 1)}
              </span>
              <h3>
                <a href={p.url} target="_blank" rel="noopener">
                  {p.name}
                </a>
                <small>{p.tag}</small>
              </h3>
            </div>
            <p>{p.desc}</p>
            <p class="go">
              <a href={p.url} target="_blank" rel="noopener">
                {p.host}
              </a>
            </p>
          </div>
          <div class="out">
            <p class="out-h">
              {p.out} — <strong>{p.items.length}</strong>
            </p>
            <ul class="tags">
              {p.items.map((i: any) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </section>
  </article>
</Base>
