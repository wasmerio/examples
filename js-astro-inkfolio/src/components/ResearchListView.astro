---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import type { Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang !== 'en';
const altHref = zh ? '/research/' : '/zh/research/';

const collection = zh ? 'researchZh' : 'research';
const articles = (await getCollection(collection as 'research' | 'researchZh'))
  .filter((e: any) => !e.data.draft)
  .sort((a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const fmtDate = (d: Date) => d.toISOString().slice(0, 10);

// Demo research areas. Add or remove entries; each takes the write-ups above.
const areas = [
  {
    id: 'analytics',
    icon: 'search',
    name: { en: 'Traffic and analytics', zh: '流量与统计' },
    q: { en: 'How much of a small site’s traffic is actually people?', zh: '小站流量里到底有多少是真人？' },
    blurb: {
      en: 'Everything I measure on my own sites, including the parts that make the numbers look worse: bots, preview crawlers, and reporting that hides them.',
      zh: '我在自己站上量到的一切，包括那些让数字变难看的部分：机器人、预览抓取，以及把这两者藏起来的报表。',
    },
  },
  {
    id: 'costs',
    icon: 'coins',
    name: { en: 'Running costs', zh: '运行成本' },
    q: {
      en: 'What does a one-person product line actually cost per year?',
      zh: '一个人撑一条产品线，一年到底花多少？',
    },
    blurb: {
      en: 'Invoices, not estimates: domains, hosting, storage, email, and the model calls that are worth paying for.',
      zh: '看账单不看估算：域名、托管、存储、邮件，以及那些值这个钱的模型调用。',
    },
  },
];

const readsFor = (id: string) =>
  articles
    .filter(
      (entry: any) => (entry.data.tags ?? []).map((t: any) => t.toLowerCase()).includes(id) || articles.length <= 2,
    )
    .map((entry: any) => ({
      title: entry.data.title,
      href: zh ? `/zh/research/${entry.id}/` : `/research/${entry.id}/`,
      method: entry.data.type,
      date: new Date(entry.data.date),
    }));
---

<Base title={zh ? '研究' : 'Research'} lang={lang} alt={altHref}>
  <article>
    <section class="hero rs-hero">
      <h1>{zh ? '研究' : 'Research'}</h1>
      <div class="rs-lede">
        {zh ? (
          <>
            <p>长一点的调查：拆解、账单和方法笔记。都来自我自己跑过的东西，或者一行一行读过的源码。</p>
            <p>项目方的说法会标出来，没验证的不当结论。</p>
          </>
        ) : (
          <>
            <p>
              Longer investigations — teardowns, ledgers and method notes. Everything here comes from something I ran
              myself, or read line by line in the source.
            </p>
            <p>Vendor claims are labelled as such. Nothing unverified gets called a finding.</p>
          </>
        )}
      </div>
    </section>

    <section class="blk">
      <div class="blk-head">
        <h2>{zh ? '方向' : 'Areas'}</h2>
        <span class="note">{zh ? `${areas.length} 个` : `${areas.length} tracked`}</span>
      </div>
      <ul class="eng-list">
        {areas.map((a: any) => (
          <li class="eng" id={a.id}>
            <div>
              <h3 class="eng-id">
                <Icon name={a.icon} size={26} class="eng-ic" />
                {a.name[zh ? 'zh' : 'en']}
              </h3>
              <p class="eng-meta">
                {readsFor(a.id).length
                  ? zh
                    ? `${readsFor(a.id).length} 篇`
                    : `${readsFor(a.id).length} write-ups`
                  : zh
                    ? '即将发布'
                    : 'Coming soon'}
              </p>
            </div>
            <div>
              <p class="eng-q">{a.q[zh ? 'zh' : 'en']}</p>
              <p class="eng-blurb">{a.blurb[zh ? 'zh' : 'en']}</p>
              {readsFor(a.id).length > 0 && (
                <div class="reads">
                  <h4>{zh ? `拆解 · ${readsFor(a.id).length} 篇` : `Teardowns · ${readsFor(a.id).length}`}</h4>
                  <ul>
                    {readsFor(a.id).map((x: any) => (
                      <li>
                        <a class="read" href={x.href}>
                          <span class="read-body">
                            <span class="read-title">{x.title}</span>
                            <span class="read-meta">
                              <time datetime={fmtDate(x.date)}>{fmtDate(x.date)}</time> · {x.method}
                            </span>
                          </span>
                          <Icon name="arrow-right" size={18} class="read-arrow" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
      <p class="reach-note" style="margin-top:48px">
        {zh
          ? '在做类似的研究，或者想让我拆某个工具？'
          : 'Working on something similar, or want me to take a tool apart?'}
        <a href={zh ? '/zh/contact/' : '/contact/'}>{zh ? '打个招呼' : 'Say hi'}</a>
      </p>
    </section>
  </article>
</Base>

<style>
  .rs-hero {
    padding-top: 88px;
  }
  .rs-lede {
    display: grid;
    gap: 14px;
    margin-top: 14px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--body);
    max-width: 34em;
  }
  .rs-lede p {
    margin: 0;
  }
  .blk {
    padding-top: 96px;
  }
  .blk-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 18px;
  }
  .blk-head h2 {
    margin: 0;
    font-size: 27px;
    line-height: 1.15;
    font-weight: 640;
    letter-spacing: -0.025em;
  }
  .note {
    font-size: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .eng-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .eng {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    column-gap: 48px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  .eng:last-child {
    border-bottom: 1px solid var(--line);
  }
  .eng-id {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: 19px;
    line-height: 1.2;
    font-weight: 640;
    letter-spacing: -0.015em;
  }
  .eng-id :global(.eng-ic) {
    flex: none;
    color: var(--accent);
  }
  .eng-meta {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .eng-q {
    margin: 0 0 10px;
    font-size: 19px;
    line-height: 1.45;
    font-weight: 600;
    color: var(--ink);
    max-width: 34em;
  }
  .eng-blurb {
    margin: 0;
    font-size: 17px;
    line-height: 1.65;
    color: var(--body);
    max-width: 38em;
  }
  .reads {
    margin: 22px 0 0;
    max-width: 38em;
  }
  .reads h4 {
    margin: 0 0 8px;
    font-size: 13.5px;
    font-weight: 560;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .reads ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .reads li {
    border-top: 1px solid var(--line);
  }
  .read {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    padding: 16px 0;
    text-decoration-line: none;
  }
  .read-body {
    display: grid;
    gap: 4px;
    min-width: 0;
  }
  .read-title {
    font-size: 17px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-style: wavy;
    text-decoration-color: var(--u);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }
  .read-meta {
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .read :global(.read-arrow) {
    flex: none;
    color: var(--accent);
    transition: transform 0.18s ease;
  }
  .read:hover .read-title,
  .read:focus-visible .read-title {
    color: var(--u);
  }
  .read:hover :global(.read-arrow),
  .read:focus-visible :global(.read-arrow) {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .read :global(.read-arrow) {
      transition: none;
    }
  }
  @media (max-width: 900px) {
    .rs-hero {
      padding-top: 36px;
    }
    .rs-lede {
      font-size: 17.5px;
    }
    .blk {
      padding-top: 72px;
    }
    .blk-head h2 {
      font-size: 24px;
    }
    .eng {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px 0;
    }
    .eng-meta {
      margin: 6px 0 14px;
    }
  }
</style>
