---
import Base from '../layouts/Base.astro';
import { langPath, site, type Lang } from '../lib/config';
import { t } from '../i18n/ui';
import { categoryMeta, tagMeta } from '../data/taxonomy';

interface Props {
  lang: Lang;
  kind: 'categories' | 'tags';
  terms: { name: string; count: number; cover?: string }[];
  cloud?: { name: string; count: number }[];
  alt?: string;
}

const { lang, kind, terms, cloud = [], alt } = Astro.props;
const meta = kind === 'categories' ? categoryMeta : tagMeta;
const label = t(lang, kind);
const other = kind === 'categories' ? 'tags' : 'categories';
const otherLabel = t(lang, other);
const zh = lang !== 'en';
const maxCount = Math.max(1, ...cloud.map((c) => c.count));
const link = (name: string) => langPath(`/${kind}/${encodeURIComponent(name)}/`, lang);
---
<Base title={label} description={`${label}: browse posts by ${kind === 'categories' ? (zh ? '方向' : 'category') : (zh ? '主题' : 'topic')}.`} lang={lang} alt={alt}>
  <section class="art-head">
    <h1>{label}</h1>
    <p class="meta">
      <span class="pf-count">{terms.length}</span>
      <a class="link-wavy" href={langPath(`/${other}/`, lang)}>{otherLabel}</a>
    </p>
  </section>

  <div class="taxonomy-grid">
    {terms.map((term) => (
      <a class="taxonomy-card" href={link(term.name)}>
        {(meta[term.name]?.cover ?? term.cover)
          ? <img class="taxonomy-cover" src={meta[term.name]?.cover ?? term.cover} alt="" width="64" height="64" loading="lazy" decoding="async" />
          : <span class="taxonomy-cover taxonomy-cover-empty" aria-hidden="true">{term.name.slice(0, 1)}</span>}
        <div class="taxonomy-body">
          <h2>{term.name}</h2>
          {meta[term.name]?.description && <p>{meta[term.name]!.description}</p>}
          <p class="taxonomy-count">{term.count} {zh ? '篇' : 'posts'}</p>
        </div>
        <svg class="taxonomy-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7" /><path d="M8 7h9v9" />
        </svg>
      </a>
    ))}
  </div>

  {cloud.length > 0 && (
    <section class="tag-cloud-section">
      <h2>{otherLabel}</h2>
      <div class="tag-cloud">
        {cloud.map((tag) => (
          <a href={langPath(`/${other}/${encodeURIComponent(tag.name)}/`, lang)}
             style={`--tag-size:${12 + (tag.count / maxCount) * 6}px`}>
            {tag.name}<small>{tag.count}</small>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
