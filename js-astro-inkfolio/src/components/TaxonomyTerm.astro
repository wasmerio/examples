---
import Base from '../layouts/Base.astro';
import { langPath, site, type Lang } from '../lib/config';
import { t } from '../i18n/ui';
import { pickTrad } from '../lib/trad';

interface Props {
  lang: Lang;
  kind: 'categories' | 'tags';
  term: string;
  posts: { id: string; title: string; description: string; date: Date; cover?: string }[];
  alt?: string;
}

const { lang, kind, term, posts, alt } = Astro.props;
const label = t(lang, kind);
const zh = lang !== 'en';
const allLabel = kind === 'categories'
  ? (zh ? pickTrad(lang, '全部分类') : 'All categories')
  : (zh ? pickTrad(lang, '全部标签') : 'All tags');
const fmt = (d: Date) =>
  new Date(d).toLocaleDateString(zh ? 'zh-CN' : 'en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
---
<Base title={`${term} · ${label}`} description={`${label}: ${term}, ${posts.length} ${zh ? '篇' : 'posts'}.`} lang={lang} alt={alt}>
  <section class="art-head">
    <h1>{term}</h1>
    <p class="meta"><span class="pf-count">{posts.length}</span>{zh ? '篇' : 'posts'} · <a class="link-wavy" href={langPath(`/${kind}/`, lang)}>{allLabel}</a></p>
  </section>
  <ul class="tag-list">
    {posts.map((post) => (
      <li>
        <a href={langPath(`/posts/${post.id}/`, lang)}>
          {post.cover && (
            <img src={post.cover} alt="" width="156" height="98" loading="lazy" decoding="async" />
          )}
          <span class="txt">
            <b>{post.title}</b>
            {post.description && <small>{post.description.slice(0, 110)}</small>}
            <span class="meta2">{fmt(post.date)}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
