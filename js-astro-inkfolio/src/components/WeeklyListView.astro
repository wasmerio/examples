---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang !== 'en';
const altHref = zh ? '/weekly/' : '/zh/weekly/';

const collection = zh ? 'weeklyZh' : 'weekly';
const entries = (await getCollection(collection as 'weekly' | 'weeklyZh'))
  .filter((e: any) => !e.data.draft)
  .sort((a: any, b: any) => b.data.issue - a.data.issue);

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString(zh ? 'zh-CN' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title={t(lang, 'weekly')} lang={lang} alt={altHref}>
  <section class="art-head">
    <h1>{zh ? '周更' : 'Weekly'}</h1>
    <p class="meta">
      <span class="pf-count">
        {entries.length} {zh ? '期' : 'issues'}
      </span>
      {t(lang, 'weeklyLede')}
    </p>
  </section>

  <section class="sec" style="padding-top:44px">
    <div class="sec-head">
      <h2>{zh ? '全部' : 'All issues'}</h2>
    </div>
    <div class="sec-body">
      <ul class="rows">
        {entries.map((entry: any) => (
          <li>
            <div>
              <a href={zh ? `/zh/weekly/${entry.id}/` : `/weekly/${entry.id}/`}>
                {zh ? `第 ${entry.data.issue} 期 · ` : `№ ${entry.data.issue} · `}
                {entry.data.title}
              </a>
              {entry.data.description && <p class="tagline">{entry.data.description}</p>}
            </div>
            <time class="meta" datetime={new Date(entry.data.date).toISOString()}>
              {fmt(new Date(entry.data.date))}
            </time>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
