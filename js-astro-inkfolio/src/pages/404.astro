---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
---

<Base title={t('en', 'notFoundTitle')} lang="en" alt="/zh/404/">
  <section class="post-head">
    <h1>{t('en', 'notFoundTitle')}</h1>
    <p class="post-lede">{t('en', 'notFoundBody')}</p>
    <p>
      <a class="btn" href="/posts/">
        {t('en', 'notFoundCta')}
      </a>
    </p>
  </section>
</Base>
