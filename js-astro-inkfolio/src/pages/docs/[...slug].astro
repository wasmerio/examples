---
import { getCollection, render } from 'astro:content';
import DocsPage from '../../components/DocsPage.astro';
import { buildSidebar, docHref, docNeighbours } from '../../lib/docs';

export async function getStaticPaths() {
  const [entries, others] = await Promise.all([getCollection('docs'), getCollection('docsZh')]);
  const sidebar = buildSidebar(entries, 'en');
  const otherIds = new Set(others.map((e: any) => e.id));
  return entries.map((entry: any) => {
    const { prev, next } = docNeighbours(sidebar, entry.id, 'en');
    return {
      params: { slug: entry.id },
      props: {
        entry,
        sidebar,
        prev,
        next,
        alt: otherIds.has(entry.id) ? docHref(entry.id, 'zh') : undefined,
      },
    };
  });
}

const { entry, sidebar, prev, next, alt } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsPage
  lang="en"
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  currentId={entry.id}
  toc={headings}
  prev={prev}
  next={next}
  alt={alt}
>
  <Content />
</DocsPage>
