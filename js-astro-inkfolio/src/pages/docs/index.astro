---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { buildSidebar, docHref } from '../../lib/docs';
---

<Base title="Docs" lang="en" alt="/zh/docs/" maxWidth="1000px">
  <section class="docs-hero">
    <h1>Documentation</h1>
    <p class="docs-lede">
      Everything Inkfolio does, in the order you would do it: install, configure, write, publish. Each page is one job,
      with commands you can paste.
    </p>
  </section>

  <section class="cards">
    {buildSidebar(await getCollection('docs'), 'en').map((section: any) => (
      <div class="card">
        <h2>{section.title}</h2>
        <ul>
          {section.items.map((item: any) => (
            <li>
              <a href={docHref(item.id, 'en')}>{item.title}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Base>

<style is:global>
  .docs-hero {
    padding-top: 72px;
  }
  .docs-hero h1 {
    margin: 0;
    font-size: clamp(40px, 6vw, 56px);
    letter-spacing: -0.03em;
    line-height: 1.03;
  }
  .docs-lede {
    margin: 16px 0 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--body);
    max-width: 34em;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 48px;
    padding: 64px 0 40px;
  }
  .card h2 {
    margin: 0 0 10px;
    font-size: 17px;
    font-weight: 640;
  }
  .card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }
  .card a {
    display: block;
    padding: 8px 0;
    border-top: 1px solid var(--line);
    font-size: 16px;
  }
  @media (max-width: 720px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-top: 44px;
    }
  }
</style>
