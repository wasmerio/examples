---
import { getCollection, render } from 'astro:content';
import ArticleView from '../../components/ArticleView.astro';
import { langPath } from '../../lib/config';

export async function getStaticPaths() {
  const entries = await getCollection('research');
  return entries.map((entry: any) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const other = (await getCollection('researchZh')).find((e: any) => e.id === entry.id);
---

<ArticleView
  lang="en"
  title={entry.data.title}
  description={entry.data.description}
  date={new Date(entry.data.date)}
  tags={entry.data.tags}
  badge={entry.data.type}
  backHref="/research/"
  backLabel="Research"
  alt={other ? langPath(`/research/${entry.id}/`, 'zh') : undefined}
>
  <Content />
</ArticleView>
