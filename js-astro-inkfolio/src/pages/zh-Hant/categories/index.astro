---
import { getCollection } from 'astro:content';
import TaxonomyIndex from '../../../components/TaxonomyIndex.astro';

const entries = (await getCollection('postsZh')) as any[];

const counts = new Map<string, number>();
const covers = new Map<string, string>();
for (const post of entries) {
  for (const term of post.data.categories ?? []) {
    counts.set(term, (counts.get(term) ?? 0) + 1);
    if (post.data.cover && !covers.has(term)) covers.set(term, post.data.cover);
  }
}
const terms = [...counts.entries()]
  .map(([name, count]) => ({ name, count, cover: covers.get(name) }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const cloudCounts = new Map<string, number>();
for (const post of entries) {
  for (const tag of post.data.tags ?? []) cloudCounts.set(tag, (cloudCounts.get(tag) ?? 0) + 1);
}
const cloud = [...cloudCounts.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---
<TaxonomyIndex lang="zh-hant" kind="categories" terms={terms} cloud={cloud} alt="/categories/" />
