---
import { getCollection, render } from 'astro:content';
import ArticleView from '../../../components/ArticleView.astro';
import { langPath } from '../../../lib/config';

export async function getStaticPaths() {
  const entries = await getCollection('researchZh');
  return entries.map((entry: any) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const other = (await getCollection('research')).find((e: any) => e.id === entry.id);
---

<ArticleView
  lang="zh-hant"
  title={entry.data.title}
  description={entry.data.description}
  date={new Date(entry.data.date)}
  tags={entry.data.tags}
  badge={entry.data.type}
  backHref="/zh/research/"
  backLabel="研究"
  alt={other ? langPath(`/research/${entry.id}/`, 'en') : undefined}
>
  <Content />
</ArticleView>
