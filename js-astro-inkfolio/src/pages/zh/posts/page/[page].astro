---
import PostsIndex from '../../../../components/PostsIndex.astro';
import { loadPosts } from '../../../../lib/posts';

export async function getStaticPaths() {
  const { totalPages, page } = await loadPosts('zh');
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { n: i + 2, totalPages, entries: page(i + 2) },
  }));
}

const { total, page } = await loadPosts('zh');
const { n, totalPages, entries } = Astro.props;
---

<PostsIndex lang="zh" page={n} totalPages={totalPages} entries={entries} total={total} />
