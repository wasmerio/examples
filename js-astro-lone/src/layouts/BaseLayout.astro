---
import '../styles/global.css';
import fontsCss from '../styles/fonts.css?raw';
import SiteFoot from '../components/SiteFoot.astro';
import { site, nav, ui } from 'lone/config';

const path = Astro.url.pathname;
const title = Astro.props.title ? `${Astro.props.title} · ${site.name}` : `${site.name} — ${site.motto}`;
const desc = Astro.props.description || site.description;
const origin = site.url.replace(/\/$/, '');
const canonPath = path.endsWith('/') ? path : `${path}/`;
const url = `${origin}${canonPath}`;
const rawImage = Astro.props.image || site.ogImage;
const image = rawImage
  ? (String(rawImage).startsWith('http') ? String(rawImage) : `${origin}${rawImage}`)
  : undefined;
const notesCurrent = path === '/' || path.startsWith('/page/') || path.startsWith('/notes/');
const noindex = Boolean(Astro.props.noindex);
const type = Astro.props.type || 'website';
const favicon = site.favicon || '/favicon.svg';
const rssTitle = site.rssTitle || `${site.name} — ${site.motto}`;
const themeKey = 'lone-theme';
const chrome = {
  day: ui.themeDay || 'Day',
  night: ui.themeNight || 'Night',
  toDay: ui.themeToDay || 'Switch to day',
  toNight: ui.themeToNight || 'Switch to night',
  menuOpen: ui.menuOpen || 'Open menu',
  menuClose: ui.menuClose || 'Close menu',
  menuCloseWord: ui.menuCloseWord || 'Close',
};

const display = {
  family: (site.displayFont || '').trim(),
  weight:
    typeof site.displayWeight === 'number' && Number.isFinite(site.displayWeight)
      ? site.displayWeight
      : undefined,
  tracking: (site.displayTracking || '').trim(),
};
const displayCss = display.family
  ? `:root{--display:${display.family};` +
    `${display.weight !== undefined ? `--display-weight:${display.weight};` : ''}` +
    `${display.tracking ? `--display-tracking:${display.tracking};` : ''}}`
  : '';
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline define:vars={{ themeKey }}>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem(themeKey); } catch (e) {}
        var theme = saved === 'dark' || saved === 'light'
          ? saved
          : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') document.documentElement.dataset.theme = 'dark';
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#161310' : '#ffffff');
      })();
    </script>
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={favicon} />
    <link rel="preload" href="/fonts/source-serif-4-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/shippori-mincho-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/zen-kaku-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <Fragment set:html={`<style>${fontsCss}</style>`} />
    {displayCss && <Fragment set:html={`<style>${displayCss}</style>`} />}
    <title>{title}</title>
    <link rel="canonical" href={url} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    {image && <meta name="twitter:image" content={image} />}
    <link rel="alternate" type="application/rss+xml" title={rssTitle} href="/rss.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <div class="shell">
      <header class="mast">
        <div class="wrap mast-row mast-desk">
          <a class="wordmark" href="/">{site.wordmark}</a>
          <nav class="topnav" aria-label={ui.ariaNav}>
            {nav.map((item) => (
              <a
                href={item.href}
                aria-current={
                  item.href === '/'
                    ? notesCurrent ? 'page' : undefined
                    : item.href !== '/rss.xml' && path.startsWith(item.href.replace(/\/$/, '')) ? 'page' : undefined
                }
              ><span class="nav-k">{item.label}</span></a>
            ))}
          </nav>
          <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label={chrome.toNight}>
            <span class="theme-opt" data-day>{chrome.day}</span><span class="theme-bar" aria-hidden="true"></span><span class="theme-opt" data-night>{chrome.night}</span>
          </button>
        </div>
        <div class="wrap mast-phone">
          <div class="mast-brand">
            <a class="wordmark" href="/">{site.wordmark}</a>
            <div class="mast-tools">
              <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label={chrome.toNight}>
                <span class="theme-opt" data-day>{chrome.day}</span><span class="theme-bar" aria-hidden="true"></span><span class="theme-opt" data-night>{chrome.night}</span>
              </button>
              <button class="menu-btn" type="button" data-menu-open aria-expanded="false" aria-controls="site-drawer" aria-label={chrome.menuOpen}>
                <svg class="menu-ico" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                  <path d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
          </div>
        </div>
        <div class="drawer" id="site-drawer" hidden>
          <button class="drawer-veil" type="button" data-menu-close tabindex="-1" aria-label={chrome.menuClose}></button>
          <nav class="drawer-panel" aria-label={ui.ariaNav}>
            <button class="drawer-close" type="button" data-menu-close aria-label={chrome.menuClose}>{chrome.menuCloseWord}</button>
            {nav.map((item) => (
              <a
                href={item.href}
                aria-current={
                  item.href === '/'
                    ? notesCurrent ? 'page' : undefined
                    : item.href !== '/rss.xml' && path.startsWith(item.href.replace(/\/$/, '')) ? 'page' : undefined
                }
              ><span class="nav-k">{item.label}</span></a>
            ))}
          </nav>
        </div>
      </header>
      <main id="main">
        <slot />
      </main>
      <SiteFoot />
    </div>
  <script is:inline define:vars={{ themeKey, toDay: chrome.toDay, toNight: chrome.toNight }}>
  (function () {
    var btns = document.querySelectorAll('[data-theme-toggle]');
    if (!btns.length) return;
    function paint() {
      var dark = document.documentElement.dataset.theme === 'dark';
      btns.forEach(function (btn) {
        btn.setAttribute('aria-pressed', String(dark));
        btn.setAttribute('aria-label', dark ? toDay : toNight);
      });
    }
    paint();
    btns.forEach(function (btn) { btn.addEventListener('click', function () {
      var dark = document.documentElement.dataset.theme !== 'dark';
      if (dark) document.documentElement.dataset.theme = 'dark';
      else delete document.documentElement.dataset.theme;
      try { localStorage.setItem(themeKey, dark ? 'dark' : 'light'); } catch (e) {}
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', dark ? '#161310' : '#ffffff');
      paint();
    }); });
  })();
  </script>
  <script is:inline define:vars={{ menuOpen: chrome.menuOpen, menuClose: chrome.menuClose }}>
  (function () {
    var drawer = document.getElementById('site-drawer');
    var openBtn = document.querySelector('[data-menu-open]');
    if (!drawer || !openBtn) return;
    function set(open) {
      drawer.hidden = !open;
      openBtn.setAttribute('aria-expanded', String(open));
      openBtn.setAttribute('aria-label', open ? menuClose : menuOpen);
      document.documentElement.classList.toggle('menu-open', open);
    }
    openBtn.addEventListener('click', function () { set(drawer.hidden); });
    drawer.querySelectorAll('[data-menu-close]').forEach(function (el) {
      el.addEventListener('click', function () { set(false); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !drawer.hidden) set(false);
    });
  })();
  </script>
  </body>
</html>
