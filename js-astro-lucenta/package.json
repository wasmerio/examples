{
  "name": "lucenta-astro-theme",
  "description": "An Astro theme for design studios, creative agencies and portfolios: bold case studies in each project's own colour, a full-width work showcase, scroll-lit type, a filterable work index, services, a studio page, a journal and a project enquiry form.",
  "type": "module",
  "version": "1.0.0",
  "author": "Andrei Alba",
  "license": "MIT",
  "private": true,
  "keywords": [
    "astro-theme",
    "astro",
    "agency",
    "design-studio",
    "creative-agency",
    "portfolio",
    "case-studies",
    "branding",
    "web-design",
    "journal",
    "tailwindcss"
  ],
  "homepage": "https://lucenta.xocoweb.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xocothemes/lucenta.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "release:check": "npm run check && npm run build && npm run format:check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
