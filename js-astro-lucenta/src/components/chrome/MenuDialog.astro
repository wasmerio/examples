---
import Icon from "@/components/ui/Icon.astro";
import Logo from "@/components/ui/Logo.astro";
import { navigation, siteConfig } from "@/config/site";
import { outbound } from "@/lib/links";
import { socialIcon } from "@/lib/socials";

const path = Astro.url.pathname;
---

<dialog id="menu" class="menu on-ink" aria-label="Menu">
  <div class="shell flex min-h-full flex-col">
    <div class="flex h-(--header-h) items-center justify-between">
      <a href="/" aria-label={`${siteConfig.name}, home`}><Logo /></a>
      <button type="button" class="menu-close" aria-label="Close menu" data-menu-close>
        <Icon name="x" class="size-7" stroke={1.5} />
      </button>
    </div>
    <nav aria-label="Menu" class="flex-1 py-10">
      <ul>
        {
          navigation.map((link, index) => (
            <li class="menu-item" style={`--i:${index}`}>
              <a href={link.href} class="display menu-link" aria-current={path.startsWith(link.href) ? "page" : undefined}>
                <span class="meta">{String(index + 1).padStart(2, "0")}</span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu-foot grid gap-6 py-8 sm:grid-cols-2">
      <a href={`mailto:${siteConfig.email}`} class="display display-sm link-under justify-self-start">{siteConfig.email}</a>
      <ul class="flex flex-wrap gap-3 sm:justify-end">
        {
          siteConfig.socials.map((social) => (
            <li>
              <a href={social.href} class="social-icon menu-social" aria-label={social.label} {...outbound(social.href, "me noopener")}>
                <Icon name={socialIcon(social.label)} class="size-6" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</dialog>

<style>
  .menu {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
  }

  .menu[open] {
    animation: menu-in 0.7s var(--ease-out-expo) both;
  }

  .menu::backdrop {
    background: transparent;
  }

  @keyframes menu-in {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .menu-close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
  }

  .menu-social {
    width: 4rem;
    height: 4rem;
  }

  .menu-item {
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .menu[open] .menu-link {
    animation: line-up 0.9s var(--ease-out-expo) both;
    animation-delay: calc(var(--i) * 60ms + 150ms);
  }

  .menu-link {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding-block: 0.9rem 0.6rem;
    font-size: clamp(2.5rem, 11vw, 5rem);
    transition: color 0.3s;
  }

  .menu-link .meta {
    padding-top: 0.6rem;
  }

  .menu-link[aria-current="page"] {
    color: var(--signal);
  }
</style>

<script>
  const menu = document.querySelector<HTMLDialogElement>("#menu");
  const opener = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  opener?.addEventListener("click", () => menu?.showModal());
  menu?.querySelector("[data-menu-close]")?.addEventListener("click", () => menu.close());
  menu?.addEventListener("close", () => opener?.focus());
  /* Close before navigating so the page transition captures the page, not the menu. */
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => menu.close()));
</script>
