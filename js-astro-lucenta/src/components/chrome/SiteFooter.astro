---
import Icon from "@/components/ui/Icon.astro";
import Roll from "@/components/ui/Roll.astro";
import { footerNavigation, legalNavigation, siteConfig } from "@/config/site";
import { outbound } from "@/lib/links";
import { socialIcon } from "@/lib/socials";

const year = new Date().getFullYear();
---

<footer class="site-footer on-ink">
  <div class="shell pt-[clamp(5rem,3rem+6vw,9rem)]">
    <a href={siteConfig.action.href} class="footer-cta group flex items-center gap-[0.15em]">
      <span class="display display-xl">Let's talk</span>
      <span class="footer-arrow" aria-hidden="true"><Icon name="arrow-up-right" class="size-[0.5em]" stroke={1.5} /></span>
    </a>

    <div class="mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href={`mailto:${siteConfig.email}`} class="display display-sm link-under">{siteConfig.email}</a>
        <p class="mt-5 max-w-sm text-mute">{siteConfig.summary}</p>
        <ul class="mt-8 flex flex-wrap gap-2">
          {
            siteConfig.socials.map((social) => (
              <li>
                <a href={social.href} class="social-icon" aria-label={social.label} {...outbound(social.href, "me noopener")}>
                  <Icon name={socialIcon(social.label)} class="size-5" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        footerNavigation.map((column) => (
          <nav aria-label={column.title} class="lg:col-span-2">
            <p class="meta">{column.title}</p>
            <ul class="mt-4 grid gap-2">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="footer-link">
                    <Roll text={link.label} />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      <div class="grid gap-8 sm:grid-cols-2 lg:col-span-4">
        {
          siteConfig.studios.map((studio) => (
            <div>
              <p class="meta">{studio.city}</p>
              <address class="mt-4 not-italic text-ink-2">
                {studio.address.map((line) => (
                  <span class="block">{line}</span>
                ))}
                <a href={`tel:${studio.phone.replace(/[^\d+]/g, "")}`} class="link mt-2 inline-block">
                  {studio.phone}
                </a>
              </address>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="shell mt-16 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-line py-6 text-sm text-mute">
    <p>© {year} {siteConfig.legalName}.</p>
    <div class="flex items-center gap-6">
      {
        legalNavigation.map((link) => (
          <a href={link.href} class="link">
            {link.label}
          </a>
        ))
      }
      <a href="#top" class="inline-flex items-center gap-1.5 text-ink">
        <Roll text="Back to top" />
        <Icon name="arrow-up" class="size-3.5" />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
  }

  /* Only when the page ends on a dark or coloured section, which would otherwise run into the footer. */
  :global(.page:has(> :is(.on-ink, .on-tint):last-child)) + .site-footer {
    border-top: 1px solid var(--line);
  }

  .footer-arrow {
    display: grid;
    place-items: center;
    width: 0.9em;
    height: 0.9em;
    font-size: clamp(2.4rem, 0.6rem + 6.6vw, 7.75rem);
    border-radius: 999px;
    background: var(--signal);
    color: #0d0d0c;
    transform: scale(0.7);
    transition: transform 0.7s var(--ease-out-expo);
  }

  .footer-cta:hover .footer-arrow {
    transform: scale(0.8) rotate(45deg);
  }

  .footer-cta .display {
    transition: transform 0.7s var(--ease-out-expo);
  }

  .footer-cta:hover .display {
    transform: translateX(0.08em);
  }

  .footer-link {
    color: var(--ink-2);
    transition: color 0.3s;
  }

  .footer-link:hover {
    color: var(--ink);
  }
</style>
