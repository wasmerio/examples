---
import { Image } from "astro:assets";
import Button from "@/components/ui/Button.astro";
import { hero } from "@/config/home";
import { siteConfig } from "@/config/site";
import { noOrphan } from "@/lib/format";
import type { Work } from "@/lib/work";

interface Props {
  /** Projects whose covers cycle in the headline capsule and the reel below. */
  work: Work[];
}

const { work } = Astro.props;

const years = work.map((item) => item.data.year);
const span = years.length ? `${Math.min(...years)}–${String(Math.max(...years)).slice(2)}` : "";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell pt-[calc(var(--header-h)+clamp(3rem,7vw,7rem))]">
    <h1 id="hero-title" class="display display-xxl">
      {
        hero.lines.map((line, index) => (
          <span class="mask-line" style={`--i:${index + 1}`}>
            <span>
              {line}
              {index === hero.capsuleLine && work.length > 0 && (
                <span class="capsule" data-reel="1100" aria-hidden="true">
                  {work.map((item, i) => (
                    <Image
                      src={item.data.cover}
                      alt=""
                      widths={[240, 480]}
                      sizes="16rem"
                      loading="eager"
                      data-frame
                      data-active={i === 0 ? "" : undefined}
                    />
                  ))}
                </span>
              )}
            </span>
          </span>
        ))
      }
    </h1>

    <div class="mt-[clamp(2.5rem,5vw,4.5rem)] grid items-end gap-8 lg:grid-cols-12">
      <p class="lead rise max-w-[36ch] lg:col-span-5" style="--i:4">{noOrphan(hero.intro)}</p>
      <div class="rise flex flex-wrap gap-3 lg:col-span-7 lg:justify-end" style="--i:5">
        <Button href={siteConfig.action.href} label={siteConfig.action.label} />
        <Button href="/work/" label="See the work" variant="ghost" arrow={false} />
      </div>
    </div>
  </div>

  {
    work.length > 0 && (
      <div class="showcase mt-[clamp(3rem,6vw,6rem)]" data-expand>
        <a href="/work/" class="showcase-media" data-reel="1500" aria-label="See all work">
          {work.map((item, i) => (
            <Image
              src={item.data.cover}
              alt=""
              widths={[800, 1400, 2000, 2400]}
              sizes="100vw"
              loading={i === 0 ? "eager" : "lazy"}
              class="showcase-frame"
              data-frame
              data-active={i === 0 ? "" : undefined}
            />
          ))}
          <span class="showcase-bar">
            <span class="meta text-white/80">Selected projects {span}</span>
            <span class="showcase-labels display display-sm">
              {work.map((item, i) => (
                <span data-frame-label data-active={i === 0 ? "" : undefined}>
                  {item.data.title} <span class="subhead text-white/75">{item.data.headline}</span>
                </span>
              ))}
            </span>
          </span>
        </a>
      </div>
    )
  }
</section>

<style>
  .capsule {
    position: relative;
    display: inline-block;
    width: 1.55em;
    height: 0.72em;
    margin-left: 0.12em;
    vertical-align: 0.02em;
    border-radius: 999px;
    overflow: hidden;
    background: var(--paper-2);
  }

  .capsule img,
  .showcase-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    visibility: hidden;
  }

  .capsule img[data-active],
  .showcase-frame[data-active] {
    visibility: visible;
    animation: frame-in 1.6s var(--ease-out-expo) both;
  }

  @keyframes frame-in {
    from {
      transform: scale(1.12);
    }
  }

  .showcase {
    --p: 1;
  }

  .showcase-media {
    position: relative;
    display: block;
    height: clamp(26rem, 92svh, 64rem);
    overflow: hidden;
    background: var(--ink);
    clip-path: inset(
      calc((1 - var(--p)) * 9%) calc((1 - var(--p)) * (var(--gutter) + 9vw))
        round calc((1 - var(--p)) * 3rem + var(--radius) * var(--p) * 0)
    );
    will-change: clip-path;
  }

  .showcase-bar {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding: clamp(1.25rem, 3vw, 2.5rem) var(--gutter);
    background: linear-gradient(transparent, rgb(0 0 0 / 0.55));
    color: #fff;
    opacity: calc(var(--p) * 1.6 - 0.6);
  }

  .showcase-labels {
    display: grid;
    text-align: right;
  }

  .showcase-labels > span {
    grid-area: 1 / 1;
    visibility: hidden;
  }

  .showcase-labels > span[data-active] {
    visibility: visible;
    animation: line-up 0.9s var(--ease-out-expo) both;
  }
</style>
