---
import Button from "@/components/ui/Button.astro";
import { figures, manifesto } from "@/config/home";

const words = manifesto.text.split(" ");
---

<section class="section" aria-label={manifesto.label}>
  <div class="shell">
    <p class="display manifesto max-w-[30ch]" data-words style={`--n:${words.length}`}>
      {words.map((word, index) => <span style={`--w:${index}`}>{`${word} `}</span>)}
    </p>
    <Button href={manifesto.link.href} label={manifesto.link.label} class="reveal mt-12" />
  </div>

  <dl class="shell mt-[clamp(4rem,8vw,8rem)] grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4">
    {
      figures.map((figure) => (
        <div class="reveal flex flex-col">
          <dt class="meta">{figure.label}</dt>
          <dd class="display display-lg mt-auto pt-4">
            <span data-count={figure.value}>{figure.value}</span>
            {figure.suffix}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .manifesto {
    --p: 1;
    font-size: clamp(1.6rem, 0.8rem + 2.9vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .manifesto span {
    opacity: clamp(0.13, calc(var(--p) * var(--n) * 1.15 - var(--w)), 1);
    transition: opacity 0.2s linear;
  }
</style>
