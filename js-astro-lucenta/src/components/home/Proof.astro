---
import { clients } from "@/config/clients";
import { testimonial } from "@/config/home";
import { noOrphan } from "@/lib/format";

const logos = import.meta.glob<string>("/src/assets/clients/*.svg", { query: "?raw", import: "default", eager: true });
const marks = clients
  .map((client) => ({ name: client.name, svg: logos[`/src/assets/clients/${client.logo}.svg`] }))
  .filter((mark) => mark.svg);
---

<section class="section" aria-labelledby="proof-title">
  <div class="shell">
    <h2 id="proof-title" class="display display-md reveal">Trusted by brave brands</h2>
  </div>

  <div class="marquee mt-10" data-marquee>
    <ul class="marquee-track" data-marquee-track>
      {
        [0, 1].map((copy) =>
          marks.map((mark) => (
            <li aria-hidden={copy === 1 ? "true" : undefined} class="marquee-item">
              <span set:html={mark.svg} />
              {copy === 0 && <span class="sr-only">{mark.name}</span>}
            </li>
          )),
        )
      }
    </ul>
  </div>

  <figure class="shell mt-[clamp(4rem,8vw,8rem)] grid gap-4 lg:grid-cols-12 lg:gap-10">
    <span class="quote-mark reveal lg:col-span-2" aria-hidden="true">“</span>
    <div class="lg:col-span-10">
      <blockquote class="quote reveal">
        <p>{noOrphan(testimonial.quote)}</p>
      </blockquote>
      <figcaption class="reveal mt-10 flex items-center gap-4">
        <span class="h-px w-12 bg-ink"></span>
        <span>
          <span class="block font-semibold">{testimonial.name}</span>
          <span class="block text-mute">{testimonial.role}</span>
        </span>
      </figcaption>
    </div>
  </figure>
</section>

<style>
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee-item {
    display: grid;
    place-items: center;
    padding: clamp(1.75rem, 3vw, 2.75rem) clamp(2rem, 4vw, 4rem);
    color: var(--ink);
  }

  .marquee-item :global(svg) {
    height: clamp(1.75rem, 1.2rem + 1.4vw, 2.75rem);
    width: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
    }

    .marquee-track {
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }

    .marquee-item[aria-hidden] {
      display: none;
    }
  }

  .quote-mark {
    height: 0.5em;
    font-size: clamp(7rem, 5rem + 10vw, 16rem);
    line-height: 0.7;
    color: var(--signal);
  }

  .quote {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 0.9rem + 2vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
</style>
