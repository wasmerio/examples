---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { servicesBlock } from "@/config/home";
import { services } from "@/config/services";
import { pad } from "@/lib/format";
import type { Work } from "@/lib/work";

interface Props {
  work: Work[];
}

const { work } = Astro.props;
const byId = new Map(work.map((item) => [item.id, item]));
const rows = services.map((service) => ({ ...service, cover: byId.get(service.project)?.data.cover }));
---

<section class="on-ink section relative" aria-labelledby="services-title" data-follow>
  <div class="shell">
    <SectionHead id="services-title" title={servicesBlock.title} link={servicesBlock.link} />
    <ul class="mt-[clamp(2.5rem,5vw,4.5rem)] border-t border-line">
      {
        rows.map((service, index) => (
          <li class="border-b border-line">
            <a href={`/services/#${service.key}`} class="service-row group" data-follow-key={service.key}>
              <span class="meta pt-[0.4em]">{pad(index + 1)}</span>
              <span class="display display-lg service-title">{service.title}</span>
              <span class="service-summary text-mute">{service.summary}</span>
              <span class="arrow-circle service-arrow" aria-hidden="true">
                <Icon name="arrow-up-right" class="size-5" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="follow-float" data-follow-float aria-hidden="true">
    {rows.map((service) => service.cover && <Image src={service.cover} alt="" widths={[480, 800]} sizes="24rem" data-follow-image={service.key} />)}
  </div>
</section>

<style>
  .service-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: start;
    gap: 0.5rem 1.25rem;
    padding-block: clamp(1.25rem, 2.4vw, 2.25rem);
  }

  .service-title {
    transition:
      transform 0.7s var(--ease-out-expo),
      color 0.4s;
  }

  .service-summary {
    grid-column: 2;
    max-width: 30ch;
  }

  .service-arrow {
    grid-column: 3;
    grid-row: 1;
    align-self: center;
  }

  @media (min-width: 64rem) {
    .service-row {
      grid-template-columns: 4rem 1fr 22rem auto;
      align-items: center;
    }

    .service-summary {
      grid-column: 3;
    }

    .service-arrow {
      grid-column: 4;
    }
  }

  .service-row:hover .service-title {
    transform: translateX(clamp(0.5rem, 2vw, 2rem));
    color: var(--signal);
  }

  .service-row:hover .service-arrow {
    background: var(--signal);
    color: #0d0d0c;
    box-shadow: none;
    transform: rotate(45deg);
  }
</style>
