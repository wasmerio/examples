---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { selectedWork } from "@/config/home";
import { pad } from "@/lib/format";
import { disciplineLabel, transitionName, workHref, type Work } from "@/lib/work";

interface Props {
  work: Work[];
  total: number;
}

const { work, total } = Astro.props;
---

<section class="section pb-0" aria-labelledby="work-title">
  <div class="shell">
    <SectionHead
      id="work-title"
      title={selectedWork.title}
      link={total > work.length ? { label: "All projects", href: "/work/" } : undefined}
    />
  </div>

  <div class="shell mt-[clamp(2.5rem,5vw,4.5rem)] grid gap-[clamp(1rem,2vw,1.5rem)]">
    {
      work.map((item, index) => (
        <article class="stack-card reveal">
          <a href={workHref(item)} class="stack-inner group" aria-label={`${item.data.title}: ${item.data.headline}`}>
            <div class="media absolute inset-0 rounded-[inherit]" data-vt={transitionName(item)}>
              <Image
                src={item.data.cover}
                alt={item.data.coverAlt}
                widths={[800, 1400, 2000, 2400]}
                sizes="(min-width: 110rem) 105rem, 95vw"
                class="zoom-img"
              />
            </div>
            <div class="stack-overlay">
              <div class="flex items-start justify-between gap-4">
                <span class="meta text-white/85">
                  {pad(index + 1)} / {pad(work.length)}
                </span>
                <ul class="flex flex-wrap justify-end gap-1.5">
                  {item.data.disciplines.map((key) => (
                    <li class="chip chip-solid">{disciplineLabel(key)}</li>
                  ))}
                </ul>
              </div>
              <div class="flex items-end justify-between gap-6">
                <div>
                  <p class="subhead text-[clamp(1.1rem,0.9rem+0.9vw,1.75rem)] text-white/90">{item.data.headline}</p>
                  <h3 class="display display-xl mt-2">{item.data.title}</h3>
                </div>
                <div class="hidden flex-col items-end gap-4 sm:flex">
                  <span class="meta text-white/85">
                    {item.data.sector} · {item.data.year}
                  </span>
                  <span class="arrow-circle stack-arrow">
                    <Icon name="arrow-up-right" class="size-5" />
                  </span>
                </div>
              </div>
            </div>
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  .stack-card {
    aspect-ratio: 4 / 5;
  }

  @media (min-width: 48rem) {
    .stack-card {
      aspect-ratio: 16 / 9;
    }
  }

  .stack-inner {
    position: relative;
    display: block;
    height: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    color: #fff;
  }

  .stack-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.1rem, 2.6vw, 2.5rem);
    background:
      linear-gradient(rgb(0 0 0 / 0.28), transparent 26%),
      linear-gradient(transparent 45%, rgb(0 0 0 / 0.55));
  }

  .stack-arrow {
    background: #fff;
    color: #0d0d0c;
    box-shadow: none;
  }

  .group:hover .stack-arrow {
    background: var(--signal);
    transform: rotate(45deg);
  }
</style>
