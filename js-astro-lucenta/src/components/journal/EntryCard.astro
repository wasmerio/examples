---
import { Image } from "astro:assets";
import { formatShortDate } from "@/lib/format";
import { entryHref, journalCategoryLabel, type Entry } from "@/lib/journal";

interface Props {
  entry: Entry;
  /** The wide layout for the lead entry on the journal's first page. */
  wide?: boolean;
  class?: string;
}

const { entry, wide = false, class: className } = Astro.props;
const { title, description, cover, coverAlt, category, date } = entry.data;
---

<article class:list={["entry reveal group", wide && "entry-wide", className]}>
  <a href={entryHref(entry)} class="entry-link">
    {
      cover && (
        <div class="media entry-media">
          <Image
            src={cover}
            alt={coverAlt ?? ""}
            widths={wide ? [800, 1400, 2000] : [480, 800, 1200]}
            sizes={wide ? "(min-width: 64rem) 60vw, 100vw" : "(min-width: 64rem) 32vw, (min-width: 40rem) 50vw, 100vw"}
            class="zoom-img"
          />
        </div>
      )
    }
    <div class="entry-body">
      <p class="meta flex items-center gap-3">
        <span class="text-ink">{journalCategoryLabel(category)}</span>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()} >{formatShortDate(date)}</time>
      </p>
      <h3 class:list={["mt-3", wide ? "display display-md" : "entry-title"]}>
        <span class="link">{title}</span>
      </h3>
      <p class:list={["mt-3 text-mute", wide ? "lead" : "line-clamp-3"]}>{description}</p>
    </div>
  </a>
</article>

<style>
  .entry-link {
    display: grid;
    gap: 1.4rem;
  }

  .entry-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
  }

  .entry-title {
    font-size: clamp(1.2rem, 1.05rem + 0.45vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  @media (min-width: 64rem) {
    .entry-wide .entry-link {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      gap: 3rem;
    }

    .entry-wide .entry-media {
      aspect-ratio: 16 / 11;
    }
  }
</style>
