---
import EntryCard from "@/components/journal/EntryCard.astro";
import type { Entry } from "@/lib/journal";

interface Props {
  entries: Entry[];
  /** Give the first entry the wide layout. */
  lead?: boolean;
}

const { entries, lead = false } = Astro.props;
const [first, ...rest] = entries;
---

{
  first && (
    <div class="grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      <EntryCard entry={first} wide={lead} class:list={[lead && "sm:col-span-2 lg:col-span-3"]} />
      {rest.map((entry) => (
        <EntryCard entry={entry} />
      ))}
    </div>
  )
}
