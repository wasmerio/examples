---
import { journalCategories, journalCategoryKeys, type JournalCategory } from "@/config/journal";
import { noOrphan } from "@/lib/format";
import { journalCategoryHref } from "@/lib/journal";

interface Props {
  title: string;
  lead: string;
  current?: JournalCategory;
}

const { title, lead, current } = Astro.props;
const tabs = [
  { label: "All", href: "/journal/", active: !current },
  ...journalCategoryKeys.map((key) => ({
    label: journalCategories[key].label,
    href: journalCategoryHref(key),
    active: key === current,
  })),
];
---

<section class="shell pt-[calc(var(--header-h)+clamp(3rem,7vw,7rem))] pb-[clamp(2.5rem,5vw,4rem)]">
  <h1 class="display display-xxl">
    <span class="mask-line" style="--i:1"><span>{title}</span></span>
  </h1>
  <div class="rise mt-10 flex flex-wrap items-end justify-between gap-6" style="--i:3">
    <p class="lead max-w-[46ch]">{noOrphan(lead)}</p>
    <nav aria-label="Journal categories">
      <ul class="flex flex-wrap gap-2">
        {
          tabs.map((tab) => (
            <li>
              <a href={tab.href} class="chip tab" aria-current={tab.active ? "page" : undefined}>
                {tab.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>

<style>
  .tab[aria-current="page"] {
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }

  .tab:not([aria-current="page"]):hover {
    box-shadow: inset 0 0 0 1px var(--ink);
  }
</style>
