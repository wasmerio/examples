---
import ShareSheet from "@/components/journal/ShareSheet.astro";
import Icon from "@/components/ui/Icon.astro";
import Roll from "@/components/ui/Roll.astro";

interface Props {
  title: string;
  /** Absolute URL of the entry. */
  url: string;
}

const { title, url } = Astro.props;
---

<section hidden data-share-card aria-labelledby="share-card-title" class="share-card">
  <h2 id="share-card-title" class="display display-sm">Enjoyed this? Pass it on.</h2>
  <button type="button" class="btn share-open" aria-haspopup="dialog" data-share-open hidden>
    <Roll text="Share" />
    <span class="btn-dot">
      <Icon name="share-2" class="size-4" />
    </span>
  </button>
</section>

<ShareSheet title={title} url={url} />

<style>
  .share-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius);
    background: var(--paper-2);
  }

  .share-card[hidden] {
    display: none;
  }

  .share-open:hover .btn-dot {
    transform: none;
  }
</style>
