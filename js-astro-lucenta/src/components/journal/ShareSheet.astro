---
import Icon from "@/components/ui/Icon.astro";

/* One native `<dialog>` per page, opened by any `[data-share-open]` control. */
interface Props {
  title: string;
  /** Absolute URL of the page being shared. */
  url: string;
}

const { title, url } = Astro.props;
const link = encodeURIComponent(url);
const text = encodeURIComponent(title);

const targets = [
  { label: "X", icon: "social-twitter-x", brand: "#0d0d0c", href: `https://x.com/intent/post?text=${text}&url=${link}` },
  { label: "LinkedIn", icon: "social-linkedin", brand: "#0a66c2", href: `https://www.linkedin.com/sharing/share-offsite/?url=${link}` },
  { label: "Facebook", icon: "social-facebook", brand: "#1877f2", href: `https://www.facebook.com/sharer/sharer.php?u=${link}` },
  { label: "Email", icon: "social-envelope", brand: "#c2413f", href: `mailto:?subject=${text}&body=${link}` },
  { label: "WhatsApp", icon: "social-whatsapp", brand: "#1eb355", href: `https://api.whatsapp.com/send?text=${text}%20${link}` },
  { label: "Telegram", icon: "social-telegram", brand: "#2596d8", href: `https://t.me/share/url?url=${link}&text=${text}` },
  { label: "Threads", icon: "social-threads", brand: "#0d0d0c", href: `https://www.threads.net/intent/post?text=${text}%20${link}` },
];

const extraTargets = [
  { label: "Bluesky", icon: "social-bluesky", brand: "#1185fe", href: `https://bsky.app/intent/compose?text=${text}%20${link}` },
  { label: "Mastodon", icon: "social-mastodon", brand: "#5a5bd6", href: `https://mastodonshare.com/?text=${text}&url=${link}` },
  { label: "Reddit", icon: "social-reddit", brand: "#e03d00", href: `https://www.reddit.com/submit?url=${link}&title=${text}` },
  { label: "Pinterest", icon: "social-pinterest", brand: "#d5001f", href: `https://pinterest.com/pin/create/button/?url=${link}&description=${text}` },
];
---

<dialog class="share-sheet" aria-labelledby="share-title" data-share-sheet>
  <div class="share-panel">
    <div class="flex items-center justify-between gap-4">
      <h2 id="share-title" class="display display-sm">Share this story</h2>
      <button type="button" class="share-close" aria-label="Close sharing options" data-share-close>
        <Icon name="x" class="size-6" stroke={1.5} />
      </button>
    </div>

    <ul class="share-targets mt-7">
      {
        targets.map((target) => (
          <li>
            <a class="share-target" style={`--network:${target.brand}`} href={target.href} target="_blank" rel="noopener noreferrer" data-share-target>
              <span class="share-icon">
                <Icon name={target.icon} class="size-5" />
              </span>
              <span class="text-sm">{target.label}</span>
            </a>
          </li>
        ))
      }
      <li data-share-more-item>
        <button type="button" class="share-target share-target-quiet" data-share-more>
          <span class="share-icon">
            <Icon name="social-three-dots" class="size-5" />
          </span>
          <span class="text-sm">More</span>
        </button>
      </li>
      {
        extraTargets.map((target) => (
          <li hidden data-share-extra>
            <a class="share-target" style={`--network:${target.brand}`} href={target.href} target="_blank" rel="noopener noreferrer" data-share-target>
              <span class="share-icon">
                <Icon name={target.icon} class="size-5" />
              </span>
              <span class="text-sm">{target.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8">
      <label for="share-url" class="meta">Link</label>
      <div class="share-field mt-3">
        <input id="share-url" class="min-w-0 flex-1 bg-transparent px-4 text-sm text-mute outline-none" type="text" readonly value={url} data-share-url />
        <button type="button" class="share-copy" data-share-copy>
          <Icon name="copy" class="size-4" />
          <span aria-live="polite" data-share-copy-label>Copy</span>
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  .share-sheet {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 1.25rem;
    border: 0;
    background: transparent;
    color: var(--ink);
  }

  .share-sheet[open] {
    display: grid;
    place-items: center;
  }

  .share-sheet::backdrop {
    background: rgb(13 13 12 / 0.45);
    backdrop-filter: blur(4px);
  }

  .share-panel {
    width: 100%;
    max-width: 28rem;
    max-height: calc(100dvh - 2.5rem);
    overflow-y: auto;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: 0 2rem 4rem -1.5rem rgb(13 13 12 / 0.45);
  }

  .share-sheet[open] .share-panel {
    animation: share-in 0.6s var(--ease-out-expo);
  }

  @keyframes share-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  .share-close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
  }

  .share-targets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem 0.5rem;
  }

  .share-targets li[hidden] {
    display: none;
  }

  .share-target {
    display: grid;
    width: 100%;
    justify-items: center;
    gap: 0.55rem;
    color: var(--mute);
    text-align: center;
    transition: color 0.3s;
  }

  .share-target:hover {
    color: var(--ink);
  }

  .share-icon {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    border-radius: 999px;
    background: var(--network);
    color: #fff;
  }

  .share-target-quiet .share-icon {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .share-field {
    display: flex;
    padding: 0.3rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .share-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    padding-inline: 1.1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  :global(html.has-open-share) {
    overflow: hidden;
  }
</style>

<script>
  const sheet = document.querySelector<HTMLDialogElement>("[data-share-sheet]");

  if (sheet && typeof sheet.showModal === "function") {
    let opener: HTMLElement | null = null;
    const close = () => sheet.open && sheet.close();

    /* Hidden without the script, since they would do nothing. */
    document.querySelectorAll<HTMLElement>("[data-share-card]").forEach((card) => (card.hidden = false));

    document.querySelectorAll<HTMLButtonElement>("[data-share-open]").forEach((button) => {
      button.hidden = false;
      button.addEventListener("click", async () => {
        // Phones get their own share sheet, which knows the reader's apps.
        if (navigator.share && matchMedia("(pointer: coarse)").matches) {
          try {
            await navigator.share({
              title: document.title,
              url: sheet.querySelector<HTMLInputElement>("[data-share-url]")?.value,
            });
            return;
          } catch (error) {
            if ((error as DOMException).name === "AbortError") return;
          }
        }
        opener = button;
        sheet.showModal();
        document.documentElement.classList.add("has-open-share");
      });
    });

    sheet.addEventListener("close", () => {
      document.documentElement.classList.remove("has-open-share");
      opener?.focus({ preventScroll: true });
      opener = null;
    });

    sheet.addEventListener("click", (event) => {
      if (event.target === sheet) close();
    });
    sheet.querySelector("[data-share-close]")?.addEventListener("click", close);
    sheet.querySelectorAll("[data-share-target]").forEach((target) => target.addEventListener("click", close));

    sheet.querySelector("[data-share-more]")?.addEventListener("click", () => {
      sheet.querySelectorAll<HTMLElement>("[data-share-extra]").forEach((item) => (item.hidden = false));
      const more = sheet.querySelector<HTMLElement>("[data-share-more-item]");
      if (more) more.hidden = true;
      sheet.querySelector<HTMLElement>("[data-share-extra] a")?.focus();
    });

    const copy = sheet.querySelector<HTMLButtonElement>("[data-share-copy]");
    const label = sheet.querySelector<HTMLElement>("[data-share-copy-label]");
    const field = sheet.querySelector<HTMLInputElement>("[data-share-url]");
    let restore = 0;

    copy?.addEventListener("click", async () => {
      if (!field || !label) return;
      let message = "Copied";
      try {
        await navigator.clipboard.writeText(field.value);
      } catch {
        field.select();
        message = "Press Ctrl+C";
      }
      label.textContent = message;
      window.clearTimeout(restore);
      restore = window.setTimeout(() => (label.textContent = "Copy"), 2400);
    });
  }
</script>
