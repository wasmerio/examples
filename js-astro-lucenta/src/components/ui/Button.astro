---
import Icon from "@/components/ui/Icon.astro";
import Roll from "@/components/ui/Roll.astro";

interface Props {
  href: string;
  label: string;
  variant?: "solid" | "ghost";
  /** The round arrow at the end. Off gives a plain pill. */
  arrow?: boolean;
  class?: string;
}

const { href, label, variant = "solid", arrow = true, class: className } = Astro.props;
---

<a href={href} class:list={["btn", variant === "ghost" && "btn-ghost", !arrow && "btn-plain", className]}>
  <Roll text={label} />
  {
    arrow && (
      <span class="btn-dot">
        <Icon name="arrow-right" class="size-4" />
      </span>
    )
  }
</a>
