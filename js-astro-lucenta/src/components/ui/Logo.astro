---
import { siteConfig } from "@/config/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["logo", className]}>
  <span class="logo-mark" aria-hidden="true"></span>
  <span class="logo-word">{siteConfig.name.toLowerCase()}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .logo-mark {
    width: 0.62em;
    height: 0.62em;
    border-radius: 999px;
    background: currentColor;
    box-shadow: inset -0.2em 0 0 0 var(--signal);
    transition: box-shadow 0.6s var(--ease-out-expo);
  }

  :where(a):hover .logo-mark {
    box-shadow: inset -0.62em 0 0 0 var(--signal);
  }
</style>
