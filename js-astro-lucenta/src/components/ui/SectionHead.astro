---
import Button from "@/components/ui/Button.astro";

interface Props {
  title: string;
  id?: string;
  link?: { label: string; href: string };
  class?: string;
}

const { title, id, link, class: className } = Astro.props;
---

<div class:list={["flex flex-wrap items-end justify-between gap-x-10 gap-y-6", className]}>
  <h2 id={id} class="display display-lg reveal">
    {title}
  </h2>
  {link && <Button href={link.href} label={link.label} variant="ghost" class="reveal" />}
</div>
