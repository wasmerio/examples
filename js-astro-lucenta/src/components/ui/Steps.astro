---
import { approach } from "@/config/studio";
import { pad } from "@/lib/format";

interface Props {
  title?: string;
}

const { title = "How a project runs" } = Astro.props;
---

<section class="on-ink section" aria-labelledby="steps-title">
  <div class="shell">
    <h2 id="steps-title" class="display display-lg reveal max-w-[14ch]">{title}</h2>
    <ol class="mt-[clamp(3rem,6vw,5rem)] grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        approach.map((step, index) => (
          <li class="step reveal" style={`--i:${index}`}>
            <span class="step-num display">{pad(index + 1)}</span>
            <h3 class="display display-sm mt-6">{step.title}</h3>
            <p class="mt-3 text-mute">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .step-num {
    display: block;
    font-size: clamp(3.5rem, 2rem + 4vw, 6rem);
    color: var(--signal);
  }
</style>
