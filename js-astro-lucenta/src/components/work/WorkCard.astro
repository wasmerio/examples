---
import { Image } from "astro:assets";
import { disciplineLabel, transitionName, workHref, type Work } from "@/lib/work";

interface Props {
  work: Work;
  eager?: boolean;
  class?: string;
}

const { work, eager = false, class: className } = Astro.props;
const { title, headline, cover, coverAlt, disciplines, year, color } = work.data;
---

<article class:list={["work-card group", className]} data-work-item data-disciplines={disciplines.join(" ")} style={`--tint:${color}`}>
  <a href={workHref(work)} class="block">
    <div class="media card-media" data-vt={transitionName(work)}>
      <Image
        src={cover}
        alt={coverAlt}
        widths={[600, 1000, 1600, 2200]}
        sizes="(min-width: 64rem) 50vw, 100vw"
        loading={eager ? "eager" : "lazy"}
        class="zoom-img"
      />
    </div>
    <div class="mt-5 flex flex-wrap items-start justify-between gap-x-6 gap-y-2">
      <div>
        <h2 class="display display-md card-title">
          <span class="card-dot" aria-hidden="true"></span>
          {title}
        </h2>
        <p class="subhead mt-1.5 text-lg text-ink-2">{headline}</p>
      </div>
      <p class="meta pt-1">{disciplines.map(disciplineLabel).join(", ")} · {year}</p>
    </div>
  </a>
</article>

<style>
  .card-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 0;
    transition: gap 0.6s var(--ease-out-expo);
  }

  .card-dot {
    width: 0;
    height: 0.5em;
    border-radius: 999px;
    background: var(--tint);
    transition:
      width 0.6s var(--ease-out-expo),
      margin 0.6s var(--ease-out-expo);
  }

  .group:hover .card-dot {
    width: 0.5em;
    margin-right: 0.3em;
  }
</style>
