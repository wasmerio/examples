---
import { formatDate } from "@/lib/format";
import BaseLayout from "@/layouts/BaseLayout.astro";

/** The layout for the Markdown pages in `src/pages/legal`. */
interface Props {
  frontmatter: {
    title: string;
    description: string;
    /** The date the page last changed, as YYYY-MM-DD. */
    updated: string;
  };
}

const { title, description, updated } = Astro.props.frontmatter;
---

<BaseLayout title={title} description={description}>
  <article class="shell pt-[calc(var(--header-h)+clamp(3rem,7vw,7rem))] pb-[clamp(5rem,10vw,9rem)]">
    <div class="mx-auto max-w-[44rem]">
      <header>
        <h1 class="display display-xl">
          <span class="mask-line" style="--i:1"><span>{title}</span></span>
        </h1>
        <p class="meta rise mt-6" style="--i:2">Last updated <time datetime={updated}>{formatDate(new Date(updated))}</time></p>
      </header>
      <div class="prose mt-14">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
