---
import Button from "@/components/ui/Button.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you were looking for has moved or never existed." noindex>
  <section class="shell flex min-h-svh flex-col justify-end pt-(--header-h) pb-[clamp(3rem,8vw,7rem)]">
    <h1 class="display display-xxl">
      <span class="mask-line" style="--i:1"><span>Lost the light.</span></span>
    </h1>
    <div class="rise mt-10 flex flex-wrap items-end justify-between gap-8" style="--i:4">
      <p class="lead max-w-[34ch]">This page has moved or never existed. The work is still where it always&nbsp;was.</p>
      <div class="flex flex-wrap gap-3">
        <Button href="/" label="Back home" />
        <Button href="/work/" label="See the work" variant="ghost" arrow={false} />
      </div>
    </div>
  </section>
</BaseLayout>
