---
import Icon from "@/components/ui/Icon.astro";
import Roll from "@/components/ui/Roll.astro";
import { contact, faq } from "@/config/contact";
import { noOrphan } from "@/lib/format";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { outbound } from "@/lib/links";
import { socialIcon } from "@/lib/socials";

const form = siteConfig.contact;
const live = form.enabled && form.action !== "";
---

<BaseLayout title="Contact" description={contact.lead}>
  <section class="shell pt-[calc(var(--header-h)+clamp(3rem,7vw,7rem))]">
    <h1 class="display display-xl max-w-[14ch]">
      <span class="mask-line" style="--i:1"><span>Let's make something worth looking at</span></span>
    </h1>
  </section>

  <section class="shell grid gap-[clamp(3rem,6vw,6rem)] pt-[clamp(3rem,6vw,5rem)] pb-[clamp(5rem,10vw,9rem)] lg:grid-cols-12">
    <form class="rise lg:col-span-7" style="--i:3" method={form.method} action={live ? form.action : undefined} data-contact data-live={live ? "" : undefined} novalidate>
      <p class="lead max-w-[46ch]">{noOrphan(contact.lead)}</p>

      <div class="mt-10 grid gap-x-6 gap-y-8 sm:grid-cols-2">
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="name-error" />
          <p id="name-error" class="error" hidden>Tell us your name.</p>
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-error" />
          <p id="email-error" class="error" hidden>Add an email we can reply to.</p>
        </div>
        <div class="field">
          <label for="company">Company <span class="text-mute">(optional)</span></label>
          <input id="company" name="company" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="timing">Timing</label>
          <select id="timing" name="timing">
            {contact.timings.map((timing) => <option>{timing}</option>)}
          </select>
        </div>
      </div>

      <fieldset class="mt-10">
        <legend class="meta">I'm interested in</legend>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            contact.interests.map((interest) => (
              <label class="pick">
                <input type="checkbox" name="interests" value={interest} class="sr-only" />
                <span>{interest}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="mt-10">
        <legend class="meta">Budget</legend>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            contact.budgets.map((budget, index) => (
              <label class="pick">
                <input type="radio" name="budget" value={budget} class="sr-only" checked={index === 1} />
                <span>{budget}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="field mt-10">
        <label for="message">About the project</label>
        <textarea id="message" name="message" rows="5" required aria-describedby="message-error" placeholder="What are you making, and what needs to change?"></textarea>
        <p id="message-error" class="error" hidden>A sentence or two is plenty.</p>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-6">
        <button type="submit" class="btn">
          <Roll text="Send message" />
          <span class="btn-dot"><Icon name="arrow-right" class="size-4" /></span>
        </button>
        {!live && <p class="text-sm text-mute">Demo form: messages are not sent until a form endpoint is set.</p>}
      </div>
      <p class="success mt-8" role="status" data-success hidden>{contact.success}</p>
    </form>

    <aside class="rise lg:col-span-5" style="--i:4">
        <p class="meta">New projects</p>
        <a href={`mailto:${siteConfig.email}`} class="display display-md link-under mt-3 inline-block break-all">{siteConfig.email}</a>
        {
          siteConfig.availability && (
            <p class="mt-6 flex items-center gap-2.5">
              <span class="size-2 rounded-full bg-[#1fbf5c]" aria-hidden="true" />
              {siteConfig.availability}
            </p>
          )
        }
        <div class="mt-12 grid gap-8 sm:grid-cols-2">
          {
            siteConfig.studios.map((studio) => (
              <div>
                <p class="flex items-baseline justify-between gap-3">
                  <span class="display display-sm">{studio.city}</span>
                  <time class="meta text-ink" data-clock={studio.timeZone} />
                </p>
                <address class="mt-3 not-italic text-ink-2">
                  {studio.address.map((line) => (
                    <span class="block">{line}</span>
                  ))}
                  <a href={`tel:${studio.phone.replace(/[^\d+]/g, "")}`} class="link mt-2 inline-block">
                    {studio.phone}
                  </a>
                </address>
              </div>
            ))
          }
        </div>
        <ul class="mt-10 flex flex-wrap gap-2">
          {
            siteConfig.socials.map((social) => (
              <li>
                <a href={social.href} class="social-icon" aria-label={social.label} {...outbound(social.href, "me noopener")}>
                  <Icon name={socialIcon(social.label)} class="size-5" />
                </a>
              </li>
            ))
          }
        </ul>
    </aside>
  </section>

  <section class="on-ink section" aria-labelledby="faq-title">
    <div class="shell grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="faq-title" class="display display-lg">Good to&nbsp;know</h2>
      </div>
      <div class="lg:col-span-8">
        {
          faq.map((item) => (
            <details class="faq">
              <summary>
                <span class="display display-sm">{item.question}</span>
                <span class="faq-icon" aria-hidden="true" />
              </summary>
              <p class="lead max-w-[56ch] pb-8">{noOrphan(item.answer)}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.6rem 0 0.75rem;
    border: 0;
    border-bottom: 1.5px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    font-size: 1.25rem;
    transition: border-color 0.3s;
  }

  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .field select {
    appearance: none;
    background: linear-gradient(45deg, transparent 50%, currentColor 50%) no-repeat calc(100% - 0.35rem) 55% / 0.4rem 0.4rem,
      linear-gradient(-45deg, transparent 50%, currentColor 50%) no-repeat 100% 55% / 0.4rem 0.4rem;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--ink);
  }

  .field [aria-invalid="true"] {
    border-color: #d13a15;
  }

  .error {
    color: #b8320f;
    font-size: 0.875rem;
  }

  .pick span {
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding-inline: 1.2rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.3s,
      color 0.3s,
      box-shadow 0.3s;
  }

  .pick:hover span {
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .pick input:checked + span {
    background: var(--ink);
    color: var(--paper);
  }

  .pick input:focus-visible + span {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }

  .success {
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: var(--signal);
    color: #0d0d0c;
    font-weight: 600;
  }

  .faq {
    border-bottom: 1px solid var(--line);
  }

  .faq:first-child {
    border-top: 1px solid var(--line);
  }

  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.75rem;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition:
      transform 0.5s var(--ease-out-expo),
      background-color 0.3s;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.9rem;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
  }

  .faq-icon::after {
    rotate: 90deg;
  }

  .faq[open] .faq-icon {
    transform: rotate(45deg);
    background: var(--signal);
    color: #0d0d0c;
    box-shadow: none;
  }

  .faq summary:hover .faq-icon {
    box-shadow: inset 0 0 0 1px var(--ink);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact]");
  const success = form?.querySelector<HTMLElement>("[data-success]");

  const validate = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const valid = field.checkValidity();
    field.setAttribute("aria-invalid", String(!valid));
    const error = document.getElementById(`${field.id}-error`);
    if (error) error.hidden = valid;
    return valid;
  };

  const required = Array.from(form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]") ?? []);
  required.forEach((field) =>
    field.addEventListener("blur", () => {
      if (field.value) validate(field);
    }),
  );

  form?.addEventListener("submit", (event) => {
    const results = required.map(validate);
    if (results.includes(false)) {
      event.preventDefault();
      required[results.indexOf(false)]?.focus();
      return;
    }
    /* Without an endpoint the form only shows its thank-you message. */
    if (!form.hasAttribute("data-live")) {
      event.preventDefault();
      form.reset();
      if (success) success.hidden = false;
    }
  });
</script>
