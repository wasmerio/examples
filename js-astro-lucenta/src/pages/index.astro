---
import Hero from "@/components/home/Hero.astro";
import Manifesto from "@/components/home/Manifesto.astro";
import Proof from "@/components/home/Proof.astro";
import ServicesList from "@/components/home/ServicesList.astro";
import WorkStack from "@/components/home/WorkStack.astro";
import EntryCard from "@/components/journal/EntryCard.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { journalBlock, selectedWork } from "@/config/home";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getJournal } from "@/lib/journal";
import { featuredWork, getWork } from "@/lib/work";

const work = await getWork();
const featured = featuredWork(work).slice(0, selectedWork.limit);
const entries = (await getJournal()).slice(0, 3);
---

<BaseLayout>
  <Hero work={work} />
  <WorkStack work={featured} total={work.length} />
  <Manifesto />
  <ServicesList work={work} />
  <Proof />
  {
    entries.length > 0 && (
      <section class="section pt-0" aria-labelledby="journal-title">
        <div class="shell">
          <SectionHead id="journal-title" title={journalBlock.title} link={journalBlock.link} />
          <div class="mt-[clamp(2.5rem,5vw,4.5rem)] grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {entries.map((entry, index) => (
              <EntryCard entry={entry} class={index === 2 ? "sm:max-lg:hidden" : undefined} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
