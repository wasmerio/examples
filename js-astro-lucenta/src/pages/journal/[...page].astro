---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import EntryGrid from "@/components/journal/EntryGrid.astro";
import JournalHeader from "@/components/journal/JournalHeader.astro";
import Pagination from "@/components/journal/Pagination.astro";
import { journalPageSize } from "@/config/journal";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getJournal } from "@/lib/journal";

export const getStaticPaths = (async ({ paginate }) => {
  const entries = await getJournal();
  const lead = entries.find((entry) => entry.data.featured) ?? entries[0];
  const ordered = lead ? [lead, ...entries.filter((entry) => entry !== lead)] : entries;
  return paginate(ordered, { pageSize: journalPageSize });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const first = page.currentPage === 1;
const title = "Journal";
const lead = "Notes on craft, process and life in the studio, written by the people who do the work.";
---

<BaseLayout title={first ? title : `${title}, page ${page.currentPage}`} description={lead} prevUrl={page.url.prev} nextUrl={page.url.next}>
  <JournalHeader title={title} lead={lead} />
  <div class="shell pb-[clamp(5rem,10vw,10rem)]">
    <EntryGrid entries={page.data} lead={first} />
    {page.data.length === 0 && <p class="lead">Nothing published yet.</p>}
    <Pagination current={page.currentPage} last={page.lastPage} base="/journal/" />
  </div>
</BaseLayout>
