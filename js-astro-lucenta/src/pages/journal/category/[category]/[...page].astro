---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import EntryGrid from "@/components/journal/EntryGrid.astro";
import JournalHeader from "@/components/journal/JournalHeader.astro";
import Pagination from "@/components/journal/Pagination.astro";
import { journalCategories, journalCategoryKeys, journalPageSize } from "@/config/journal";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getJournal, journalCategoryHref } from "@/lib/journal";

export const getStaticPaths = (async ({ paginate }) => {
  const entries = await getJournal();
  return journalCategoryKeys.flatMap((category) =>
    paginate(
      entries.filter((entry) => entry.data.category === category),
      { params: { category }, props: { category }, pageSize: journalPageSize },
    ),
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, category } = Astro.props as Props;
const { label, description } = journalCategories[category];
---

<BaseLayout title={page.currentPage === 1 ? label : `${label}, page ${page.currentPage}`} description={description} prevUrl={page.url.prev} nextUrl={page.url.next}>
  <JournalHeader title={label} lead={description} current={category} />
  <div class="shell pb-[clamp(5rem,10vw,10rem)]">
    {
      page.data.length > 0 ? (
        <EntryGrid entries={page.data} />
      ) : (
        <p class="lead">
          Nothing filed under {label.toLowerCase()} yet.{" "}
          <a href="/journal/" class="link-under text-ink">
            See every entry
          </a>
          .
        </p>
      )
    }
    <Pagination current={page.currentPage} last={page.lastPage} base={journalCategoryHref(category)} />
  </div>
</BaseLayout>
