---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import Steps from "@/components/ui/Steps.astro";
import { services } from "@/config/services";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { noOrphan, pad } from "@/lib/format";
import { getWork, workHref } from "@/lib/work";

const work = await getWork();
const byId = new Map(work.map((item) => [item.id, item]));
const rows = services.map((service) => {
  const related = work.filter((item) => item.data.disciplines.includes(service.key));
  /* Falls back to the newest project in the discipline if the named one is missing or a draft. */
  const hero = byId.get(service.project) ?? related[0];
  return { ...service, hero, more: related.filter((item) => item.id !== hero?.id).slice(0, 3) };
});
---

<BaseLayout title="Services" description="Brand identity, digital, packaging, campaign and spatial design from Lucenta, an independent studio in Lisbon and New York.">
  <section class="shell pt-[calc(var(--header-h)+clamp(3rem,7vw,7rem))] pb-[clamp(3rem,6vw,6rem)]">
    <h1 class="display display-xxl">
      <span class="mask-line" style="--i:1"><span>Five ways in.</span></span>
    </h1>
    <div class="rise mt-10 grid gap-8 lg:grid-cols-12" style="--i:3">
      <p class="lead max-w-[44ch] lg:col-span-6">
        Most clients start with one and end up with three. However you come in, the same small team takes the work from the first workshop to launch&nbsp;day.
      </p>
      <nav aria-label="Services" class="lg:col-span-6 lg:justify-self-end">
        <ul class="flex flex-wrap gap-2 lg:justify-end">
          {
            rows.map((service) => (
              <li>
                <a href={`#${service.key}`} class="chip transition-colors hover:bg-ink hover:text-paper">
                  {service.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  {
    rows.map((service, index) => (
      <section id={service.key} class="service shell" aria-labelledby={`${service.key}-title`}>
        <div class="grid items-end gap-x-10 gap-y-6 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <span class="meta">
              {pad(index + 1)} / {pad(rows.length)}
            </span>
            <h2 id={`${service.key}-title`} class="display display-lg mt-4">
              {service.title}
            </h2>
          </div>
          <p class="lead max-w-[48ch] lg:col-span-6">{noOrphan(service.description)}</p>
        </div>

        {service.hero && (
          <a href={workHref(service.hero)} class="group mt-[clamp(2rem,4vw,3.5rem)] block">
            <div class="media reveal-img service-media">
              <Image src={service.hero.data.cover} alt={service.hero.data.coverAlt} widths={[800, 1400, 2000, 2400]} sizes="(min-width: 110rem) 105rem, 100vw" class="zoom-img" />
            </div>
            <p class="mt-4 flex items-center justify-between gap-4">
              <span>
                <span class="font-semibold">{service.hero.data.title}</span>
                <span class="ml-2 text-ink-2">{service.hero.data.headline}</span>
              </span>
              <Icon name="arrow-up-right" class="size-5" />
            </p>
          </a>
        )}

        <div class="mt-[clamp(2.5rem,5vw,4rem)] grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <h3 class="meta">What we deliver</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {service.deliverables.map((deliverable) => (
                <li class="chip h-10 px-4 text-[0.95rem]">{deliverable}</li>
              ))}
            </ul>
          </div>
          {service.more.length > 0 && (
            <div class="lg:col-span-6">
              <h3 class="meta">More {service.title.toLowerCase()} work</h3>
              <ul class="mt-3 border-t border-line">
                {service.more.map((item) => (
                  <li class="border-b border-line">
                    <a href={workHref(item)} class="related-link flex items-center justify-between gap-4 py-4">
                      <span class="flex items-center gap-3">
                        <span class="size-3 rounded-full" style={`background:${item.data.color}`} aria-hidden="true" />
                        <span class="display text-xl">{item.data.title}</span>
                        <span class="hidden text-mute sm:inline">{item.data.sector}</span>
                      </span>
                      <Icon name="arrow-right" class="size-5" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    ))
  }

  <div class="h-[clamp(5rem,10vw,10rem)]"></div>
  <Steps />
</BaseLayout>

<style>
  .service + .service {
    margin-top: clamp(6rem, 12vw, 11rem);
  }

  .service {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .service-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
  }

  @media (min-width: 48rem) {
    .service-media {
      aspect-ratio: 21 / 9;
    }
  }

  .related-link {
    transition: padding 0.5s var(--ease-out-expo);
  }

  .related-link:hover {
    padding-inline: 0.75rem;
  }
</style>
