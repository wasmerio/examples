---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import Steps from "@/components/ui/Steps.astro";
import { clients } from "@/config/clients";
import { figures } from "@/config/home";
import { careers, recognition, studio } from "@/config/studio";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { noOrphan } from "@/lib/format";
import { outbound } from "@/lib/links";
import { getPeople } from "@/lib/people";
import space from "@/assets/studio/space.jpg";
import wall from "@/assets/studio/wall.jpg";

const people = await getPeople();
const logos = import.meta.glob<string>("/src/assets/clients/*.svg", { query: "?raw", import: "default", eager: true });
const marks = clients
  .map((client) => ({ name: client.name, svg: logos[`/src/assets/clients/${client.logo}.svg`] }))
  .filter((mark) => mark.svg)
  .slice(0, 12);
---

<BaseLayout title="Studio" description={studio.lead} image={space} imageAlt="The Lucenta studio">
  <section class="shell pt-[calc(var(--header-h)+clamp(3rem,7vw,7rem))]">
    <h1 class="display display-xl max-w-[13ch]">
      <span class="mask-line" style="--i:1"><span>A small studio with a loud point of view</span></span>
    </h1>
    <p class="lead rise mt-10 max-w-[52ch]" style="--i:4">{noOrphan(studio.lead)}</p>
  </section>

  <div class="mt-[clamp(3rem,7vw,6rem)] px-(--gutter)">
    <div class="media parallax studio-hero" style={`aspect-ratio:${space.width}/${space.height}`}>
      <Image src={space} alt="Inside the Lucenta studio: tall windows, long tables and a wall of work in progress" widths={[800, 1400, 2000, 2400]} sizes="100vw" loading="eager" />
    </div>
  </div>

  <section class="shell section grid gap-12 lg:grid-cols-12" aria-label="Our story">
    <div class="lg:col-span-5">
      <div class="media reveal-img aspect-4/5 rounded-(--radius)">
        <Image src={wall} alt="A studio wall pinned with prints, colour chips and photographs" widths={[600, 1000, 1400]} sizes="(min-width: 64rem) 40vw, 100vw" />
      </div>
    </div>
    <div class="flex flex-col justify-between gap-12 lg:col-span-6 lg:col-start-7">
      <div class="grid gap-6">
        {studio.story.map((paragraph) => <p class="display display-sm reveal leading-[1.12] font-semibold">{noOrphan(paragraph)}</p>)}
      </div>
      <dl class="grid grid-cols-2 gap-x-6 gap-y-10">
        {
          figures.map((figure) => (
            <div class="reveal flex flex-col">
              <dt class="meta">{figure.label}</dt>
              <dd class="display display-lg mt-auto pt-3">
                <span data-count={figure.value}>{figure.value}</span>
                {figure.suffix}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="team" class="shell pb-[clamp(5rem,10vw,10rem)]" aria-labelledby="team-title">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 id="team-title" class="display display-lg reveal">
        The team
      </h2>
      <p class="reveal max-w-[34ch] text-mute">The people you meet in the first workshop are the people who design, write and build your project.</p>
    </div>
    <ul class="mt-[clamp(2.5rem,5vw,4rem)] grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        people.map((person) => (
          <li class="reveal">
            <div class="media aspect-2/3 rounded-(--radius)">
              <Image src={person.data.portrait} alt={`Portrait of ${person.data.name}`} widths={[480, 800, 1100]} sizes="(min-width: 64rem) 32vw, (min-width: 40rem) 50vw, 100vw" />
            </div>
            <div class="mt-4 flex items-start justify-between gap-4">
              <div>
                <h3 class="display display-sm">{person.data.name}</h3>
                <p class="mt-1 text-mute">
                  {person.data.role} · {person.data.location}
                </p>
              </div>
              <div class="flex gap-1.5">
                {person.data.linkedin && (
                  <a href={person.data.linkedin} class="social" aria-label={`${person.data.name} on LinkedIn`} {...outbound(person.data.linkedin)}>
                    <Icon name="social-linkedin" class="size-3.5" />
                  </a>
                )}
                {person.data.instagram && (
                  <a href={person.data.instagram} class="social" aria-label={`${person.data.name} on Instagram`} {...outbound(person.data.instagram)}>
                    <Icon name="social-instagram" class="size-3.5" />
                  </a>
                )}
              </div>
            </div>
            <p class="mt-3 max-w-[42ch] text-[0.95rem] text-mute">{noOrphan(person.body?.trim() ?? "")}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <Steps title="Four steps, no surprises" />

  <section class="shell section" aria-labelledby="awards-title">
    <h2 id="awards-title" class="display display-lg reveal">Kind words from juries</h2>
    <ul class="mt-12 border-t border-line">
      {
        recognition.map((row) => (
          <li class="award reveal">
            <span class="award-name display text-[clamp(1.2rem,0.95rem+0.8vw,1.75rem)]">{row.award}</span>
            <span class="award-body text-ink-2">{row.body}</span>
            <span class="award-project font-medium">{row.project}</span>
            <span class="award-year meta text-right">{row.year}</span>
          </li>
        ))
      }
    </ul>

    <h2 class="display display-md reveal mt-[clamp(5rem,9vw,8rem)]">Clients we have worked with</h2>
    <ul class="logos mt-10">
      {
        marks.map((mark) => (
          <li class="logo-cell">
            <span set:html={mark.svg} aria-hidden="true" />
            <span class="sr-only">{mark.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="careers" aria-labelledby="careers-title">
    <div class="shell grid items-end gap-10 py-[clamp(4rem,8vw,8rem)] lg:grid-cols-12">
      <h2 id="careers-title" class="display display-xl lg:col-span-7">{careers.title}</h2>
      <div class="lg:col-span-5">
        <p class="text-lg">{careers.text}</p>
        <a href={`mailto:${careers.email}`} class="btn mt-8">
          <span class="roll"><span data-text={careers.email}>{careers.email}</span></span>
          <span class="btn-dot bg-paper! text-ink!"><Icon name="arrow-right" class="size-4" /></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .studio-hero {
    border-radius: var(--radius);
  }

  .social {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .social:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .award {
    display: grid;
    grid-template:
      "name year" auto
      "body body" auto
      "project project" auto / 1fr auto;
    gap: 0.25rem 2rem;
    align-items: baseline;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .award-name {
    grid-area: name;
  }

  .award-body {
    grid-area: body;
  }

  .award-project {
    grid-area: project;
  }

  .award-year {
    grid-area: year;
  }

  @media (min-width: 64rem) {
    .award {
      grid-template: "name body project year" auto / 1.3fr 1fr 1fr 5rem;
    }
  }

  .logos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .logos {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .logos {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .logo-cell {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    background: var(--paper-2);
  }

  .logo-cell :global(svg) {
    height: clamp(1.5rem, 1rem + 1vw, 2.25rem);
    width: auto;
  }

  .careers {
    background: var(--signal);
    color: #0d0d0c;
  }

  .careers .btn {
    background: #0d0d0c;
    color: #f3f1ec;
  }
</style>
