---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import WorkCard from "@/components/work/WorkCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { disciplineCounts, disciplineLabel, getWork, workHref } from "@/lib/work";

const work = await getWork();
const filters = disciplineCounts(work);
---

<BaseLayout title="Work" description="Brand identities, websites, packaging, campaigns and spaces made by Lucenta for independent companies.">
  <section class="shell pt-[calc(var(--header-h)+clamp(3rem,7vw,7rem))]">
    <h1 class="display display-xxl">
      <span class="mask-line" style="--i:1">
        <span>Selected work</span>
      </span>
    </h1>
    <p class="lead rise mt-8 max-w-[44ch]" style="--i:3">
      Brands, websites, packaging and spaces for companies that would rather be seen. Every project here started with one idea and one&nbsp;colour.
    </p>

    <div class="rise mt-12 flex flex-wrap items-center justify-between gap-6" style="--i:4">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by discipline" data-filters>
        <button type="button" class="chip filter gap-1.5" aria-pressed="true" data-filter="all">
          All <span class="text-mute">{work.length}</span>
        </button>
        {
          filters.map((filter) => (
            <button type="button" class="chip filter gap-1.5" aria-pressed="false" data-filter={filter.key}>
              {disciplineLabel(filter.key)} <span class="text-mute">{filter.count}</span>
            </button>
          ))
        }
      </div>
      <div class="flex gap-1 rounded-full p-1 shadow-[inset_0_0_0_1px_var(--line-strong)]" role="group" aria-label="Layout">
        <button type="button" class="view-toggle" aria-pressed="true" data-view="grid">Grid</button>
        <button type="button" class="view-toggle" aria-pressed="false" data-view="list">List</button>
      </div>
    </div>
  </section>

  <section class="shell pt-10 pb-[clamp(5rem,10vw,10rem)]" aria-label="Projects" data-work-root data-view="grid">
    <p class="sr-only" aria-live="polite" data-status></p>

    <div class="work-grid" data-layout="grid">
      {work.map((item, index) => <WorkCard work={item} eager={index < 2} />)}
    </div>

    <div class="relative" data-layout="list" data-follow hidden>
      <ul class="border-t border-line">
        {
          work.map((item) => (
            <li data-work-item data-disciplines={item.data.disciplines.join(" ")} class:list={["work-row", item.data.ink === "light" ? "row-light" : "row-dark"]} style={`--tint:${item.data.color}`}>
              <a href={workHref(item)} class="work-row-link" data-follow-key={item.id}>
                <span class="meta">{item.data.year}</span>
                <span class="display display-md">{item.data.title}</span>
                <span class="subhead hidden text-lg md:block">{item.data.headline}</span>
                <span class="meta hidden lg:block">{item.data.disciplines.map(disciplineLabel).join(", ")}</span>
                <Icon name="arrow-up-right" class="size-6 justify-self-end" />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="follow-float" data-follow-float aria-hidden="true">
        {work.map((item) => <Image src={item.data.cover} alt="" widths={[480, 800]} sizes="24rem" data-follow-image={item.id} />)}
      </div>
    </div>

    <p class="lead mt-10" data-empty hidden>No projects in this discipline yet.</p>
  </section>
</BaseLayout>

<style>
  .filter[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }

  .filter[aria-pressed="true"] span {
    color: inherit;
    opacity: 0.6;
  }

  .filter:not([aria-pressed="true"]):hover {
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .view-toggle {
    height: 2.25rem;
    padding-inline: 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .view-toggle[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
  }

  .work-grid {
    display: grid;
    gap: clamp(3rem, 5vw, 5rem) clamp(1rem, 2vw, 2rem);
  }

  @media (min-width: 48rem) {
    .work-grid {
      grid-template-columns: 1fr 1fr;
    }

    /* Every third visible project runs full width, so the rhythm survives filtering. */
    .work-grid > :nth-child(3n + 1 of :not([hidden])) {
      grid-column: 1 / -1;
    }

    .work-grid > :nth-child(3n + 1 of :not([hidden])) :global(.card-media) {
      aspect-ratio: 21 / 10;
    }

    .work-grid > :nth-child(3n of :not([hidden])) {
      margin-top: clamp(0rem, 8vw, 9rem);
    }
  }

  .work-row {
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  .work-row::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--tint);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .work-row-link {
    position: relative;
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(1.25rem, 2.2vw, 2rem) 0.5rem;
    transition:
      color 0.4s,
      padding 0.6s var(--ease-out-expo);
  }

  @media (min-width: 48rem) {
    .work-row-link {
      grid-template-columns: 5rem 1.1fr 1fr auto;
    }
  }

  @media (min-width: 64rem) {
    .work-row-link {
      grid-template-columns: 5rem 1.1fr 1fr 14rem auto;
    }
  }

  .work-row:hover::before {
    transform: scaleY(1);
    transform-origin: 50% 0;
  }

  .work-row:hover .work-row-link {
    padding-inline: 1.5rem;
  }

  .row-light:hover .work-row-link,
  .row-light:hover .meta {
    color: #fbfaf7;
  }

  .row-dark:hover .work-row-link,
  .row-dark:hover .meta {
    color: #0d0d0c;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-work-root]");
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-view]")).filter((el) => el.tagName === "BUTTON");
  const layouts = Array.from(document.querySelectorAll<HTMLElement>("[data-layout]"));
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-work-item]"));
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const status = document.querySelector<HTMLElement>("[data-status]");

  const applyFilter = (key: string, push = true) => {
    if (!filterButtons.some((button) => button.dataset.filter === key)) key = "all";
    filterButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.filter === key)));
    let shown = 0;
    for (const item of items) {
      const match = key === "all" || (item.dataset.disciplines ?? "").split(" ").includes(key);
      item.hidden = !match;
      if (match && item.closest("[data-layout='grid']")) shown++;
    }
    if (empty) empty.hidden = shown > 0;
    if (status) status.textContent = `${shown} project${shown === 1 ? "" : "s"}`;
    if (push) {
      const url = new URL(location.href);
      if (key === "all") url.searchParams.delete("discipline");
      else url.searchParams.set("discipline", key);
      history.replaceState(null, "", url);
    }
  };

  const applyView = (view: string) => {
    viewButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.view === view)));
    layouts.forEach((layout) => (layout.hidden = layout.dataset.layout !== view));
    if (root) root.dataset.view = view;
    try {
      localStorage.setItem("lucenta-work-view", view);
    } catch {}
  };

  filterButtons.forEach((button) => button.addEventListener("click", () => applyFilter(button.dataset.filter ?? "all")));
  viewButtons.forEach((button) => button.addEventListener("click", () => applyView(button.dataset.view ?? "grid")));

  applyFilter(new URLSearchParams(location.search).get("discipline") ?? "all", false);
  try {
    const saved = localStorage.getItem("lucenta-work-view");
    if (saved === "list") applyView("list");
  } catch {}
</script>
