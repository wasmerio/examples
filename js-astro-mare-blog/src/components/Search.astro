---
import { Icon } from "astro-icon/components";
const isDev = import.meta.env.DEV;
---

<button
  id="search-toggle"
  type="button"
  aria-label="Search"
  data-tooltip="Search"
  class="nav-scale-bg cursor-pointer rounded-md p-2 text-sm font-medium text-gray-600 transition-colors duration-200 hover:text-blue-600 hover:before:bg-blue-50/70 dark:text-gray-400 dark:hover:text-blue-400 dark:hover:before:bg-gray-800"
>
  <Icon name="lucide:search" class="h-5 w-5" />
</button>

{
  !isDev && (
    <>
      <pagefind-modal-trigger
        instance="site-search"
        compact
        data-tooltip="Search"
        id="pagefind-search-trigger"
        hidden
      />
      <pagefind-modal instance="site-search" />
    </>
  )
}

{
  isDev && (
    <dialog
      id="search-dev-dialog"
      aria-labelledby="search-dev-title"
      class="mx-auto mt-[10dvh] mb-auto max-h-[min(80dvh,800px)] w-full max-w-140 overflow-hidden rounded-xl border border-gray-200 bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-black/50 dark:border-neutral-800 dark:bg-neutral-900 dark:text-gray-100 dark:shadow-black/60"
    >
      <div class="flex items-center gap-2 border-b border-gray-200 px-4 py-4 dark:border-neutral-800">
        <Icon
          name="lucide:search"
          class="h-4 w-4 shrink-0 text-gray-500 dark:text-gray-400"
        />
        <h2
          id="search-dev-title"
          class="m-0 min-w-0 flex-1 truncate text-base leading-5 font-normal tracking-normal text-gray-500 dark:text-gray-400"
        >
          Search
        </h2>
      </div>
      <div class="px-4 py-8 text-center">
        <Icon
          name="lucide:info"
          class="mx-auto mb-3 h-5 w-5 text-gray-500 dark:text-gray-400"
        />
        <p class="mb-1 text-sm font-medium text-gray-700 dark:text-gray-200">
          Search is unavailable in development
        </p>
        <p class="text-xs text-gray-500 dark:text-gray-400">
          Build the site and use preview mode to test Pagefind search.
        </p>
      </div>
      <div class="border-t border-gray-200 px-4 py-2.5 text-xs text-gray-500 dark:border-neutral-800 dark:text-gray-400">
        Press
        <kbd class="mx-1 rounded border border-gray-300 px-1.5 py-0.5 text-[10px] dark:border-gray-700 dark:bg-neutral-800">
          Esc
        </kbd>
        to close
      </div>
    </dialog>
  )
}

<script>
  import "@pagefind/component-ui";
</script>

<style is:global>
  @import "@pagefind/component-ui/css";

  @media (prefers-reduced-motion: no-preference) {
    #search-dev-dialog[open] {
      animation: search-dev-dialog-appear 0.15s ease-out;
    }

    @keyframes search-dev-dialog-appear {
      from {
        opacity: 0;
        transform: scale(0.95);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }
  }
</style>

<script is:inline>
  (() => {
    const syncPagefindTheme = () => {
      const pagefindModal = document.querySelector("pagefind-modal");
      if (!(pagefindModal instanceof HTMLElement)) return;

      if (document.documentElement.classList.contains("dark")) {
        pagefindModal.setAttribute("data-pf-theme", "dark");
      } else {
        pagefindModal.removeAttribute("data-pf-theme");
      }
    };

    const setupSearchToggle = () => {
      syncPagefindTheme();
      const searchButton = document.getElementById("search-toggle");
      const devDialog = document.getElementById("search-dev-dialog");

      if (!searchButton) return;

      if (devDialog instanceof HTMLDialogElement) {
        devDialog.onclick = (event) => {
          if (event.target === devDialog) devDialog.close();
        };
      }

      searchButton.onclick = () => {
        if (devDialog instanceof HTMLDialogElement) {
          if (!devDialog.open) devDialog.showModal();
          return;
        }

        const modal = document.querySelector("pagefind-modal");
        if (modal && "open" in modal && typeof modal.open === "function") {
          modal.open();
        }
      };
    };

    setupSearchToggle();
    if (!window.__searchToggleBound) {
      window.__searchToggleBound = true;
      document.addEventListener("theme-changed", syncPagefindTheme);
      document.addEventListener("astro:after-swap", setupSearchToggle);
    }
  })();
</script>
