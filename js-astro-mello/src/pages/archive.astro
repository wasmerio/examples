---
import Layout from '../layouts/Layout.astro'
import PageHeader from '../components/PageHeader.astro'
import { getCollection } from 'astro:content'
const allPosts = await getCollection('posts')
const posts = allPosts.sort((a, b) => {
  return new Date(b.data.published).getTime() - new Date(a.data.published).getTime()
})

const title = '归档'
---

<Layout title={title}>
  <PageHeader title={title} subtitle="浏览所有已发布的文章" />
  <ul class="archive">
    {posts.map(post => (
      <li class="archive-item">
        <span class="archive-published">{post.data.published.toISOString().split('T')[0]}</span>
        <a href={`/post/${post.data.id ?? post.id}`} class="archive-title hover-underline">{post.data.title}</a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .archive {
    list-style: none;
    margin: 0;
    padding: 1rem 0;
  }

  .archive-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: .75rem 0;
  }
  .archive-item:first-child{
    padding: 0 0 .75rem 0;
  }
  .archive-item:last-child{
    padding: .75rem 0 0 0;
  }
  .archive-item:only-child {
    padding: 0;
  }

  .archive-published {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
    font-family: Consolas, "Noto serif SC", serif;
    flex-shrink: 0;
    min-width: 4rem;
  }

  .archive-title {
    font-size: var(--text-content-fontsize);
    color: var(--text-logo-color);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .archive-item {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
