---
import Layout from '../layouts/Layout.astro'
import PageHeader from '../components/PageHeader.astro'
import { getCollection } from 'astro:content'

const posts = await getCollection('posts')

// 分类统计：名称 -> 文章数
const categoryMap = new Map<string, number>()
for (const post of posts) {
  const c = post.data.category || '未分类'
  categoryMap.set(c, (categoryMap.get(c) || 0) + 1)
}

const title = '分类'
---

<Layout title={title}>
  <PageHeader title={title} subtitle="按分类浏览文章" />
  <div class="category">
    {[...categoryMap.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => (
      <a
        href={`/category/${name}`}
        class="category-item hover-underline"
        title={`${count} 篇`}
      >{name}<span class="category-count">{count}</span></a>
    ))}
  </div>
</Layout>

<style>
  .category {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 16px;
    padding: 1rem 0;
  }

  .category-item {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: var(--text-content-color);
    font-size: var(--text-content-fontsize);
    text-decoration: none;
  }

  .category-count {
    color: var(--text-faint-color);
  }
</style>
