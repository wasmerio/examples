---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  const categories = [...new Set(posts.map(p => p.data.category || '未分类'))]
  return categories.map(name => ({
    params: { name },
    props: { name },
  }))
}

const { name } = Astro.props

const posts = (await getCollection('posts'))
  .filter(post => (post.data.category || '未分类') === name)
  .sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime())

const title = `分类：${name}`
---

<Layout title={title}>
  <ul class="post-list">
    {posts.map(post => (
      <li class="post-list-item">
        <span class="post-list-published">{post.data.published.toISOString().split('T')[0]}</span>
        <a href={`/post/${post.data.id ?? post.id}`} class="post-list-title hover-underline">{post.data.title}</a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .post-list {
    list-style: none;
    padding: 2rem 0;
    margin: 0;
  }

  .post-list-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: .75rem 0;
  }

  .post-list-published {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
    font-family: Consolas, "Noto serif SC", serif;
    flex-shrink: 0;
    min-width: 4rem;
  }

  .post-list-title {
    font-size: var(--text-content-fontsize);
    color: var(--text-logo-color);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .post-list-item {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
