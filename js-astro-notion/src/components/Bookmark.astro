---
/**
 * Notion-style bookmark card for an external link.
 *
 * <Bookmark href="https://astro.build" title="Astro" description="The web framework" />
 */
const { href, title, description = null, class: className } = Astro.props;
let host = href;
try { host = new URL(href).host; } catch { /* leave as given */ }
---

<a class:list={['nt-bookmark', className]} href={href} rel="noopener noreferrer">
  <div class="nt-bookmark__title">{title}</div>
  {description && <div class="nt-bookmark__desc">{description}</div>}
  <div class="nt-bookmark__url">{host}</div>
</a>
