---
/**
 * Notion-style button. Renders <a> when given href, otherwise <button>.
 *
 * <Button href="https://example.com">Get started</Button>
 * <Button variant="secondary">Cancel</Button>
 */
const { href = null, variant = 'primary', class: className, ...rest } = Astro.props;
const classes = ['nt-button', variant === 'secondary' && 'nt-button--secondary', className];
const external = href && /^https?:/i.test(href);
---

{href ? (
  <a class:list={classes} href={href} rel={external ? 'noopener noreferrer' : null} {...rest}>
    <slot />
  </a>
) : (
  <button class:list={classes} type="button" {...rest}><slot /></button>
)}
