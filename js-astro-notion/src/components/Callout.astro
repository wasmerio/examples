---
/**
 * Notion-style callout.
 *
 * <Callout icon="💡" color="blue">Text or any markup.</Callout>
 */
const COLORS = ['default', 'gray', 'brown', 'orange', 'yellow', 'green', 'blue', 'purple', 'pink', 'red'];

const { icon = null, color = 'default', class: className } = Astro.props;
const tone = COLORS.includes(color) ? color : 'default';
---

<aside class:list={['nt-callout', tone !== 'default' && `nt-callout--${tone}`, className]}>
  {icon && <span class="nt-callout__icon" aria-hidden="true">{icon}</span>}
  <div class="nt-callout__body"><slot /></div>
</aside>
