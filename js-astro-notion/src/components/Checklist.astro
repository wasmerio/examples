---
/**
 * Notion-style to-do list. Read-only, matching how a published Notion page
 * renders — checkboxes are disabled so the list stays static HTML.
 *
 * <Checklist items={[{ text: 'Ship it', checked: true }, { text: 'Tell people' }]} />
 */
const { items = [], class: className } = Astro.props;
---

<ul class:list={['nt-todo', className]}>
  {items.map((item) => (
    <li data-checked={item.checked ? 'true' : 'false'}>
      <input type="checkbox" checked={!!item.checked} disabled aria-label={item.text} />
      <span>{item.text}</span>
    </li>
  ))}
</ul>
