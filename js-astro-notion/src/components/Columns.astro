---
/**
 * Notion-style column layout. Wrap <Column> children.
 *
 * <Columns>
 *   <Column ratio={2}>wide</Column>
 *   <Column>narrow</Column>
 * </Columns>
 *
 * Columns stack on narrow screens rather than squeezing.
 */
const { class: className } = Astro.props;
---

<div class:list={['nt-columns', className]}><slot /></div>
