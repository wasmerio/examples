---
/**
 * Notion page header: optional cover image, optional icon (emoji or image),
 * title and description. With a cover, the icon overlaps its lower edge the
 * way Notion does.
 *
 * <PageHeader title="Handbook" icon="📘" cover="/cover.jpg" description="…" />
 */
const { title, description = null, icon = null, cover = null } = Astro.props;
const iconIsImage = icon ? /^(https?:|\/)/.test(String(icon)) : false;
---

{cover && <img class="nt-cover" src={cover} alt="" fetchpriority="high" />}

{icon && (
  <div class="nt-page-icon" aria-hidden="true">
    {iconIsImage ? <img src={icon} alt="" /> : icon}
  </div>
)}

<h1 class="nt-title">{title}</h1>
{description && <p class="nt-description">{description}</p>}
