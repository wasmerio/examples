---
/**
 * Notion-style toggle. Uses <details>, so it works with no JavaScript
 * and stays readable to crawlers even when collapsed.
 *
 * <Toggle summary="How does it work?" open>Answer…</Toggle>
 */
const { summary, open = false, class: className } = Astro.props;
---

<details class:list={['nt-toggle', className]} open={open}>
  <summary>{summary}</summary>
  <div class="nt-toggle__body"><slot /></div>
</details>
