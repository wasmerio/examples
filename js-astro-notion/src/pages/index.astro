---
import NotionPage from '../layouts/NotionPage.astro';
import Callout from '../components/Callout.astro';
import Columns from '../components/Columns.astro';
import Column from '../components/Column.astro';
import Toggle from '../components/Toggle.astro';
import Quote from '../components/Quote.astro';
import Button from '../components/Button.astro';
import Bookmark from '../components/Bookmark.astro';
import Checklist from '../components/Checklist.astro';

const colors = ['gray', 'brown', 'orange', 'yellow', 'green', 'blue', 'purple', 'pink', 'red'];
---

<NotionPage
  title="astro-notion-theme"
  description="An Astro starter that looks like a Notion page — static HTML, no JavaScript."
  icon="📄"
  footer="MIT licensed · Unofficial, not affiliated with Notion Labs, Inc."
>
  <Callout icon="👋" color="blue">
    <strong>This page is the demo and the documentation.</strong> Everything below is a
    component you can use. View source on this file to see exactly how each one is written.
  </Callout>

  <p>
    The theme reproduces Notion's typography and block styles: the warm near-black
    <code>rgb(55, 53, 47)</code>, a 10px callout radius, 46px column gaps, and the full
    block-colour palette. It ships as static HTML with <strong>no client-side JavaScript</strong>,
    and follows your system light/dark setting.
  </p>

  <h2>Callouts</h2>
  <p>Nine background colours, each with an optional icon.</p>

  <Callout icon="💡" color="yellow">Use a callout to draw the eye to one idea.</Callout>
  <Callout icon="⚠️" color="red">Callouts take any markup — <a href="#columns">links</a>, lists, code.</Callout>
  <Callout color="gray">An icon is optional.</Callout>

  <div class="nt-columns" style="gap: 0.75rem;">
    {colors.map((c) => (
      <div class={`nt-callout nt-callout--${c}`} style="flex: 1 1 8rem; margin: 0;">
        <div class="nt-callout__body"><code>{c}</code></div>
      </div>
    ))}
  </div>

  <h2 id="columns">Columns</h2>
  <p>Set a <code>ratio</code> to weight a column. They stack on narrow screens instead of squeezing.</p>

  <Columns>
    <Column ratio={2}>
      <Callout icon="📐" color="green">
        <strong>Two-thirds.</strong> This column has <code>ratio={2}</code>.
      </Callout>
    </Column>
    <Column>
      <Callout icon="📏" color="purple"><strong>One-third.</strong> Default ratio.</Callout>
    </Column>
  </Columns>

  <h2>Toggles</h2>
  <p>
    Built on <code>&lt;details&gt;</code>, so they work without JavaScript and their contents
    stay readable to search engines and AI crawlers even when collapsed.
  </p>

  <Toggle summary="What's inside a toggle?">
    <p>Anything. This one holds a paragraph and a nested toggle.</p>
    <Toggle summary="A nested toggle">
      <p>Toggles nest as deeply as you like.</p>
    </Toggle>
  </Toggle>
  <Toggle summary="Open by default" open>
    <p>Pass <code>open</code> to start expanded.</p>
  </Toggle>

  <h2>Quotes</h2>
  <Quote cite="Notion's design, roughly">
    Good tools disappear. You notice the writing, not the interface.
  </Quote>

  <h2>Buttons</h2>
  <p>
    <Button href="https://github.com/yickminglee/astro-notion-theme">Use this template</Button>
    {' '}
    <Button variant="secondary" href="#top">Secondary</Button>
  </p>
  <p class="nt-c-gray">
    White on the primary blue is 4.68:1 — WCAG AA for normal text.
  </p>

  <h2>Bookmarks</h2>
  <Bookmark
    href="https://astro.build"
    title="Astro"
    description="The web framework for content-driven websites."
  />

  <h2>Checklists</h2>
  <Checklist
    items={[
      { text: 'Fork the template', checked: true },
      { text: 'Edit src/pages/index.astro', checked: true },
      { text: 'Change the tokens in src/styles/notion.css' },
      { text: 'Deploy anywhere static' },
    ]}
  />

  <h2>Tables</h2>
  <div class="nt-table-wrap">
    <table class="nt-table">
      <thead>
        <tr><th>Token</th><th>Value</th><th>What it controls</th></tr>
      </thead>
      <tbody>
        <tr><td><code>--nt-fg</code></td><td>rgb(55, 53, 47)</td><td>Body text</td></tr>
        <tr><td><code>--nt-radius</code></td><td>10px</td><td>Callouts, cards</td></tr>
        <tr><td><code>--nt-gap</code></td><td>46px</td><td>Column spacing</td></tr>
        <tr><td><code>--nt-width</code></td><td>900px</td><td>Page width</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Text colours</h2>
  <p>
    {colors.map((c) => (
      <span><span class={`nt-c-${c}`}>{c}</span>{' · '}</span>
    ))}
  </p>

  <hr />

  <h2>Make it yours</h2>
  <p>
    Every value is a CSS custom property at the top of
    <code>src/styles/notion.css</code>. Change <code>--nt-fg</code> and
    <code>--nt-bg</code> and the whole site follows — no component edits.
  </p>

  <Columns>
    <Column>
      <Toggle summary="Use a serif page">
        <p>Add <code>class="nt-serif"</code> to the page body, mirroring Notion's font switcher. <code>nt-mono</code> works too.</p>
      </Toggle>
    </Column>
    <Column>
      <Toggle summary="Narrower pages">
        <p>Pass <code>width="default"</code> to the layout for Notion's 708px width instead of full-width.</p>
      </Toggle>
    </Column>
  </Columns>

  <Callout icon="📝" color="green">
    Writing in Markdown? See <a href="/example/">the Markdown example</a> — set the layout in
    frontmatter and prose is styled automatically.
  </Callout>
</NotionPage>
