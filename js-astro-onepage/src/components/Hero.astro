---
import { assets } from "../lib/data";
import SocialIcon from "./SocialIcon.astro";
import LangSwitch from "./LangSwitch.astro";
import StatsSection from "./StatsSection.astro";
import type { SiteData } from "../lib/schema";
import type { Locale } from "../lib/locales";

interface Props {
  site: SiteData;
  locales: Locale[];
  current: string;
}
const { site, locales, current } = Astro.props;
// 头像：构建时抓取的缓存优先，其次配置里的手填地址
const avatar = assets.avatar ?? site.avatar;
// mailto: 与站内路径（/ 开头）不新开窗口；其余外链新标签打开
const isLocal = (u: string) => u.startsWith("mailto:") || u.startsWith("/");
---

<header id="page-top" class="profile" tabindex="-1">
  {(site.mark || locales.length > 1) && <div class="profile-top">
    {site.mark && <span class="eyebrow text-(--color-ink)">{site.mark}</span>}
    <LangSwitch locales={locales} current={current} />
  </div>}

  <div class="profile-content">
    <div class="profile-copy">
      <div class="profile-identity">
        {avatar && <img src={avatar} alt="" width="72" height="72" />}
        <div>
          <h1>{site.name}</h1>
          {site.title && <p class="profile-role">{site.title}</p>}
        </div>
      </div>
      {site.intro && <p class="profile-intro">{site.intro}</p>}
      {site.links.length > 0 && (
        <div class="profile-links">
          {site.links.map((l, i) => (
            <a href={l.url}
              target={isLocal(l.url) ? undefined : "_blank"}
              rel={isLocal(l.url) ? undefined : "noopener noreferrer"}
              class={i === 0 ? "btn btn-primary" : "btn"}>
              <span class="flex items-center gap-2">
                <SocialIcon url={l.url} label={l.label} />
                <span>{l.label}</span>
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
    {site.stats.length > 0 && <StatsSection stats={site.stats} />}
  </div>
</header>

<style>
  .profile {
    padding-block-start: 1rem;
    overflow-wrap: anywhere;
  }

  .profile-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.25rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--color-line);
  }

  .profile-content {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1.5rem 3rem;
    padding-block: 2rem;
  }

  .profile-copy {
    flex: 1 1 30rem;
    min-inline-size: 0;
  }

  .profile-identity {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .profile-identity img {
    flex: none;
    inline-size: clamp(3.5rem, 7vw, 4.5rem);
    block-size: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    text-wrap: balance;
  }

  .profile-role {
    margin-block-start: 0.375rem;
    font-weight: 500;
  }

  .profile-intro {
    max-inline-size: 58ch;
    margin-block-start: 1rem;
    color: var(--color-ink-2);
    line-height: 1.65;
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 1.25rem;
  }

  @media (min-width: 40rem) {
    .profile-content {
      padding-block: 2.75rem;
    }

    .profile-intro {
      font-size: 1.125rem;
    }
  }
</style>
