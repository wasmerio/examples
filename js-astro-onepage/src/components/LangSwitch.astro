---
// 语言切换：纯 <a> 链接，不引入任何 JS。只有一种语言时整块不渲染。
import { nativeName } from "../i18n/ui";
import type { Locale } from "../lib/locales";

interface Props {
  locales: Locale[];
  current: string;
}
const { locales, current } = Astro.props;
---

{locales.length > 1 && (
  <ul class="languages mono">
    {locales.map((l) => (
      <li lang={l.code}>
        {l.code === current ? (
          <span aria-current="page">{nativeName(l.code)}</span>
        ) : (
          <a href={l.href} hreflang={l.code} class="link-quiet">{nativeName(l.code)}</a>
        )}
      </li>
    ))}
  </ul>
)}

<style>
  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-inline-start: auto;
    font-size: 0.875rem;
  }

  .languages :is(a, span) {
    display: block;
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
  }

  .languages [aria-current] {
    background: var(--color-cell);
    font-weight: 600;
  }
</style>
