---
import { repoOf, fmtStars, thumbOf } from "../lib/data";
import type { UIStrings } from "../i18n/ui";
import type { SiteData } from "../lib/schema";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  group: SiteData["groups"][number];
  id: string;
  title: string;
  t: UIStrings;
  thumbs?: boolean;
}
const { group, id, title, t, thumbs = true } = Astro.props;
const entries = group.items.map((item) => ({ item, image: thumbs ? thumbOf(item) : undefined }));
const hasDate = entries.some(({ item }) => item.date);
const hasImage = entries.some(({ image }) => image);
---

<section aria-labelledby={id}>
  <SectionHeader id={id} title={title} count={entries.length} />
  <ul>
    {entries.map(({ item, image }) => {
      const repo = repoOf(item);
      const stars = repo && repo.stars >= 10 ? fmtStars(repo.stars) : undefined;
      return (
        <li class:list={["work-row", { "has-dates": hasDate, "has-images": hasImage, "shows-image": image }]}>
          {item.date && <span class="work-date mono">{item.date}</span>}
          {image && <img src={image} alt="" width="40" height="40" loading="lazy" />}
          <div class="work-copy">
            <h3 class="font-semibold">
              {item.link
                ? <a href={item.link} target="_blank" rel="noopener noreferrer" class="link-quiet">{item.name}</a>
                : item.name}
            </h3>
            {item.desc && <p>{item.desc}</p>}
            {(stars || item.via || item.source) && (
              <div class="work-meta">
                {stars && <span class="chip chip-star">★ {stars}</span>}
                {item.via && <span>{item.via}</span>}
                {item.source && (
                  <a href={item.source} target="_blank" rel="noopener noreferrer" class="link-quiet">
                    {t.source} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .work-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "date" "copy";
    column-gap: 0.875rem;
    padding-block: 0.875rem;
    border-block-end: 1px solid var(--color-line);
    overflow-wrap: anywhere;
  }

  .shows-image {
    grid-template-columns: 2.5rem minmax(0, 1fr);
    grid-template-areas: ". date" "image copy";
  }

  .work-date {
    grid-area: date;
    padding-block-end: 0.25rem;
    color: var(--color-ink-2);
    font-size: 0.75rem;
  }

  img {
    grid-area: image;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
  }

  .work-copy {
    grid-area: copy;
  }

  .work-copy p {
    margin-block-start: 0.25rem;
    color: var(--color-ink-2);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .work-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.875rem;
    margin-block-start: 0.25rem;
    color: var(--color-ink-2);
    font-size: 0.75rem;
  }

  .work-meta a {
    padding-block: 0.375rem;
  }

  @media (min-width: 40rem) {
    /* 宽屏给同组的日期和图留齐整的列，窄屏只给实际出现的内容留位置。 */
    .work-row {
      grid-template-columns: var(--work-date-track, 0) var(--work-image-track, 0) minmax(0, 1fr);
      grid-template-areas: "date image copy";
      column-gap: 0;
      align-items: start;
    }

    .has-dates {
      --work-date-track: 6rem;
    }

    .has-images {
      --work-image-track: 3.375rem;
    }

    .work-date {
      padding-block-start: 0.25rem;
      padding-inline-end: 0.875rem;
    }
  }
</style>
