---
// 数据条：一排数字。auto="stars" 取 GitHub 总星数、auto="repos" 取非 fork/归档的公开仓库数（构建时抓）。
import { gh } from "../lib/data";
import type { StatItem } from "../lib/schema";

interface Props {
  stats: StatItem[];
}
const { stats } = Astro.props;
// toLocaleString 只对数字（千位分隔）；字符串（如「30+」「18 种」）原样显示
const fmtVal = (v: string | number) => (typeof v === "number" ? v.toLocaleString() : v);
// 自动数不显示零头：取整到十位 + 「+」（10885→10,880+、53→50+）
const floorTen = (n: number) => Math.floor(n / 10) * 10;
const statText = (s: StatItem) =>
  s.auto === "repos"
    ? `${floorTen(gh.repoCount).toLocaleString()}+`
    : s.auto === "forks"
      ? `${floorTen(gh.totalForks).toLocaleString()}+`
      : s.auto === "stars"
        ? `${floorTen(gh.totalStars).toLocaleString()}+`
        : fmtVal(s.value);
---

<dl class="profile-stats">
  {stats.map((s) => (
    <div>
      <dt>{s.label}</dt>
      <dd class="stat-num">{statText(s)}</dd>
    </div>
  ))}
</dl>

<style>
  .profile-stats {
    flex: 1 1 15rem;
    min-inline-size: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 7rem), 1fr));
    gap: 0.75rem 1rem;
    padding: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-card);
  }

  dt {
    color: var(--color-ink-2);
    font-size: 0.875rem;
  }

  dd {
    font-size: 1.5rem;
  }

  @media (min-width: 64rem) {
    .profile-stats {
      max-inline-size: 21rem;
      padding: 1.25rem;
    }

    dd {
      font-size: 1.875rem;
    }
  }
</style>
