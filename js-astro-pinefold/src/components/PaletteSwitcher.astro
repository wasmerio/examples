---
// Demo-only palette switcher — lets visitors preview all six palettes
// live. Not meant to ship on a real personal site; delete this file and
// its <PaletteSwitcher /> line in Layout.astro once you've picked one
// and set it permanently via site.palette in config.ts.

const palettes = [
  { value: "emerald", label: "Emerald" },
  { value: "warm", label: "Warm" },
  { value: "slate", label: "Slate" },
  { value: "mono", label: "Mono" },
  { value: "ink", label: "Ink" },
  { value: "forest", label: "Forest" },
];
---

<script is:inline>
  const storedPalette = localStorage.getItem("palette");
  if (storedPalette) {
    document.documentElement.setAttribute("data-palette", storedPalette);
  }
</script>

<span class="palette-switcher__label">Preview:</span>
<select id="palette-switcher" class="palette-switcher" aria-label="Preview palette">
  {palettes.map((p) => <option value={p.value}>{p.label}</option>)}
</select>

<style>
  .palette-switcher {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--bg-raised);
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: 20px;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
  }
  .palette-switcher__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
</style>

<script is:inline>
  const select = document.getElementById("palette-switcher");
  const current = document.documentElement.getAttribute("data-palette") || "warm";
  select.value = current;
  select.addEventListener("change", () => {
    document.documentElement.setAttribute("data-palette", select.value);
    localStorage.setItem("palette", select.value);
  });
</script>