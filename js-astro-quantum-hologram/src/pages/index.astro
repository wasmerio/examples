---
import Layout from '../layouts/Layout.astro';
import { Hero } from '../components/Hero';
import { Features } from '../components/Features';
import { BentoGrid } from '../components/BentoGrid';
import { TechMarquee } from '../components/TechMarquee';
import { QuantumCore } from '../components/QuantumCore';
---

<Layout title="Quantum Hologram | Next-Gen Interface">
  <main class="relative">
    {/* Ambient base layer */}
    <div class="fixed inset-0 bg-[url('/noise.svg')] opacity-20 pointer-events-none mix-blend-overlay z-50"></div>
    
    <Hero client:load />
    
    <TechMarquee client:visible />
    
    <BentoGrid client:load />
    
    <QuantumCore client:visible />
    
    <Features client:visible />
    
    <footer class="py-12 border-t border-white/10 mt-24">
      <div class="container mx-auto px-6 text-center text-gray-500">
        <p>&copy; 2026 CodeSculptor. Built with Astro & React.</p>
      </div>
    </footer>
  </main>
</Layout>
