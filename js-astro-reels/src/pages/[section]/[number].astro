---
import { siteConfig } from '../../config.ts';
import PieceCard from '../../components/PieceCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getPieces, type Piece } from '../../lib/collection.ts';
import { pieceJsonLd } from '../../lib/identity.ts';
import { piecePath } from '../../lib/pieces.ts';

export async function getStaticPaths() {
  const pieces = await getPieces();
  return pieces.map((piece) => ({ params: { section: siteConfig.pieces.name, number: String(piece.data.number) }, props: { piece, total: pieces.length } }));
}

interface Props { piece: Piece; total: number }
const { piece, total } = Astro.props;
if (!Astro.site) throw new Error('Set the origin in src/config.ts.');
const { title, description, number } = piece.data;
const jsonLd = pieceJsonLd({ url: new URL(piecePath(number), Astro.site).href, name: title, description, creator: piece.data.creator });
---

<Layout title={title} description={description} ogType="article" jsonLd={jsonLd}>
  <PieceCard piece={piece} total={total} level="h1" context="page" />
</Layout>
