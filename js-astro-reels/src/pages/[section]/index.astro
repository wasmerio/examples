---
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config.ts';
import { getPieces } from '../../lib/collection.ts';
import { ownTitle, pieceWords, piecePath, sharedCreator } from '../../lib/pieces.ts';
import { firstLine } from '../../lib/verse.ts';

export function getStaticPaths() {
  return [{ params: { section: siteConfig.pieces.name } }];
}

const pieces = await getPieces();
const words = pieceWords();
const { book } = siteConfig.pieces;
const creator = sharedCreator(pieces.map((piece) => piece.data));
const source = book ? `${book.name}${'datePublished' in book && book.datePublished ? ` (${book.datePublished})` : ''}` : undefined;
---

<Layout title={words.contentsHeading} description={words.contentsDescription(pieces.length)}>
  <section class="poem contents" aria-labelledby="contents-title">
    <h1 id="contents-title">{words.contentsHeading}</h1>
    {(creator || source) && <p class="byline">{[creator, source].filter(Boolean).join(', ')}</p>}
    <ol>
      {pieces.map((piece) => (
        <li><a href={piecePath(piece.data.number)}><span class="n">{piece.data.number}</span> <span>{ownTitle(piece.data.title, piece.data.number) ?? firstLine(piece.body ?? '') ?? piece.data.description}</span></a></li>
      ))}
    </ol>
  </section>
</Layout>
