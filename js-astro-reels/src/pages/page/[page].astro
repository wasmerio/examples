---
import FeedPage from '../../components/FeedPage.astro';
import Layout from '../../layouts/Layout.astro';
import { getPieces, type Piece } from '../../lib/collection.ts';
import { pageCount, pageRange } from '../../lib/feed.ts';
import { pieceWords } from '../../lib/pieces.ts';

export async function getStaticPaths() {
  const pieces = await getPieces();
  return Array.from({ length: pageCount(pieces.length) - 1 }, (_, i) => ({ params: { page: String(i + 2) }, props: { pieces } }));
}

interface Props { pieces: Piece[] }
const { pieces } = Astro.props;
const page = Number(Astro.params.page);
const { first, last } = pageRange(page, pieces.length);
---

<Layout title={`Page ${page}: ${first}–${last}`} description={pieceWords().pageDescription(first, last, pieces.length)} bodyClass="feed">
  <FeedPage page={page} pieces={pieces} />
</Layout>
