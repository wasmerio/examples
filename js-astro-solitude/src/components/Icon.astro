---
import { Icon as AstroIcon } from 'astro-icon/components';
import type { ComponentProps } from 'astro/types';
import type { IconName } from '@/lib/icons';

interface Props extends Omit<
  ComponentProps<typeof AstroIcon>,
  'name' | 'is:inline'
> {
  name: IconName;
  title?: string;
  size?: number | string;
  spin?: boolean;
}

const {
  name,
  title,
  size = '1em',
  spin = false,
  class: className,
  ...attributes
} = Astro.props;
---

<AstroIcon
  name={name}
  is:inline
  size={size}
  title={title}
  class:list={['solitude-icon', className, { 'icon-spin': spin }]}
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  aria-label={title}
  focusable="false"
  {...attributes}
/>
