---
import Icon from '@/components/Icon.astro';
import { cfg, config, url } from '@/lib/site';

const card = cfg.aside.my_card;
const links = card.information.slice(0, 4);
const iconsOnly = links.length > 2;
const portrait =
  card.cover ||
  (card.author.img === '/img/logo.png'
    ? '/img/brand/profile-avatar.webp'
    : card.author.img);
---

<section class="card-widget card-profile" aria-label={config.author.name}>
  <div class="profile-surface">
    <img
      class="profile-portrait"
      src={url(portrait)}
      alt={config.author.name}
      width="750"
      height="1000"
      loading="lazy"
      decoding="async"
    />
    <div class="profile-glass" aria-hidden="true"></div>

    <button
      class="profile-greeting"
      id="sayhi"
      type="button"
      data-solitude-action="changeWittyWord"
    >
      {config.author.name}
    </button>

    <div class="profile-content">
      <div class="profile-identity">
        <h2 class="profile-name">{config.author.name}</h2>
        {card.author.emoji ? (
          <span
            class="profile-sticker profile-sticker-emoji"
            aria-hidden="true"
          >
            {card.author.emoji}
          </span>
        ) : (
          card.author.sticker && (
            <span class="profile-sticker" aria-hidden="true">
              <img src={url(card.author.sticker)} alt="" loading="lazy" />
            </span>
          )
        )}
      </div>
      <div class="profile-bio" set:html={card.description} />
      {card.content && (
        <div class="profile-description" set:html={card.content} />
      )}

      {links.length > 0 && (
        <div class="profile-footer">
          <div
            class:list={['profile-socials', { 'is-icon-only': iconsOnly }]}
            role="group"
            aria-label={config.author.name}
          >
            {links.map((link) => (
              <a
                class="profile-social"
                href={url(link.url)}
                title={link.name}
                aria-label={link.name}
              >
                <Icon name={link.icon ?? 'lucide:link'} aria-hidden="true" />
                {!iconsOnly && <span>{link.name}</span>}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  @layer solitude.components {
    :global(#aside-content) .card-profile {
      --profile-card-background: var(--current-banner-theme, var(--efu-theme));
      --profile-card-text-color: var(--efu-nav-hover-text);
      --profile-ink: #222522;
      --profile-muted: #4c514d;
      --profile-glass-color: color-mix(
        in srgb,
        var(--profile-card-background) 6%,
        #f3f4ef
      );
      position: relative;
      isolation: isolate;
      padding: 6px;
      overflow: hidden;
      border: 1px solid rgb(255 255 255 / 80%);
      color: var(--profile-ink);
      background: color-mix(
        in srgb,
        var(--profile-card-background) 6%,
        #fafbf8
      );
      box-shadow:
        0 10px 30px -16px rgb(25 30 25 / 28%),
        inset 0 1px 0 rgb(255 255 255 / 80%);
    }

    :global([data-theme='dark'] #aside-content) .card-profile {
      --profile-ink: #f5f6f2;
      --profile-muted: #c6ccc6;
      --profile-glass-color: color-mix(
        in srgb,
        var(--profile-card-background) 8%,
        #202421
      );
      border-color: rgb(255 255 255 / 12%);
      background: color-mix(
        in srgb,
        var(--profile-card-background) 8%,
        #292d29
      );
      box-shadow:
        0 10px 30px -16px rgb(0 0 0 / 50%),
        inset 0 1px 0 rgb(255 255 255 / 8%);
    }

    .profile-surface {
      --profile-surface-radius: max(0px, calc(var(--radius) - 7px));
      position: relative;
      overflow: hidden;
      border-radius: var(--profile-surface-radius);
      clip-path: inset(0 round var(--profile-surface-radius));
      background: var(--profile-glass-color);
    }

    .profile-portrait {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 60% top;
    }

    .profile-glass {
      position: absolute;
      inset: 32% 0 0;
      pointer-events: none;
    }

    .profile-glass::before,
    .profile-glass::after {
      position: absolute;
      inset: 0;
      content: '';
    }

    .profile-glass::before {
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      -webkit-mask-image: linear-gradient(transparent, #000 65%);
      mask-image: linear-gradient(transparent, #000 65%);
    }

    .profile-glass::after {
      background: linear-gradient(
        transparent,
        color-mix(in srgb, var(--profile-glass-color) 80%, transparent) 25%,
        color-mix(in srgb, var(--profile-glass-color) 96%, transparent) 76%,
        var(--profile-glass-color)
      );
    }

    .profile-greeting {
      position: absolute;
      z-index: 1;
      top: 12px;
      left: 12px;
      max-width: calc(100% - 24px);
      padding: 5px 10px;
      border: 1px solid rgb(255 255 255 / 35%);
      border-radius: 999px;
      color: #fff;
      background: rgb(25 30 25 / 30%);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      font: inherit;
      font-size: 11px;
      line-height: 1.5;
      text-align: left;
      overflow-wrap: anywhere;
      cursor: pointer;
      transition: background var(--efu-motion-fast);
    }

    .profile-greeting:hover {
      background: rgb(25 30 25 / 55%);
    }

    .profile-content {
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 326px;
      padding: 145px 18px 16px;
    }

    .profile-identity {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .profile-name {
      min-width: 0;
      margin: 0;
      color: var(--profile-ink);
      font-size: 27px;
      font-weight: 650;
      line-height: 1.2;
      letter-spacing: -0.8px;
      overflow-wrap: anywhere;
    }

    .profile-sticker {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      width: 25px;
      height: 25px;
      overflow: hidden;
      border-radius: 50%;
    }

    .profile-sticker img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile-sticker-emoji {
      font-size: 20px;
      line-height: 1;
    }

    .profile-bio,
    .profile-description {
      overflow-wrap: anywhere;
      font-size: 13px;
      line-height: 1.55;
    }

    .profile-bio {
      margin-top: 8px;
      color: var(--profile-ink);
    }

    .profile-description {
      margin-top: 6px;
      color: var(--profile-muted);
    }

    .profile-footer {
      margin-top: auto;
      padding-top: 16px;
    }

    .profile-socials {
      display: flex;
      align-items: center;
      gap: 6px 18px;
      min-width: 0;
    }

    .profile-social {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      max-width: 100%;
      min-height: 40px;
      color: var(--profile-ink);
      font-size: 14px;
      font-weight: 400;
      line-height: 1.5;
      overflow-wrap: anywhere;
      transition: opacity var(--efu-motion-fast);
    }

    .profile-social :global(.solitude-icon) {
      flex: 0 0 auto;
      font-size: 20px;
    }

    .profile-social:hover {
      color: var(--profile-ink);
      opacity: 0.65;
    }

    .profile-socials.is-icon-only .profile-social {
      flex: 0 0 auto;
      justify-content: center;
      width: 40px;
    }

    .profile-greeting:focus-visible,
    .profile-social:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 4px;
    }

    .profile-bio :global(> :first-child),
    .profile-description :global(> :first-child) {
      margin-top: 0;
    }

    .profile-bio :global(> :last-child),
    .profile-description :global(> :last-child) {
      margin-bottom: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .profile-greeting,
      .profile-social {
        transition: none;
      }
    }
  }
</style>
