---
import { cfg, t } from '@/lib/site';
import type { Route } from '@/lib/routing';
import type { Post } from '@/types/content';
import Aside from '@/components/layout/Aside.astro';
import CategoryBar from '@/components/navigation/CategoryBar.astro';
import Pagination from '@/components/navigation/Pagination.astro';
import PostCard from '@/components/post/PostCard.astro';
import HomeTop from './HomeTop.astro';

interface Props {
  route: Route;
  posts: Post[];
}
const { route, posts } = Astro.props;
---

<div class="home-main-flow tw:flex tw:flex-col">
  <main
    class="layout layout--home tw:[.layout#content-inner&]:flex-col tw:[.layout&]:relative"
    id="content-inner"
  >
    <div class="home-layout-row">
      <div id="home">
        {cfg.hometop.enable && route.current === 1 && (
          <div id="home_top">
            <HomeTop posts={posts} />
          </div>
        )}
        <div class="home-category-bar category-in-bar">
          <CategoryBar posts={posts} home />
        </div>
        <div class="recent-posts tw:relative" id="recent-posts">
          {route.posts?.map((post, i) => (
            <PostCard post={post} index={i} newest={posts[0]?.id} />
          ))}
          {!route.posts?.length && (
            <p class="empty-state">{t('archiveEmpty')}</p>
          )}
          <Pagination current={route.current!} total={route.total!} />
        </div>
      </div>
      <Aside posts={posts} home />
    </div>
  </main>
</div>
