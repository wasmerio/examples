---
const renderedAt = new Date().toISOString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Astro SSR on Wasmer Edge</title>
  </head>
  <body>
    <main>
      <h1>Hello from Astro on Wasmer Edge!</h1>
      <p>
        This page is server-side rendered by the Astro standalone server
        running on EdgeJS. Rendered at: {renderedAt}
      </p>
    </main>
  </body>
</html>
