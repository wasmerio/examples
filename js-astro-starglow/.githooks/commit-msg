#!/bin/sh
msg=$(awk '/^# -+ >8 -+$/ { exit } !/^#/' "$1" | sed -e '/^[[:space:]]*$/d')
subject=$(printf '%s\n' "$msg" | head -n 1)
fail() { printf 'commit-msg: %s\n  %s\n' "$1" "$subject" >&2; exit 1; }
[ "$(printf '%s\n' "$msg" | wc -l)" -le 1 ] || fail 'header only: no description body and no trailers'
case "$subject" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;; esac
printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ]' \
  || fail 'use Conventional Commits, e.g. "fix(search): keep focus after closing"'
[ "${#subject}" -le 72 ] || fail "subject is ${#subject} characters, keep it at most 72"
printf '%s' "$subject" | grep -q 'Starglow' && fail 'write "starglow" lowercase'
printf '%s' "$subject" | grep -Eq '\.$' && fail 'drop the full stop at the end of the subject'
exit 0
