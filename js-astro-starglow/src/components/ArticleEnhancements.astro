---
import config from "@/config";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale ?? config.site.lang);
---

<div
  class="sr-only"
  role="status"
  aria-live="polite"
  data-pagefind-ignore
  data-copy-label={t.post.copyCode}
  data-copied-label={t.post.copied}
  data-copy-failed-label={t.post.copyCodeFailed}
  data-copy-success={t.a11y.copySuccess}
  data-copy-failure={t.a11y.copyFailure}
>
</div>

<script is:inline data-astro-rerun>
  function attachCopyButtons() {
    // Strings come from the status element's data attributes (i18n).
    const status = document.querySelector("[data-copy-label]");
    if (!status) return;
    const labels = status.dataset;

    const announce = message => {
      status.textContent = "";
      // A fresh text node each time so a repeated message is announced again.
      requestAnimationFrame(() => {
        status.textContent = message;
      });
    };

    const codeBlocks = Array.from(document.querySelectorAll("#article pre"));

    for (const codeBlock of codeBlocks) {
      // rehypeBlockLabels wraps highlighted blocks; other blocks get a
      // wrapper here so the button can sit on the top border.
      let wrapper = codeBlock.parentElement;
      if (!wrapper?.classList.contains("code-block")) {
        wrapper = document.createElement("div");
        wrapper.className = "code-block";
        codeBlock.parentNode?.insertBefore(wrapper, codeBlock);
        wrapper.append(codeBlock);
      }
      // Re-running the script never adds a second button.
      if (wrapper.querySelector(":scope > .copy-code")) continue;

      const copyButton = document.createElement("button");
      copyButton.type = "button";
      copyButton.className = "copy-code";
      copyButton.textContent = labels.copyLabel;
      codeBlock.setAttribute("tabindex", "0");
      wrapper.append(copyButton);

      let resetTimer;
      const flash = (label, ms) => {
        copyButton.textContent = label;
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          copyButton.textContent = labels.copyLabel;
        }, ms);
      };

      copyButton.addEventListener("click", async () => {
        const code = codeBlock.querySelector("code") ?? codeBlock;
        try {
          if (!navigator.clipboard?.writeText) throw new Error("no clipboard");
          await navigator.clipboard.writeText(code.innerText);
          flash(labels.copiedLabel, 1500);
          announce(labels.copySuccess);
        } catch {
          // Plain-HTTP origins have no clipboard API: select the text instead.
          const range = document.createRange();
          range.selectNodeContents(code);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
          flash(labels.copyFailedLabel, 2000);
          announce(labels.copyFailure);
        }
      });
    }
  }
  attachCopyButtons();

  /** Accessible image lightbox for article images. */
  function initLightbox() {
    const article = document.getElementById("article");
    if (!article) return;

    const prefersReducedMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let overlay = null;
    let lastFocused = null;
    let removeDragListeners = null;

    // Deferred so the attribute writes don't push the LCP timestamp.
    requestAnimationFrame(() => {
      const images = Array.from(article.querySelectorAll("img"));
      for (const image of images) {
        if (image.closest("a")) continue;
        image.setAttribute("role", "button");
        image.setAttribute("tabindex", "0");
        image.setAttribute("aria-haspopup", "dialog");
        image.setAttribute(
          "aria-label",
          image.alt ? `Zoom image: ${image.alt}` : "Zoom image"
        );
      }
    });

    function open(src, alt, trigger) {
      if (overlay) return;
      lastFocused = trigger ?? document.activeElement;

      overlay = document.createElement("div");
      overlay.setAttribute("role", "dialog");
      overlay.setAttribute("aria-modal", "true");
      overlay.setAttribute(
        "aria-label",
        alt ? `Image preview: ${alt}` : "Image preview"
      );
      overlay.className =
        "fixed inset-0 z-50 flex cursor-zoom-out items-center justify-center bg-black/70 backdrop-blur-sm opacity-0 transition-opacity duration-200 motion-reduce:transition-none";

      const closeButton = document.createElement("button");
      closeButton.type = "button";
      closeButton.setAttribute("aria-label", "Close image preview");
      closeButton.className =
        "absolute end-4 top-4 z-1 flex size-11 items-center justify-center border border-white/50 bg-black/50 text-white";
      closeButton.innerHTML =
        '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
      closeButton.addEventListener("click", close);

      const image = document.createElement("img");
      image.src = src;
      image.alt = "";
      image.className =
        "max-h-[90dvh] max-w-[90dvw] cursor-default object-contain transition-transform duration-100 ease-out motion-reduce:transition-none data-[zoom=drag]:cursor-grabbing data-[zoom=drag]:transition-none data-[zoom=in]:cursor-grab";

      overlay.append(closeButton, image);
      overlay.addEventListener("click", e => {
        if (e.target === overlay && currentScale <= 1) close();
      });

      let currentScale = 1;
      let translateX = 0;
      let translateY = 0;
      let initialDist = 0;
      let initialScale = 1;
      let panStartX = 0;
      let panStartY = 0;
      let panStartTranslateX = 0;
      let panStartTranslateY = 0;
      let lastTapTime = 0;

      function applyTransform() {
        image.style.transform = `scale(${currentScale}) translate(${translateX}px, ${translateY}px)`;
        // A backdrop click only closes at fit size, so drop the zoom-out cursor while zoomed.
        overlay?.classList.toggle("cursor-zoom-out", currentScale <= 1);
      }

      function resetTransform() {
        currentScale = 1;
        translateX = 0;
        translateY = 0;
        image.style.transform = "";
        image.removeAttribute("data-zoom");
        overlay?.classList.add("cursor-zoom-out");
      }

      // Keep the zoomed image from being panned past its edges.
      function clampTranslate() {
        if (!overlay) return;
        const maxX = Math.max(
          0,
          (image.clientWidth - overlay.clientWidth / currentScale) / 2
        );
        const maxY = Math.max(
          0,
          (image.clientHeight - overlay.clientHeight / currentScale) / 2
        );
        translateX = Math.min(maxX, Math.max(-maxX, translateX));
        translateY = Math.min(maxY, Math.max(-maxY, translateY));
      }

      overlay.addEventListener(
        "touchstart",
        e => {
          const t = e.touches;
          if (t.length === 2) {
            image.setAttribute("data-zoom", "drag");
            initialDist = Math.hypot(
              t[1].clientX - t[0].clientX,
              t[1].clientY - t[0].clientY
            );
            initialScale = currentScale;
          } else if (t.length === 1) {
            const now = Date.now();
            if (now - lastTapTime < 300) {
              e.preventDefault();
              if (currentScale > 1) {
                resetTransform();
              } else {
                currentScale = 2;
                translateX = 0;
                translateY = 0;
                applyTransform();
                image.setAttribute("data-zoom", "in");
              }
              lastTapTime = 0;
              panStartX = t[0].clientX;
              panStartY = t[0].clientY;
              panStartTranslateX = translateX;
              panStartTranslateY = translateY;
            } else {
              lastTapTime = now;
              if (currentScale > 1) {
                image.setAttribute("data-zoom", "drag");
                panStartX = t[0].clientX;
                panStartY = t[0].clientY;
                panStartTranslateX = translateX;
                panStartTranslateY = translateY;
              }
            }
          }
        },
        { passive: false }
      );

      overlay.addEventListener(
        "touchmove",
        e => {
          const t = e.touches;
          if (t.length === 2) {
            e.preventDefault();
            const dist = Math.hypot(
              t[1].clientX - t[0].clientX,
              t[1].clientY - t[0].clientY
            );
            const oldScale = currentScale;
            currentScale = Math.min(
              4,
              Math.max(1, initialScale * (dist / initialDist))
            );

            // Zoom to the midpoint of the two fingers.
            const midX = (t[0].clientX + t[1].clientX) / 2;
            const midY = (t[0].clientY + t[1].clientY) / 2;
            const ox = overlay.clientWidth / 2;
            const oy = overlay.clientHeight / 2;
            translateX =
              (midX - ox) * (1 / currentScale - 1 / oldScale) + translateX;
            translateY =
              (midY - oy) * (1 / currentScale - 1 / oldScale) + translateY;
            clampTranslate();
            applyTransform();
          } else if (t.length === 1) {
            if (currentScale > 1) {
              e.preventDefault();
              image.setAttribute("data-zoom", "drag");
              translateX =
                panStartTranslateX + (t[0].clientX - panStartX) / currentScale;
              translateY =
                panStartTranslateY + (t[0].clientY - panStartY) / currentScale;
              clampTranslate();
              applyTransform();
            } else {
              e.preventDefault();
            }
          }
        },
        { passive: false }
      );

      overlay.addEventListener("touchend", e => {
        if (e.touches.length === 0) {
          if (currentScale > 1) {
            image.setAttribute("data-zoom", "in");
          } else {
            image.removeAttribute("data-zoom");
          }
          if (currentScale <= 1.05) resetTransform();
        }
      });

      overlay.addEventListener("touchcancel", e => {
        if (e.touches.length === 0) {
          if (currentScale > 1) {
            image.setAttribute("data-zoom", "in");
          } else {
            image.removeAttribute("data-zoom");
          }
          if (currentScale <= 1.05) resetTransform();
        }
      });

      overlay.addEventListener(
        "wheel",
        e => {
          e.preventDefault();
          const oldScale = currentScale;
          const delta = -e.deltaY * 0.001;
          currentScale = Math.min(4, Math.max(1, currentScale * (1 + delta)));

          if (currentScale <= 1.05) {
            resetTransform();
          } else {
            image.setAttribute("data-zoom", "in");
            // Keep the point under the cursor fixed.
            const ox = overlay.clientWidth / 2;
            const oy = overlay.clientHeight / 2;
            translateX =
              (e.clientX - ox) * (1 / currentScale - 1 / oldScale) + translateX;
            translateY =
              (e.clientY - oy) * (1 / currentScale - 1 / oldScale) + translateY;
            clampTranslate();
            applyTransform();
          }
        },
        { passive: false }
      );

      let isMouseDown = false;
      let mouseStartX = 0;
      let mouseStartY = 0;

      overlay.addEventListener("mousedown", e => {
        if (e.button !== 0 || currentScale <= 1) return;
        if (e.target.closest("button")) return;
        isMouseDown = true;
        mouseStartX = e.clientX;
        mouseStartY = e.clientY;
        panStartTranslateX = translateX;
        panStartTranslateY = translateY;
        image.setAttribute("data-zoom", "drag");
        e.preventDefault();
      });

      function onMouseMove(e) {
        if (!isMouseDown || !overlay) return;
        translateX =
          panStartTranslateX + (e.clientX - mouseStartX) / currentScale;
        translateY =
          panStartTranslateY + (e.clientY - mouseStartY) / currentScale;
        clampTranslate();
        applyTransform();
      }

      function onMouseUp() {
        if (!isMouseDown) return;
        isMouseDown = false;
        if (currentScale > 1) {
          image.setAttribute("data-zoom", "in");
        } else {
          image.removeAttribute("data-zoom");
        }
      }

      document.addEventListener("mousemove", onMouseMove);
      document.addEventListener("mouseup", onMouseUp);
      removeDragListeners = () => {
        document.removeEventListener("mousemove", onMouseMove);
        document.removeEventListener("mouseup", onMouseUp);
      };

      document.body.appendChild(overlay);
      document.documentElement.style.overflow = "hidden";
      document.addEventListener("keydown", onKeyDown);
      window.__closeLightbox = close;

      requestAnimationFrame(() => overlay?.classList.add("opacity-100"));
      closeButton.focus();
    }

    function close() {
      if (!overlay) return;
      const el = overlay;
      overlay = null;
      el.classList.add("pointer-events-none");
      window.__closeLightbox = null;

      document.removeEventListener("keydown", onKeyDown);
      removeDragListeners?.();
      removeDragListeners = null;
      document.documentElement.style.overflow = "";
      lastFocused?.focus();
      lastFocused = null;

      if (prefersReducedMotion()) {
        el.remove();
        return;
      }
      const remove = () => el.remove();
      el.addEventListener("transitionend", remove, { once: true });
      setTimeout(remove, 250); // fallback in case transitionend never fires
      el.classList.remove("opacity-100");
    }

    function onKeyDown(e) {
      if (e.key === "Escape") {
        close();
      } else if (e.key === "Tab") {
        trapFocus(e);
      }
    }

    // Keep keyboard focus inside the open dialog.
    function trapFocus(e) {
      if (!overlay) return;
      const focusables = overlay.querySelectorAll(
        'a[href], button, [tabindex]:not([tabindex="-1"])'
      );
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function triggerFromEvent(e) {
      const image = e.target.closest("img");
      if (!image || !article.contains(image) || image.closest("a")) return null;
      return image;
    }

    function activate(image) {
      open(image.currentSrc || image.src, image.alt, image);
    }

    article.addEventListener("click", e => {
      const image = triggerFromEvent(e);
      if (!image) return;
      e.preventDefault();
      activate(image);
    });

    article.addEventListener("keydown", e => {
      if (e.key !== "Enter" && e.key !== " " && e.key !== "Spacebar") return;
      const image = triggerFromEvent(e);
      if (!image) return;
      e.preventDefault();
      activate(image);
    });
  }
  initLightbox();

  if (!window.__lightboxSwapBound) {
    window.__lightboxSwapBound = true;
    document.addEventListener("astro:before-swap", () =>
      window.__closeLightbox?.()
    );
  }

  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
