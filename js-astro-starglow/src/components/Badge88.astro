---
import { BADGE_ICONS, badgeIcon, bitmapRuns } from "@/utils/badges";
import { getAssetPath } from "@/utils/withBase";

/**
 * One 88x31 pixel badge: bevelled frame, an 11x11 icon in 2px cells and a
 * one-line label. Colours are CSS tokens, so both themes and hover work
 * without script.
 */
type Props = {
  type: string;
  href: string;
  label?: string;
  title?: string;
  rel?: string;
};

const { type, label, title, rel } = Astro.props;
const href = /^\/(?!\/)/.test(Astro.props.href)
  ? getAssetPath(Astro.props.href)
  : Astro.props.href;
const known = Object.hasOwn(BADGE_ICONS, type);
const icon = badgeIcon(type);
const text = label ?? (known ? icon.label : type);
const name = title ?? (known ? icon.title : type);
const colour = `var(--badge-${known ? type : "link"})`;
const runs = bitmapRuns(icon.bitmap);
// Long labels are squeezed into the 56px text area.
const squeeze =
  text.length > 9 ? { textLength: 52, lengthAdjust: "spacingAndGlyphs" } : {};
---

<a class="b88" href={href} rel={rel} title={name}>
  <svg
    width="88"
    height="31"
    viewBox="0 0 88 31"
    shape-rendering="crispEdges"
    aria-hidden="true"
  >
    <rect width="88" height="31" fill="var(--b-edge)"></rect>
    <rect x="1" y="1" width="86" height="29" fill="var(--b-face)"></rect>
    <rect x="1" y="1" width="86" height="1" fill="var(--b-hi)"></rect>
    <rect x="1" y="1" width="1" height="29" fill="var(--b-hi)"></rect>
    <rect x="1" y="29" width="86" height="1" fill="var(--b-lo)"></rect>
    <rect x="86" y="1" width="1" height="29" fill="var(--b-lo)"></rect>
    <rect x="2" y="2" width="28" height="27" fill="var(--b-icon)"></rect>
    {
      runs.map(([x, y, length]) => (
        <rect
          x={5 + x * 2}
          y={5 + y * 2}
          width={length * 2}
          height="2"
          fill={colour}
        />
      ))
    }
    <rect x="30" y="2" width="1" height="27" fill="var(--b-lo)"></rect>
    <text x="59" y="19.5" text-anchor="middle" class="b88-text" {...squeeze}>
      {text}
    </text>
  </svg>
  <span class="sr-only">{name}</span>
</a>
