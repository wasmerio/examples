---
type Props = {
  id?: string;
  heading: string;
  text: string;
  linkLabel?: string;
  href?: string;
  /** Trailing text after the link, e.g. the closing period. */
  suffix?: string;
};

const { id, heading, text, linkLabel, href, suffix } = Astro.props;
---

<section id={id} class="empty-state">
  <h2 class="section-title">{heading}</h2>
  <p>
    {text}
    {
      linkLabel && href && (
        <>
          {" "}
          <a href={href} class="text-link">
            {linkLabel}
          </a>
        </>
      )
    }{suffix}
  </p>
</section>
