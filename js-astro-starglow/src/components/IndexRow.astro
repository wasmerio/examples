---
import { useTranslations } from "@/i18n";

/**
 * One row of a leader list: optional kind column, title, dev-only draft word,
 * a dotted leader and a right-aligned end column (date, status or count).
 * Render inside `<ul class="index">`.
 */
type Props = {
  href: string;
  title: string;
  /** Mono kind column, e.g. "post" or "note". */
  kind?: string;
  draft?: boolean;
  /** `<time>` end column: ISO value and visible text. */
  time?: { iso: string; text: string };
  /** Plain end text: a status word or a count. */
  end?: string;
  /** Marks the end text as a project status (`data-status`). */
  status?: string;
  /** Accessible name of the plain end text, e.g. "3 entries". */
  endLabel?: string;
  rel?: string;
  /** view-transition-name of the title, shared with the page's h1. */
  transitionName?: string;
};

const {
  href,
  title,
  kind,
  draft,
  time,
  status,
  end,
  endLabel,
  rel,
  transitionName,
} = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<li>
  <a href={href} rel={rel} class="index-row">
    {kind && <span class="kind">{kind}</span>}
    <span
      class="name"
      style={transitionName
        ? { viewTransitionName: transitionName }
        : undefined}
    >
      {title}
      {
        import.meta.env.DEV && draft && (
          <span class="draft-word">{t.post.draft.toLowerCase()}</span>
        )
      }
    </span>
    <span class="lead" aria-hidden="true"></span>
    {
      time && (
        <time class="end" datetime={time.iso}>
          {time.text}
        </time>
      )
    }
    {
      end && (
        <span
          class:list={["end", { status }]}
          data-status={status}
          aria-label={endLabel}
        >
          {end}
        </span>
      )
    }
  </a>
</li>
