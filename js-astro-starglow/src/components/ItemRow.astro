---
import type { ContentItem } from "@/utils/content/items";
import { itemTime } from "@/utils/content/items";
import { toTransitionName } from "@/utils/toTransitionName";
import IndexRow from "./IndexRow.astro";
import { useTranslations } from "@/i18n";

type Props = {
  item: ContentItem;
  /** Show the post/note kind column (mixed lists). */
  showKind?: boolean;
};

const { item, showKind = false } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const kind = (
  item.type === "post" ? t.content.typePost : t.content.typeNote
).toLowerCase();
---

<IndexRow
  href={item.url}
  title={item.title}
  kind={showKind ? kind : undefined}
  draft={item.draft}
  time={itemTime(item)}
  transitionName={toTransitionName(item.key)}
/>
