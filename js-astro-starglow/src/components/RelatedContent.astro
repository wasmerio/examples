---
import type { ContentItem } from "@/utils/content/items";
import { useTranslations } from "@/i18n";
import ItemRow from "./ItemRow.astro";

type Props = {
  items: ContentItem[];
  /** Heading text; defaults to "Related reading". */
  title?: string;
};

const { items, title } = Astro.props;

const t = useTranslations(Astro.currentLocale);
---

{
  items.length > 0 && (
    <section aria-labelledby="related-heading">
      <h2 id="related-heading" class="section-title">
        {title ?? t.related.title}
      </h2>
      <ul class="index">
        {items.map(item => (
          <ItemRow item={item} showKind />
        ))}
      </ul>
    </section>
  )
}
