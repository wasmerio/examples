---
import config from "@/config";
import { useTranslations } from "@/i18n";
import IndexRow from "./IndexRow.astro";

const t = useTranslations(Astro.currentLocale);

const stripScheme = (url: string) =>
  url.replace(/^https?:\/\//, "").replace(/\/+$/, "");

const items = config.socials.map(({ label, url }) => ({
  label,
  url,
  display: stripScheme(url),
}));
---

<section aria-labelledby="contact-methods">
  <h2 id="contact-methods" class="section-title">
    {t.contact.methods}
  </h2>
  {
    items.length > 0 ? (
      <ul class="index">
        {items.map(({ label, url, display }) => (
          <IndexRow href={url} title={label} end={display} rel="me" />
        ))}
      </ul>
    ) : (
      <p class="plain-text">{t.contact.noMethods}</p>
    )
  }
</section>
