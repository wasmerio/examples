---
import config from "@/config";

/**
 * Vim-style status bar for post and note pages: mode, the source file
 * relative to the content folder, file type and scroll position. Decorative
 * only (aria-hidden); rendered when `appearance.statusline` is on.
 */
type Props = {
  /** The entry's `filePath`, e.g. src/content/blog/2026/my-post.md */
  filePath?: string;
};

const { filePath = "" } = Astro.props;
const file = filePath.replace(/^(?:.*\/)?content\//, "");
const type = file.endsWith(".mdx") ? "mdx" : "markdown";
---

{
  (config.appearance.statusline || config.appearance.preview) && file && (
    <div class="statusline" aria-hidden="true" data-pagefind-ignore>
      <span class="statusline-mode">NORMAL</span>
      <span class="statusline-file">{file}</span>
      <span class="statusline-ro">[RO]</span>
      <span class="statusline-fill" />
      <span class="statusline-type">{type}</span>
      <span class="statusline-pos" data-statusline-pos>
        Top
      </span>
    </div>
  )
}

<script>
  // Vim's ruler: Top, NN%, Bot, or All when the page does not scroll.
  let pos: HTMLElement | null = null;

  function update(): void {
    if (!pos) return;
    const max = document.documentElement.scrollHeight - innerHeight;
    pos.textContent =
      max <= 0
        ? "All"
        : scrollY <= 0
          ? "Top"
          : scrollY >= max - 1
            ? "Bot"
            : `${Math.round((scrollY / max) * 100)}%`;
  }

  function init(): void {
    pos = document.querySelector<HTMLElement>("[data-statusline-pos]");
    update();
  }

  addEventListener("scroll", update, { passive: true });
  addEventListener("resize", update, { passive: true });
  document.addEventListener("astro:page-load", init);
  init();
</script>
