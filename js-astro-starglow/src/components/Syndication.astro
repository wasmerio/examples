---
import config from "@/config";
import { useTranslations } from "@/i18n";

type Props = {
  /** Validated http(s) URLs from the `syndication` frontmatter, in order. */
  urls: string[];
};

const { urls } = Astro.props;
const t = useTranslations(Astro.currentLocale ?? config.site.lang);

const KNOWN_HOSTS: Record<string, string> = {
  "dev.to": "DEV.to",
  "medium.com": "Medium",
  "hashnode.com": "Hashnode",
  "linkedin.com": "LinkedIn",
  "bsky.app": "Bluesky",
  "reddit.com": "Reddit",
  "news.ycombinator.com": "Hacker News",
  "x.com": "X",
};

/** A known name for the host, else the bare hostname without `www.`. */
function labelOf(url: string): string {
  const host = new URL(url).hostname.replace(/^www\./, "");
  if (host.endsWith(".medium.com")) return KNOWN_HOSTS["medium.com"];
  return KNOWN_HOSTS[host] ?? host;
}

const links = urls.map(url => ({ url, label: labelOf(url) }));
---

{
  links.length > 0 && (
    <p class="syndication">
      <span class="syndication-label">{t.post.alsoOn}</span>{" "}
      {links.map(({ url, label }, index) => (
        <>
          {index > 0 && ", "}
          <a class="u-syndication" rel="syndication" href={url}>
            {label}
          </a>
        </>
      ))}
    </p>
  )
}
