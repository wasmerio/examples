---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  /** Off inside lists, where a repeated tag would duplicate the name. */
  transition?: boolean;
};

const { tag, tagName, transition = true } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `tags/${tag}/`);
---

<li>
  {
    transition ? (
      <a href={href} transition:name={tag} class="tag">
        #{tagName}
      </a>
    ) : (
      <a href={href} class="tag">
        #{tagName}
      </a>
    )
  }
</li>
