---
// Rendered in <head> on every page, after the theme's own tags. Add
// your own tags here: analytics, site verification, extra <meta> or
// <link>, stylesheets. This file is yours: starglow never changes it
// after release.
import config from "@/config";

type Props = {
  title: string;
  description: string;
};

const fediverseCreator = config.site.fediverseCreator;
---

{
  fediverseCreator && (
    <meta name="fediverse:creator" content={fediverseCreator} />
  )
}
