---
import Layout from "./Layout.astro";
import type { Props as LayoutProps } from "./Layout.astro";
import config from "@/config";
import { blogPosting, requireSite, toJsonLd } from "@/utils/jsonLd";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";

type Props = Omit<LayoutProps, "ogType"> & {
  /** The post title as the visible h1 shows it, without the site suffix. */
  headline: string;
  pubDatetime: Date;
  modDatetime?: Date | null;
};

const { site } = config;

const { headline, pubDatetime, modDatetime, ...layoutProps } = Astro.props;
const { description = site.description } = layoutProps;

// Computed once and passed to Layout too, so the JSON-LD, canonical and
// og:image can never disagree.
const canonical =
  layoutProps.canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(
  layoutProps.ogImage ?? resolveDefaultOgImagePath(config),
  Astro.site
).href;
// PostMeta shows "Updated" only when the modification is later.
const isUpdated =
  modDatetime != null && modDatetime.getTime() > pubDatetime.getTime();

const structuredDataJson = toJsonLd(
  blogPosting({
    site: requireSite(Astro.site),
    headline,
    description,
    url: canonical,
    image,
    datePublished: pubDatetime.toISOString(),
    dateModified: isUpdated ? modDatetime.toISOString() : undefined,
    inLanguage: site.lang,
    authorName: site.author,
  })
);
---

<Layout
  {...layoutProps}
  canonicalURL={canonical}
  ogImage={image}
  ogType="article"
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={pubDatetime.toISOString()}
    />
    {
      isUpdated && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJson}
    />
  </Fragment>

  <slot />
</Layout>
