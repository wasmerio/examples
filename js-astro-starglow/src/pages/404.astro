---
import { getAssetPath } from "@/utils/withBase";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import IndexRow from "@/components/IndexRow.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// A terminal that cannot find the page; <b> marks the accent parts.
const MONITOR = [
  "   .-----------------------.",
  "   |  $ cd /requested/page |",
  "   |  <b>cd: no such file or</b>  |",
  "   |  <b>directory</b>            |",
  "   |  $ <b>_</b>                  |",
  "   '-----------------------'",
  "        _|___________|_",
  "       /_______________\\",
].join("\n");

const suggestions = [
  { label: t.nav.home, href: getRelativeLocaleUrl(locale, "") },
  { label: t.nav.blog, href: getRelativeLocaleUrl(locale, "blog") },
  ...(config.features.search !== false
    ? [{ label: t.nav.search, href: getRelativeLocaleUrl(locale, "search") }]
    : []),
];
---

<!-- GitHub Pages serves this document at /404.html; /404/ does not exist. -->
<Layout
  title={`${t.notFound.title} | ${config.site.title}`}
  canonicalURL={new URL(getAssetPath("404.html"), Astro.site).href}
  noindex
>
  <Header />

  <Main pageTitle={t.notFound.message}>
    <pre class="ascii" aria-hidden="true" set:html={MONITOR} />
    <p class="not-found-text">{t.notFound.body}</p>
    <ul class="index">
      {
        suggestions.map(({ label, href }) => (
          <IndexRow href={href} title={label} end={href} />
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
