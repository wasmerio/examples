---
import { getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const entry = await getEntry("pages", "about");
if (!entry) {
  throw new Error("[pages] src/content/pages/about.md is missing");
}
const { data } = entry;
const { Content } = await render(entry);
---

<Layout
  title={`${data.title} | ${config.site.title}`}
  description={data.description}
  ogImage={data.ogImage}
  canonicalURL={data.canonicalUrl}
>
  <Header />

  <Main pageTitle={data.title} pageDesc={data.description}>
    <article class="app-prose">
      <Content />
    </article>
    <p class="about-cta">
      <a href={getRelativeLocaleUrl(locale, "contact")} class="text-link">
        {t.about.contactCta}
      </a>
      <span aria-hidden="true"> →</span>
    </p>
  </Main>

  <Footer />
</Layout>
