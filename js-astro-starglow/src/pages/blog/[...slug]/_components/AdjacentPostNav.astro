---
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

{
  (prevPost || nextPost) && (
    <nav
      class="adjacent"
      aria-label={`${t.post.previousPost} / ${t.post.nextPost}`}
      data-pagefind-ignore
    >
      {prevPost && (
        <a href={getPostUrl(prevPost.id, prevPost.filePath, locale)}>
          <span class="meta">
            <span aria-hidden="true">←</span> {t.post.previousPost}
          </span>
          {prevPost.title}
        </a>
      )}
      {nextPost && (
        <a
          class="next"
          href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        >
          <span class="meta">
            {t.post.nextPost} <span aria-hidden="true">→</span>
          </span>
          {nextPost.title}
        </a>
      )}
    </nav>
  )
}
