---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import config from "@/config";
import { useTranslations, tplStr } from "@/i18n";
import { resolveTimezone } from "@/utils/resolveTimezone";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  /** Mono kind word, e.g. "post" or "note". */
  kind: string;
  /** The main date: a post's publication date, a note's effective date. */
  date?: string | Date;
  /** Shown instead of a date when there is none (a note's folder year). */
  year?: string;
  /** A later modification date, shown as "updated". */
  modDatetime?: string | Date | null;
  timezone?: string;
  draft?: boolean;
  minutes: number;
};

const {
  kind,
  date,
  year,
  modDatetime,
  timezone: postTimezone,
  draft,
  minutes,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);
const zone = resolveTimezone(postTimezone ?? config.site.timezone);

const main = date ? dayjs(date).tz(zone) : null;
const updated = modDatetime ? dayjs(modDatetime).tz(zone) : null;
const isUpdated =
  main !== null && updated !== null && updated.valueOf() > main.valueOf();
const format = "YYYY-MM-DD";
---

<p class="post-meta meta">
  <span>{kind}</span>
  <span aria-hidden="true"> · </span>
  {
    main ? (
      <time datetime={main.toISOString()}>{main.format(format)}</time>
    ) : (
      <time datetime={year}>{year}</time>
    )
  }
  {
    isUpdated && updated && (
      <>
        <span aria-hidden="true"> · </span>
        <span>
          {t.post.updatedAt.toLowerCase()}{" "}
          <time datetime={updated.toISOString()}>{updated.format(format)}</time>
        </span>
      </>
    )
  }
  <span aria-hidden="true"> · </span>
  <span>{tplStr(t.post.readingTime, { minutes })}</span>
  {
    import.meta.env.DEV && draft && (
      <>
        <span aria-hidden="true"> · </span>
        <span>{t.post.draft.toLowerCase()}</span>
      </>
    )
  }
</p>
