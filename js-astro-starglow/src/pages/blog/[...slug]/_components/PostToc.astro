---
import type { MarkdownHeading } from "astro";
import { useTranslations } from "@/i18n";
import { buildTocTree, hasToc } from "@/utils/buildTocTree";
import TocList from "./TocList.astro";

type Props = { headings: MarkdownHeading[] };

const { headings } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

{
  hasToc(headings) && (
    <nav
      class="post-toc"
      aria-label={t.post.tableOfContents}
      data-pagefind-ignore
    >
      <span class="post-toc-label" aria-hidden="true">
        {t.post.contentsLabel}
      </span>
      <TocList items={buildTocTree(headings)} />
    </nav>
  )
}
