---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Statusline from "@/components/Statusline.astro";
import Tag from "@/components/Tag.astro";
import RelatedContent from "@/components/RelatedContent.astro";
import { getAllItems, postToItem } from "@/utils/content/items";
import { getRelatedItems } from "@/utils/content/related";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import EditPost from "./_components/EditPost.astro";
import BackButton from "./_components/BackButton.astro";
import BackToTopButton from "./_components/BackToTopButton.astro";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import PostToc from "./_components/PostToc.astro";
import PostMeta from "./_components/PostMeta.astro";
import { readingTime } from "@/utils/readingTime";
import ArticleEnhancements from "@/components/ArticleEnhancements.astro";
import CopyLink from "@/components/CopyLink.astro";
import Syndication from "@/components/Syndication.astro";
import PostEnd from "@/custom/PostEnd.astro";
import config from "@/config";
import { tplStr, useTranslations } from "@/i18n";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts);

  return sortedPosts.map((post, index) => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: {
      post,
      // sortedPosts is newest-first, so "older" (prev) is a higher index
      // and "newer" (next) is a lower index.
      prevPost:
        index < sortedPosts.length - 1
          ? {
              id: sortedPosts[index + 1].id,
              title: sortedPosts[index + 1].data.title,
              filePath: sortedPosts[index + 1].filePath,
            }
          : null,
      nextPost:
        index > 0
          ? {
              id: sortedPosts[index - 1].id,
              title: sortedPosts[index - 1].data.title,
              filePath: sortedPosts[index - 1].filePath,
            }
          : null,
    },
  }));
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const {
  title,
  description,
  ogImage: initOgImage,
  canonicalUrl,
  syndication,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  hideToc,
  draft,
} = post.data;

const related = getRelatedItems(postToItem(post), await getAllItems());

const { Content, headings } = await render(post);
const tocHeadings = config.features.toc && !hideToc ? headings : [];

let ogImageUrl: string | undefined;
let ogImageSize: { width: number; height: number } | null | undefined;
let ogImageAlt: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
  ogImageSize = null;
  ogImageAlt = title;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
  ogImageSize = { width: initOgImage.width, height: initOgImage.height };
  ogImageAlt = title;
}

if (!ogImageUrl && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );
  ogImageUrl = `${postUrl}/index.png`;
  ogImageAlt = tplStr(t.og.imageAlt, { type: t.content.typePost, title });
}

const ogImage = ogImageUrl ? new URL(ogImageUrl, Astro.site).href : undefined;

// The one canonical of this page: PostLayout, the copy link and the JSON-LD
// all use it.
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;
---

<PostLayout
  headline={title}
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogImageSize={ogImageSize}
  canonicalURL={canonical}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <Main
    pageTitle={title}
    titleStyle={{ viewTransitionName: toTransitionName(`post:${post.id}`) }}
    trackBack={false}
    data-pagefind-body
  >
    <Fragment slot="meta">
      <PostMeta
        kind={t.content.typePost.toLowerCase()}
        date={pubDatetime}
        {modDatetime}
        {timezone}
        {draft}
        minutes={readingTime(post.body)}
      />
      <BackButton />
    </Fragment>

    {
      import.meta.env.DEV && draft && (
        <p class="draft-note" data-pagefind-ignore>
          {t.post.draftNotice}
        </p>
      )
    }

    <div class="post-body">
      <PostToc headings={tocHeadings} />
      <article id="article" class="app-prose">
        <Content />
      </article>
    </div>
    <ArticleEnhancements />

    <BackToTopButton />

    {
      tags.length > 0 && (
        <ul class="post-tags" aria-label={t.post.tagLabel}>
          {tags.map(tag => (
            <Tag tag={slugifyStr(tag)} tagName={tag} />
          ))}
        </ul>
      )
    }

    <div
      class:list={["share-row", { "share-row-solo": tags.length === 0 }]}
      data-pagefind-ignore
    >
      <CopyLink url={canonical} />
      <Syndication urls={syndication} />
      <EditPost {hideEditPost} {post} />
    </div>

    {
      related.length > 0 && (
        <div data-pagefind-ignore>
          <RelatedContent items={related} />
        </div>
      )
    }

    <div data-pagefind-ignore>
      <PostEnd {post} />
    </div>

    <AdjacentPostNav {prevPost} {nextPost} />
  </Main>
  <Footer />
  <Statusline filePath={post.filePath} />
</PostLayout>
