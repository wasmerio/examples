---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import SocialList from "@/components/SocialList.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const entry = await getEntry("pages", "contact");
if (!entry) {
  throw new Error("[pages] src/content/pages/contact.md is missing");
}
const { data } = entry;
const { Content } = await render(entry);
---

<Layout
  title={`${data.title} | ${config.site.title}`}
  description={data.description}
  ogImage={data.ogImage}
  canonicalURL={data.canonicalUrl}
>
  <Header />

  <Main pageTitle={data.title} pageDesc={data.description}>
    <article class="app-prose">
      <Content />
    </article>
    <SocialList />
  </Main>

  <Footer />
</Layout>
