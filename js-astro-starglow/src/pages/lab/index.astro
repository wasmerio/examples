---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import ProjectRow from "@/components/ProjectRow.astro";
import EmptyState from "@/components/EmptyState.astro";
import Footer from "@/components/Footer.astro";
import {
  getVisibleProjects,
  isLabProject,
  sortProjects,
} from "@/utils/content/projects";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const experiments = sortProjects(
  (await getVisibleProjects()).filter(isLabProject)
);
---

<Layout title={`${t.pages.labTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.labTitle} pageDesc={t.pages.labDesc}>
    {
      experiments.length > 0 ? (
        <ul class="index">
          {experiments.map(project => (
            <ProjectRow project={project} />
          ))}
        </ul>
      ) : (
        <EmptyState
          id="empty-lab"
          heading={t.empty.labHeading}
          text={t.empty.labBody}
          linkLabel={t.empty.readTheBlog}
          href={getRelativeLocaleUrl(locale, "blog")}
          suffix="."
        />
      )
    }
  </Main>

  <Footer />
</Layout>
