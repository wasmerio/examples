---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import ItemRow from "@/components/ItemRow.astro";
import EmptyState from "@/components/EmptyState.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getNoteItems } from "@/utils/content/items";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getNoteItems(), { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.notesTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.notesTitle} pageDesc={t.pages.notesDesc}>
    {
      page.data.length > 0 ? (
        <ul class="index">
          {page.data.map(item => (
            <ItemRow item={item} />
          ))}
        </ul>
      ) : (
        <EmptyState
          id="empty-notes"
          heading={t.empty.notesHeading}
          text={t.empty.notesBody}
          linkLabel={t.empty.rssLabel}
          href={getAssetPath("rss.xml")}
          suffix="."
        />
      )
    }
    <Pagination {page} />
  </Main>

  <Footer />
</Layout>
