---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import ProjectRow from "@/components/ProjectRow.astro";
import EmptyState from "@/components/EmptyState.astro";
import Footer from "@/components/Footer.astro";
import {
  getVisibleProjects,
  isLabProject,
  sortProjects,
} from "@/utils/content/projects";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const projects = sortProjects(
  (await getVisibleProjects()).filter(project => !isLabProject(project))
);
const githubUrl = config.socials
  .find(social => social.name === "github")
  ?.url?.trim();
---

<Layout title={`${t.pages.projectsTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.projectsTitle} pageDesc={t.pages.projectsDesc}>
    {
      projects.length > 0 ? (
        <ul class="index">
          {projects.map(project => (
            <ProjectRow project={project} />
          ))}
        </ul>
      ) : githubUrl ? (
        <EmptyState
          id="empty-projects"
          heading={t.empty.projectsHeading}
          text={t.empty.projectsBody}
          linkLabel={t.empty.projectsGithub}
          href={githubUrl}
          suffix="."
        />
      ) : (
        <EmptyState
          id="empty-projects"
          heading={t.empty.projectsHeading}
          text={t.empty.projectsFallback}
          linkLabel={t.empty.readTheBlog}
          href={getRelativeLocaleUrl(locale, "blog")}
          suffix="."
        />
      )
    }
  </Main>

  <Footer />
</Layout>
