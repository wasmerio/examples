---
import { getRelativeLocaleUrl } from "astro:i18n";
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";
import { getNoteItems, getPostItems } from "@/utils/content/items";
import { getVisibleProjects } from "@/utils/content/projects";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search !== "pagefind" && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const backUrl = config.features.showBackButton
  ? `${Astro.url.pathname}`
  : getRelativeLocaleUrl(locale, "");

const pagefindBundlePath = getAssetPath("pagefind/");

const t = useTranslations(locale);

// The same helpers the content routes use, so this is true exactly when the
// search index holds pages. An empty index makes the Pagefind client throw, so
// nothing is mounted until something is published.
const [posts, notes, projects] = await Promise.all([
  getPostItems(),
  getNoteItems(),
  getVisibleProjects(),
]);
const searchable = posts.length + notes.length + projects.length > 0;

// `search.noscript` and `search.emptyBrowse` carry {{blog}}, {{notes}} and
// {{projects}} tokens. The split keeps each token at an odd index, so text
// stays text and tokens become links.
const linkClass = "text-link";
const noscriptLinks: Record<string, { href: string; label: string }> = {
  blog: { href: getRelativeLocaleUrl(locale, "blog"), label: t.search.blog },
  notes: { href: getRelativeLocaleUrl(locale, "notes"), label: t.search.notes },
  projects: {
    href: getRelativeLocaleUrl(locale, "projects"),
    label: t.search.projects,
  },
};
const splitTokens = (text: string) =>
  text.split(/\{\{(blog|notes|projects)\}\}/);
const noscriptParts = splitTokens(t.search.noscript);
const emptyParts = splitTokens(t.search.emptyBrowse);
---

<Layout title={`${t.pages.searchTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.searchTitle} pageDesc={t.pages.searchDesc}>
    {
      searchable ? (
        <div
          id="pagefind-search"
          transition:persist
          data-backurl={backUrl}
          data-bundle-path={pagefindBundlePath}
          data-error-search={t.search.errorLoad}
        >
          <noscript>
            <p>
              {noscriptParts.map((part, index) => {
                const link = index % 2 === 1 ? noscriptLinks[part] : undefined;
                return link ? (
                  <a href={link.href} class={linkClass}>
                    {link.label}
                  </a>
                ) : (
                  part
                );
              })}
            </p>
          </noscript>
          <template data-search-empty-template>
            <p>
              {t.search.empty}{" "}
              {emptyParts.map((part, index) => {
                const link = index % 2 === 1 ? noscriptLinks[part] : undefined;
                return link ? (
                  <a href={link.href} class={linkClass}>
                    {link.label}
                  </a>
                ) : (
                  part
                );
              })}
            </p>
          </template>
        </div>
      ) : (
        <div id="pagefind-search" data-search-empty>
          <p>
            {t.search.empty}{" "}
            {emptyParts.map((part, index) => {
              const link = index % 2 === 1 ? noscriptLinks[part] : undefined;
              return link ? (
                <a href={link.href} class={linkClass}>
                  {link.label}
                </a>
              ) : (
                part
              );
            })}
          </p>
        </div>
      )
    }
  </Main>

  <Footer />
</Layout>

<script>
  function initSearch() {
    const pageFindSearch: HTMLElement | null =
      document.querySelector("#pagefind-search");

    if (!pageFindSearch) return;

    // Nothing is published, so there is no index to load.
    if ("searchEmpty" in pageFindSearch.dataset) return;

    const bundlePath = pageFindSearch?.dataset?.bundlePath;
    if (!bundlePath) return;

    const params = new URLSearchParams(window.location.search);

    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    // The UI waits on /pagefind/pagefind.js. When that import fails (index
    // blocked, deployed without it), the UI's own init would throw an uncaught
    // TypeError and show nothing, so the failure is shown here instead.
    const showLoadError = (error: unknown) => {
      // eslint-disable-next-line no-console
      console.error(error);
      pageFindSearch.querySelector("[data-search-error]")?.remove();
      const message = document.createElement("p");
      message.dataset.searchError = "";
      message.setAttribute("role", "alert");
      message.className = "plain-text";
      message.textContent = pageFindSearch.dataset.errorSearch ?? "";
      pageFindSearch.append(message);
    };

    const showEmpty = () => {
      const template = pageFindSearch.querySelector<HTMLTemplateElement>(
        "template[data-search-empty-template]"
      );
      if (!template) return;
      pageFindSearch.replaceChildren(template.content.cloneNode(true));
      pageFindSearch.dataset.searchEmpty = "";
    };

    onIdle(async () => {
      try {
        // @ts-expect-error — Missing types for @pagefind/default-ui package.
        const { PagefindUI } = await import("@pagefind/default-ui");

        // An index without pages has no language index, and the UI would
        // hang on "Searching…". That happens in dev, where drafts make the
        // page searchable but the last build's index never holds them.
        const entry = await fetch(`${bundlePath}pagefind-entry.json`)
          .then(response => (response.ok ? response.json() : null))
          .catch(() => null);
        if (!entry && import.meta.env.DEV) {
          pageFindSearch.innerHTML = `
            <p class="search-notice">Dev mode: build the site once to search during development:
            <code>./dev.sh build</code></p>
          `;
          return;
        }
        if (entry && Object.keys(entry.languages ?? {}).length === 0) {
          showEmpty();
          return;
        }

        // Fail early and visibly when the index bundle cannot be loaded.
        await import(/* @vite-ignore */ `${bundlePath}pagefind.js`);

        const search = new PagefindUI({
          element: "#pagefind-search",
          bundlePath,
          showImages: false,
          showSubResults: true,
          autofocus: true,
          translations: { error_search: pageFindSearch.dataset.errorSearch },
          processTerm: function (term: string) {
            params.set("q", term);
            history.replaceState(history.state, "", "?" + params.toString());

            const backUrl =
              pageFindSearch?.dataset?.backurl ?? window.location.pathname;
            sessionStorage.setItem(
              "backUrl",
              `${backUrl}?${params.toString()}`
            );

            return term;
          },
        });

        const query = params.get("q");
        if (query) {
          search.triggerSearch(query);
        }

        const searchInput = document.querySelector(
          ".pagefind-ui__search-input"
        );
        const clearButton = document.querySelector(
          ".pagefind-ui__search-clear"
        );
        searchInput?.addEventListener("input", resetSearchParam);
        clearButton?.addEventListener("click", resetSearchParam);

        function resetSearchParam(e: Event) {
          if ((e.target as HTMLInputElement)?.value.trim() === "") {
            history.replaceState(history.state, "", window.location.pathname);
          }
        }
      } catch (error) {
        showLoadError(error);
      }
    });
  }

  document.addEventListener("astro:after-swap", () => {
    const pagefindSearch = document.querySelector("#pagefind-search");

    if (pagefindSearch && pagefindSearch.querySelector("form")) return;

    initSearch();
  });
  initSearch();
</script>
