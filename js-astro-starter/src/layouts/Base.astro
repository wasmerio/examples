---
interface Props {
  title: string;
  heading: string;
  description: string;
}

const { title, heading, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script>
      import "../starter-ui.js";
    </script>
  </head>
  <body>
    <wasmer-starter>
      <wasmer-card>
        <wasmer-stack slot="header" vertical>
          <wasmer-badge>Astro</wasmer-badge>
          <wasmer-title>{heading}</wasmer-title>
          <wasmer-text>{description}</wasmer-text>
        </wasmer-stack>
        <slot />
        <wasmer-text slot="footer">Astro starter for Wasmer Edge</wasmer-text>
      </wasmer-card>
    </wasmer-starter>
  </body>
</html>

<style is:global>
  body { margin: 0; }
</style>
