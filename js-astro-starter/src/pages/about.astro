  <wasmer-stack>
    <wasmer-action href="/" variant="outline" size="lg">Back home</wasmer-action>
    <wasmer-action href="https://docs.astro.build/" variant="outline" size="lg" target="_blank">Astro docs</wasmer-action>
  </wasmer-stack>
</Base>
