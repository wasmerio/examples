---
import Base from "../layouts/Base.astro";

const pages = [
  { href: "/about/", label: "About this starter" },
];
const builtAt = new Date().toISOString().slice(0, 10);
---

<Base title="Astro on Wasmer Edge">
  <span class="badge">Astro</span>
  <h1>Your Astro site is live on Wasmer Edge</h1>
  <p>
    Astro renders every page to HTML at build time, and Wasmer Edge serves the result from <code>dist/</code>. Edit
    <code>src/pages/index.astro</code> and push to redeploy.
  </p>
  <ul>
    <li>Zero JavaScript shipped by default</li>
    <li>File-based routing in <code>src/pages/</code></li>
    <li>Built on {builtAt}</li>
  </ul>
  <div class="actions">
    {pages.map((page) => <a class="button primary" href={page.href}>{page.label}</a>)}
    <a class="button secondary" href="https://docs.wasmer.io/edge" target="_blank" rel="noreferrer">Wasmer Edge docs</a>
  </div>
</Base>
