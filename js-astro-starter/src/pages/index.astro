---
import Base from "../layouts/Base.astro";
---

<Base
  title="Astro on Wasmer Edge"
  heading="Your Astro site is running"
  description="Build a fast static site with Astro on Wasmer Edge."
>
  <wasmer-notice variant="success">Astro rendered this page to HTML at build time.</wasmer-notice>
  <wasmer-text>Edit src/pages/index.astro to make it yours. Each page is built into dist/ and served as a static file.</wasmer-text>
  <wasmer-text>A small local JavaScript module provides the shared Wasmer interface. No client framework is needed.</wasmer-text>
  <wasmer-stack>
    <wasmer-action href="/about/" size="lg">About this starter</wasmer-action>
    <wasmer-action href="https://docs.wasmer.io/edge" variant="outline" size="lg" target="_blank">Wasmer Edge docs</wasmer-action>
  </wasmer-stack>
</Base>
