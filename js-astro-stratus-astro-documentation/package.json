{
  "name": "stratus-astro-template",
  "type": "module",
  "version": "1.0.0",
  "description": "A documentation site starter built with Astro, designed for visual editing in CloudCannon",
  "keywords": ["documentation", "docs", "astro", "cloudcannon", "template"],
  "author": "CloudCannon",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && npm run routing:build && npm run search:index",
    "routing:build": "node scripts/cms/routing.mjs",
    "search:index": "pagefind --site dist",
    "search:dev": "npm run build && node scripts/search/dev-index.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run lint && npm run format && npm run typecheck && npm run previews:check && npm run docs:catalog:check && npm run agents:check && npm run icons:check && npm run lint:cms && npm run lint:roots && npm run lint:nesting && npm run lint:schema && npm run lint:links && npm run check:placeholders",
    "check:placeholders": "node scripts/check/placeholders.mjs",
    "reset:starter": "node scripts/setup/reset-starter.mjs",
    "check:fix": "npm run lint:fix && npm run format:fix",
    "typecheck": "astro check",
    "lint:cms": "node scripts/cms/lint.mjs",
    "lint:roots": "node scripts/cms/lint-roots.mjs",
    "agents:sync": "node scripts/agents/sync.mjs",
    "agents:check": "node scripts/agents/sync.mjs --check",
    "icons:sync": "node scripts/icons/sync.mjs",
    "icons:check": "node scripts/icons/sync.mjs --check",
    "test:render": "node scripts/tests/render-all-sections.mjs",
    "test:unit": "vitest run",
    "test:smoke": "node scripts/tests/smoke.mjs",
    "test:flow-margins": "node scripts/tests/flow-margins.mjs",
    "new:component": "node scripts/scaffold/new-component.mjs",
    "previews:build": "node scripts/previews/build.mjs",
    "previews:screenshot": "node scripts/previews/screenshot.mjs",
    "previews:montage": "node scripts/previews/montage.mjs",
    "previews:check": "node scripts/previews/build.mjs --check && node scripts/previews/check.mjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:css-vars && npm run lint:css-literals && npm run lint:yml",
    "lint:css-vars": "node scripts/css/lint-vars.mjs",
    "lint:css-literals": "node scripts/css/lint-literals.mjs",
    "lint:schema": "node scripts/cms/lint-schema.mjs",
    "lint:js": "eslint .",
    "lint:yml": "eslint \"**/*.{yml,yaml}\"",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix && npm run lint:yml:fix",
    "lint:js:fix": "eslint . --fix",
    "lint:yml:fix": "eslint \"**/*.{yml,yaml}\" --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "deps:sync": "rm -rf node_modules && npm install --os=linux --cpu=x64 --libc=glibc --ignore-scripts --no-audit && npm ci",
    "deps:check": "npm ci --dry-run",
    "lint:nesting": "node scripts/cms/lint-nesting.mjs",
    "lint:links": "node scripts/check/links.mjs",
    "docs:catalog": "node scripts/docs/catalog.mjs && npm run agents:sync",
    "docs:catalog:check": "node scripts/docs/catalog.mjs --check"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@choctawnationofoklahoma/lite-vimeo": "^1.3.1",
    "@cloudcannon/editable-regions": "^0.0.19",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@pagefind/component-ui": "^1.5.2",
    "astro": "^7.2.0",
    "glob": "^13.0.6",
    "js-yaml": "^5.2.3",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.17.2",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudcannon/configuration-types": "^0.0.60",
    "@cloudcannon/javascript-api": "^0.0.14",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "ajv": "^8.20.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsonc": "^3.4.1",
    "eslint-plugin-yml": "^3.8.1",
    "jsonc-eslint-parser": "^3.3.0",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml-eslint-parser": "^2.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "^0.35.3",
    "@img/sharp-linuxmusl-x64": "^0.35.3",
    "@pagefind/linux-x64": "^1.5.2",
    "@pagefind/windows-x64": "^1.5.2",
    "@rollup/rollup-linux-x64-gnu": "^4.62.4",
    "@rollup/rollup-win32-x64-msvc": "^4.62.4"
  }
}
