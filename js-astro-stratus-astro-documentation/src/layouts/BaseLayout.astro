---
import { ClientRouter } from "astro:transitions";
import { fade } from "astro:transitions";
import SeoHead from "@components/utils/SeoHead.astro";
import StructuredData from "@components/utils/StructuredData.astro";
import seoData from "@data/seo.json";
import "@styles/style.css";
import SiteFonts from "@layouts/SiteFonts.astro";
import ThemeSelector from "@components/navigation/theme-selector/ThemeSelector.astro";
import themeData from "@data/theme.json";
import { themeStyleAttribute } from "@utils/themeTokens.mjs";

export interface Props {
  title: string;
  heading?: string | null;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  canonical?: string | null;
  type?: "website" | "article";
  article?: {
    publishedTime?: string | null;
    modifiedTime?: string | null;
    author?: string | string[] | null;
    tags?: string[] | null;
  } | null;
  noindex?: boolean;
  defaultTheme?: "light" | "dark";
}

const props = Astro.props;

const themeStyle = themeStyleAttribute(themeData.theme);
---

<!doctype html>
<html
  lang="en"
  data-theme={props.defaultTheme ?? "light"}
  style={themeStyle}
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    {
      seoData.faviconIcoSource && (
        <link
          rel="icon"
          href={seoData.faviconIcoSource}
          sizes="32x32"
        />
      )
    }
    {
      seoData.faviconSource && (
        <link
          rel="icon"
          type="image/svg+xml"
          href={seoData.faviconSource}
        />
      )
    }
    <meta
      name="generator"
      content={Astro.generator}
    />
    <style is:inline>
      /* `pagefind` must sit below `components` so component styles win over Pagefind's. */
      @layer reset, base, pagefind, components, page-sections, utils, overrides;
    </style>

    <SiteFonts />

    {
      import.meta.env.DEV ? (
        <script
          is:inline
          type="module"
          src="/@vite/client"
        />
      ) : null
    }

    <script>
      if (window.inEditorMode) {
        import("../../live-editing");
        import("../../editor-live-sync");
      }
    </script>

    <SeoHead
      site={seoData}
      title={props.title}
      description={props.description}
      keywords={props.keywords}
      image={props.image}
      canonical={props.canonical}
      type={props.type}
      article={props.article}
      noindex={props.noindex}
    />

    <StructuredData
      site={seoData}
      heading={props.heading}
      title={props.title}
      description={props.description}
      image={props.image}
      canonical={props.canonical}
      type={props.type}
      article={props.article}
    />

    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap-index.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${seoData.siteName} changelog`}
      href="/changelog.xml"
    />

    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <div transition:animate={fade({ duration: "0.2s" })}>
      <slot />
    </div>
    <ThemeSelector />
  </body>
</html>
