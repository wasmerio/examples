---
import Base from '../layouts/Base.astro';
import { SITE, shown } from '../consts.ts';
import { getPage } from '../lib/pages.ts';

/* The wording is the theme's; the chips under it are the site's, from
   src/content/pages/404.md, and a row whose feature is off is dropped, so
   switching a section off cannot leave a dead link here. */
const { data } = await getPage('404');
const links = shown(data.links ?? []);
---

{/* noindex: served for every URL that does not exist, so no canonical could
     name it truthfully — without the flag it claimed "/404/". */}
<Base
  title="Page not found"
  description={`That page does not exist on ${new URL(SITE.url).host}.`}
  noindex
>
  <section class="wrap section center">
    <p class="kicker">cat $REQUEST_URI</p>
    <h1>404</h1>
    <p class="msg">
      No such file or directory. The page you were looking for is not here — it may have moved, or
      it may never have been anything.
    </p>
    <ul class="options">
      {links.map((item) => (
        <li>
          <a class="chip" href={item.href} data-section={item.section}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .center {
    text-align: center;
    padding-block: clamp(4rem, 14vw, 9rem);
  }
  .kicker {
    justify-content: center;
  }
  h1 {
    font-family: var(--font-mono);
    font-size: clamp(4rem, 18vw, 9rem);
    color: var(--sec);
    line-height: 1;
    margin-bottom: 1rem;
  }
  .msg {
    max-width: 48ch;
    margin-inline: auto;
    color: var(--text-muted);
  }
  .options {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  /* Each chip previews its destination's accent: its own data-section has
     already re-pointed --sec inside it. */
  .options .chip:hover {
    border-color: var(--sec-line);
    color: var(--sec-strong);
    background: var(--sec-dim);
  }
</style>
