---
import { FEATURES, disabled } from '../../features.ts';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PubEntry from '../../components/pub/PubEntry.astro';
import ScholarMark from '../../components/ScholarMark.astro';
import { byYear } from '../../lib/publications.ts';
import { scholarMetrics, scholarProfileUrl, formatUpdated } from '../../lib/citations.ts';
import { formatCount } from '../../lib/format.ts';
import { peopleLinks } from '../../lib/people.ts';
import { fill, getPage, need } from '../../lib/pages.ts';

if (!FEATURES.publications) return disabled();

const pubs = await getCollection('publications');
const groups = byYear(pubs);
const metrics = FEATURES.citations ? scholarMetrics() : undefined;
const profile = scholarProfileUrl();
const Metric = profile ? 'a' : 'div';
// Built once for the whole page, then handed to every entry.
const links = FEATURES.people ? await peopleLinks() : undefined;

/* The words: src/content/pages/publications.md. */
const page = await getPage('publications');
const { label } = page;
---

<Base {...page.meta()} section="publications">
  <section class="wrap section">
    <p class="kicker" data-sigil="##">
      publications
    </p>
    <h1>Publications</h1>
    {/* The count, then the body, as one paragraph: the body renders its own
         <p>, set inline here. */}
    <div class="lede">
      {fill(need(page.data.count, 'publications.count'), { count: pubs.length })} <page.Content />
    </div>

    {metrics && metrics.total > 0 && (
      <ul class="metrics">
        {[
          { value: formatCount(metrics.total), key: 'citations', asOf: true },
          { value: String(metrics.hIndex), key: 'hIndex' },
          { value: String(metrics.i10), key: 'i10' },
        ].map((metric) => (
          <li>
            <Metric class="metric" {...(profile ? { href: profile, rel: 'noopener' } : {})}>
              <span class="metric-value">{metric.value}</span>
              <span class="metric-label mono">
                <ScholarMark />
                {label(metric.key)}
                <span class="sr-only"> (Google Scholar)</span>
              </span>
              {metric.asOf && (
                <span class="metric-sub mono">
                  {fill(label('asOf'), { date: formatUpdated(metrics.lastUpdated) })}
                </span>
              )}
            </Metric>
          </li>
        ))}
      </ul>
    )}

    <div class="filter">
      <label class="sr-only" for="pubsearch">
        Filter publications
      </label>
      <input
        id="pubsearch"
        type="search"
        placeholder="Filter by title, author or venue…"
        autocomplete="off"
        hidden
      />
    </div>
    <p class="no-results" hidden>
      {label('noResults')}
    </p>

    {groups.map((group) => (
      <section class="year" data-year={group.year}>
        <h2 class="year-head mono">{group.year}</h2>
        <ul class="entries">
          {group.items.map((pub) => (
            <PubEntry pub={pub} links={links} />
          ))}
        </ul>
      </section>
    ))}
  </section>
</Base>

<script>
  /*
   * Client-side filter over the whole list. No index, no library: the loader
   * already built a lowercased `searchText` per entry, so this is a substring
   * test over a few dozen strings and runs in well under a frame.
   *
   * The input ships `hidden` and this script reveals it, so with JS off there
   * is no dead control — the full list is there either way.
   */
  const input = document.querySelector<HTMLInputElement>('#pubsearch');
  const empty = document.querySelector<HTMLElement>('.no-results');
  const rows = [...document.querySelectorAll<HTMLElement>('.entry')];
  const years = [...document.querySelectorAll<HTMLElement>('.year')];

  if (input && empty) {
    input.hidden = false;

    const apply = (raw: string) => {
      const query = raw.trim().toLowerCase();
      let shown = 0;
      for (const row of rows) {
        const hit = query === '' || (row.dataset.search ?? '').includes(query);
        row.hidden = !hit;
        if (hit) shown += 1;
      }
      // Hide a year heading once everything under it is filtered out,
      // otherwise the page is a column of empty years.
      for (const year of years) {
        year.hidden = !year.querySelector('.entry:not([hidden])');
      }
      empty.hidden = shown > 0;
    };

    input.addEventListener('input', () => apply(input.value));

    // A fragment that is not an entry's own id is treated as a starting
    // filter, so /publications/#rhetoric is a shareable pre-filtered view.
    // Checking getElementById first keeps deep links to a single entry —
    // /publications/#cicero_de_officiis_1913 — scrolling to it instead.
    const hash = decodeURIComponent(location.hash.replace(/^#/, ''));
    if (hash && !document.getElementById(hash)) {
      input.value = hash;
      apply(hash);
    }
  }
</script>

<style>
  .lede {
    max-width: 60ch;
    /* What the paragraph it replaces had from base.css: the body's own <p>
       is inline here, so the block that wraps the lines is this one. */
    margin-bottom: 1em;
    text-wrap: pretty;
    color: var(--text-muted);
  }
  .lede :global(p) {
    display: inline;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }
  /* Flat, like the home page stats: a hairline rule instead of a card. */
  .metric {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    padding: 0.85rem 0 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }
  .metric:hover {
    border-top-color: var(--sec-line);
  }
  a.metric:hover .metric-label {
    color: var(--sec);
  }
  .metric-value {
    font-family: var(--font-head);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--sec);
  }
  .metric-label {
    color: var(--text-faint);
  }
  .metric-label :global(svg) {
    margin-right: 0.3em;
    vertical-align: -0.15em;
  }
  .metric-sub {
    color: var(--text-faint);
    font-size: 0.75rem;
  }

  .filter {
    margin-top: 1.5rem;
  }
  #pubsearch {
    width: min(100%, 28rem);
    padding: 0.6rem 0.9rem;
    font: inherit;
    font-size: var(--fs-small);
    color: var(--text);
    background: var(--bg-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-m);
  }
  #pubsearch:focus-visible {
    border-color: var(--sec-line);
  }
  .no-results {
    margin: 1rem 0 0;
    color: var(--text-faint);
    font-size: var(--fs-small);
  }

  .entries {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .year {
    margin-top: 2.25rem;
  }
  /* A flat section marker rather than a sticky pill: a sticky one floats over
     the entries as you scroll, and stacks up wherever two years sit close
     together. The rule is drawn by ::after so it fills whatever space is left
     beside the number, at any width. */
  .year-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    color: var(--sec);
  }
  .year-head::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
</style>
