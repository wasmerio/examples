---
import { config } from "@/config";

const year = new Date().getFullYear();
---

<footer class="column meta mt-24 border-t border-rule pt-6 pb-12">
  <ul class="flex flex-wrap gap-x-5 gap-y-1">
    <li><a href="/rss.xml">RSS</a></li>
    {config.social.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
  </ul>
  <p class="mt-4">&copy; {year} {config.copyright}</p>
  {
    config.credit && (
      <p class="mt-1">
        Made with <a class="text-link" href="https://tessera.hevislav.workers.dev/themes/plain">Plain</a> by{" "}
        <a class="text-link" href="https://tessera.hevislav.workers.dev">Tessera</a>
      </p>
    )
  }
</footer>

<style>
  ul a {
    color: inherit;
    text-decoration: none;
  }

  ul a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .text-link:hover {
    color: var(--fg);
  }
</style>
