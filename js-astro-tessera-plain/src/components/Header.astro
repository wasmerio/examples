---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { config } from "@/config";

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

function current(href: string): "page" | "true" | undefined {
  const target = href.replace(/\/+$/, "") || "/";
  if (target === path) return "page";
  if (target === "/") return path.startsWith("/page/") || path.startsWith("/blog/") ? "true" : undefined;
  return path.startsWith(`${target}/`) ? "true" : undefined;
}
---

<header class="column flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pt-10 sm:pt-14">
  {
    isHome ? (
      <h1 class="site-title">
        <a href="/">{config.title}</a>
      </h1>
    ) : (
      <p class="site-title">
        <a href="/">{config.title}</a>
      </p>
    )
  }
  <div class="flex items-baseline gap-x-5">
    <nav aria-label="Main">
      <ul class="flex gap-x-5">
        {
          config.nav.map((item) => (
            <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-title {
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .site-title a {
    color: inherit;
    text-decoration: none;
  }

  .site-title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--fg);
  }

  nav a[aria-current] {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
</style>
