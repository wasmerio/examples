---
import { pageUrl } from "@/utils/posts";

interface Props {
  page: number;
  total: number;
}

const { page, total } = Astro.props;
---

{
  total > 1 && (
    <nav aria-label="Pagination" class="pagination meta">
      {page > 1 ? <a href={pageUrl(page - 1)} rel="prev">Newer posts</a> : <span />}
      <span>
        Page {page} of {total}
      </span>
      {page < total ? <a href={pageUrl(page + 1)} rel="next">Older posts</a> : <span />}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 3.5rem;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
</style>
