---
import { config } from "@/config";

interface Props {
  title?: string;
  description: string;
  type?: "website" | "article";
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}

const { title, description, type = "website", published, updated, noindex = false } = Astro.props;
const site = Astro.site ?? new URL(config.url);
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, site).href;
const image = new URL("/og.png", site).href;
const pageTitle = title ? `${title} · ${config.title}` : config.title;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={config.title} />
<meta property="og:title" content={title ?? config.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Three short horizontal lines on a plain background" />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
{type === "article" && <meta property="article:author" content={config.author} />}
<meta name="twitter:card" content="summary_large_image" />
