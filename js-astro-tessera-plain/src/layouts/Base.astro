---
import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Seo from "@/components/Seo.astro";
import { config } from "@/config";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  preloadItalic?: boolean;
}

const { title, description = config.description, type, published, updated, noindex, preloadItalic = false } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname.startsWith("/page/");
---

<!doctype html>
<html lang={config.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme");
          if (theme === "dark" || theme === "light") document.documentElement.classList.add(theme);
        } catch (error) {}
      })();
    </script>
    <Seo title={title} description={description} type={type} published={published} updated={updated} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={config.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preloadItalic && <link rel="preload" href="/fonts/newsreader-italic-latin.woff2" as="font" type="font/woff2" crossorigin />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfbf8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161615" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header isHome={isHome} />
    <main id="main" class="column flex-1 pt-14 sm:pt-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
