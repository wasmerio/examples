---
import Prose from "@/components/Prose.astro";
import Base from "@/layouts/Base.astro";
import { formatDate, isoDate } from "@/utils/dates";
import { postUrl, type Post } from "@/utils/posts";
import { readingTimeLabel } from "@/utils/readingTime";
import { tagUrl } from "@/utils/tags";

interface Props {
  post: Post;
  prev: Post | null;
  next: Post | null;
}

const { post, prev, next } = Astro.props;
const { title, description, date, updated, tags } = post.data;
---

<Base title={title} description={description} type="article" published={date} updated={updated} preloadItalic>
  <article>
    <header class="post-header">
      <h1 class="page-title">{title}</h1>
      <p class="post-meta meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        <span>{readingTimeLabel(post.body ?? "")}</span>
        {
          updated && (
            <span>
              Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
            </span>
          )
        }
      </p>
    </header>
    <Prose>
      <slot />
    </Prose>
    {
      tags.length > 0 && (
        <div class="tags meta">
          <span>Tagged</span>
          <ul class="tag-list">
            {tags.map((tag) => (
              <li><a class="text-link" href={tagUrl(tag)}>{tag}</a></li>
            ))}
          </ul>
        </div>
      )
    }
  </article>
  {
    (prev || next) && (
      <nav aria-label="Adjacent posts" class="adjacent">
        {prev && (
          <a href={postUrl(prev)} rel="prev" class="prev">
            <span class="label">Previous</span>
            {prev.data.title}
          </a>
        )}
        {next && (
          <a href={postUrl(next)} rel="next" class="next">
            <span class="label">Next</span>
            {next.data.title}
          </a>
        )}
      </nav>
    )
  }
</Base>

<style>
  .post-header {
    margin-block-end: 2.5rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.5em;
    margin-block-start: 0.75rem;
  }

  .post-meta > * + *::before {
    content: "·";
    margin-inline-end: 0.5em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.4em;
    margin-block-start: 3rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
  }

  .tag-list li:not(:last-child)::after {
    content: ",";
    margin-inline-end: 0.4em;
  }

  .adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule);
  }

  .adjacent a {
    color: inherit;
    text-decoration: none;
    text-wrap: balance;
  }

  .adjacent a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .label {
    display: block;
    margin-block-end: 0.15rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .next {
    grid-column: 2;
    text-align: end;
  }

  @media (max-width: 30rem) {
    .adjacent {
      grid-template-columns: 1fr;
    }

    .next {
      grid-column: auto;
      text-align: start;
    }
  }
</style>
