---
import Prose from "@/components/Prose.astro";
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found" description="There is nothing at this address." noindex>
  <h1 class="page-title">Page not found</h1>
  <Prose class="mt-8">
    <p>There is nothing at this address. The page may have moved, or the link may have been mistyped.</p>
