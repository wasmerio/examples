---
import Pagination from "@/components/Pagination.astro";
import PostList from "@/components/PostList.astro";
import Base from "@/layouts/Base.astro";
import { config } from "@/config";
import { getPosts, pageCount, pageSlice } from "@/utils/posts";

const posts = await getPosts();
const total = pageCount(posts.length, config.postsPerPage);
---

<Base>
  <p class="lede">{config.description}</p>
  <PostList posts={pageSlice(posts, 1, config.postsPerPage)} class="mt-12" />
  <Pagination page={1} total={total} />
</Base>
