---
import Pagination from "@/components/Pagination.astro";
import PostList from "@/components/PostList.astro";
import Base from "@/layouts/Base.astro";
import { config } from "@/config";
import { getPosts, pageCount, pageSlice, type Post } from "@/utils/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const total = pageCount(posts.length, config.postsPerPage);
  return Array.from({ length: total - 1 }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: { page, total, posts: pageSlice(posts, page, config.postsPerPage) },
    };
  });
}

interface Props {
  page: number;
  total: number;
  posts: Post[];
}

const { page, total, posts } = Astro.props;
---

<Base title={`Page ${page}`}>
  <PostList posts={posts} />
  <Pagination page={page} total={total} />
</Base>
