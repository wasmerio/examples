---
import PostList from "@/components/PostList.astro";
import Base from "@/layouts/Base.astro";
import { config } from "@/config";
import { getPosts, type Post } from "@/utils/posts";
import { collectTags, tagSlug } from "@/utils/tags";

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectTags(posts).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, posts: posts.filter((post) => post.data.tags.some((name) => tagSlug(name) === slug)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
const count = posts.length === 1 ? "1 post" : `${posts.length} posts`;
---

<Base title={tag} description={`Posts tagged ${tag} on ${config.title}`}>
  <h1 class="page-title">{tag}</h1>
  <p class="meta mt-3">{count}</p>
  <PostList posts={posts} class="mt-10" />
</Base>
