---
import Base from "@/layouts/Base.astro";
import { config } from "@/config";
import { getPosts } from "@/utils/posts";
import { collectTags, tagUrl } from "@/utils/tags";

const tags = collectTags(await getPosts());
---

<Base title="Tags" description={`Every tag used on ${config.title}`}>
  <h1 class="page-title">Tags</h1>
  <ul class="tag-index mt-8">
    {
      tags.map(({ tag, count }) => (
        <li>
          <a href={tagUrl(tag)}>{tag}</a>
          <span class="count">{count}</span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .tag-index {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.75rem;
    row-gap: 0.5rem;
    font-size: 1.125rem;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .count {
    margin-inline-start: 0.1em;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
