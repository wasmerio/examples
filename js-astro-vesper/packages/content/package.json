{
  "name": "@astronomic/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Astronomic content adapters: one contract for any content source, with Markdown and EmDash adapters.",
  "keywords": [
    "astro-component"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./markdown": "./src/markdown/index.ts",
    "./emdash": "./src/emdash/index.ts",
    "./emdash/access": "./src/emdash/access.mjs",
    "./emdash/search-guard": "./src/emdash/search-guard.ts",
    "./public-origin": "./src/public-origin.ts",
    "./placeholder-gate": "./src/placeholder-gate.ts",
    "./astro": "./src/astro.mjs",
    "./TrustedHtml.astro": "./src/TrustedHtml.astro",
    "./virtual": {
      "types": "./src/virtual.d.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "astro check"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "emdash": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "emdash": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.5",
    "emdash": "^1.4.0",
    "typescript": "^6.0.3"
  }
