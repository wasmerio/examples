---
/**
 * Renders `{ format: "html", value: string }` as-is. Register it only for
 * HTML you trust, or sanitize in your adapter's `map` before it gets here
 * (e.g. with `sanitize-html`). Never pass user-submitted HTML unsanitized.
 */
import type { RichText } from "./types";

interface Props {
	value: RichText;
}

const { value } = Astro.props;
---

{typeof value.value === "string" && <Fragment set:html={value.value} />}
