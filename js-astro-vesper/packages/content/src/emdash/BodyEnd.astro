---
/** EmDash page contributions (plugins, SEO, analytics) via `EmDashBodyEnd`. */
import { EmDashBodyEnd } from "emdash/ui";
import type { PageMeta } from "../index";
import { pageContext } from "./page-context";

interface Props {
	page: PageMeta;
}

const page = pageContext(Astro, Astro.props.page);
---

<EmDashBodyEnd page={page} />
