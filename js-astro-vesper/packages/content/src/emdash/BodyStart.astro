---
/** EmDash page contributions (plugins, SEO, analytics) via `EmDashBodyStart`. */
import { EmDashBodyStart } from "emdash/ui";
import type { PageMeta } from "../index";
import { pageContext } from "./page-context";

interface Props {
	page: PageMeta;
}

const page = pageContext(Astro, Astro.props.page);
---

<EmDashBodyStart page={page} />
