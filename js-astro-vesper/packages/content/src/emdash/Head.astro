---
/**
 * EmDash head contributions: plugin metadata, JSON-LD, Twitter card, og:type,
 * og:url, robots, verification tags, favicon and head fragments. Tags the
 * product layout already rendered (`page.baseMeta`) are removed; EmDash's
 * other tags, such as its default og:image, stay (see WithoutBaseMeta.astro).
 */
import { EmDashHead } from "emdash/ui";
import type { PageMeta } from "../index";
import { pageContext } from "./page-context";
import WithoutBaseMeta from "./WithoutBaseMeta.astro";

interface Props {
	page: PageMeta;
}

const page = pageContext(Astro, Astro.props.page);
---

<WithoutBaseMeta exclude={Astro.props.page.baseMeta}><EmDashHead page={page} /></WithoutBaseMeta>
