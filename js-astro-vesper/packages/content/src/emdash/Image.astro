---
/**
 * Renders an EmDash image (`source.kind` "emdash") responsively from its raw value.
 * EmDash picks its own srcset widths, so `widths` is ignored; `sizes` is passed on. `style` (a focal point's
 * object-position), when set, replaces EmDash's own inline style on the <img> (its placeholder and focal point), so it
 * is passed only when the editor has not set a focal point on the image: the editor's choice wins.
 */
import { Image as EmDashImage } from "emdash/ui";
import type { ContentImage } from "../index";

interface Props {
	image: ContentImage;
	priority?: boolean;
	class?: string;
	widths?: number[];
	sizes?: string;
	style?: string;
}

const { image, priority, class: className, sizes, style } = Astro.props;
const value = image.source?.value as Parameters<typeof EmDashImage>[0]["image"];
const raw = (value ?? {}) as { focalX?: unknown; focalY?: unknown };
const editorFocal = typeof value === "object" && (raw.focalX != null || raw.focalY != null);
const passStyle = style && !editorFocal;
---

<EmDashImage image={value ?? image.src} alt={image.alt} priority={priority} class={className} sizes={sizes} {...(passStyle ? { style } : {})} />
