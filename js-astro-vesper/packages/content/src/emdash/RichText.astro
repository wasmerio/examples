---
/** Renders EmDash Portable Text. */
import { PortableText } from "emdash/ui";
import type { RichText } from "../index";

interface Props {
	value: RichText;
}

const { value } = Astro.props;
const blocks = value.format === "portable-text" && Array.isArray(value.value) ? value.value : [];
---

<PortableText value={blocks} />
