---
/** Renders a local image (`source.kind` "astro-image") through astro:assets. */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { ContentImage } from "../index";

type Props = {
	image: ContentImage;
	priority?: boolean;
	class?: string;
	/** srcset widths. Default: Astro's widths for the layout. */
	widths?: number[];
	/** The `sizes` attribute. Default: Astro's value for the layout. */
	sizes?: string;
	/** Inline style for the <img> (a focal point's object-position), when set. */
	style?: string;
};

const { image, priority = false, class: className, widths, sizes, style } = Astro.props;
const meta = image.source?.value as ImageMetadata;
---

<Image src={meta} alt={image.alt} priority={priority} class={className} widths={widths} sizes={sizes} style={style} />
