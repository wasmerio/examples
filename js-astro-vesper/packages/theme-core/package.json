{
  "name": "@astronomic/theme-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Astronomic theme plumbing: content helpers, routes, outline, conformance machinery, test runners and look-free parts shared by every theme.",
  "keywords": [
    "astro-component"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./content": "./src/content/index.ts",
    "./conformance": "./src/conformance.ts",
    "./astro": "./src/astro.mjs",
    "./routes": "./src/routes.ts",
    "./outline": "./src/outline.ts",
    "./date": "./src/date.ts",
    "./seo": "./src/seo.ts",
    "./feeds": "./src/feeds.ts",
    "./jsonld": "./src/jsonld.ts",
    "./share": "./src/share.ts",
    "./middleware": "./src/middleware.ts",
    "./components/*": "./src/components/*",
    "./scripts/*": "./scripts/*"
  },
  "files": [
    "src",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astronomic/content": "workspace:*",
    "@astronomic/ui": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "pagefind": "^1.5.2",
    "satori": "0.35.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "emdash": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "emdash": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.5",
    "typescript": "^6.0.3"
  }
}
