---
/**
 * Renders a `ContentImage` with the renderer for its source kind
 * (EmDash responsive media, Astro local optimization), or a plain <img>.
 * `widths` and `sizes` describe how wide the image shows; `style` (a focal
 * point's object-position) goes on the <img> when set. Pass the theme's
 * `useContent(Astro).renderers.image`.
 */
import type { ContentImage, Renderers } from "@astronomic/content";

interface Props {
	image: ContentImage;
	priority?: boolean;
	class?: string;
	widths?: readonly number[];
	sizes?: string;
	style?: string;
	renderers?: Renderers["image"];
}

const { image, priority, class: className, widths, sizes, style, renderers } = Astro.props;
const kind = image.source?.kind;
const Renderer = kind ? renderers?.[kind] : undefined;
---

{
	Renderer ? (
		<Renderer image={image} priority={priority} class={className} widths={widths ? [...widths] : undefined} sizes={sizes} style={style} />
	) : (
		<img
			src={image.src}
			alt={image.alt}
			width={image.width}
			height={image.height}
			loading={priority ? "eager" : "lazy"}
			fetchpriority={priority ? "high" : undefined}
			decoding="async"
			class={className}
			style={style}
		/>
	)
}
