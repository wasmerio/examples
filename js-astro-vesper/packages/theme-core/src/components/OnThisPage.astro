---
/**
 * "On this page": links to the text's h2s (see `outline`).
 *
 * - `list`: a labeled nav with the label above the links, for a side column.
 * - `details`: a closed <details> with the label as its summary, for phones.
 *
 * Where each shows (e.g. `max-lg:hidden`) comes in through `class`, the link
 * look through `linkClass`.
 */
import Icon from "@astronomic/ui/components/Icon.astro";
import { cn } from "@astronomic/ui/lib/cn.ts";
import { ON_THIS_PAGE_LABEL_ID, type OutlineItem } from "../outline.ts";

interface Props {
	items: OutlineItem[];
	label: string;
	variant: "list" | "details";
	/** The list label's id. Default `on-this-page-label` (in PART_IDS). */
	labelId?: string;
	linkClass?: string;
	class?: string;
}

const { items, label, variant, labelId = ON_THIS_PAGE_LABEL_ID, linkClass, class: className } = Astro.props;
---

{
	variant === "list" ? (
		<nav
			aria-labelledby={labelId}
			class={cn("grid content-start gap-3 border-t-(length:--ui-border-w) border-solid border-border pt-3 first:border-t-0 first:pt-0", className)}
		>
			<p id={labelId} class="m-0 text-sm text-muted">
				{label}
			</p>
			<ol role="list" class="m-0 grid list-none gap-2 p-0">
				{items.map((h) => (
					<li>
						<a href={`#${h.id}`} class={linkClass}>
							{h.text}
						</a>
					</li>
				))}
			</ol>
		</nav>
	) : (
		<nav aria-label={label} class={className}>
			<details class="group border-y-(length:--ui-border-w) border-solid border-border">
				<summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-sm text-muted transition-colors duration-150 hover:text-fg motion-reduce:transition-none [&::-webkit-details-marker]:hidden">
					{label}
					<Icon size="sm" class="transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none">
						<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5 7.5l5 5 5-5" />
						</svg>
					</Icon>
				</summary>
				<ol role="list" class="m-0 grid list-none gap-2 p-0 pt-1 pb-4">
					{items.map((h) => (
						<li>
							<a href={`#${h.id}`} class={linkClass}>
								{h.text}
							</a>
						</li>
					))}
				</ol>
			</details>
		</nav>
	)
}
