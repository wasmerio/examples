---
/**
 * Renders a locked entry's preview: plain text blocks as escaped text (never markup, never raw HTML), h2s with the
 * ids `previewOutline` gives (pass the same `reserved` as to the page's outline). Look-free: every class comes in
 * as a prop. An empty preview renders nothing. A preview is never rich text: `RichText` refuses one.
 */
import type { Preview } from "@astronomic/content";
import { previewOutline } from "../content/preview.ts";

interface Props {
	preview: Preview;
	reserved?: readonly string[];
	class?: string;
	headingClass?: string;
	paragraphClass?: string;
}

const { preview, reserved, class: className, headingClass, paragraphClass } = Astro.props;
const ids = previewOutline(preview, { reserved }).map((item) => item.id);
let h2 = 0;
const blocks = preview.blocks.map((block) => (block.type === "heading" && block.level === 2 ? { ...block, id: ids[h2++] } : { ...block, id: undefined }));
---

{
	blocks.length > 0 && (
		<div class={className}>
			{blocks.map((block) =>
				block.type === "paragraph" ? (
					<p class={paragraphClass}>{block.text}</p>
				) : block.level === 2 ? (
					<h2 id={block.id} class={headingClass}>{block.text}</h2>
				) : (
					<h3 class={headingClass}>{block.text}</h3>
				),
			)}
		</div>
	)
}
