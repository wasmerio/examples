---
/**
 * Renders a `RichText` with the renderer registered for its format.
 * Works for mixed sources: each entry renders with its own source's renderer.
 * Pass the theme's `useContent(Astro).renderers.richText`.
 */
import type { Renderers, RichText } from "@astronomic/content";

interface Props {
	value: RichText;
	renderers: Renderers["richText"];
}

const { value, renderers } = Astro.props;
// A locked entry's preview is plain text with its own renderer; a rich text renderer must never see one.
if ((value as { kind?: unknown }).kind === "preview") {
	throw new Error("A preview is not rich text: render it with PreviewText.");
}
const Renderer = renderers[value.format];
if (!Renderer) {
	throw new Error(`No rich text renderer for format "${value.format}".`);
}
---

<Renderer value={value} />
