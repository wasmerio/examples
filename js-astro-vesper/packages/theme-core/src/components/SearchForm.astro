---
/**
 * Site search form. Submits to `action` (default /search). Show it only when the source has search.
 *
 * - `inline` (default): the box in the header, md and up.
 * - `row`: the full-width row under the header on phones (see SearchToggle),
 *   a taller box plus a submit button.
 *
 * Each instance needs its own `id` (the input id). On the `action` page, server
 * builds prefill the box with the current query.
 */
import Button from "@astronomic/ui/components/Button.astro";
import { cn } from "@astronomic/ui/lib/cn.ts";
import { SEARCH_INPUT_ID } from "../outline.ts";
import { currentPath, searchQuery } from "../routes.ts";

interface Props {
	/** The input id. Default `site-search` (in PART_IDS). */
	id?: string;
	variant?: "inline" | "row";
	/** The search page the form submits to. Default `/search`. */
	action?: string;
	class?: string;
	/** `label` (the input's hidden label), `placeholder`, `submit` (the row's button), `landmark` (the form's name). */
	strings: { label: string; placeholder: string; submit: string; landmark: string };
}

const { id = SEARCH_INPUT_ID, variant = "inline", action = "/search", class: className, strings } = Astro.props;

// Only the search page reads `q`; prerendered pages have no query string to read.
const query = currentPath(Astro.url) === action ? searchQuery(Astro) : "";

const input =
	"w-full min-w-0 rounded-control border-(length:--ui-border-w) border-border bg-surface px-3 text-fg placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
---

<form action={action} method="get" role="search" aria-label={strings.landmark} class={cn(variant === "row" && "flex items-center gap-3", className) || undefined}>
	<label class="sr-only" for={id}>{strings.label}</label>
	<input
		id={id}
		name="q"
		type="search"
		value={query || undefined}
		placeholder={strings.placeholder}
		class={cn(
			input,
			// Row: 44px tall for touch, 16px text so phones do not zoom on focus.
			variant === "row" ? "h-11 flex-1 text-base" : "h-[calc(var(--ui-control-h)-8px)] text-sm",
		)}
	/>
	{
		variant === "row" && (
			<Button type="submit" variant="secondary" class="h-11">
				{strings.submit}
			</Button>
		)
	}
</form>
