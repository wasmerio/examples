---
/**
 * The search index's data for one entry page, for static search (Pagefind).
 * Put it inside the page's indexed element (`<main data-pagefind-body>`).
 * Hidden data only: nothing shows. `kind` is the collection key; SearchPage
 * shows it as its label from `kinds`. `image` (a URL, best a small one) and
 * `imageAlt` become `hit_image` and `hit_image_alt`: the hit's picture. Not
 * Pagefind's own `image` key, which Pagefind fills from the first <img> in the
 * indexed body when a page sets none (a related story's photo, say).
 */
interface Props {
	kind: string;
	title: string;
	/** The entry's summary; the hit's excerpt. Without it, Pagefind's own excerpt. */
	summary?: string;
	/** The entry's public picture as a URL; nothing is indexed without one. */
	image?: string;
	imageAlt?: string;
}

const { kind, title, summary, image, imageAlt } = Astro.props;
---

<span hidden data-pagefind-meta="kind[data-value]" data-value={kind}></span>
<span hidden data-pagefind-meta="title[data-value]" data-value={title}></span>
{summary && <span hidden data-pagefind-meta="summary[data-value]" data-value={summary}></span>}
{image && <span hidden data-pagefind-meta="hit_image[data-value]" data-value={image}></span>}
{image && imageAlt && <span hidden data-pagefind-meta="hit_image_alt[data-value]" data-value={imageAlt}></span>}
