---
/**
 * The product's own meta tags, in the order `pageMeta` lists them in
 * `baseMeta`. Put it in the head after the title, icon and fonts. Source
 * hooks only add to these. `noindex` goes to `pageMeta`; this reads it from
 * `baseMeta` ("robots"), so the two cannot disagree, and `twitter:card` the
 * same way (it renders only when `pageMeta` had a site and an image).
 * The JSON-LD graph is `page.jsonLd` (pageMeta sets it from its `jsonLd`
 * input); its one escaped script renders last, only when `baseMeta` lists
 * "jsonld".
 */
import type { PageMeta } from "@astronomic/content";
import { jsonLdScript, type JsonLdGraph } from "../jsonld.ts";

interface Props {
	page: PageMeta;
}

const { page } = Astro.props;
const ldText = page.baseMeta.includes("jsonld") && page.jsonLd?.["@graph"].length ? jsonLdScript(page.jsonLd as JsonLdGraph) : undefined;
const noindex = page.baseMeta.includes("robots");
const twitterCard = page.baseMeta.includes("twitter:card");
---

{noindex && <meta name="robots" content="noindex" />}
{page.description && <meta name="description" content={page.description} />}
{page.canonical && <link rel="canonical" href={page.canonical} />}
<meta property="og:title" content={page.pageTitle} />
<meta property="og:site_name" content={page.siteName} />
{page.description && <meta property="og:description" content={page.description} />}
{page.url && <meta property="og:url" content={page.url} />}
{page.type && <meta property="og:type" content={page.type} />}
{page.image && <meta property="og:image" content={page.image} />}
{page.imageAlt && <meta property="og:image:alt" content={page.imageAlt} />}
{twitterCard && <meta name="twitter:card" content="summary_large_image" />}
{page.feed && <link rel="alternate" type="application/rss+xml" title={page.feed.title} href={page.feed.href} />}
{ldText && <script is:inline type="application/ld+json" set:html={ldText} />}
