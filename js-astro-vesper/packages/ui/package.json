{
  "name": "@astronomic/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Astronomic UI: restylable Astro components driven by semantic tokens.",
  "exports": {
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./presets/*.css": "./src/styles/presets/*.css",
    "./components/*": "./src/components/*",
    "./lib/*": "./src/lib/*",
    "./system": "./src/system/index.mjs",
    "./system/link": {
      "types": "./src/system/link.d.ts",
      "default": "./src/system/link.mjs"
    },
    "./system/virtual": {
      "types": "./src/system/virtual.d.ts"
    },
    "./system/samples/*": "./src/system/samples/*",
    "./system/tokens": "./src/system/tokens.ts",
    "./system/contrast": {
      "types": "./src/system/contrast.d.ts",
      "default": "./src/system/contrast.mjs"
    }
  },
  "dependencies": {
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0",
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "astro": "^7.3.5"
  }
}
