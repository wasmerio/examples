---
import type { ImageComponent, MediaImage } from "../lib/image";
import ArticleHeader, { type ArticleHeaderRecipeProps } from "./ArticleHeader.astro";
import Media from "./Media.astro";

export interface Props extends ArticleHeaderRecipeProps {
	/** The post's photo, under the text. Content: write its alt. Loaded eagerly at high priority unless it sets its own loading. */
	image?: MediaImage;
	/** Your image component for the photo (Media's imageComponent): Astro's <Image>, or a small wrapper for your CMS. */
	imageComponent?: ImageComponent;
	/** How wide the photo shows, for imageComponent's sizes. Default "(min-width: 80rem) 77rem, 100vw". */
	imageSizes?: string;
	/** The photo's shape, as classes (Media's ratioClass). Default aspect-[16/9]. */
	ratioClass?: string;
}

const { image, imageComponent, imageSizes = "(min-width: 80rem) 77rem, 100vw", ratioClass = "aspect-[16/9]", ...props } = Astro.props;
const loading = image?.loading ?? "eager";
// The plain post header: the text block (the meta line, the title, the standfirst and your byline), then the photo
// under it at the text's full row width. Without a photo, just the text: the fallback for any post, in every theme.
// The photo opens the page, so it is fetched eagerly at high priority (unless it sets its own loading). The recipe's
// own props come after the rest, so its layout and tone always win.
---

<ArticleHeader {...props} tone="page" contentClass={undefined} textClass={undefined} headingClass={undefined} mediaClass={undefined}>
	{Astro.slots.has("byline") && <Fragment slot="byline"><slot name="byline" /></Fragment>}
	{
		image && (
			<Fragment slot="media">
				<Media
					src={image.src}
					alt={image.alt}
					width={image.width}
					height={image.height}
					ratioClass={ratioClass}
					focalPoint={image.focalPoint}
					loading={loading}
					fetchpriority={loading === "eager" ? "high" : undefined}
					imageComponent={imageComponent}
					sizes={imageSizes}
				/>
			</Fragment>
		)
	}
</ArticleHeader>
