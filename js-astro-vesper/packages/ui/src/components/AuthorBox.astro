---
import type { HTMLAttributes } from "astro/types";
import { buttonClasses, focusRing, touchBox } from "../lib/button";
import { cn } from "../lib/cn";
import { headingType } from "../lib/display";
import { uid } from "../lib/id";
import { imageAttrs, type DecorativeImage } from "../lib/image";
import Avatar from "./Avatar.astro";
import Icon from "./Icon.astro";
import type { PostsLink } from "./Posts.astro";
import type { TeamLink } from "./TeamMember.astro";

// The native role attribute is left out: role here is the writer's job, as in TeamMember.
export interface Props extends Omit<HTMLAttributes<"section">, "role"> {
	/** The writer's name. The section's heading. */
	name: string;
	/** Their role, e.g. "Editor · Food". */
	role?: string;
	/** A few sentences about them. */
	bio?: string;
	/** For the caller (no recipes here, as Form's hooks are for form parts): the bio box, after its own classes (e.g. a theme's darker body color). */
	bioClass?: string;
	/** Their photo, as decoration: the part writes alt="", since the name is right beside it. Without it, their initials. */
	image?: DecorativeImage;
	/** Icon links show as 44px round buttons (the label is read as "<name> on <label>"); text links without an icon. */
	links?: TeamLink[];
	/** A link to all their posts, e.g. { label: "All letters by Ruth", href }. */
	viewAll?: PostsLink;
	/** Default h2. h1 on an author page. */
	headingTag?: "h1" | "h2" | "h3" | "h4";
	class?: string;
}

const { name, role, bio, bioClass, image, links = [], viewAll, headingTag: Heading = "h2", class: className, ...rest } = Astro.props;
const headingId = uid("author");
const iconLinks = links.filter((link) => link.icon);
const textLinks = links.filter((link) => !link.icon);
// The author box (decisions 0013, 0015): the end of a post, an author page, or a theme's side column. A <section> named
// by the name heading. It is a named container (author): from 28rem of its own box (@md/author) the photo (Avatar xl,
// 6rem) sits beside the text; below that the photo (4rem) sits above the name, so the same part works at the end of a
// post and in a 16rem column. The order: the name (the heading), the role (small, muted), the bio (muted, at the
// running-text width; bioClass comes after its own classes, so a theme's color wins), then one row: the all-posts
// link, the text links, and the icon links as round secondary buttons (the control size). On a touch screen every link
// is a real box of 2.75rem (44px) at least, in rem so the preset's spacing does not shrink it, so when the links wrap
// no two hit areas overlap (a tap-area ::after would reach into the next row). Each link reads "<name> on <label>": the
// name is visually hidden; an icon link's whole name is.
---

<section aria-labelledby={headingId} class={cn("@container/author font-body", className)} {...rest}>
	<div class="grid gap-item @md/author:grid-cols-[auto_minmax(0,1fr)] @md/author:items-start @md/author:gap-group">
		<Avatar
			name={name}
			image={image ? { ...imageAttrs(image.src, image.width, image.height), alt: "" } : undefined}
			size="xl"
			decorative
			class="@max-md/author:size-[4rem] @max-md/author:text-avatar-lg"
		/>
		<div class="grid min-w-0 content-start gap-2">
			<Heading id={headingId} class={cn("m-0 text-heading text-balance [overflow-wrap:anywhere]", headingType)}>{name}</Heading>
			{role && <p class="m-0 text-small text-muted">{role}</p>}
			{bio && <p data-author-bio class={cn("m-0 max-w-prose text-body text-pretty text-muted", bioClass)}>{bio}</p>}
			{
				(viewAll || links.length > 0) && (
					<div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-3">
						{viewAll && (
							<a href={viewAll.href} class={cn("link-underline inline-flex items-center justify-center rounded-control text-small font-medium", touchBox, focusRing)}>{viewAll.label}</a>
						)}
						{textLinks.length > 0 && (
							<ul role="list" class="m-0 flex list-none flex-wrap gap-x-4 gap-y-2 p-0 text-small">
								{textLinks.map((link) => (
									<li>
										<a href={link.href} class={cn("link-underline inline-flex items-center justify-center rounded-control", touchBox, focusRing)}>
											<span class="sr-only">{`${name} on `}</span>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						)}
						{iconLinks.length > 0 && (
							<ul role="list" class="m-0 flex list-none flex-wrap gap-2 p-0">
								{iconLinks.map((link) => (
									<li>
										<a href={link.href} class={cn(buttonClasses({ variant: "secondary", size: "md", icon: true }), "rounded-full pointer-coarse:size-[2.75rem]")}>
											<Icon icon={link.icon} size="sm" />
											<span class="sr-only">{`${name} on ${link.label}`}</span>
										</a>
									</li>
								))}
							</ul>
						)}
					</div>
				)
			}
		</div>
	</div>
</section>
