---
import type { HTMLAttributes } from "astro/types";
import { initials } from "../lib/avatar";
import { cn } from "../lib/cn";
import type { UiImage } from "../lib/image";

export interface Props extends HTMLAttributes<"span"> {
	/** Person's name. Used for the initials and the accessible name. */
	name: string;
	image?: UiImage;
	/** sm 2rem, md 2.75rem, lg 4rem, xl 6rem (an author box's photo). */
	size?: "sm" | "md" | "lg" | "xl";
	/**
	 * Set when the name is shown next to the avatar. The avatar is then hidden
	 * from assistive tech (no duplicate name). Otherwise it is an image named `name`.
	 */
	decorative?: boolean;
	class?: string;
}

const { name, image, size = "md", decorative: asked = false, class: className, ...rest } = Astro.props;
// An empty name has nothing to say: decoration, never an empty label.
const decorative = asked || !name.trim();

const sizes = {
	sm: "size-[2rem] text-avatar-sm",
	md: "size-[2.75rem] text-avatar",
	lg: "size-[4rem] text-avatar-lg",
	xl: "size-[6rem] text-avatar-xl",
};
// The sizes are rem, not the spacing scale: size-8 would follow --ui-space (40px in Soft, not 32px).
// Always round (`rounded-full`) by design, like the Badge dot, whatever the preset's radius.
// The initials sit on --ui-tint in --ui-tint-fg when a preset sets them (default surface-2 and muted): avatar-fill and
// avatar-fg, not the Badge's tint names, whose fallbacks are a pill's. The text-avatar* sizes (sm, base, lg, xl) set line height 1.
const hasImageSlot = Astro.slots.has("image");
const showsImage = hasImageSlot || image !== undefined;
---

<span
	class={cn(
		"inline-grid shrink-0 place-items-center overflow-hidden rounded-full bg-avatar-fill text-avatar-fg font-body font-semibold select-none",
		"[&>img]:size-full [&>img]:object-cover",
		sizes[size],
		className,
	)}
	aria-hidden={decorative ? "true" : undefined}
	role={!decorative && !showsImage ? "img" : undefined}
	aria-label={!decorative && !showsImage ? name : undefined}
	{...rest}
>
	{
		hasImageSlot ? (
			<slot name="image" />
		) : image ? (
			<img
				src={image.src}
				alt={decorative ? "" : image.alt || name}
				width={image.width}
				height={image.height}
				loading="lazy"
				decoding="async"
			/>
		) : (
			initials(name)
		)
	}
</span>
