---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";

/** A state: `positive` (e.g. taking new work), `caution` (limited), `neutral` (anything else). */
export type BadgeStatus = "neutral" | "positive" | "caution";

export interface Props extends HTMLAttributes<"span"> {
	/**
	 * Sets the dot: `positive` is a filled accent dot, `caution` an accent ring on `accent-soft`,
	 * `neutral` a muted dot. The text must say the state too; the dot is decoration.
	 */
	status?: BadgeStatus;
	/**
	 * `pill` (the default): a small label with its own fill and edge (the tint), so it reads on a page, a band or an
	 * image. `plain`: the dot and the text only, which take their size, weight, line height and color from the text
	 * around them, for a status inside a line or a list of facts.
	 */
	variant?: "pill" | "plain";
	/** Shows the dot. Default: on for `positive` and `caution`. */
	dot?: boolean;
	class?: string;
}

const { status = "neutral", variant = "pill", dot = status !== "neutral", class: className, ...rest } = Astro.props;

const dots: Record<BadgeStatus, string> = {
	neutral: "bg-muted border-muted",
	positive: "bg-accent border-accent",
	caution: "bg-accent-soft border-accent",
};
// The pill is the tint when a preset sets --ui-tint and --ui-tint-fg (else surface, a border edge and fg text).
// text-eyebrow brings its own line height (1.25).
const variants = {
	pill: "rounded-control border-ui border-solid border-tint-edge bg-tint px-2.5 py-1 text-eyebrow font-medium text-tint-fg font-body",
	plain: "",
};
---

<span class={cn("inline-flex items-center gap-[0.5em]", variants[variant], className)} {...rest}>
	{dot && <span aria-hidden="true" class={cn("size-[0.6em] shrink-0 rounded-full border-[0.15em] border-solid", dots[status])} />}
	<slot />
</span>
