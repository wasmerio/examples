---
import type { HTMLAttributes } from "astro/types";
import { buttonClasses, iconTileButton, iconTileClasses, iconTileIcon, iconTileSlideCopy, iconTileSlideIcon, rollText, type ButtonSize, type ButtonVariant, type TileMotion } from "../lib/button";
import { cn } from "../lib/cn";
import type { IconComponent } from "../lib/icon";
import Icon from "./Icon.astro";

type Attrs = Omit<HTMLAttributes<"button">, "type" | "disabled"> & Omit<HTMLAttributes<"a">, "href">;

export interface Props extends Attrs {
	variant?: ButtonVariant;
	size?: ButtonSize;
	/**
	 * `image` when the button sits on an image under a scrim: scrim-fg colors that read on any picture (a scrim-fg
	 * fill for primary, an outline for secondary, no fill for ghost). The focus ring is the caller's: on an image put
	 * focus-on-image on an ancestor, as the Hero does under tone="image". `band` on an optional band (the Navbar's
	 * bar): inverted on the band when a preset sets --ui-band, else the page colors. `cta` on the CTA band (the band,
	 * else the accent): inverted against it; put focus-on-cta on the band. `inverse` on the inverse surface (Panel
	 * tone="inverse"): inverted against it; Panel puts focus-on-inverse on the surface. `accent` on the accent surface
	 * (surface-accent: GuaranteeStrip, EmergencyBanner): inverted against it; put focus-on-accent on the surface.
	 */
	tone?: "page" | "image" | "band" | "cta" | "inverse" | "accent";
	/**
	 * A tile at the end of the pill that holds your icon component (an arrow). The pill takes the pill token's corners
	 * (--ui-radius-pill, fully round by default) and is at least 44px tall; the tile's corners nest in the pill's (its
	 * radius less the 6px gap), and the tile is the inverted pair of the button's own colors. The icon is decoration
	 * (hidden from a screen reader) and moves on hover and focus when motion is allowed (tileMotion).
	 */
	iconTile?: IconComponent;
	/**
	 * How the tile's icon moves on hover and keyboard focus, when motion is allowed: `turn` (default) turns it -45°;
	 * `slide` moves it out past the tile's end while a copy of it moves in from the start. Still under reduced motion
	 * and the theme's calm setting.
	 */
	tileMotion?: TileMotion;
	/**
	 * On hover and keyboard focus, the label rolls up and the same words roll in from below. The label is read once.
	 * Off under reduced motion or the theme's calm setting. The label should be plain words (a copy is drawn from its text).
	 */
	roll?: boolean;
	/** Renders a link (`<a>`) instead of a `<button>`. */
	href?: string;
	type?: "button" | "submit" | "reset";
	disabled?: boolean;
	class?: string;
}

const {
	variant = "primary",
	size = "md",
	tone = "page",
	iconTile: TileIcon,
	tileMotion = "turn",
	roll = false,
	href,
	type = "button",
	disabled = false,
	class: className,
	...rest
} = Astro.props;

const classes = cn(buttonClasses({ variant, size, tone }), TileIcon && iconTileButton, roll && "text-roll", className);
// roll: the label in a clipping box (data-roll); the text-roll utility (theme.css) draws a copy of its words from
// data-label under it (::after, with empty alt text, so the name is read once) and moves both up on hover and focus,
// under the motion gate. Without iconTile and roll the HTML is as before.
const label = roll ? await Astro.slots.render("default") : "";
const slide = tileMotion === "slide";
---

{
	href !== undefined ? (
		// A disabled link drops its href so it cannot be followed.
		<a
			href={disabled ? undefined : href}
			aria-disabled={disabled ? "true" : undefined}
			role={disabled ? "link" : undefined}
			class={classes}
			{...rest}
		>
			{roll ? <span data-roll><span data-roll-label data-label={rollText(label)} set:html={label} /></span> : <slot />}
			{TileIcon && (
				<span data-button-tile class={iconTileClasses({ variant, tone, motion: tileMotion })}>
					<Icon icon={TileIcon} size="sm" class={slide ? iconTileSlideIcon : iconTileIcon} />
					{slide && <span data-tile-copy aria-hidden="true" class={iconTileSlideCopy}><Icon icon={TileIcon} size="sm" /></span>}
				</span>
			)}
		</a>
	) : (
		<button type={type} disabled={disabled} class={classes} {...rest}>
			{roll ? <span data-roll><span data-roll-label data-label={rollText(label)} set:html={label} /></span> : <slot />}
			{TileIcon && (
				<span data-button-tile class={iconTileClasses({ variant, tone, motion: tileMotion })}>
					<Icon icon={TileIcon} size="sm" class={slide ? iconTileSlideIcon : iconTileIcon} />
					{slide && <span data-tile-copy aria-hidden="true" class={iconTileSlideCopy}><Icon icon={TileIcon} size="sm" /></span>}
				</span>
			)}
		</button>
	)
}
