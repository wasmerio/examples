---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import { cn } from "../lib/cn";
import type { MediaImage } from "../lib/image";
import Media from "./Media.astro";

export interface Props extends HTMLAttributes<"div"> {
	/** Element to render. */
	as?: HTMLTag;
	/** Highlights the card with an accent border (e.g. the recommended plan), and sets data-featured, a hook a host can style. */
	featured?: boolean;
	/** An image at the top of the card, inside its edge (Media; default ratio 16/9). The media slot wins over it. */
	image?: MediaImage;
	class?: string;
}

const { as: Tag = "div", featured = false, image, class: className, ...rest } = Astro.props;
// The named slots are rendered first, so one whose content is empty (`{href && <span slot="footer" />}`)
// leaves no empty wrapper.
const media = Astro.slots.has("media") ? (await Astro.slots.render("media")).trim() : "";
const header = Astro.slots.has("header") ? (await Astro.slots.render("header")).trim() : "";
const footer = Astro.slots.has("footer") ? (await Astro.slots.render("footer")).trim() : "";
// The family's shell (decision 0013): it owns the order media, header, body (the default slot), footer, and
// recipes fill the slots. A column: the default slot's children sit straight in it, so a caller's gap or flex
// classes reach them. The footer takes the free height above it, so in a row of stretched cards every footer
// sits on the bottom edge. The edge is border-card (--ui-card-border-w, default --ui-border-w); 0px leaves the
// shadow alone to lift the card. The image's inset and corners are card-media (theme.css).
---

<Tag
	class={cn(
		"flex flex-col gap-item card-pad bg-surface text-fg rounded-card shadow-card border-card border-solid border-border",
		featured && "border-accent ring-ui ring-accent",
		className,
	)}
	data-featured={featured ? "" : undefined}
	{...rest}
>
	{
		media ? (
			<div data-card-media class="card-media mb-1.5" set:html={media} />
		) : (
			image && <Media {...image} data-card-media class="card-media mb-1.5" />
		)
	}
	{header && <div class="grid gap-1" set:html={header} />}
	<slot />
	{footer && <div class="mt-auto flex flex-wrap items-center gap-item pt-2" set:html={footer} />}
</Tag>
