---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import { stretchedLink } from "../lib/card";
import { cn } from "../lib/cn";
import { headingType } from "../lib/display";
import type { MediaImage } from "../lib/image";
import Card from "./Card.astro";
import Media from "./Media.astro";

export interface Props extends HTMLAttributes<"article"> {
	/** The image on top (Media; default ratio 16/9). */
	image: MediaImage;
	/** A short line above the title, such as a category. */
	eyebrow?: string;
	title: string;
	/** A line or two under the title. */
	text?: string;
	/** Makes the whole card one link to this page; the title is its name. */
	href?: string;
	/** A cue at the foot, such as "Read the case study". Shown only with `href`. */
	viewText?: string;
	/** Element for the title. */
	headingTag?: "h2" | "h3" | "h4";
	/** Element to render. */
	as?: HTMLTag;
	class?: string;
}

const { image, eyebrow, title, text, href, viewText, headingTag: Heading = "h3", as = "article", class: className, ...rest } = Astro.props;
---

<Card as={as} class={cn(href && "relative", className)} {...rest}>
	<Fragment slot="media"><Media {...image} /></Fragment>
	<Fragment slot="header">
		{eyebrow && <p class="m-0 text-eyebrow font-medium text-muted">{eyebrow}</p>}
		<Heading class={cn("m-0 text-heading", headingType)}>{href ? <a href={href} class={stretchedLink}>{title}</a> : title}</Heading>
	</Fragment>
	{text && <p class="m-0 text-body text-muted">{text}</p>}
	{/* The title already names the link, so the cue is not read twice. */}
	{href && viewText && <span slot="footer" aria-hidden="true" class="text-small font-medium">{`${viewText}\u00a0→`}</span>}
</Card>
