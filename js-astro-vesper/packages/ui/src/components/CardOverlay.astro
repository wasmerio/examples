---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import { imageCardRing, stretchedLink } from "../lib/card";
import { cn } from "../lib/cn";
import { headingType } from "../lib/display";
import { focalCss, imageAttrs, type MediaImage } from "../lib/image";
import Card from "./Card.astro";

export interface Props extends HTMLAttributes<"article"> {
	/** The image behind the text. It fills the card and is cropped; `ratio` is not used. */
	image: MediaImage;
	/** A short line above the title, such as a category. */
	eyebrow?: string;
	title: string;
	/** A line or two under the title. */
	text?: string;
	/** Makes the whole card one link to this page; the title is its name. */
	href?: string;
	/** Element for the title. */
	headingTag?: "h2" | "h3" | "h4";
	/** Element to render. */
	as?: HTMLTag;
	class?: string;
}

const { image, eyebrow, title, text, href, headingTag: Heading = "h3", as = "article", class: className, ...rest } = Astro.props;
const img = imageAttrs(image.src, image.width, image.height);
const focal = focalCss(image.focalPoint);
// The image fills the card behind the text, under a light veil of --ui-scrim (a dark ink in both modes). The text
// sits at the foot on scrim-rise: the scrim out to the card's edges, rising slowly under the text from 60% at its
// top, and fading on a smooth curve over the 8rem above (--scrim-fade), so no line shows and, with short text, the
// top of the image stays clear. All text is scrim-fg, so it reads at 4.5:1 on any image, black or white, in every
// kit preset and mode (SCRIM_LAYERS in system/contrast.mjs holds these shares for the contrast checks).
// data-on-image marks the text block for checks that read colors from the page and cannot see the image.
// data-card-overlay keeps the card's full padding (card-pad pads a card with a picture above its text by the image
// inset; this one's picture is behind the text). The card clips its overflow, so the focus ring sits inside, and it must show on any image (imageCardRing, lib/card.ts).
---

<Card
	as={as}
	data-card-overlay
	class={cn(
		"relative isolate min-h-80 justify-end overflow-hidden [&>[data-card-media]]:absolute [&>[data-card-media]]:inset-0 [&>[data-card-media]]:-z-10 [&>[data-card-media]]:m-0",
		className,
	)}
	{...rest}
>
	<Fragment slot="media">
		<img src={img.src} alt={image.alt} width={img.width} height={img.height} loading={image.loading ?? "lazy"} decoding="async" class="block size-full object-cover" style={focal ? `object-position: ${focal}` : undefined} />
		<span class="absolute inset-0 bg-scrim/20"></span>
	</Fragment>
	<div class="scrim-rise grid gap-item text-scrim-fg [--scrim-fade:8rem]" data-on-image>
		<div class="grid gap-1">
			{eyebrow && <p class="m-0 text-eyebrow font-medium">{eyebrow}</p>}
			<Heading class={cn("m-0 text-heading", headingType)}>{href ? <a href={href} class={cn(stretchedLink, imageCardRing)}>{title}</a> : title}</Heading>
		</div>
		{text && <p class="m-0 text-body">{text}</p>}
	</div>
</Card>
