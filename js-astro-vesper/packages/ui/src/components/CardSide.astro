---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import { stretchedLink } from "../lib/card";
import { cn } from "../lib/cn";
import { headingType } from "../lib/display";
import type { MediaImage } from "../lib/image";
import Card from "./Card.astro";
import Media from "./Media.astro";
import Stack from "./Stack.astro";

export interface Props extends HTMLAttributes<"article"> {
	/** The image beside the text (Media; default ratio 4/3). */
	image: MediaImage;
	/** A short line above the title, such as a category. */
	eyebrow?: string;
	title: string;
	/** A line or two under the title. */
	text?: string;
	/** Makes the whole card one link to this page; the title is its name. */
	href?: string;
	/** A cue at the foot, such as "Read the case study". Shown only with `href`. */
	viewText?: string;
	/** Element for the title. */
	headingTag?: "h2" | "h3" | "h4";
	/** Element to render. */
	as?: HTMLTag;
	class?: string;
}

const { image, eyebrow, title, text, href, viewText, headingTag: Heading = "h3", as = "article", class: className, ...rest } = Astro.props;
// Image and text sit side by side, about 2 to 3, while the card's content is at least 32rem wide, and stack below
// that, by the card's own width (Split's flex-wrap switch). The card is a named container (card-side) only so its
// image can follow the same switch: side by side, the image keeps its inset at the bottom and none toward the text.
---

<Card
	as={as}
	class={cn(
		"@container/card-side flex-row flex-wrap gap-x-6 [&>*]:min-w-0 [&>*]:grow-3 [&>*]:basis-[calc((32rem_-_100%)*999)] [&>[data-card-media]]:grow-2",
		"@min-[32rem]/card-side:[&>[data-card-media]]:me-0 @min-[32rem]/card-side:[&>[data-card-media]]:mb-(--card-media-offset)",
		href && "relative",
		className,
	)}
	{...rest}
>
	<Fragment slot="media"><Media ratio="4/3" {...image} /></Fragment>
	<Stack gap="item">
		<div class="grid gap-1">
			{eyebrow && <p class="m-0 text-eyebrow font-medium text-muted">{eyebrow}</p>}
			<Heading class={cn("m-0 text-heading", headingType)}>{href ? <a href={href} class={stretchedLink}>{title}</a> : title}</Heading>
		</div>
		{text && <p class="m-0 text-body text-muted">{text}</p>}
		{/* The title already names the link, so the cue is not read twice. */}
		{href && viewText && <span aria-hidden="true" class="mt-auto pt-2 text-small font-medium">{`${viewText}\u00a0→`}</span>}
	</Stack>
</Card>
