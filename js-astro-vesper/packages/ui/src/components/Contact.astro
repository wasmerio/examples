---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import type { SectionHeadingTag } from "../lib/heading";
import { uid } from "../lib/id";
import SectionHead from "./SectionHead.astro";

export interface Props extends HTMLAttributes<"section"> {
	/** The section heading. Without it there is no section and no header: a <div> holds only the body. */
	heading?: string;
	/** Turn one *phrase* in the heading into <em> (lib/emphasis.ts). Off by default: the heading shows as typed. */
	emphasis?: boolean;
	/** A short mark after the heading, such as "(12)". Shown beside the heading, outside it, so the heading's name stays plain. Shown only with a heading. */
	mark?: string;
	/** What the mark says to a screen reader, such as "12 projects". Without it, the mark is read as written. */
	markLabel?: string;
	/** One or two sentences under the heading. Shown only with a heading. */
	text?: string;
	/** Heading element. Channel titles sit one level under it (childHeadingTag in lib/heading.ts). */
	headingTag?: SectionHeadingTag;
	/** For recipes: the alignment of the header. */
	align?: "start" | "center";
	/** For recipes: the row that holds the header and the body. */
	contentClass?: string;
	/** For recipes: the header (SectionHead). */
	headerClass?: string;
	/** For recipes: the body box (the details, the form, or the channels). */
	bodyClass?: string;
	class?: string;
}

/** A recipe's props: the shell's, less the ones that set the layout, which the recipe sets itself. */
export type ContactRecipeProps = Omit<Props, "align" | "contentClass" | "headerClass" | "bodyClass">;

const { heading, emphasis = false, mark, markLabel, text, headingTag = "h2", align = "start", contentClass, headerClass, bodyClass, class: className, ...rest } = Astro.props;
const headingId = heading ? uid("contact") : undefined;
const eyebrow = heading && Astro.slots.has("eyebrow") ? (await Astro.slots.render("eyebrow")).trim() : "";
const Root = heading ? "section" : "div";
// The contact family's shell (decisions 0013, 0015): with a heading, the region named by it, then SectionHead and
// the body; without one, a plain <div>. The body is a box, not a list: a recipe puts ContactInfo, a MessageForm or a
// list of channels in it and sets its layout. The root is a named container (contact), so a split stacks by the
// room the section has, and a large email address sizes to it.
---

<Root aria-labelledby={headingId} class={cn("@container/contact", className)} {...rest}>
	<div data-contact-row class={cn("grid gap-blocks", contentClass)}>
		{
			heading && (
				<SectionHead data-contact-header heading={heading} emphasis={emphasis} mark={mark} markLabel={markLabel} text={text} headingTag={headingTag} id={headingId} align={align} class={headerClass}>
					{eyebrow && <Fragment slot="eyebrow" set:html={eyebrow} />}
				</SectionHead>
			)
		}
		<div data-contact-body class={cn("grid min-w-0", bodyClass)}>
			<slot />
		</div>
	</div>
</Root>
