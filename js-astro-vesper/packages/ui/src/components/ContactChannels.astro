---
import { focusRing } from "../lib/button";
import { cn } from "../lib/cn";
import { headingType } from "../lib/display";
import { childHeadingTag, type ItemHeadingTag } from "../lib/heading";
import type { IconComponent } from "../lib/icon";
import Card from "./Card.astro";
import Contact, { type ContactRecipeProps } from "./Contact.astro";
import Icon from "./Icon.astro";

/** One way to reach you: a title, a line about it, and one link. */
export interface ContactChannelItem {
	title: string;
	text?: string;
	/** Where the link goes: a mailto:, a tel: or a page. */
	href: string;
	/** The link text, specific to the channel ("Email support", not "Click here"). */
	label: string;
	/** An icon component (Lucide's, your own SVG component, or other), drawn in the accent color. */
	icon?: IconComponent;
}

export interface Props extends ContactRecipeProps {
	/** The title element when there is no heading. With a heading, titles sit one level under it. */
	itemHeadingTag?: ItemHeadingTag;
	/** The channels, in order. */
	items: ContactChannelItem[];
}

const { itemHeadingTag = "h3", items, ...props } = Astro.props;
const tag = childHeadingTag({ heading: props.heading, headingTag: props.headingTag, itemHeadingTag });
// Ways to reach you, no form: one Card per channel, as many columns as fit, each at least 16rem (auto-fit). At 320px
// inside the usual padding, one column (the min() lets it shrink to the row); two from about 33rem; three channels in
// a 6xl row stretch to thirds, and one or two stretch to fill the row. Each card: the icon (decoration, in the accent
// color), the title (the item heading), the text, and the link in the card's footer, so the links line up on the
// bottom edge of a row. The link text is the channel's own label. With no channels the list is left out, as in Posts.
// Only a channel's own fields reach the markup; the recipe's own props come after the rest, so its layout always wins.
---

<Contact {...props} align="start" contentClass={undefined} headerClass={undefined} bodyClass={undefined}>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{
		items.length > 0 && (
			<ul role="list" class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,16rem),1fr))] gap-cards p-0">
				{items.map(({ title, text, href, label, icon }) => {
					const Heading = tag;
					return (
						<li class="grid min-w-0">
							<Card class="h-full">
								{icon && <Icon icon={icon} size="lg" class="text-accent" />}
								<Heading class={cn("m-0 text-heading text-balance [overflow-wrap:anywhere]", headingType)}>{title}</Heading>
								{text && <p class="m-0 text-body text-pretty text-muted">{text}</p>}
								<Fragment slot="footer">
									<a href={href} class={cn("link-underline rounded-control text-body", focusRing)}>{label}</a>
								</Fragment>
							</Card>
						</li>
					);
				})}
			</ul>
		)
	}
</Contact>
