---
import type { HTMLAttributes } from "astro/types";
import { focusRing, touchBox } from "../lib/button";
import { cn } from "../lib/cn";

/** One line of opening hours: the days and the times. */
export interface ContactHours {
	label: string;
	value: string;
}

export interface Props extends HTMLAttributes<"dl"> {
	/** Shown as a mailto: link. */
	email?: string;
	/** Shown as written; the tel: link keeps only the digits and a leading +. */
	phone?: string;
	/** The address, one line each. */
	address?: string[];
	/** Opening hours, one { label, value } per line. */
	hours?: ContactHours[];
	emailLabel?: string;
	phoneLabel?: string;
	addressLabel?: string;
	hoursLabel?: string;
	/** For recipes: each term and its detail. */
	itemClass?: string;
	/** For recipes: the email's term and detail, after itemClass (e.g. a row of its own). */
	emailItemClass?: string;
	/** For recipes: the email link. */
	emailClass?: string;
	class?: string;
}

const {
	email,
	phone,
	address = [],
	hours = [],
	emailLabel = "Email",
	phoneLabel = "Phone",
	addressLabel = "Address",
	hoursLabel = "Hours",
	itemClass,
	emailItemClass,
	emailClass,
	class: className,
	...rest
} = Astro.props;
const at = email ? email.indexOf("@") : -1;
const local = email && at >= 0 ? email.slice(0, at) : email;
const domain = email && at >= 0 ? email.slice(at + 1) : "";
// "+44 (0)1234 567 890" dials as tel:+4401234567890: everything but the digits and a leading + goes.
const tel = phone?.replace(/(?!^\+)[^\d]/g, "");
// The email and phone links stand alone in their items, not inside a sentence: each is a 44px box on a coarse pointer
// (touchBox, decision 0015), so its hit area never reaches the next item.
const link = cn("link-underline rounded-control pointer-coarse:inline-flex pointer-coarse:items-center", touchBox, focusRing);
// The contact details (design, "Contact family"): a <dl> of what the buyer gives, in a fixed order (email, phone,
// address, hours); what is left out leaves no term. Each term is small and muted over its detail. The email address
// breaks at the @ first (a <wbr> there, break-normal on the link); only a part too long for the box breaks anywhere
// inside it (overflow-wrap: anywhere), so it never runs out of a narrow column. The phone shows as
// written. The address keeps its lines in <address>; the hours are a nested <dl> of days and times in two columns.
---

<dl class={cn("m-0 grid gap-blocks", className)} {...rest}>
	{
		email && (
			<div class={cn("grid content-start gap-1", itemClass, emailItemClass)}>
				<dt class="text-small text-muted">{emailLabel}</dt>
				<dd class="m-0 text-body text-fg">
					<a href={`mailto:${email}`} class={cn(link, "break-normal [overflow-wrap:anywhere]", emailClass)}>{domain ? <>{local}@<wbr />{domain}</> : local}</a>
				</dd>
			</div>
		)
	}
	{
		phone && (
			<div class={cn("grid content-start gap-1", itemClass)}>
				<dt class="text-small text-muted">{phoneLabel}</dt>
				<dd class="m-0 text-body text-fg">
					<a href={`tel:${tel}`} class={link}>{phone}</a>
				</dd>
			</div>
		)
	}
	{
		address.length > 0 && (
			<div class={cn("grid content-start gap-1", itemClass)}>
				<dt class="text-small text-muted">{addressLabel}</dt>
				<dd class="m-0 text-body text-fg">
					<address class="not-italic">{address.map((line, i) => <>{i > 0 && <br />}{line}</>)}</address>
				</dd>
			</div>
		)
	}
	{
		hours.length > 0 && (
			<div class={cn("grid content-start gap-1", itemClass)}>
				<dt class="text-small text-muted">{hoursLabel}</dt>
				<dd class="m-0 text-body text-fg">
					<dl class="m-0 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1">
						{
							hours.map((line) => (
								<>
									<dt>{line.label}</dt>
									<dd class="m-0">{line.value}</dd>
								</>
							))
						}
					</dl>
				</dd>
			</div>
		)
	}
</dl>
