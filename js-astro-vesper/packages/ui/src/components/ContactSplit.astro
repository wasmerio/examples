---
import Contact, { type ContactRecipeProps } from "./Contact.astro";
import ContactInfo, { type ContactHours } from "./ContactInfo.astro";
import MessageForm, { type MessageFormOptions } from "./MessageForm.astro";

export type { ContactHours } from "./ContactInfo.astro";
export type { MessageFormOptions } from "./MessageForm.astro";

export interface Props extends ContactRecipeProps {
	email?: string;
	phone?: string;
	/** The address, one line each. */
	address?: string[];
	hours?: ContactHours[];
	/** The form's settings: its action (required) and any MessageForm prop. */
	form: MessageFormOptions;
}

const { email, phone, address, hours, form, ...props } = Astro.props;
// The details beside the form. From a 48rem contact container: the details in a start column, the form in the end
// column (one and a half times wider), a group gap between. Below 48rem stacked, the details first, so a reader who
// only wants the phone number finds it before the form. items-start keeps the details at the top of their column.
// The note slot passes through to the form. The recipe's own props come after the rest, so its layout always wins.
---

<Contact {...props} align="start" contentClass={undefined} headerClass={undefined} bodyClass="gap-blocks @3xl/contact:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] @3xl/contact:items-start @3xl/contact:gap-x-group">
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	<ContactInfo email={email} phone={phone} address={address} hours={hours} />
	<MessageForm {...form}>
		{Astro.slots.has("note") && <Fragment slot="note"><slot name="note" /></Fragment>}
	</MessageForm>
</Contact>
