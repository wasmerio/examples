---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import { cn } from "../lib/cn";

export type ContainerSize = "sm" | "md" | "lg" | "full";

export interface Props extends HTMLAttributes<"div"> {
	/** Element to render. */
	as?: HTMLTag;
	/** Max width: `sm` 42rem (a column of text), `md` 64rem, `lg` 80rem (a page), `full` none. */
	size?: ContainerSize;
	class?: string;
}

const { as: Tag = "div", size = "lg", class: className, ...rest } = Astro.props;

const sizes: Record<ContainerSize, string> = { sm: "max-w-2xl", md: "max-w-5xl", lg: "max-w-7xl", full: "max-w-none" };
// The page gutter: 6 spacing steps (24px at the default density), 4 under 640px.
---

<Tag class={cn("mx-auto w-full px-6 max-sm:px-4", sizes[size], className)} {...rest}><slot /></Tag>
