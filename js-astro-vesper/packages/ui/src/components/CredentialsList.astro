---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import type { IconComponent } from "../lib/icon";
import Icon from "./Icon.astro";

export interface CredentialItem {
	/** "License", "Insured", "Warranty", "Certified". */
	term: string;
	/** "Sample license OH PL.000000". An empty or missing detail hides the row: each row shows only when it is filled. */
	detail?: string;
	/** A quieter line under the detail, such as "Ohio plumbing contractor". */
	note?: string;
	/** Your icon component for this row's marker. It wins over the list's marker. */
	icon?: IconComponent;
}

export interface Props extends HTMLAttributes<"dl"> {
	items: CredentialItem[];
	/** Your icon component, the decorative marker on every row: the strip's icon tile, or the rows' check. */
	marker?: IconComponent;
	/** Each row (a <div> around its <dt> and <dd>). */
	itemClass?: string;
	/** Each row's term (the <dt>). */
	termClass?: string;
	/** Each row's detail (the <dd>, which holds the note too). */
	detailClass?: string;
	/** Each row's marker (the span around the icon, inside the <dt>). */
	markerClass?: string;
	class?: string;
}

/** The props a recipe takes: the shell's, less the classes the recipe sets. */
export type CredentialsRecipeProps = Omit<Props, "itemClass" | "termClass" | "detailClass" | "markerClass">;

const { items = [], marker, itemClass, termClass, detailClass, markerClass, class: className, ...rest } = Astro.props;
const text = (value: unknown) => String(value ?? "").trim();
// Only filled rows: a row needs its term and its detail, so a missing value never leaves an empty row.
const rows = items
	.map((item) => ({ term: text(item?.term), detail: text(item?.detail), note: text(item?.note), icon: item?.icon ?? marker }))
	.filter((row) => row.term && row.detail);
// The credentials list (decision 0015): a <dl>, one <div> per filled row, the <dt> in the eyebrow role and the <dd>
// with the detail and, under it, the note in the small muted text. The note is never hidden at any width: it wraps.
// The marker is decoration (aria-hidden) inside the <dt>, since a <dl>'s <div> holds only <dt> and <dd>; a recipe
// places it with markerClass. A named container (credentials), so a recipe's layout reads the list's own width. With
// no filled row, nothing renders.
---

{
	rows.length > 0 && (
		<dl data-credentials class={cn("@container/credentials m-0 grid", className)} {...rest}>
			{rows.map((row) => (
				<div data-credentials-item class={cn("relative min-w-0", itemClass)}>
					<dt class={cn("text-eyebrow font-medium uppercase tracking-wider text-muted font-body text-balance [overflow-wrap:anywhere]", termClass)}>
						{row.icon && (
							<span data-credentials-marker aria-hidden="true" class={markerClass}>
								<Icon icon={row.icon} size="sm" />
							</span>
						)}
						{row.term}
					</dt>
					<dd class={cn("m-0 font-semibold text-pretty [overflow-wrap:anywhere]", detailClass)}>
						{row.detail}
						{row.note && <span data-credentials-note class="mt-0.5 block text-small font-normal text-muted text-pretty [overflow-wrap:anywhere]">{row.note}</span>}
					</dd>
				</div>
			))}
		</dl>
	)
}
