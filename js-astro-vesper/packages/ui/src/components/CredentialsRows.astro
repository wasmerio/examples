---
import { cn } from "../lib/cn";
import CredentialsList, { type CredentialsRecipeProps } from "./CredentialsList.astro";

export type { CredentialItem } from "./CredentialsList.astro";

export interface Props extends CredentialsRecipeProps {}

const props = Astro.props;
// A full credentials list in ruled rows: a hairline above the first row and under each one. Below @xl/credentials the
// term sits on its own line over the detail; from @xl (36rem) the term takes a fixed 12rem column (grid-cols-credentials-rows) and the detail the
// rest, on one baseline. The marker (your check) sits at the end of each row, centered on it, in the accent on the page
// (decoration, at 3:1, aria-hidden); the row keeps room for it, so a long detail wraps before it. The recipe's own
// props come after the rest, so its layout always wins.
---

<CredentialsList
	{...props}
	class={cn("border-t-ui border-solid border-border", props.class)}
	itemClass="grid gap-x-6 gap-y-1 border-b-ui border-solid border-border py-4.5 has-[[data-credentials-marker]]:pe-10 @xl/credentials:grid-cols-credentials-rows @xl/credentials:items-baseline"
	detailClass="text-body"
	markerClass="absolute end-0 top-1/2 flex -translate-y-1/2 text-accent normal-case"
/>
