---
import { cn } from "../lib/cn";
import CredentialsList, { type CredentialsRecipeProps } from "./CredentialsList.astro";

export type { CredentialItem } from "./CredentialsList.astro";

export interface Props extends CredentialsRecipeProps {}

const props = Astro.props;
// Proof in a row of columns, with hairlines between them (rules-between: the rules at the list's outer edges are
// clipped). As many columns as fit, auto-fit. The list is the credentials container, and a container query never
// reads its own element, so the column minimum (grid-cols-credentials-strip, theme.css) reads the list's width (100%) in the track itself: 9rem below 36rem
// and 12rem from 36rem (the (100% - 36rem) * 999 term is negative below 36rem and huge above it). So two columns
// share a 320px screen inside the usual padding, three fit from 27rem, and four from about 48rem. auto-fit drops empty
// columns, so a few items stretch across the row. Each row reads the same 36rem (@xl/credentials): below it the icon
// tile sits over the text, from it the tile sits at the start beside the text. The tile is the card surface with the
// icon in the accent (decoration, at 3:1), with a hairline round it so it shows on a page or a band of the card
// color, and a control's corners (the rows are square, so there is no outer corner to nest in). The note
// wraps at every width, never hidden. The recipe's own props come after the rest, so its layout always wins.
---

<CredentialsList
	{...props}
	class={cn("rules-between grid-cols-credentials-strip", props.class)}
	itemClass="p-4.5 @xl/credentials:px-6 @xl/credentials:py-6.5 @xl/credentials:has-[[data-credentials-marker]]:ps-20"
	termClass="mb-1"
	markerClass="mb-2.5 flex size-9 items-center justify-center rounded-control border-ui border-solid border-border bg-surface text-accent normal-case @xl/credentials:absolute @xl/credentials:start-6 @xl/credentials:top-6.5 @xl/credentials:mb-0 @xl/credentials:size-10.5"
/>
