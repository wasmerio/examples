---
import CtaBand, { type CtaBandRecipeProps } from "./CtaBand.astro";

export interface Props extends CtaBandRecipeProps {}

const props = Astro.props;
// Everything centered on the band: the eyebrow, the heading and the text in a block at the reading width, then the
// actions and the default slot. The shell centers all of it from align. No media block. The recipe's own props
// come after the rest, so its layout always wins.
---

<CtaBand
	{...props}
	align="center"
	headingClass={undefined}
	contentClass={undefined}
	bodyClass={undefined}
	textClass={undefined}
	actionsClass={undefined}
	mediaClass={undefined}
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	<slot />
</CtaBand>
