---
import { cn } from "../lib/cn";
import type { MediaImage } from "../lib/image";
import CtaBand, { type CtaBandRecipeProps } from "./CtaBand.astro";
import Media from "./Media.astro";

export interface Props extends CtaBandRecipeProps {
	/** An image beside the text on a wide band, on top at 16/9 when narrower (Media; loaded lazily unless set). The media slot wins over it. */
	image?: MediaImage;
	/** The image's side on a wide band. Below 48rem the image always sits on top. */
	side?: "end" | "start";
}

const { image, side = "end", ...rest } = Astro.props;
// The body and the image side by side from a 48rem band, each half; below that, the image on top at 16/9, full
// width. side="start" moves the image first on a wide band only, so the reading order stays heading first. On a
// wide band the image leaves the flow and fills the media block (its nearest positioned box), so the body's text
// sets the height; min-h-64 keeps a short band's image in view. rounded-none replaces the media radius: the band
// clips its overflow, so only its corners show. The media slot is rendered first, so an empty one counts as none;
// with neither it nor image there is nothing to show, and the build stops. The body is a container, so the title
// (cqi) sizes to its half, not the band. The recipe's own props come after the
// rest, so its layout always wins.
const slotted = Astro.slots.has("media") ? (await Astro.slots.render("media")).trim() : "";
if (!slotted && !image) throw new Error("CtaBandImage: pass image or fill the media slot");
---

<CtaBand
	{...rest}
	align="start"
	headingClass={undefined}
	contentClass="@3xl/cta:grid-cols-2"
	bodyClass="@container"
	textClass={undefined}
	actionsClass={undefined}
	mediaClass={cn("order-first @3xl/cta:order-none @3xl/cta:relative @3xl/cta:min-h-64", side === "start" && "@3xl/cta:order-first")}
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{
		slotted ? (
			<Fragment slot="media" set:html={slotted} />
		) : (
			image && (
				<Fragment slot="media">
					<Media {...image} ratioClass="aspect-video rounded-none @3xl/cta:absolute @3xl/cta:inset-0 @3xl/cta:size-full @3xl/cta:aspect-auto" loading={image.loading ?? "lazy"} />
				</Fragment>
			)
		)
	}
	<slot />
</CtaBand>
