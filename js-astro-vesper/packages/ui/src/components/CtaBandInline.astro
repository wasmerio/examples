---
import CtaBand, { type CtaBandRecipeProps } from "./CtaBand.astro";

export interface Props extends Omit<CtaBandRecipeProps, "text"> {}

const props = Astro.props;
// One slim row: a short heading in the lead role (still in display type) at the start, the actions at the end from
// a 36rem band; it wraps to two lines below that. No text line, no eyebrow, no media block. Slim: the body pads with
// the blocks role on both axes. The recipe's own props come after the rest, so its layout always wins.
---

<CtaBand
	{...props}
	text={undefined}
	align="start"
	headingClass="text-lead leading-tight"
	contentClass={undefined}
	bodyClass="gap-item @xl/cta:gap-blocks @xl/cta:grid-flow-col @xl/cta:items-center @xl/cta:justify-between py-blocks @3xl/cta:py-blocks"
	textClass={undefined}
	actionsClass={undefined}
	mediaClass={undefined}
>
	<slot />
</CtaBand>
