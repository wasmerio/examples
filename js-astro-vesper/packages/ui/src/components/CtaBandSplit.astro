---
import CtaBand, { type CtaBandRecipeProps } from "./CtaBand.astro";

export interface Props extends CtaBandRecipeProps {}

const props = Astro.props;
// The heading and the text at the start, the actions at the end from a 48rem band, both on the last line;
// stacked below that. No media block. The recipe's own props come after the rest, so its layout always wins.
---

<CtaBand
	{...props}
	align="start"
	headingClass={undefined}
	contentClass={undefined}
	bodyClass="@3xl/cta:grid-cols-[minmax(0,1fr)_auto] @3xl/cta:items-end"
	textClass={undefined}
	actionsClass={undefined}
	mediaClass={undefined}
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	<slot />
</CtaBand>
