---
import type { HTMLAttributes } from "astro/types";
import { focusRing, touchBox } from "../lib/button";
import { cn } from "../lib/cn";
import Badge, { type BadgeStatus } from "./Badge.astro";

export interface DescriptionItem {
	term: string;
	/**
	 * Text, a status (`{ label, status }`: the label with the Badge dot), or several values shown as a vertical
	 * list. A list value with `href` is a link.
	 */
	detail: string | { label: string; status: BadgeStatus } | (string | { label: string; href: string })[];
}

export interface Props extends HTMLAttributes<"dl"> {
	items: DescriptionItem[];
	/**
	 * Each link in a list value is a real box at least 44px tall on a coarse pointer (touchBox, decision 0015), so
	 * stacked links never share a hit area. Off by default.
	 */
	touchTargets?: boolean;
	class?: string;
}

const { items, touchTargets = false, class: className, ...rest } = Astro.props;
const link = cn("rounded-control link-underline", touchTargets && "pointer-coarse:inline-flex pointer-coarse:items-center", touchTargets && touchBox, focusRing);
---

{/*
	Columns of at least 12rem that fill the row (auto-fit, as StatsGrid's facts): one column at 320px inside the usual
	padding; two or three facts stretch to fill the row. A caller's own grid columns (Agency's sidebar) replace these
	through cn(). The items stay <div>s: a caller may select them ([&>div]).
*/}
<dl class={cn("m-0 grid grid-cols-[repeat(auto-fit,minmax(min(100%,12rem),1fr))] gap-blocks", className)} {...rest}>
	{
		items.map((item) => (
			<div class="grid content-start gap-1 border-t-ui border-solid border-border pt-item">
				<dt class="text-small text-muted">{item.term}</dt>
				<dd class="m-0 text-body text-fg">
					{Array.isArray(item.detail) ? (
						<ul role="list" class="m-0 grid list-none gap-1 p-0">
							{item.detail.map((d) => (
								<li>{typeof d === "string" ? d : <a href={d.href} class={link}>{d.label}</a>}</li>
							))}
						</ul>
					) : typeof item.detail === "string" ? (
						item.detail
					) : (
						<Badge variant="plain" status={item.detail.status}>
							{item.detail.label}
						</Badge>
					)}
				</dd>
			</div>
		))
	}
</dl>
