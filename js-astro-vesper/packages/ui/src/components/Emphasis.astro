---
import { emphasisParts } from "../lib/emphasis";

export interface Props {
	/** The heading as typed. One *phrase* marked with asterisks becomes an <em> when enabled (lib/emphasis.ts). */
	text: string;
	/** Turn the marked phrase into an <em>. Off: the text shows as typed, asterisks and all. */
	enabled?: boolean;
}

const { text, enabled = false } = Astro.props;
// A helper inside a heading, not a family: it prints text and <em> nodes and no wrapper. Each part is an Astro
// expression, so it is escaped. The <em> has no class: how it looks (italic, a weight) is the theme's.
---

{enabled ? emphasisParts(text).map((p) => (p.em ? <em>{p.text}</em> : p.text)) : text}
