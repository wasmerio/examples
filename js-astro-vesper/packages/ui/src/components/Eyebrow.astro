---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import type { IconComponent } from "../lib/icon";
import Icon from "./Icon.astro";

export interface Props extends HTMLAttributes<"span"> {
	/** A small mark before the label: your icon component, drawn at the small size and hidden from a screen reader. */
	marker?: IconComponent;
	class?: string;
}

const { marker, class: className, ...rest } = Astro.props;
// A short label above a heading (a section's eyebrow slot, a Hero's): the eyebrow role, medium weight, uppercase with
// wider tracking, muted, in the body face. It is plain text, never a heading, so it reads on the page and on a
// surface-2 band as it is; on the CTA band pass text-inherit, so it takes the band's text color. Badge is a filled
// pill, or plain text with a state dot; this is the plain kicker. The marker (an icon component, 0015's name) sits an
// item's small gap before the label, in the label's color.
---

<span data-eyebrow class={cn("inline-flex items-center gap-2 text-eyebrow font-medium uppercase tracking-wider text-muted font-body", className)} {...rest}>
	{marker && <Icon icon={marker} size="sm" />}
	<slot />
</span>
