---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import { factCells, type ListingField, type ListingValues } from "../lib/listing";

export interface Props extends HTMLAttributes<"div"> {
	/** Your fields list: one cell per field shown on cards (card is not false) that has a value, in list order. */
	fields: ListingField[];
	/** The listing's values by field key. A missing or bad value hides its cell. */
	values: ListingValues;
	/** The mode ("buy", "rent"): each label and price value follows the field's labels and period for it. */
	mode?: string;
	class?: string;
	/** Classes for each cell (a term and its value). */
	cellClass?: string;
}

const { fields, values, mode, class: className, cellClass, ...rest } = Astro.props;
const cells = factCells(fields, values, mode);
// A ruled strip of facts (comp D's fact sheet): a <dl>, one cell per fact, a small tracked term over its value
// in figures of one width. A rule above and below, and one between cells. Its own named container (facts): four
// equal columns from 16rem (a card in a grid of four at 1280px); below that as many as fit (auto-fit, at least 4.5rem
// each: three in a card at 320px, the fourth cell on a row of its own), so a term or a value is never cut. The rule between cells is each
// cell's start edge, before its start padding; the list starts that padding before the strip, which clips it
// (overflow-hidden), so the first cell of every row has no rule and its text lines up with the strip's start. With
// no cell at all, nothing renders.
---

{
	cells.length > 0 && (
		<div data-fact-strip class={cn("@container/facts overflow-hidden border-y-ui border-solid border-border", className)} {...rest}>
			<dl class="my-0 -ms-2.5 grid grid-cols-[repeat(auto-fit,minmax(min(100%,4.5rem),1fr))] @3xs/facts:grid-cols-4">
				{
					cells.map((cell) => (
						<div data-fact={cell.key} class={cn("min-w-0 border-s-ui border-solid border-border py-2.5 ps-2.5 pe-1.5", cellClass)}>
							<dt data-fact-label class="text-xs font-semibold tracking-widest text-balance text-muted uppercase [overflow-wrap:anywhere]">{cell.label}</dt>
							<dd data-fact-value class="m-0 mt-1.5 text-body leading-none font-medium tabular-nums [overflow-wrap:anywhere]">
								{cell.text}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	)
}
