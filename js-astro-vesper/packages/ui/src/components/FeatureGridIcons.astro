---
import { cn } from "../lib/cn";
import { featureAutoCols, featureCols, type FeatureCols } from "../lib/features";
import { childHeadingTag, type ItemHeadingTag } from "../lib/heading";
import type { IconComponent } from "../lib/icon";
import FeatureItemPart from "./FeatureItem.astro";
import Features, { type FeaturesRecipeProps } from "./Features.astro";
import Icon from "./Icon.astro";

/** One feature with an icon. */
export interface FeatureIconItem {
	title: string;
	text: string;
	/** An icon component (Lucide's, your own SVG component, or other), drawn in the accent color. */
	icon: IconComponent;
}

export interface Props extends FeaturesRecipeProps {
	/** The item title element when there is no heading. With a heading, titles sit one level under it. */
	itemHeadingTag?: ItemHeadingTag;
	items: FeatureIconItem[];
	/** The most columns (2, 3 or 4), so a count such as six splits evenly (3 + 3). Unset: as many as fit, each at least 15rem. */
	cols?: FeatureCols;
}

const { itemHeadingTag = "h3", items, cols, ...props } = Astro.props;
const tag = childHeadingTag({ heading: props.heading, headingTag: props.headingTag, itemHeadingTag });
// No cards: each item is its icon over the title and the text, on the open page. The icon is decoration (the title
// says what it means), so Icon hides it from a screen reader; it is large, in the accent color. As many columns as
// fit, each at least 15rem, as FeatureGridCards; with `cols`, one column, two from a 36rem features box, then `cols`
// from 56rem (four from 64rem; lib/features.ts). The recipe's own props come after the rest, so its layout wins.
const columns = cols ? featureCols[cols] : featureAutoCols;
---

<Features {...props} contentClass={undefined} headerClass={undefined} listClass={cn("gap-x-blocks", columns)}>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{
		items.map(({ title, text, icon }) => (
			<FeatureItemPart title={title} text={text} headingTag={tag}>
				<Fragment slot="lead">
					<Icon icon={icon} size="lg" class="text-accent" />
				</Fragment>
			</FeatureItemPart>
		))
	}
</Features>
