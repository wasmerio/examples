---
import { childHeadingTag } from "../lib/heading";
import type { IconComponent } from "../lib/icon";
import FeatureItemPart from "./FeatureItem.astro";
import Features, { type FeaturesRecipeProps } from "./Features.astro";
import Icon from "./Icon.astro";

/** One feature, with an optional icon. */
export interface FeatureSplitItem {
	title: string;
	text: string;
	/** An icon component (Lucide's, your own SVG component, or other), drawn in the accent color. */
	icon?: IconComponent;
}

export interface Props extends FeaturesRecipeProps {
	/** Required: the header is the start column. */
	heading: string;
	items: FeatureSplitItem[];
}

const { items, ...props } = Astro.props;
// The heading is always there, so the item titles always sit one level under it.
const tag = childHeadingTag({ heading: props.heading, headingTag: props.headingTag });
// The header in a start column and the items in two columns beside it, from a 48rem section; stacked below that.
// The list takes two columns from 36rem of its own section, never more. Both follow the features container, not
// the page, so the recipe stays stacked in a narrow column. The header is not a container of its own: its heading
// (the section role, cqi) reads the features container, the shell's width, so it is as large as every other section
// heading on the page, not shrunk to the start column. The columns sit a block apart: open text has no
// card edge to keep them apart. An icon, when given, is decoration: Icon hides it from a screen reader; it is large,
// in the accent color. The recipe's own props come after the rest, so its layout always wins.
---

<Features
	{...props}
	contentClass="@3xl/features:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] @3xl/features:items-start"
	headerClass={undefined}
	listClass="gap-x-blocks @xl/features:grid-cols-2"
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{
		items.map(({ title, text, icon }) => (
			<FeatureItemPart title={title} text={text} headingTag={tag}>
				{icon && (
					<Fragment slot="lead">
						<Icon icon={icon} size="lg" class="text-accent" />
					</Fragment>
				)}
			</FeatureItemPart>
		))
	}
</Features>
