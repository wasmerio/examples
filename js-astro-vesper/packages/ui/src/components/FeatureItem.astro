---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import { headingType } from "../lib/display";
import type { ItemHeadingTag } from "../lib/heading";
import type { MediaImage } from "../lib/image";
import Card from "./Card.astro";

export interface Props extends HTMLAttributes<"li"> {
	title: string;
	text: string;
	/** The title element. Required: a recipe passes childHeadingTag(...) (lib/heading.ts), one level under its heading. */
	headingTag: ItemHeadingTag;
	/** Draws the item as a Card. */
	card?: boolean;
	/** An image at the top of the card (Card's `image`). Only with `card`. */
	image?: MediaImage;
	/** For recipes: the title, after its own classes. */
	titleClass?: string;
	/** For recipes: the text block (the title and the text). */
	textClass?: string;
	/** For recipes: the media block after the text. Not used with `card`. */
	mediaClass?: string;
	class?: string;
}

const { title, text, headingTag: Title, card = false, image, titleClass, textClass, mediaClass, class: className, ...rest } = Astro.props;
// The named slots are rendered first, so an empty one (a recipe passes its slots on in an expression, which always
// fills them) leaves no wrapper.
const lead = Astro.slots.has("lead") ? (await Astro.slots.render("lead")).trim() : "";
const media = !card && Astro.slots.has("media") ? (await Astro.slots.render("media")).trim() : "";
// The feature family's item (decision 0013): one <li> for the Features list, in the order lead (an icon, in a flex
// box so an inline Icon adds no line height under it), the text block (the title in the heading role, the text in
// the body role, muted), then the media block (a row's image), item-role gaps between them.
// With card, the lead and the text block sit in a Card, which takes the image at its top and the item's full height,
// so a row of cards lines up. Without card the rows pack at the top (content-start): an item stretched to a taller
// neighbor's height keeps its lead-to-title gap, so the titles in a row line up. The recipes lay the item out with
// the class props.
---

<li data-feature-item class={cn("grid min-w-0 gap-item", !card && "content-start", className)} {...rest}>
	{
		card ? (
			<Card image={image} class="h-full">
				{lead && <div data-feature-lead class="flex" set:html={lead} />}
				<div data-feature-text class={cn("grid content-start gap-2", textClass)}>
					<Title class={cn("m-0 text-heading text-balance", headingType, titleClass)}>{title}</Title>
					<p class="m-0 text-body text-pretty text-muted">{text}</p>
				</div>
			</Card>
		) : (
			<Fragment>
				{lead && <div data-feature-lead class="flex" set:html={lead} />}
				<div data-feature-text class={cn("grid content-start gap-2", textClass)}>
					<Title class={cn("m-0 text-heading text-balance", headingType, titleClass)}>{title}</Title>
					<p class="m-0 text-body text-pretty text-muted">{text}</p>
				</div>
				{media && <div data-feature-media class={cn("min-w-0", mediaClass)} set:html={media} />}
			</Fragment>
		)
	}
</li>
