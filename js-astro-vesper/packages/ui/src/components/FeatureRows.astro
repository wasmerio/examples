---
import { cn } from "../lib/cn";
import { childHeadingTag, type ItemHeadingTag } from "../lib/heading";
import type { MediaImage } from "../lib/image";
import FeatureItemPart from "./FeatureItem.astro";
import Features, { type FeaturesRecipeProps } from "./Features.astro";
import Media from "./Media.astro";

/** One feature row: the image is required. */
export interface FeatureRowItem {
	title: string;
	text: string;
	/** The row's picture (Media; ratio 4/3 unless set, loaded lazily unless set). */
	image: MediaImage;
}

export interface Props extends FeaturesRecipeProps {
	/** The item title element when there is no heading. With a heading, titles sit one level under it. */
	itemHeadingTag?: ItemHeadingTag;
	items: FeatureRowItem[];
}

const { itemHeadingTag = "h3", items, ...props } = Astro.props;
const tag = childHeadingTag({ heading: props.heading, headingTag: props.headingTag, itemHeadingTag });
// Each item is a full row: the text and its image side by side from a 48rem section, the image at the end, then the
// start, row by row; below that, the image on top. The text stays first in the markup, so a screen reader reads the
// title before the picture; only the visual order moves. Rows need more air than cards, so the list gap is the group
// role (not section, which a preset may set very wide). Beside the image the title takes the section role, sized to its
// text block (a container), so it never outweighs the section heading (0015), and the text the lead role at a reading width, so the text side holds its own against the picture. The recipe's own props come after the rest, so its layout
// always wins.
---

<Features {...props} contentClass={undefined} headerClass={undefined} listClass="gap-group">
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{
		items.map(({ title, text, image }, i) => (
			<FeatureItemPart
				title={title}
				text={text}
				headingTag={tag}
				class="gap-blocks @3xl/features:grid-cols-2 @3xl/features:items-center"
				titleClass="@3xl/features:text-section"
				textClass="@container @3xl/features:max-w-lead-narrow @3xl/features:gap-3 @3xl/features:[&>p]:text-lead"
				mediaClass={cn("order-first", i % 2 === 0 && "@3xl/features:order-none")}
			>
				<Fragment slot="media">
					<Media {...image} ratio={image.ratio ?? "4/3"} loading={image.loading ?? "lazy"} />
				</Fragment>
			</FeatureItemPart>
		))
	}
</Features>
