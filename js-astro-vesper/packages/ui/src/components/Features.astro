---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import type { SectionHeadingTag } from "../lib/heading";
import { uid } from "../lib/id";
import SectionHead from "./SectionHead.astro";

export interface Props extends HTMLAttributes<"section"> {
	/** The section heading. Without it there is no section and no header: a <div> holds only the list. */
	heading?: string;
	/** Turn one *phrase* in the heading into <em> (lib/emphasis.ts). Off by default: the heading shows as typed. */
	emphasis?: boolean;
	/** A short mark after the heading, such as "(12)". Shown beside the heading, outside it, so the heading's name stays plain. Shown only with a heading. */
	mark?: string;
	/** What the mark says to a screen reader, such as "12 projects". Without it, the mark is read as written. */
	markLabel?: string;
	/** One or two sentences under the heading. Shown only with a heading. */
	text?: string;
	/** Heading element. Item titles sit one level under it (childHeadingTag in lib/heading.ts). */
	headingTag?: SectionHeadingTag;
	/** For recipes: the row that holds the header and the list. */
	contentClass?: string;
	/** For recipes: the header (eyebrow, heading, text), at the reading width (max-w-head). */
	headerClass?: string;
	/** For recipes: the list of items. */
	listClass?: string;
	class?: string;
}

/** A recipe's props: the shell's, less the ones that set the layout, which the recipe sets itself. */
export type FeaturesRecipeProps = Omit<Props, "contentClass" | "headerClass" | "listClass">;

const { heading, emphasis = false, mark, markLabel, text, headingTag = "h2", contentClass, headerClass, listClass, class: className, ...rest } = Astro.props;
const headingId = heading ? uid("features") : undefined;
// The eyebrow is rendered first, so an empty one (a recipe passes its slots on in an expression, which always fills
// them) leaves no wrapper.
const eyebrow = heading && Astro.slots.has("eyebrow") ? (await Astro.slots.render("eyebrow")).trim() : "";
// The feature family's shell (decision 0013): with a heading, the region named by it, the header (SectionHead: the
// eyebrow, the heading and the text; the lead's gap widens from a 48rem shell), then the list; without one, a plain
// <div> around the list, so a page can put its own heading above it. One <ul role="list"> holds the items
// (FeatureItem, one <li> each), which the recipes put in the default slot. The root (the section or the div) is a
// named container (features) for the recipes' queries, so a layout follows the room it has, not the page. The list
// is never the container: a query matches ancestors only, so the list's own classes (listClass) could not query its
// width. The list gap is gap-cards (twice the item role, 20px by default, the kit's gap between cards): the item role
// is too tight between cards, and block is too wide between short items; the icon and split recipes widen only the
// column gap, to block.
const list = cn("m-0 grid list-none gap-cards p-0", listClass);
---

{
	heading ? (
		<section aria-labelledby={headingId} class={cn("@container/features", className)} {...rest}>
			<div data-features-row class={cn("grid gap-blocks", contentClass)}>
				<SectionHead data-features-header heading={heading} emphasis={emphasis} mark={mark} markLabel={markLabel} text={text} headingTag={headingTag} id={headingId} leadClass="@3xl/features:mt-5" class={headerClass}>
					{eyebrow && <Fragment slot="eyebrow" set:html={eyebrow} />}
				</SectionHead>
				<ul role="list" class={list}>
					<slot />
				</ul>
			</div>
		</section>
	) : (
		<div class={cn("@container/features", className)} {...rest}>
			<ul role="list" class={list}>
				<slot />
			</ul>
		</div>
	)
}
