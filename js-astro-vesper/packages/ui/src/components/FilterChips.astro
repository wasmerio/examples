---
import type { HTMLAttributes } from "astro/types";
import { focusRing, touchBox } from "../lib/button";
import { cn } from "../lib/cn";
import Icon from "./Icon.astro";

export interface Props extends HTMLAttributes<"ul"> {
	class?: string;
}

const { class: className, ...rest } = Astro.props;
// The active filters, one removable chip each ("3+ beds"; a choice list gives one per picked value). Empty and hidden
// until the Filters script draws them from the template below (text and attributes only, never HTML): each a button
// named "Remove: 3+ beds" (the visible text and an × icon hidden from screen readers), 44px on touch. After a chip
// is removed, focus moves to the next chip, else to the first filter.
---

<ul role="list" data-filter-chips hidden class={cn("m-0 flex list-none flex-wrap gap-2 p-0", className)} {...rest}></ul>
<template data-filter-chip>
	<li class="flex">
		<button
			type="button"
			data-chip
			class={cn(
				"inline-flex min-h-control-sm cursor-pointer items-center gap-1.5 rounded-full border-ui border-solid border-border-control bg-surface-2 ps-3.5 pe-2.5 py-1 text-control-sm font-medium text-fg hover:border-fg [overflow-wrap:anywhere]",
				"motion-ok:transition-[border-color] motion-ok:duration-150",
				focusRing,
				touchBox,
			)}
		>
			<span data-chip-text></span>
			<Icon size="sm" class="text-muted">
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" /></svg>
			</Icon>
		</button>
	</li>
</template>
