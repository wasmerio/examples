---
import type { HTMLAttributes } from "astro/types";
import { focusRing, touchBox } from "../lib/button";
import { cn } from "../lib/cn";
import { pillClasses } from "../lib/pill";

export interface FilterItem {
	label: string;
	href: string;
	/** The active filter (aria-current="page"). */
	current?: boolean;
}

export interface Props extends HTMLAttributes<"nav"> {
	items: FilterItem[];
	/** Accessible name of the navigation, e.g. "Filter by service". */
	label: string;
	/**
	 * Each filter is a real box at least 44px each way on a coarse pointer (touchBox, decision 0015): the pill grows
	 * to 44px on touch, so rows of pills that wrap never share a hit area. Off by default.
	 */
	touchTargets?: boolean;
	class?: string;
}

const { items, label, touchTargets = false, class: className, ...rest } = Astro.props;
---

<nav aria-label={label} class={cn("font-body", className)} {...rest}>
	<ul role="list" class="m-0 flex list-none flex-wrap gap-2 p-0">
		{
			items.map((item) => (
				<li>
					<a
						href={item.href}
						aria-current={item.current ? "page" : undefined}
						class={cn(pillClasses({ wrap: false }), "whitespace-nowrap", touchTargets && touchBox, focusRing)}
					>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>
