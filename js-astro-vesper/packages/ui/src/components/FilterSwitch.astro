---
import type { HTMLAttributes } from "astro/types";
import { focusRingWithin } from "../lib/button";
import { cn } from "../lib/cn";

export interface FilterMode {
	value: string;
	label: string;
}

export interface Props extends HTMLAttributes<"fieldset"> {
	/** Two to four modes, such as Buy and Rent. */
	modes: FilterMode[];
	/** The switch's name, read before its options ("Buy or rent"). Kept for screen readers; the options say the rest. */
	label: string;
	/** The checked mode. Default: the first. */
	value?: string;
	/** The radios' name. Default "mode", the name the Filters script reads. */
	name?: string;
	class?: string;
}

const { modes, label, value = modes[0]?.value, name = "mode", class: className, ...rest } = Astro.props;
// A fieldset of native radios drawn as one round track (switch-thumb, theme.css) with the accent thumb behind the
// checked option: arrow keys move between them and Tab stops once, as on any radio group, with no script. The radio
// is visually hidden inside its label, so the label is the target (44px tall on touch) and carries the focus ring.
// The thumb slides only under motion-ok (decision 0018); the label's color changes at once. The checked label also
// takes the accent fill itself, once the thumb has arrived under it (the same color, so nothing shows), so its text
// sits on a real background, not only on the track's ::before.
---

<fieldset data-filter-switch class={cn("m-0 min-w-0 border-0 p-0", className)} {...rest}>
	<legend class="sr-only">{label}</legend>
	<div class="switch-thumb rounded-full border-ui border-solid border-border-control bg-surface">
		{
			modes.map((mode) => (
				<label class={cn("relative flex min-h-10 cursor-pointer items-center justify-center rounded-full px-4 text-control-sm font-medium whitespace-nowrap text-muted select-none hover:text-fg has-checked:bg-accent has-checked:text-accent-fg motion-ok:transition-[background-color] motion-ok:duration-0 motion-ok:has-checked:delay-300 pointer-coarse:min-h-11", focusRingWithin)}>
					<input type="radio" name={name} value={mode.value} checked={mode.value === value} class="sr-only" />
					{mode.label}
				</label>
			))
		}
	</div>
</fieldset>
