---
import type { HTMLAttributes } from "astro/types";
import { uid } from "../lib/id";
import Field from "./Field.astro";
import Icon from "./Icon.astro";
import Input from "./Input.astro";

export interface Props extends HTMLAttributes<"div"> {
	/** The text box's visible label ("Where"). */
	label: string;
	placeholder?: string;
	/** The box's text. */
	value?: string;
	/** The input's id. Default: a page-unique id. */
	id?: string;
	class?: string;
}

const { label, placeholder, value, id = uid("filters"), class: className, ...rest } = Astro.props;
// The search's text box: a Field with a native search input named q, the name the Filters script reads. No
// autocomplete list (the browser's would cover the results), and a phone's Enter key says "search". The search icon
// stays hidden until a recipe that draws the box without its edges shows it (FilterBar).
---

<Field label={label} for={id} class={className} data-filter-field="q" {...rest}>
	<div class="relative grid">
		<Input id={id} type="search" class="pointer-coarse:min-h-11" name="q" value={value} placeholder={placeholder} autocomplete="off" enterkeyhint="search" spellcheck="false" data-filter-text />
		<Icon size="sm" class="pointer-events-none absolute top-1/2 hidden -translate-y-1/2 text-muted">
			<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="7" r="4.5" /><path d="M10.5 10.5 14 14" /></svg>
		</Icon>
	</div>
</Field>
