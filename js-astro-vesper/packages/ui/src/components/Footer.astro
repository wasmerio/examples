---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import { displayType } from "../lib/display";

export interface Props extends HTMLAttributes<"footer"> {
	/**
	 * band (default): on the page, or on the band when a preset sets --ui-band. inverse: on the inverse surface (dark
	 * on a light page, light on a dark page), with its own text colors and focus ring.
	 */
	tone?: "band" | "inverse";
	class?: string;
	/** Classes for the inner row, e.g. a max width that matches the page container. Recipes set its layout here too. */
	contentClass?: string;
}

const { tone = "band", class: className, contentClass, ...rest } = Astro.props;
const inverse = tone === "inverse";
// The footer family's shell (decision 0013): the <footer> landmark, the band, the padding and the order lead
// (brand over meta), body (the default slot), then bottom. Recipes fill the slots and lay out the inner row.
// It sits on the page, or on the band when a preset sets --ui-band (surface-band). Its own text names the band
// colors (text-on-band-muted; the brand inherits on-band from surface-band), since surface-band rebinds no token
// and a kit part placed in a slot keeps its own colors. The focus ring is the band's text color, since the
// band may be the accent. Under tone="inverse" the same names move to the inverse surface's (surface-inverse,
// text-on-inverse-muted, focus-on-inverse); without it the HTML is as before. Its text is the small role at the
// page's line height. A named container (footer).
---

<footer
	class={cn(
		inverse ? "@container/footer surface-inverse border-t-ui border-solid border-on-inverse-border" : "@container/footer surface-band border-t-ui border-solid",
		"font-body text-small/[inherit]",
		inverse ? "focus-on-inverse" : "focus-on-band",
		className,
	)}
	{...rest}
>
	<div class={cn("grid gap-blocks px-6 pt-10 pb-12", contentClass)}>
		{
			(Astro.slots.has("brand") || Astro.slots.has("meta")) && (
				<div class="grid content-start gap-2">
					{Astro.slots.has("brand") && (
						<div class={cn("flex min-w-0 items-center gap-2 text-heading", displayType)}>
							<slot name="brand" />
						</div>
					)}
					{Astro.slots.has("meta") && (
						<div class={cn("grid gap-1", inverse ? "text-on-inverse-muted" : "text-on-band-muted", "[&_a]:text-inherit")}>
							<slot name="meta" />
						</div>
					)}
				</div>
			)
		}
		<slot />
	</div>
	{Astro.slots.has("bottom") && <slot name="bottom" />}
</footer>
