---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import { footerLink } from "../lib/footer";
import { relFor, type NavLink } from "../lib/nav";
import Footer from "./Footer.astro";

export interface Props extends HTMLAttributes<"footer"> {
	links: NavLink[];
	/** Social links, in a row of their own under the links. */
	socials?: NavLink[];
	/** Accessible name of the footer navigation. */
	label?: string;
	/** Accessible name of the social links. */
	socialsLabel?: string;
	class?: string;
	/** Classes for the inner column, e.g. a max width that matches the page container. */
	contentClass?: string;
}

const { links, socials = [], label = "Footer", socialsLabel = "Social links", contentClass, ...rest } = Astro.props;
// Brand, links, socials and the legal line, each a centered row of its own. A row of links wraps, and each
// wrapped line is centered too.
const rows = [
	{ items: links, name: label },
	{ items: socials, name: socialsLabel },
].filter((row) => row.items.length > 0);
---

<Footer contentClass={cn("justify-items-center text-center *:justify-items-center", contentClass)} {...rest}>
	{Astro.slots.has("brand") && <Fragment slot="brand"><slot name="brand" /></Fragment>}
	{
		rows.map((row) => (
			<nav aria-label={row.name}>
				<ul role="list" class="m-0 flex list-none flex-wrap justify-center gap-x-6 gap-y-2 p-0">
					{row.items.map((link) => (
						<li>
							<a href={link.href} target={link.target} rel={relFor(link.target)} aria-current={link.current ? "page" : undefined} class={footerLink}>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		))
	}
	{Astro.slots.has("legal") && <div class="text-on-band-muted [&_a]:text-inherit"><slot name="legal" /></div>}
</Footer>
