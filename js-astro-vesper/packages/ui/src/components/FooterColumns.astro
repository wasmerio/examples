---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import { footerLink } from "../lib/footer";
import { relFor, type NavLink } from "../lib/nav";
import Footer from "./Footer.astro";

export interface FooterColumn {
	heading: string;
	links: NavLink[];
}

export interface Props extends HTMLAttributes<"footer"> {
	columns: FooterColumn[];
	/** Social links, shown as the last column. */
	socials?: NavLink[];
	/** Heading of the socials column. */
	socialsHeading?: string;
	/** Accessible name of the footer navigation. */
	label?: string;
	/** Element for column headings. */
	headingTag?: "h2" | "h3" | "p";
	class?: string;
	/** Classes for the inner grid, e.g. a max width that matches the page container. */
	contentClass?: string;
}

const { columns, socials = [], socialsHeading = "Follow", label = "Footer", headingTag: Heading = "h2", contentClass, style, ...rest } = Astro.props;

const all: FooterColumn[] = socials.length > 0 ? [...columns, { heading: socialsHeading, links: socials }] : columns;
const cols = Math.max(all.length, 1);
// The brand and meta on the left, then one column per heading. Two columns on a narrow footer, under the brand;
// from 48rem, the brand's column and the link columns, which the nav lines up with a subgrid. Headings take the
// footer's small type and line height (preflight sets a heading's size to inherit).
---

<Footer
	contentClass={cn("@3xl/footer:grid-cols-[minmax(0,1.4fr)_repeat(var(--footer-cols),minmax(0,1fr))]", contentClass)}
	style={typeof style === "string" ? `--footer-cols: ${cols}; ${style}` : { "--footer-cols": cols, ...style }}
	{...rest}
>
	{Astro.slots.has("brand") && <Fragment slot="brand"><slot name="brand" /></Fragment>}
	{Astro.slots.has("meta") && <Fragment slot="meta"><slot name="meta" /></Fragment>}
	{
		all.length > 0 && (
			<nav aria-label={label} class="grid grid-cols-2 gap-blocks @3xl/footer:col-[2/span_var(--footer-cols)] @3xl/footer:grid-cols-subgrid">
				{all.map((column) => (
					<div class="grid content-start gap-2">
						<Heading class="m-0 font-semibold text-on-band">{column.heading}</Heading>
						<ul role="list" class="m-0 grid list-none gap-1.5 p-0">
							{column.links.map((link) => (
								<li>
									<a href={link.href} target={link.target} rel={relFor(link.target)} aria-current={link.current ? "page" : undefined} class={footerLink}>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))}
			</nav>
		)
	}
	{Astro.slots.has("bottom") && <Fragment slot="bottom"><slot name="bottom" /></Fragment>}
</Footer>
