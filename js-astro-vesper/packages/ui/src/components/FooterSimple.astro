---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import { footerLink } from "../lib/footer";
import { relFor, type NavLink } from "../lib/nav";
import Footer from "./Footer.astro";

export interface Props extends HTMLAttributes<"footer"> {
	links: NavLink[];
	/** Accessible name of the footer navigation. */
	label?: string;
	class?: string;
	/** Classes for the inner row, e.g. a max width that matches the page container. */
	contentClass?: string;
}

const { links, label = "Footer", contentClass, ...rest } = Astro.props;
// One row: the brand, the links, then the legal line at the end. It wraps on a narrow footer, so each part
// starts a line of its own, and the links wrap among themselves.
---

<Footer contentClass={cn("flex flex-wrap items-center justify-between gap-y-item", contentClass)} {...rest}>
	{Astro.slots.has("brand") && <Fragment slot="brand"><slot name="brand" /></Fragment>}
	{
		links.length > 0 && (
			<nav aria-label={label}>
				<ul role="list" class="m-0 flex list-none flex-wrap gap-x-6 gap-y-2 p-0">
					{links.map((link) => (
						<li>
							<a href={link.href} target={link.target} rel={relFor(link.target)} aria-current={link.current ? "page" : undefined} class={footerLink}>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}
	{Astro.slots.has("legal") && <div class="text-on-band-muted [&_a]:text-inherit"><slot name="legal" /></div>}
</Footer>
