---
import type { HTMLAttributes } from "astro/types";
import { focusRing } from "../lib/button";
import { cn } from "../lib/cn";

/** What the form is doing. The script sets it; the part only renders "idle". */
export type FormStatusState = "idle" | "sending" | "success" | "error";

export interface Props extends Omit<HTMLAttributes<"p">, "role"> {
	/** Said while the form sends. */
	sendingText?: string;
	/** Said when the endpoint accepts it (a 2xx JSON answer, or 204 No Content). Focus moves here. */
	successText?: string;
	/** Said when it fails (another answer, or no network). The user's text stays in the form. */
	errorText?: string;
	/** The surface: page (default) or band (a surface-band area). */
	tone?: "page" | "band";
	class?: string;
}

const {
	sendingText = "Sending…",
	successText = "Thanks. It has been sent.",
	errorText = "It did not send. Check your connection and try again.",
	tone = "page",
	class: className,
	...rest
} = Astro.props;
const band = tone === "band";
// A form's live status (design, "FormStatus"): one role="status" region (polite), in the page from the start and
// empty, so a screen reader is listening before the first change; with no text it has no box (no padding, no
// edge), so it takes no room. The texts sit in data attributes; lib/form-enhance.ts writes one of them and sets
// data-state, which the colors read: muted while sending, the page's text on success, the danger color on an
// error (the band's text color on a band, where no red reads). tabindex="-1": the script moves focus here on
// success, so a keyboard user hears it and stays in place; Tab never stops here. The ring is the kit's, or the
// band's text color on a band (focus-on-band skips tabindex="-1", so the part sets its own).
---

<p
	role="status"
	data-form-status
	data-state="idle"
	tabindex="-1"
	data-sending={sendingText}
	data-success={successText}
	data-error={errorText}
	class={cn(
		"m-0 min-w-0 rounded-control text-body font-medium text-pretty",
		focusRing,
		band
			? "text-on-band-muted focus-visible:outline-on-band data-[state=success]:text-on-band data-[state=error]:text-on-band"
			: "text-muted data-[state=success]:text-fg data-[state=error]:text-danger",
		className,
	)}
	{...rest}
></p>
