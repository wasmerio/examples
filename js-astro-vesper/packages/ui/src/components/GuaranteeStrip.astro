---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import type { IconComponent } from "../lib/icon";
import Button from "./Button.astro";
import Icon from "./Icon.astro";

export interface Props extends HTMLAttributes<"div"> {
	/** The promises, up to three short lines, such as "Fixed price in writing before we start". Empty: nothing renders. */
	items: string[];
	/** One button after the promises (Button tone="accent"), such as { label: "Book the free visit", href: "#quote" }. */
	action?: { label: string; href: string };
	/** Your icon component (an arrow), in a tile at the end of the action button. */
	actionIconTile?: IconComponent;
	/** The list of promises. */
	listClass?: string;
	class?: string;
}

const { items = [], action, actionIconTile, listClass, class: className, ...rest } = Astro.props;
// Blank lines are left out, so a missing promise never leaves an empty row.
// An icon tile stays a one-line tile (32px, as in a 44px pill) when the label wraps, instead of stretching with it.
const tileWraps = "[&_[data-button-tile]]:h-button-tile [&_[data-button-tile]]:self-center";
const promises = items.map((item) => String(item ?? "").trim()).filter(Boolean);
// The strip (decision 0015): on the accent surface (surface-accent; the pair is checked in every preset as
// accentPairs), with the accent-fg focus ring on everything inside (focus-on-accent). A named container (guarantee),
// so the layout is on the box inside it: from @2xl/guarantee the promises and the button share one row; below that
// the promises stack and the button fills the row. Its corners are the card's radius plus its padding
// (rounded-card-outer; the box inside pads with its --nest-gap), and the button's are the card's (rounded-card-nest),
// so the two run parallel. The button grows with its label (h-auto): it is at least the control height and 44px tall
// (min-h-tap), and a long label wraps inside it; the tile keeps its one-line size, centered on the label. Each promise has a check in a round mark in the
// inverted pair (an accent-fg disc, the check in the accent), hidden from a screen reader: the list says it.
---

{
	promises.length > 0 && (
		<div
			data-guarantee
			class={cn("@container/guarantee surface-accent focus-on-accent rounded-card-outer", className)}
			{...rest}
		>
			<div class="flex flex-col gap-4 p-(--nest-gap) ps-5 @2xl/guarantee:flex-row @2xl/guarantee:flex-wrap @2xl/guarantee:items-center @2xl/guarantee:gap-x-7 @2xl/guarantee:ps-7">
				<ul role="list" class={cn("flex min-w-0 flex-1 flex-col gap-x-7 gap-y-2.5 @2xl/guarantee:flex-row @2xl/guarantee:flex-wrap", listClass)}>
					{promises.map((promise) => (
						<li class="inline-flex min-w-0 items-center gap-2.5 font-semibold text-pretty [overflow-wrap:anywhere]">
							<span data-guarantee-mark aria-hidden="true" class="inline-flex size-6.5 shrink-0 items-center justify-center rounded-full bg-on-accent text-accent">
								<Icon size="sm">
									<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7" /></svg>
								</Icon>
							</span>
							<span>{promise}</span>
						</li>
					))}
				</ul>
				{action?.label && action?.href && (
					<Button href={action.href} tone="accent" iconTile={actionIconTile} class={cn("rounded-card-nest h-auto min-h-tap w-full justify-between whitespace-normal text-start [overflow-wrap:anywhere] @2xl/guarantee:w-auto", actionIconTile ? tileWraps : "py-2.5")}>
						{action.label}
					</Button>
				)}
			</div>
		</div>
	)
}
