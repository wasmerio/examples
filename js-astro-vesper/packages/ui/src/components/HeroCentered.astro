---
import type { MediaImage } from "../lib/image";
import Hero, { type Props as HeroProps } from "./Hero.astro";
import Media from "./Media.astro";

export interface Props extends Omit<HeroProps, "align" | "tone" | "contentClass" | "textClass" | "headingClass" | "stackClass" | "mediaClass"> {
	/** An image under the text, at the full hero width (Media; default ratio 4/3 on a hero narrower than 28rem and 16/9 from there, loaded eagerly since a hero opens the page). The media slot wins over it. */
	image?: MediaImage;
}

const { image, class: className, ...rest } = Astro.props;
// The eyebrow, heading, subtitle and actions centered in the reading box (the shell's align="center" centers the
// box, its items and the actions row), and the image under them at the full hero width, at every width. With no
// ratio of its own the image is 4/3 on a narrow hero, where 16/9 would be a thin strip, and 16/9 from a 28rem
// hero (classes by the hero's container, so Media sets no inline ratio); a ratio the image sets wins. The media
// slot is rendered first, so an empty one counts as none. The recipe's own props come after the rest, so its
// layout and tone always win.
const slotted = Astro.slots.has("media") ? (await Astro.slots.render("media")).trim() : "";
---

<Hero {...rest} class={className} align="center" tone="page" contentClass={undefined} textClass={undefined} headingClass={undefined} stackClass={undefined} mediaClass={undefined}>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{slotted ? <Fragment slot="media" set:html={slotted} /> : image && <Fragment slot="media"><Media {...image} ratioClass={image.ratio ? undefined : "aspect-[4/3] @md/hero:aspect-video"} loading={image.loading ?? "eager"} /></Fragment>}
	<slot />
</Hero>
