---
import { cn } from "../lib/cn";
import type { MediaImage } from "../lib/image";
import Hero, { type Props as HeroProps } from "./Hero.astro";
import Media from "./Media.astro";

export interface Props extends Omit<HeroProps, "align" | "tone" | "contentClass" | "textClass" | "headingClass" | "stackClass" | "mediaClass"> {
	/** An image beside the text (Media; default ratio 4/3, loaded eagerly since a hero opens the page). The media slot wins over it. */
	image?: MediaImage;
	/** The image's side on a wide hero. Below 48rem the image always sits under the text. */
	side?: "end" | "start";
}

const { image, side = "end", class: className, ...rest } = Astro.props;
// The text beside the image from a 48rem hero, the text column the wider one; below that, the image under the text.
// side="start" moves the image first on a wide hero only, so the reading order stays heading first. With no
// image, the text alone. Side by side the heading takes text-display-split, a steeper slope on the same ends, so
// in the narrower column it does not shrink when the image moves beside it. The media slot is rendered first, so
// an empty one counts as none. The recipe's own props come after the rest, so its layout and tone always win.
const slotted = Astro.slots.has("media") ? (await Astro.slots.render("media")).trim() : "";
const hasMedia = Boolean(slotted) || image !== undefined;
const start = side === "start";
---

<Hero
	{...rest}
	class={className}
	align="start"
	tone="page"
	contentClass={cn(hasMedia && `items-center ${start ? "@3xl/hero:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)]" : "@3xl/hero:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]"}`)}
	textClass={undefined}
	headingClass={cn(hasMedia && "@3xl/hero:text-display-split")}
	stackClass={undefined}
	mediaClass={cn(start && "@3xl/hero:order-first")}
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{slotted ? <Fragment slot="media" set:html={slotted} /> : image && <Fragment slot="media"><Media {...image} ratio={image.ratio ?? "4/3"} loading={image.loading ?? "eager"} /></Fragment>}
	<slot />
</Hero>
