---
import { cn } from "../lib/cn";
import { iconClasses, type IconComponent, type IconSize } from "../lib/icon";

export interface Props {
	/** An icon component: Lucide's (@lucide/astro), your own SVG component, or another. Wins over the default slot. */
	icon?: IconComponent;
	/** sm 1rem, md 1.25rem, lg 1.5rem. */
	size?: IconSize;
	/** What the icon means, when nothing next to it says so. Without it the icon is decoration, hidden from a screen reader. */
	label?: string;
	class?: string;
}

const { icon: Component, size = "md", label, class: className } = Astro.props;
// The icon comes from the icon prop or the default slot (an inline <svg>); the prop wins. The span takes the size and
// the line weight (the ui-icon utility, theme.css), and the svg fills it. Decorative by default: the span is hidden from
// a screen reader. With a label the span is the image (role img, aria-label), and the svg inside is hidden.
let slot = "";
if (!Component && Astro.slots.has("default")) {
	slot = (await Astro.slots.render("default")).trim();
	if (label) slot = slot.replace(/<svg\b(?![^>]*\saria-hidden=)/, '<svg aria-hidden="true"');
}
---

<span class={cn(iconClasses(size), "[&>svg]:size-full", className)} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"}>{Component ? <Component aria-hidden="true" /> : <Fragment set:html={slot} />}</span>
