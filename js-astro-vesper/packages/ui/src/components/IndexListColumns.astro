---
import IndexList, { type IndexListRecipeProps } from "./IndexList.astro";

export type { IndexItem } from "./IndexList.astro";

export interface Props extends IndexListRecipeProps {}

const props = Astro.props;
// The header above the list; the list in one column, two from a 42rem index container (a block apart, open rows have
// no edge to keep them apart), so a phone and a narrow column read one list. The rows run across, then down (the
// source order), and both columns share the list's top hairline. The recipe's own props come after the rest, so its
// layout always wins.
---

<IndexList {...props} align="start" contentClass={undefined} headerClass={undefined} listClass="gap-x-blocks @2xl/index:grid-cols-2">
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
</IndexList>
