---
import IndexList, { type IndexListRecipeProps } from "./IndexList.astro";

export type { IndexItem } from "./IndexList.astro";

export interface Props extends IndexListRecipeProps {}

const props = Astro.props;
// The header in a start column beside the list from a 56rem index container (about three to five), stacked above it
// below that; the list in one column, two from 42rem of the same container. Both follow the index container, not the
// page, so the recipe stays stacked in a narrow column. The header is not a container of its own: its heading (the
// section role, cqi) reads the index container, the shell's width, so it is as large as every other section heading
// on the page, not shrunk to the start column (2026-10-22). Without a heading there is no start column: the list takes
// the full row, as IndexListColumns. The recipe's own props come after the rest, so its layout always wins.
---

<IndexList
	{...props}
	align="start"
	contentClass={props.heading ? "@4xl/index:grid-cols-[minmax(0,3fr)_minmax(0,5fr)] @4xl/index:items-start" : undefined}
	headerClass={undefined}
	listClass="gap-x-blocks @2xl/index:grid-cols-2"
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
</IndexList>
