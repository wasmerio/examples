---
import IndexTable, { type IndexTableRecipeProps } from "./IndexTable.astro";

export type { IndexColumn, IndexRow } from "./IndexTable.astro";

export interface Props extends IndexTableRecipeProps {}

const props = Astro.props;
// The header in a start column beside the table from a 56rem index-table container (about three to five), stacked
// above it below that, as IndexListSplit. The header is not a container of its own, so its heading is as large as
// every other section heading on the page. Without a heading there is no start column: the table takes the full row.
// The recipe's own props come after the rest, so its layout always wins.
---

<IndexTable
	{...props}
	align="start"
	contentClass={props.heading ? "@4xl/index-table:grid-cols-[minmax(0,3fr)_minmax(0,5fr)] @4xl/index-table:items-start" : undefined}
	headerClass={undefined}
	tableClass={undefined}
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
</IndexTable>
