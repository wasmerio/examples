---
import IndexTable, { type IndexTableRecipeProps } from "./IndexTable.astro";

export type { IndexColumn, IndexRow } from "./IndexTable.astro";

export interface Props extends IndexTableRecipeProps {}

const props = Astro.props;
// The header (the eyebrow, the heading and the text) above the table, a block apart, the table the full width of the
// row. The recipe's own props come after the rest, so its layout always wins.
---

<IndexTable {...props} align="start" contentClass={undefined} headerClass={undefined} tableClass={undefined}>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
</IndexTable>
