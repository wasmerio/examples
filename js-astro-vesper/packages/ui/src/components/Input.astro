---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import { controlClasses } from "../lib/field";

export interface Props extends HTMLAttributes<"input"> {
	/** Marks the value as wrong (aria-invalid) and shows the danger border. */
	invalid?: boolean;
	class?: string;
}

const { type = "text", invalid = false, class: className, ...rest } = Astro.props;
---

<input
	type={type}
	aria-invalid={invalid ? "true" : undefined}
	class={cn(controlClasses, "h-control rounded-control px-3.5", className)}
	{...rest}
/>
