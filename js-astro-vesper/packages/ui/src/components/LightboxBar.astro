---
import Lightbox, { type LightboxRecipeProps } from "./Lightbox.astro";

export interface Props extends LightboxRecipeProps {}

// Recipe B of the lightbox family (decision 0013): for photo-heavy pages. The image fills the stage; one bar at the
// bottom holds the caption at the start, then the counter, prev, next and close together at the end, all in thumb
// reach on a phone (the caption takes its own line above them when the bar is narrow). Close is the last control
// (closeAt="end"), so Tab goes prev, next, close, as drawn. Only class hooks.
---

<Lightbox
	{...Astro.props}
	closeAt="end"
	stageClass="p-2 @3xl/lightbox:p-4"
	barClass="flex flex-wrap items-center justify-end gap-x-6 gap-y-1 px-4 py-2 @3xl/lightbox:px-6"
	captionClass="me-auto min-w-0 grow basis-64"
	controlsClass="gap-1"
	counterClass="order-first me-3"
/>
