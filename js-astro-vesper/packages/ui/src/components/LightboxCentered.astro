---
import Lightbox, { type LightboxRecipeProps } from "./Lightbox.astro";

export interface Props extends LightboxRecipeProps {}

// Recipe A of the lightbox family (decision 0013): the classic. Close at the top end, the image in the middle and the
// caption under it, centered. From a wide viewer (the lightbox container at 48rem) prev and next sit at the image's
// sides and the counter at the top start; narrower, prev, the counter and next make one row under the caption, in
// thumb reach. Close is the first area (closeAt="start"), so Tab goes close, prev, next, as drawn. Only class hooks.
// The caption's text keeps an inline inset of 1.5rem from the screen's edges on a phone, as the counter does on a
// wide viewer. Wide, close has no start margin, so the side columns match and the image and caption sit centered.
---

<Lightbox
	{...Astro.props}
	closeAt="start"
	closeClass="m-2 @3xl/lightbox:m-4 @3xl/lightbox:ms-0"
	stageClass="px-4 py-2 @3xl/lightbox:col-span-1 @3xl/lightbox:col-start-2 @3xl/lightbox:px-4"
	barClass="grid justify-items-center gap-3 px-4 pt-2 pb-4 text-center @3xl/lightbox:contents"
	captionClass="px-2 @3xl/lightbox:col-start-2 @3xl/lightbox:row-start-3 @3xl/lightbox:justify-self-center @3xl/lightbox:pt-3 @3xl/lightbox:pb-6"
	controlsClass="gap-6 @3xl/lightbox:contents"
	prevClass="@3xl/lightbox:col-start-1 @3xl/lightbox:row-start-2 @3xl/lightbox:self-center @3xl/lightbox:ms-4"
	nextClass="@3xl/lightbox:col-start-3 @3xl/lightbox:row-start-2 @3xl/lightbox:self-center @3xl/lightbox:me-4"
	counterClass="@3xl/lightbox:col-span-2 @3xl/lightbox:col-start-1 @3xl/lightbox:row-start-1 @3xl/lightbox:self-center @3xl/lightbox:justify-self-start @3xl/lightbox:ms-6"
/>
