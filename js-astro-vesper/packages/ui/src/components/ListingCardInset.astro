---
import { cn } from "../lib/cn";
import ListingCard, { type Props as Base } from "./ListingCard.astro";

export type { ListingCardData } from "./ListingCard.astro";

export interface Props extends Base {}

const { class: className, mediaClass, bodyClass, ...rest } = Astro.props;
// Comp D's card for a grid of homes: the photo close to the card's edge (listing-inset), the price, title, address,
// facts and foot under it, a little further in than the photo. An edge on hover and while a map or a list marks the card (data-hot, set by the search
// and the map): a ring in the text color around the card, no motion. The photo zooms a little (1.03) on hover, only
// where motion is allowed (decision 0018): the photo's box clips it to the photo's own corners (listing-media-clip).
---

<ListingCard
	{...rest}
	class={cn("listing-inset hover:ring-ui hover:ring-fg data-hot:ring-ui data-hot:ring-fg", className)}
	mediaClass={cn(
		"listing-media-clip motion-ok:[&_img]:transition-transform motion-ok:[&_img]:duration-700 motion-ok:[&_img]:ease-out motion-ok:group-hover/listing-card:[&_img]:scale-103",
		mediaClass,
	)}
	bodyClass={cn("px-2.5 pt-0.5 pb-2", bodyClass)}
/>
