---
import { cn } from "../lib/cn";
import ListingCard, { type Props as Base } from "./ListingCard.astro";

export type { ListingCardData } from "./ListingCard.astro";

export interface Props extends Base {}

const { class: className, mediaClass, bodyClass, factsClass, footClass, ...rest } = Astro.props;
// The same listing as a wide row, for a list beside a map or a short list on a page. Below 36rem of card it is the
// card, one column. From 36rem (@xl/listing-card) the photo takes the start column, about 2 to 3 against the text,
// and Save stays on its top end; the photo keeps its inset at the bottom and none toward the text (as CardSide).
// From 48rem (@3xl) the facts move beside the price and title, and the foot line runs under both. The card is the
// container, so its children read its width: two tracks always, which the photo, Save and the text span while
// stacked (each placed by its start and end lines, since a span would drop the start the shell sets).
// Beside the text, the photo fills its column's full height (cropped to cover), so a long text never leaves a blank
// space under it; the text sets the row's height, and the photo is never shorter than 10rem.
---

<ListingCard
	{...rest}
	class={cn(
		"grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-x-6 [&>[data-card-media]]:col-end-3 [&>[data-save-button]]:col-end-3",
		"@xl/listing-card:[&>[data-card-media]]:col-end-2 @xl/listing-card:[&>[data-save-button]]:col-end-2 @xl/listing-card:[&>[data-card-media]]:me-0 @xl/listing-card:[&>[data-card-media]]:mb-(--card-media-offset) @xl/listing-card:[&>[data-card-media]]:self-stretch",
		className,
	)}
	mediaClass={cn(
		"@xl/listing-card:h-full @xl/listing-card:min-h-40 @xl/listing-card:[&>div:first-child]:absolute @xl/listing-card:[&>div:first-child]:inset-0 @xl/listing-card:[&_img]:absolute @xl/listing-card:[&_img]:inset-0 @xl/listing-card:[&_img]:h-full",
		// With imageComponent the photo sits in a frame box (data-media-frame) that keeps its ratio; it fills the box too,
		// so the photo reaches the bottom even where the frame's dim filter makes it the photo's containing block.
		"@xl/listing-card:[&_[data-media-frame]]:absolute @xl/listing-card:[&_[data-media-frame]]:inset-0 @xl/listing-card:[&_[data-media-frame]]:aspect-auto!",
		mediaClass,
	)}
	bodyClass={cn(
		"col-start-1 col-end-3 @xl/listing-card:col-start-2 @xl/listing-card:row-start-1 @3xl/listing-card:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] @3xl/listing-card:gap-x-group",
		bodyClass,
	)}
	factsClass={cn("@3xl/listing-card:col-start-2 @3xl/listing-card:row-span-3 @3xl/listing-card:row-start-1 @3xl/listing-card:mt-0 @3xl/listing-card:self-start", factsClass)}
	footClass={cn("@3xl/listing-card:col-span-2", footClass)}
/>
