---
import LogoStrip, { type LogoStripRecipeProps } from "./LogoStrip.astro";

export type { LogoStripItem } from "./LogoStrip.astro";

export interface Props extends LogoStripRecipeProps {}

const props = Astro.props;
// Logos in equal cells, each at least 10rem: one column on a 320px phone (the example's px-6 leaves 17rem), two from
// a 20rem row, six in a 6xl row. auto-fit drops empty columns, so a few logos share the whole row and more wrap; a
// partial last row leaves its end open (no cell draws the edge after the last one). Hairlines run between the cells
// and none on the outside: each cell draws its top and start edge and sits one border width up and in, and the list
// clips what falls past its own edge. The cells stretch to their row's height (items-stretch), so the hairlines line
// up; a logo is centered in its cell (the cell's own items-center), with room for the focus ring. The recipe's own
// props come after the rest, so its layout always wins.
---

<LogoStrip
	{...props}
	align="start"
	contentClass={undefined}
	headerClass={undefined}
	listClass="grid items-stretch gap-0 overflow-hidden grid-cols-[repeat(auto-fit,minmax(min(100%,10rem),1fr))]"
	itemClass="-mt-hairline -ms-hairline items-center justify-center border-0 border-t-ui border-s-ui border-solid border-border px-item py-blocks"
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
</LogoStrip>
