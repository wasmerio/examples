---
import LogoStrip, { type LogoStripRecipeProps } from "./LogoStrip.astro";

export type { LogoStripItem } from "./LogoStrip.astro";

export interface Props extends LogoStripRecipeProps {
	/** start: the label and the logos on one line (a trust strip under a hero). center: the label above a centered row. */
	align?: "start" | "center";
}

const { align = "start", ...props } = Astro.props;
const center = align === "center";
// The logos in one wrapping row, a block apart, an item apart when they wrap. start: a label and the logos share
// that line (the label first); a heading sits above them, a block apart, as in every section. center: the header or
// the label above a centered row, the label an item apart. The recipe's own props come after the rest, so its layout
// always wins.
const row = "flex flex-wrap items-center gap-item gap-x-blocks";
---

<LogoStrip
	{...props}
	align={align}
	contentClass={props.heading ? (center ? "justify-items-center" : undefined) : center ? "justify-items-center gap-item" : row}
	headerClass={undefined}
	listClass={center ? `${row} justify-center` : row}
	itemClass={undefined}
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
</LogoStrip>
