---
import { cn } from "../lib/cn";
import { displayType } from "../lib/display";
import type { IconComponent } from "../lib/icon";
import Icon from "./Icon.astro";
import Marquee, { type MarqueeRecipeProps } from "./Marquee.astro";

export interface Props extends MarqueeRecipeProps {
	/** One or more short phrases, such as your services. Empty throws. */
	items: string[];
	/** The mark between the phrases: your icon component (e.g. a star). Default: a small dot in the accent. Decorative. */
	marker?: IconComponent;
}

const { items, marker, ...props } = Astro.props;
if (!items?.length) throw new Error("MarqueeText needs at least one item.");
// A band of short phrases in a moving row (the Marquee shell), in the subhead role in display type, the header above
// it. A marker follows each phrase (hidden from screen readers: your icon, else a small accent dot), so the loop has
// one between the last phrase and the first; in the still row the last one is hidden, as nothing follows it. The
// recipe's own props come after the rest, so its layout always wins.
---

<Marquee {...props} decorative={false} contentClass={undefined} headerClass={undefined} trackClass={undefined} setClass={cn("text-subhead leading-tight text-fg", displayType)}>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{
		items.map((item) => (
			<li data-marquee-item class="group/marquee-item inline-flex min-w-0 items-center gap-x-blocks marquee-moves:whitespace-nowrap">
				<span class="min-w-0 [overflow-wrap:anywhere]">{item}</span>
				{marker ? (
					<Icon icon={marker} size="md" class="shrink-0 group-last/marquee-item:hidden marquee-moves:group-last/marquee-item:inline-block" />
				) : (
					<span data-marquee-dot aria-hidden="true" class="size-2 shrink-0 rounded-full bg-accent group-last/marquee-item:hidden marquee-moves:group-last/marquee-item:inline-block" />
				)}
			</li>
		))
	}
</Marquee>
