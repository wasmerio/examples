---
import { uid } from "../lib/id";
import Field from "./Field.astro";
import Form, { type Props as FormProps } from "./Form.astro";
import Input from "./Input.astro";
import Select from "./Select.astro";
import Textarea from "./Textarea.astro";

export interface Props extends Omit<FormProps, "fieldsClass" | "actionClass" | "buttonClass" | "statusClass"> {
	/** The name field's name, as the endpoint wants it. */
	nameName?: string;
	/** The email field's name, e.g. EMAIL for Mailchimp. */
	emailName?: string;
	messageName?: string;
	companyName?: string;
	phoneName?: string;
	topicName?: string;
	nameLabel?: string;
	emailLabel?: string;
	messageLabel?: string;
	companyLabel?: string;
	phoneLabel?: string;
	topicLabel?: string;
	/** The topic select's first option, selected until the reader picks a topic; it sends an empty topic. */
	topicPlaceholder?: string;
	/** Ask for a company (optional to fill). */
	company?: boolean;
	/** Ask for a phone number (optional to fill). */
	phone?: boolean;
	/** A topic list for a native select. Without it, no select. */
	topics?: string[];
	/** The message box's height in lines. */
	messageRows?: number;
	/** The text shown under a field that is empty or wrong (enhance="fetch"). */
	fieldErrors?: { name?: string; email?: string; message?: string };
}

/** The form's settings a recipe takes as one prop (ContactSplit's form). */
export type MessageFormOptions = Omit<Props, "tone" | "class">;

const {
	nameName = "name",
	emailName = "email",
	messageName = "message",
	companyName = "company",
	phoneName = "phone",
	topicName = "topic",
	nameLabel = "Name",
	emailLabel = "Email",
	messageLabel = "Message",
	companyLabel = "Company",
	phoneLabel = "Phone",
	topicLabel = "Topic",
	topicPlaceholder = "Choose a topic",
	company = false,
	phone = false,
	topics = [],
	messageRows = 5,
	fieldErrors = {},
	submitLabel = "Send message",
	successText = "Thanks. We got your message and will answer soon.",
	enhance = "none",
	tone = "page",
	...form
} = Astro.props;
const base = uid("message");
const id = (field: string) => `${base}-${field}`;
const slot = enhance === "fetch";
const errors = {
	name: fieldErrors.name ?? "Enter your name.",
	email: fieldErrors.email ?? "Enter an email address, like name@example.com.",
	message: fieldErrors.message ?? "Enter a message.",
};
// A contact form on Form (design, "Contact family"): name, email and message always, required; company, phone and a
// topic select when asked, between the email and the message. Every field has a visible label and its autocomplete
// value; the email field is type=email with no spellcheck. Field names and labels are props with plain defaults, so
// any endpoint fits. Each required control carries its error text (data-error) for the script; with enhance="fetch"
// each Field renders its error node up front (errorSlot). The topic is the kit's Select (a native select with the
// control look and a chevron that lets clicks through). Its first option is empty and
// selected (topicPlaceholder), so a reader who never picks one sends no topic, not the first one; the field stays
// optional. The fields are an item apart (Form's gap). The note and extra slots pass through to Form.
---

<Form {...form} enhance={enhance} tone={tone} submitLabel={submitLabel} successText={successText} fieldsClass={undefined} actionClass={undefined} buttonClass={undefined} statusClass={undefined}>
	<Field label={nameLabel} for={id("name")} required tone={tone} errorSlot={slot}>
		<Input id={id("name")} name={nameName} autocomplete="name" required data-error={errors.name} />
	</Field>
	<Field label={emailLabel} for={id("email")} required tone={tone} errorSlot={slot}>
		<Input id={id("email")} type="email" name={emailName} autocomplete="email" spellcheck="false" required data-error={errors.email} />
	</Field>
	{
		company && (
			<Field label={companyLabel} for={id("company")} tone={tone} errorSlot={slot}>
				<Input id={id("company")} name={companyName} autocomplete="organization" />
			</Field>
		)
	}
	{
		phone && (
			<Field label={phoneLabel} for={id("phone")} tone={tone} errorSlot={slot}>
				<Input id={id("phone")} type="tel" name={phoneName} autocomplete="tel" />
			</Field>
		)
	}
	{
		topics.length > 0 && (
			<Field label={topicLabel} for={id("topic")} tone={tone} errorSlot={slot}>
				<Select id={id("topic")} name={topicName}>
					<option value="" selected>{topicPlaceholder}</option>
					{topics.map((topic) => <option value={topic}>{topic}</option>)}
				</Select>
			</Field>
		)
	}
	<Field label={messageLabel} for={id("message")} required tone={tone} errorSlot={slot}>
		<Textarea id={id("message")} name={messageName} rows={messageRows} required data-error={errors.message} />
	</Field>
	{Astro.slots.has("extra") && <Fragment slot="extra"><slot name="extra" /></Fragment>}
	{Astro.slots.has("note") && <Fragment slot="note"><slot name="note" /></Fragment>}
</Form>
