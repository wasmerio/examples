---
import { cn } from "../lib/cn";
import { navCollapse } from "../lib/nav";
import Navbar, { type NavbarRecipeProps } from "./Navbar.astro";

export interface Props extends NavbarRecipeProps {}

const { contentClass, linksClass, collapse = "md", ...rest } = Astro.props;
// Three columns above the fold point: the links at the start, the brand in the middle, the end group (the actions,
// then the utilities) at the end. The shell puts the brand after the links (areaOrder="links-brand-end"), so the Tab
// order follows the screen. The row is a grid of two equal outer columns around the brand's, so the brand is
// centered while the links and the end group fit their equal share; a long brand beside actions that do not wrap
// can shift it. Its fourth child, the menu button wrapper, is hidden there, so nothing takes a second row.
// The grid follows collapse (navCollapse): below the fold point the links are hidden and the row is a flex row
// again, the brand first and at the start, the menu button at the end. contentClass and linksClass merge after.
const bp = navCollapse[collapse];
---

<Navbar
	{...rest}
	collapse={collapse}
	contentClass={cn(bp.centerRow, contentClass)}
	linksClass={linksClass}
	areaOrder="links-brand-end"
	brandClass={bp.centerBrand}
	endClass={bp.centerEnd}
>
	{Astro.slots.has("brand") && <Fragment slot="brand"><slot name="brand" /></Fragment>}
	{Astro.slots.has("actions") && <Fragment slot="actions"><slot name="actions" /></Fragment>}
	{Astro.slots.has("utilities") && <Fragment slot="utilities"><slot name="utilities" /></Fragment>}
	{Astro.slots.has("emergency") && <Fragment slot="emergency"><slot name="emergency" /></Fragment>}
	{Astro.slots.has("menu") && <Fragment slot="menu"><slot name="menu" /></Fragment>}
</Navbar>
