---
import { cn } from "../lib/cn";
import { navCollapse } from "../lib/nav";
import Navbar, { type NavbarRecipeProps } from "./Navbar.astro";

export interface Props extends NavbarRecipeProps {}

const { contentClass, linksClass, collapse = "md", ...rest } = Astro.props;
const bp = navCollapse[collapse];
// One row: the brand at the start, the links, the actions and the utilities at the end. Above the fold point the
// brand and the end group share the free space in equal parts (flex 1 1 0, navCollapse centeredSide) and the link
// list keeps its own width, so at the full width the links sit at the bar's center, not between a narrow brand and a
// wide end group. Neither side goes under its content's narrowest width (min-w-min), so a long brand wraps and never
// runs over the links; when room runs out the link list gives way and its links wrap. The shrunk bar (shrink) rests
// at max-content: there each side keeps at least its own width (min-w-max), so the bar packs its groups with the
// nav's gap between them and the links sit where they fall. As it
// narrows, the sides stay equal until the wider one reaches its own width, then the other side gives up the rest, so
// nothing jumps. A brand or end group wider than its equal share shifts the links. Below the fold point the row is
// the brand and the menu button, as in the other recipes. contentClass and linksClass merge after, so a caller's
// type, gap and color win. The recipe's shell props come after the rest.
---

<Navbar
	{...rest}
	collapse={collapse}
	contentClass={contentClass}
	linksClass={cn(bp.centeredLinks, linksClass)}
	areaOrder="brand-links-end"
	brandClass={bp.centeredSide}
	endClass={cn(bp.centeredSide, "justify-end")}
>
	{Astro.slots.has("brand") && <Fragment slot="brand"><slot name="brand" /></Fragment>}
	{Astro.slots.has("actions") && <Fragment slot="actions"><slot name="actions" /></Fragment>}
	{Astro.slots.has("utilities") && <Fragment slot="utilities"><slot name="utilities" /></Fragment>}
	{Astro.slots.has("emergency") && <Fragment slot="emergency"><slot name="emergency" /></Fragment>}
	{Astro.slots.has("menu") && <Fragment slot="menu"><slot name="menu" /></Fragment>}
</Navbar>
