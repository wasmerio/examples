---
import Navbar, { type NavbarRecipeProps } from "./Navbar.astro";

export interface Props extends NavbarRecipeProps {}

// One row: the brand, the links right after it, then the actions and the utilities at the end. The shell's link
// list takes the free space and starts its links at its own start, so they sit after the brand, and the end group
// sits at the end. The recipe adds no layout of its own: contentClass and linksClass pass on in the rest.
// The recipe's shell props come after the rest, so a caller cannot reorder the areas or reach the other wrappers.
---

<Navbar {...Astro.props} areaOrder="brand-links-end" brandClass={undefined} endClass={undefined}>
	{Astro.slots.has("brand") && <Fragment slot="brand"><slot name="brand" /></Fragment>}
	{Astro.slots.has("actions") && <Fragment slot="actions"><slot name="actions" /></Fragment>}
	{Astro.slots.has("utilities") && <Fragment slot="utilities"><slot name="utilities" /></Fragment>}
	{Astro.slots.has("emergency") && <Fragment slot="emergency"><slot name="emergency" /></Fragment>}
	{Astro.slots.has("menu") && <Fragment slot="menu"><slot name="menu" /></Fragment>}
</Navbar>
