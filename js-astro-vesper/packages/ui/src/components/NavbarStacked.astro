---
import { cn } from "../lib/cn";
import { navCollapse } from "../lib/nav";
import Navbar, { type NavbarRecipeProps } from "./Navbar.astro";

export interface Props extends NavbarRecipeProps {}

const { contentClass, linksClass, collapse = "md", ...rest } = Astro.props;
// Two rows above the fold point: the brand at the start and the end group (the actions, then the utilities) at the
// end, then the links on a row of their own under a hairline. The shell puts the end group before the links
// (areaOrder="brand-end-links"), so the Tab order follows the screen, row by row: the brand, the actions, the
// utilities, then the links. The row wraps and the list takes the full width, by collapse (navCollapse), so below
// the fold point, where the list is hidden, the row is the brand, the end group and the menu button, as in the
// other recipes, and never wraps. contentClass and linksClass merge after the recipe's classes.
const bp = navCollapse[collapse];
---

<Navbar
	{...rest}
	collapse={collapse}
	contentClass={cn(bp.stackedRow, contentClass)}
	linksClass={cn(bp.stackedLinks, linksClass)}
	areaOrder="brand-end-links"
	brandClass={undefined}
	endClass={undefined}
>
	{Astro.slots.has("brand") && <Fragment slot="brand"><slot name="brand" /></Fragment>}
	{Astro.slots.has("actions") && <Fragment slot="actions"><slot name="actions" /></Fragment>}
	{Astro.slots.has("utilities") && <Fragment slot="utilities"><slot name="utilities" /></Fragment>}
	{Astro.slots.has("emergency") && <Fragment slot="emergency"><slot name="emergency" /></Fragment>}
	{Astro.slots.has("menu") && <Fragment slot="menu"><slot name="menu" /></Fragment>}
</Navbar>
