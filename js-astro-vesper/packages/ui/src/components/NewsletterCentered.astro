---
import Newsletter, { type NewsletterRecipeProps } from "./Newsletter.astro";
import SignupForm, { type SignupFormOptions } from "./SignupForm.astro";

export type { SignupFormOptions } from "./SignupForm.astro";

export interface Props extends NewsletterRecipeProps {
	/** The form's settings: its action (required) and any SignupForm prop. */
	form: SignupFormOptions;
}

const { form, ...props } = Astro.props;
const band = props.tone === "band";
// The header and the form centered, the form at a reading width (max-w-md), the field and button in one row where
// they fit. A shell cannot pass the tone into its slot (decision 0013), so the recipe gives the header the band's
// text colors and the form tone="band" itself. Looks right as a band. The note slot passes through. The recipe's
// own props come after the rest, so its layout always wins.
---

<Newsletter
	{...props}
	align="center"
	contentClass="justify-items-center"
	headerClass={undefined}
	headingClass={band ? "text-on-band" : undefined}
	leadClass={band ? "text-on-band-muted" : undefined}
	bodyClass="w-full max-w-md"
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	<SignupForm {...form} tone={band ? "band" : "page"} layout="inline">
		{Astro.slots.has("note") && <Fragment slot="note"><slot name="note" /></Fragment>}
	</SignupForm>
</Newsletter>
