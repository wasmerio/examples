---
import Newsletter, { type NewsletterRecipeProps } from "./Newsletter.astro";
import SignupForm, { type SignupFormOptions } from "./SignupForm.astro";

export type { SignupFormOptions } from "./SignupForm.astro";

export interface Props extends NewsletterRecipeProps {
	/** The form's settings: its action (required) and any SignupForm prop. The field labels (email, and name with nameField) are hidden unless labelHidden is false. */
	form: SignupFormOptions;
}

const { form, ...props } = Astro.props;
const band = props.tone === "band";
// The header in the start column, the form in the end column from a 48rem newsletter container, a group gap between;
// below it stacked, the header first (DOM order is the visual order). items-start lines the form up with the
// header's top: the form grows downward, so an error under the field or a status under the row never moves the field
// or the Button (with items-end the form was pinned to the header's last line and moved up as it grew). The field
// and button sit in one row and wrap to two in a narrow box. The heading beside the field says what it is for, so
// the email label is for screen readers only unless the caller shows it. A shell cannot pass the tone into its slot
// (decision 0013), so the recipe gives the header the band's text colors and the form tone="band" itself. The note
// slot passes through. The recipe's own props come after the rest, so its layout wins.
---

<Newsletter
	{...props}
	align="start"
	contentClass="@3xl/newsletter:grid-cols-2 @3xl/newsletter:items-start @3xl/newsletter:gap-x-group"
	headerClass={undefined}
	headingClass={band ? "text-on-band" : undefined}
	leadClass={band ? "text-on-band-muted" : undefined}
	bodyClass={undefined}
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	<SignupForm {...form} labelHidden={form.labelHidden ?? true} tone={band ? "band" : "page"} layout="inline">
		{Astro.slots.has("note") && <Fragment slot="note"><slot name="note" /></Fragment>}
	</SignupForm>
</Newsletter>
