---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import { cn } from "../lib/cn";
import Section from "./Section.astro";

export interface Props extends HTMLAttributes<"section"> {
	/** surface: the light page fill. inverse: dark on a light page, light on a dark page. image: a photo panel, dark in both modes. */
	tone?: "surface" | "inverse" | "image";
	/** The Section's element (default "section"). */
	as?: HTMLTag;
	/** For recipes and themes: the inner Section. */
	contentClass?: string;
	class?: string;
}

const { tone = "surface", as = "section", contentClass, class: className, ...rest } = Astro.props;
// A set-apart block of the page: an inset, rounded box (the panel inset at the sides and below, the panel radius)
// around a page Section, which keeps the section space above and below. The box is a wrapper, not a Section option,
// so Section's page-after-page rule never drops a panel's top padding: each inner Section is its wrapper's only child.
// The surface paints the box and rebinds no token (decision 0015, principle 2): surface is the page-family fill
// (surface-2, the page's text and ring); inverse is surface-inverse, whose text names the inverse colors and whose
// ring is focus-on-inverse; image is the scrim with scrim-fg text and the image ring, the photo (the media slot)
// absolutely placed under the content, which takes the scrim's rise; a 20% veil of the scrim over the whole photo,
// as on HeroCover and CardOverlay (SCRIM_LAYERS), so the image Buttons' shares hold on any photo. A named container (panel). Attributes go on the
// inner Section, so aria-labelledby names the region.
const surfaces = {
	surface: "bg-surface-2 text-fg",
	inverse: "surface-inverse focus-on-inverse",
	image: "bg-scrim text-scrim-fg focus-on-image",
};
const media = tone === "image" && Astro.slots.has("media");
---

<div data-panel data-panel-tone={tone} class={cn("@container/panel relative isolate mx-panel-inset mb-panel-inset overflow-clip rounded-panel", surfaces[tone] ?? surfaces.surface, className)}>
	{media && <div data-panel-media class="absolute inset-0 -z-10 [&>*]:size-full [&>*]:object-cover"><slot name="media" /><span data-panel-veil class="absolute inset-0 bg-scrim/20"></span></div>}
	<Section tone="page" as={as} class={cn(tone === "image" && "scrim-rise", contentClass)} {...rest}><slot /></Section>
</div>
