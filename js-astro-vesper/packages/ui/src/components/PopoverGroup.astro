---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";

export interface Props extends HTMLAttributes<"fieldset"> {
	/** The group's name ("Min"), shown above its options. */
	legend: string;
	/** Keeps the legend for screen readers only, when the panel's own name says it all. */
	legendHidden?: boolean;
	/** In a range (Popover's summary "range"): which end this group's radios set. */
	end?: "min" | "max";
	class?: string;
}

const { legend, legendHidden = false, end, class: className, ...rest } = Astro.props;
// A native fieldset of PopoverOptions. In a two-column panel each group takes a minimum width, and the line between
// the columns is the later group's start edge.
---

<fieldset
	{...rest}
	data-popover-end={end}
	class={cn("m-0 grid min-w-0 content-start border-0 p-0 in-data-popover-cols:min-w-34 in-data-popover-cols:not-first:border-s-ui in-data-popover-cols:not-first:border-solid in-data-popover-cols:not-first:border-border in-data-popover-cols:not-first:ps-1 in-data-popover-cols:not-last:pe-1", className)}
>
	<legend class={legendHidden ? "sr-only" : "float-start w-full px-2.5 py-2 text-eyebrow font-medium tracking-wider text-muted uppercase"}>{legend}</legend>
	<slot />
</fieldset>
