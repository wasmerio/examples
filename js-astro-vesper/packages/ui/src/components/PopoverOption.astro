---
import type { HTMLAttributes } from "astro/types";
import { focusRingWithin } from "../lib/button";
import { cn } from "../lib/cn";
import Icon from "./Icon.astro";

export interface Props extends HTMLAttributes<"input"> {
	/** A checkbox (several choices) or a radio (one choice). */
	type: "checkbox" | "radio";
	/** The form field's name. */
	name: string;
	/** The value it submits. */
	value: string;
	/** More classes for the row, merged with cn(). */
	class?: string;
}

const { type, name, value, class: className, ...rest } = Astro.props;
const tick = "M3.5 8.5l3 3 6-7";
// One row of a panel: a real checkbox or radio inside its label, so the whole row is the hit area. One line, but on a
// narrow phone its words wrap, so the panel never scrolls sideways. A checkbox draws its
// box on the real control, with the tick above it. A radio shows no circle: the control is visually hidden, the picked
// row has the fill and a tick at its end, so its state is not color alone. Either way the words are in one marked span,
// which the script reads for the trigger's words.
---

<label
	class={cn(
		"relative flex min-h-9.5 cursor-pointer items-center gap-2.5 rounded-control px-2.5 text-control whitespace-nowrap tabular-nums select-none hover:bg-surface-2 pointer-coarse:min-h-11 max-sm:min-h-11 max-sm:py-2 max-sm:whitespace-normal",
		"has-disabled:cursor-not-allowed has-disabled:text-muted has-disabled:opacity-50 has-disabled:hover:bg-transparent",
		"motion-ok:transition-colors motion-ok:duration-150",
		type === "radio" && "has-checked:bg-surface-2 has-checked:font-medium",
		focusRingWithin,
		"has-focus-visible:-outline-offset-2",
		className,
	)}
>
	{
		type === "checkbox" ? (
			<span class="grid size-4.5 shrink-0">
				<input {...rest} type="checkbox" name={name} value={value} class="peer col-start-1 row-start-1 m-0 size-full cursor-[inherit] appearance-none rounded-check border-ui border-solid border-border-control bg-field-fill outline-none checked:border-accent checked:bg-accent" />
				<Icon size="sm" class="pointer-events-none col-start-1 row-start-1 hidden place-self-center text-accent-fg peer-checked:inline-flex">
					<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d={tick} /></svg>
				</Icon>
			</span>
		) : (
			<input {...rest} type="radio" name={name} value={value} class="peer sr-only" />
		)
	}
	<span data-popover-option-text class="flex-1"><slot /></span>
	{
		type === "radio" && (
			<Icon size="sm" class="invisible peer-checked:visible">
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d={tick} /></svg>
			</Icon>
		)
	}
</label>
