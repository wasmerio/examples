---
import { childHeadingTag, type ItemHeadingTag } from "../lib/heading";
import { gridImageSizes, type ImageComponent } from "../lib/image";
import PostCard, { type PostItem } from "./PostCard.astro";
import Posts, { type PostsRecipeProps } from "./Posts.astro";

export type { PostItem } from "./PostCard.astro";

export interface Props extends PostsRecipeProps {
	/** The title element when there is no heading. With a heading, titles sit one level under it. */
	itemHeadingTag?: ItemHeadingTag;
	/** The posts, newest first (the order you pass). */
	items: PostItem[];
	/** The dates' language, e.g. "de" (formatDate in lib/date.ts). */
	locale?: string;
	/** Your image component, for every photo (Media's imageComponent): Astro's <Image>, or a small wrapper for your CMS. */
	imageComponent?: ImageComponent;
}

const { itemHeadingTag = "h3", items, locale = "en", imageComponent, ...props } = Astro.props;
const sizes = gridImageSizes(items.length);
const tag = childHeadingTag({ heading: props.heading, headingTag: props.headingTag, itemHeadingTag });
// Post cards: as many columns as fit, each at least 18rem (auto-fit). At 320px and 390px inside the usual padding,
// one column (the min() lets it shrink to the row); from about 37rem two; three from about 57rem. Two posts stretch to two
// halves. A card fills its row's height, so the footers (topic and author) line up. The cards are a cards gap apart.
// Only a post's own fields reach the card. Your image component, if given, draws every photo, with the grid's sizes
// hint for the number of items (gridImageSizes). The recipe's own props come after the rest, so its layout always wins.
---

<Posts {...props} align="start" contentClass={undefined} headerClass={undefined} listClass="grid-cols-[repeat(auto-fit,minmax(min(100%,18rem),1fr))] gap-cards">
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{
		items.map((post) => (
			<li class="grid min-w-0">
				<PostCard
					href={post.href}
					title={post.title}
					date={post.date}
					dateLabel={post.dateLabel}
					excerpt={post.excerpt}
					image={post.image}
					imageComponent={imageComponent}
					imageSizes={sizes}
					topic={post.topic}
					author={post.author}
					readingTime={post.readingTime}
					locale={locale}
					headingTag={tag}
				/>
			</li>
		))
	}
</Posts>
