---
import { childHeadingTag, type ItemHeadingTag } from "../lib/heading";
import type { PostItem } from "./PostCard.astro";
import PostRow from "./PostRow.astro";
import Posts, { type PostsRecipeProps } from "./Posts.astro";

export type { PostItem } from "./PostCard.astro";

export interface Props extends PostsRecipeProps {
	/** The title element when there is no heading. With a heading, titles sit one level under it. */
	itemHeadingTag?: ItemHeadingTag;
	/** The posts, newest first (the order you pass). A row shows no image and no author. */
	items: PostItem[];
	/** The dates' language, e.g. "de" (formatDate in lib/date.ts). */
	locale?: string;
}

const { itemHeadingTag = "h3", items, locale = "en", ...props } = Astro.props;
const tag = childHeadingTag({ heading: props.heading, headingTag: props.headingTag, itemHeadingTag });
// Posts as rows of text, one column: each row has a hairline above it and the last one a hairline below too (set on
// that row here: a last: class on the row would match every row, each alone in its <li>), so the list reads as one
// block. No gap between rows: each row's own padding spaces them. From 42rem of the posts container the date sits in
// its own start column (PostRow). Only a post's own fields reach the row (no image, no author). The recipe's own props
// come after the rest, so its layout always wins.
---

<Posts {...props} align="start" contentClass={undefined} headerClass={undefined} listClass="gap-0">
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{
		items.map((post, i) => (
			<li class="grid min-w-0">
				<PostRow
					href={post.href}
					title={post.title}
					date={post.date}
					dateLabel={post.dateLabel}
					excerpt={post.excerpt}
					topic={post.topic}
					readingTime={post.readingTime}
					locale={locale}
					headingTag={tag}
					class={i === items.length - 1 ? "border-b-ui" : undefined}
				/>
			</li>
		))
	}
</Posts>
