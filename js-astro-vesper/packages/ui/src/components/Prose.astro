---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import { cn } from "../lib/cn";

export interface Props extends HTMLAttributes<"div"> {
	/** Element to render. */
	as?: HTMLTag;
	class?: string;
}

const { as: Tag = "div", class: className, ...rest } = Astro.props;

// Styles the plain HTML a rich-text renderer emits. Each element rule sits inside :where() as a whole
// ([:where(&_h2)]:mt-12), so it has no specificity and a class on the content itself wins over it. Two rules
// keep their weight on purpose, as they order the flow: the gap after a heading, and no gap above the first
// child. The flow gap skips headings and rules, which set their own top margin. Link hover and focus-visible
// rules carry one pseudo-class of weight (:where(…):hover), so a plain class on a link ties with them and can
// lose; a hover: or focus-visible: class wins.
// Prose is a container (@container/prose), so its h2 (text-subhead) sizes to its own width, not the viewport.
// A container has no content size, so contain-intrinsic-inline-size gives it 65ch (max-w-prose) in a
// content-sized box (an inline-flex, an auto grid track); a set width still wins.
const prose = [
	"@container/prose w-full min-w-0 max-w-prose [contain-intrinsic-inline-size:65ch] text-reading text-fg font-body",
	"[:where(&>*+*:not(h2,h3,h4,hr))]:mt-5 [:where(&_:is(p,li,blockquote))]:text-pretty",
	// Headings: the display face for h2, the heading face for h3 and h4, both with the phone stretch cap.
	"[:where(&_h2)]:display-face [:where(&_h2)]:text-subhead [:where(&_h2)]:text-balance [:where(&_h2)]:mt-12",
	"[:where(&_h3)]:heading-face [:where(&_h3)]:text-heading [:where(&_h3)]:text-balance [:where(&_h3)]:mt-10",
	"[:where(&_h4)]:heading-face [:where(&_h4)]:text-reading [:where(&_h4)]:text-balance [:where(&_h4)]:mt-8",
	"[&_:is(h2,h3,h4)+*]:mt-3 [&>:first-child]:mt-0",
	// Inline
	"[:where(&_a)]:link-underline [:where(&_a)]:outline-none [:where(&_a)]:focus-visible:outline-2 [:where(&_a)]:focus-visible:outline-solid [:where(&_a)]:focus-visible:outline-offset-2 [:where(&_a)]:focus-visible:outline-accent",
	"[:where(&_:is(strong,b))]:font-semibold",
	"[:where(&_:not(pre)>code)]:rounded-code [:where(&_:not(pre)>code)]:border-ui [:where(&_:not(pre)>code)]:border-solid [:where(&_:not(pre)>code)]:border-border [:where(&_:not(pre)>code)]:bg-surface-2 [:where(&_:not(pre)>code)]:px-[0.35em] [:where(&_:not(pre)>code)]:py-[0.1em] [:where(&_:not(pre)>code)]:text-code",
	// Lists
	"[:where(&_:is(ul,ol))]:pl-[1.4em] [:where(&_ul)]:list-disc [:where(&_ol)]:list-decimal [:where(&_:is(li+li,li>ul,li>ol))]:mt-2 [:where(&_li)]:marker:text-muted",
	// Blocks
	"[:where(&_blockquote)]:border-s-quote [:where(&_blockquote)]:border-solid [:where(&_blockquote)]:border-fg [:where(&_blockquote)]:ps-5 [:where(&_blockquote)]:text-lead [:where(&_blockquote)]:text-muted [:where(&_blockquote>*+*)]:mt-3",
	"[:where(&_pre)]:overflow-x-auto [:where(&_pre)]:rounded-code-block [:where(&_pre)]:border-ui [:where(&_pre)]:border-solid [:where(&_pre)]:border-border [:where(&_pre)]:bg-surface-2 [:where(&_pre)]:p-4 [:where(&_pre)]:text-small",
	"[:where(&_:is(img,video))]:h-auto [:where(&_:is(img,video))]:max-w-full [:where(&_:is(img,video))]:rounded-card",
	"[:where(&_figcaption)]:mt-2 [:where(&_figcaption)]:text-small [:where(&_figcaption)]:text-muted",
	"[:where(&_hr)]:my-10 [:where(&_hr)]:border-0 [:where(&_hr)]:border-t-ui [:where(&_hr)]:border-solid [:where(&_hr)]:border-border",
	// Tables
	"[:where(&_table)]:w-full [:where(&_table)]:border-collapse [:where(&_table)]:text-body [:where(&_:is(th,td))]:border-b-ui [:where(&_:is(th,td))]:border-solid [:where(&_:is(th,td))]:border-border [:where(&_:is(th,td))]:px-3 [:where(&_:is(th,td))]:py-2 [:where(&_:is(th,td))]:text-left [:where(&_:is(th,td))]:align-top [:where(&_th)]:font-semibold",
].join(" ");
---

<Tag class={cn(prose, className)} {...rest}>
	<slot />
</Tag>
