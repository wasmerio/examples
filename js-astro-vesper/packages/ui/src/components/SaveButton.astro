---
import type { HTMLAttributes } from "astro/types";
import { buttonOnImage, buttonVariants, focusRing } from "../lib/button";
import { cn } from "../lib/cn";
import Icon from "./Icon.astro";

export interface Props extends Omit<HTMLAttributes<"button">, "id" | "title" | "type" | "aria-pressed" | "hidden"> {
	/** The listing's id: the value kept in the list. */
	id: string;
	/** What is saved, for the button's name: "Save The Tennyson Bungalow". */
	title: string;
	/** The list's name: the storage key is "astronomic:saved:<list>". */
	list?: string;
	/** The surface it sits on: "image" (on a listing's photo) or "page". */
	tone?: "page" | "image";
	class?: string;
}

const { id, title, list = "homes", tone = "image", class: className, ...rest } = Astro.props;
// A toggle (decision 0018): the name stays "Save" plus the title, and aria-pressed says it is saved, so a screen reader
// never hears "Unsave …, pressed". Pressed, the outlined heart fills; its outline keeps the button's text color. On
// the page it fills with the accent, which reads on the surface in every preset and mode. On a photo the disc stays
// light in dark mode, where a light accent would vanish, so the heart fills with the button's own text color (scrim on
// scrim-fg): a solid heart against an outline, at the text's contrast in every preset (the browser tests check both). It renders hidden: lib/saved.ts shows it once it can work, so with no
// script there is no button that does nothing. A 44px circle. On a photo it takes the on-image colors (buttonOnImage's
// primary: a scrim-fg disc with scrim text, which reads on any picture) and carries the on-image ring itself (the
// ring focus-on-image gives the controls inside it: a scrim-fg outline over a 6px scrim ring), so it needs no
// wrapper. The script binds every Save button on the page once, with one click listener on the document, so buttons
// in cards a search adds later work too.
const tones = {
	image: cn(
		buttonOnImage.primary,
		"outline-none focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-2 focus-visible:outline-scrim-fg focus-visible:ring-6 focus-visible:ring-scrim",
	),
	page: cn(buttonVariants.secondary, focusRing),
};
const hearts = { image: "group-aria-pressed:fill-current", page: "group-aria-pressed:fill-accent" };
---

<button
	type="button"
	data-save-button
	data-save-id={id}
	data-save-list={list}
	aria-pressed="false"
	hidden
	class={cn(
		"group inline-grid size-11 shrink-0 cursor-pointer place-items-center rounded-full border-button border-solid p-0",
		"motion-ok:transition-[background-color,border-color,color] motion-ok:duration-150",
		tones[tone],
		className,
	)}
	{...rest}
>
	<Icon size="md">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" class={hearts[tone]}>
			<path d="M12 20.5s-7.5-4.6-9.2-9.4C1.7 7.9 3.6 4.5 7 4.5c2.1 0 3.6 1.2 5 3 1.4-1.8 2.9-3 5-3 3.4 0 5.3 3.4 4.2 6.6-1.7 4.8-9.2 9.4-9.2 9.4Z" />
		</svg>
	</Icon>
	<span class="sr-only" data-save-name>Save {title}</span>
</button>

<script>
	import { start } from "../lib/saved";

	start(document, window);
</script>
