---
import { buttonClasses, touchBox } from "../lib/button";
import { cn, cx } from "../lib/cn";
import { iconClasses } from "../lib/icon";

export interface Props {
	/** The index its dialog searches. Default: the site's default index. */
	index?: string;
	/** The types its dialog shows. Default: every type of the index. */
	types?: string[] | string;
	/** Its dialog's grouping: "type", a facet name, or false. Must match a Search dialog on the page. */
	group?: string | false;
	/** Where the link goes with no JavaScript, and where "See all results" goes. Default: /search under the base. */
	href?: string;
	/** The page's main search button: the shortcut opens its dialog and focus returns to it. Default: the first. */
	main?: boolean;
	/** The icon-only button's accessible name. Default: "Search". Not used with `openText`, whose words name it. */
	label?: string;
	/** Visible words, such as "Search the docs": the button draws as a field with the icon, the words and a key hint. */
	openText?: string;
	/** The surface it sits on: `page` (default) or `band`, an optional band such as the Navbar's bar. */
	tone?: "page" | "band";
	/** Classes for the link. */
	class?: string;
}

const { index, types, group, href: own, main = false, label = "Search", openText, tone = "page", class: className } = Astro.props;

// The Search family's button (decision 0013): a real link to the search page, so it works with no JavaScript. The
// Search shell's script makes it the button that opens the dialog with the same index, types and group
// (data-search-ui="kit": the search package's own boot leaves it alone), and loads the search on hover, focus or the
// first click. Icon only, named by `label`; with `openText` a field-style button whose words name it, with the
// shortcut's key hint at the end ("⌘K" or "Ctrl K", aria-hidden: the script writes it, on the main button only).
// Both looks keep a 44px box on a touch screen. Under Astro's ClientRouter the search's boot holds the first click in
// the capture phase, before the router's listener, so the click opens the dialog while the search loads; a click with
// a modifier key or the middle button stays a normal link. Without JavaScript, or if the search fails to load, the
// link goes to the search page. data-astro-prefetch="false": a hover or focus loads the search, not the search page,
// which the click never opens (it is the no-JavaScript and failure fallback).
const base = import.meta.env.BASE_URL;
const href = own || `${base.endsWith("/") ? base : `${base}/`}search`;
const typeList = Array.isArray(types) ? types.join(",") : types;
const field = openText !== undefined && openText !== "";
const icon = '<path d="M9 15.5a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM13.75 13.75L17.5 17.5"></path>';
// The field look: the secondary button on the page fill (muted words, surface-2 on hover: both pairs hold 4.5:1), or
// the band's secondary colors on a band; the preset's button weight, case and tracking are set back to plain text.
const fieldLook = cx(buttonClasses({ variant: "secondary", tone }), tone === "band" ? "" : "bg-bg", "justify-start gap-2 ps-3 pe-2 font-normal normal-case tracking-normal");
const words = tone === "band" ? "text-on-band-muted" : "text-muted";
---

<a
	href={href}
	data-search-trigger
	data-search-ui="kit"
	data-search-index={index}
	data-search-types={typeList || undefined}
	data-search-group={group === undefined ? undefined : String(group)}
	data-search-main={main ? "" : undefined}
	data-astro-prefetch="false"
	aria-label={field ? undefined : label}
	class={cn(field ? fieldLook : buttonClasses({ variant: "ghost", icon: true, tone }), touchBox, className)}
>
	<svg class={iconClasses("md")} viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true" set:html={icon} />
	{
		field && (
			<>
				<span data-search-words class={cx("min-w-0 flex-1 truncate text-start", words)}>{openText}</span>
				<kbd data-search-key-hint aria-hidden="true" hidden class="ms-3 rounded-control border-ui border-solid border-current/30 px-1.5 font-body text-small leading-5" />
			</>
		)
	}
</a>
