---
import Search, { type SearchRecipeProps } from "./Search.astro";

export interface Props extends SearchRecipeProps {}

// Recipe A of the Search family (decision 0013): the classic. From a dialog 40rem wide (the search container) the
// panel sits near the top, centered, at most 42rem wide (max-w-2xl), its height following the results up to 80% of
// the screen, on the page fill in the search frame (search-frame in theme.css: a narrow glass ring with a faint
// hairline inside, the card's corners plus the ring, a soft shadow), its footer on the quiet fill (surface-2);
// narrower, it fills the screen. No line is the preset's border; every inner line is the search's hairline (the
// shell's). Results sit under quiet group bands with their counts; a page option shows its breadcrumb,
// title and snippet; its heading options sit indented under it in smaller, muted text (full strength when active), a
// `#` hung before each title, a light rule between page blocks. The active option is the shell's rounded soft fill, no
// edge, kept clear of the band. Only class hooks.
---

<Search
	{...Astro.props}
	panelClass="@min-[40rem]/search:mx-auto @min-[40rem]/search:mt-[10dvh] @min-[40rem]/search:h-auto @min-[40rem]/search:max-h-[80dvh] @min-[40rem]/search:w-[calc(100%-3rem)] @min-[40rem]/search:max-w-2xl @min-[40rem]/search:search-frame"
	footerClass="bg-surface-2"
/>
