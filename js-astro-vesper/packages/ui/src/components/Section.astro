---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import { cn } from "../lib/cn";

export interface Props extends HTMLAttributes<"section"> {
	/** Element to render. */
	as?: HTMLTag;
	/**
	 * The surface the section sits on: `page` (default) or `surface-2`, the light page fill (a band). Text, Buttons
	 * and the focus ring stay the page's on both. For a filled band use `tone`: a fill set through `class` loses its
	 * top padding after another Section.
	 */
	tone?: "page" | "surface-2";
	class?: string;
}

const { as: Tag = "section", tone = "page", class: className, ...rest } = Astro.props;
// A <section> with no name is not a landmark, so a plain Section adds nothing for a screen reader.
// Pass aria-labelledby (the id of its heading) to make it a region landmark.
// Every Section pads by the section role above and below. A page Section right after another page Section drops
// its top padding, so two plain sections sit one section space apart, not two; a band (surface-2) always pads both
// sides, so its fill has room. surface-2 is a page-family fill (decision 0015): its fg, muted and ring pairs are in
// the token manifest (fillPairs), checked in every preset.
---

<Tag
	data-section-tone={tone}
	class={cn("py-section", tone === "surface-2" && "bg-surface-2", tone === "page" && "[[data-section-tone=page]+&]:pt-0", className)}
	{...rest}
><slot /></Tag>
