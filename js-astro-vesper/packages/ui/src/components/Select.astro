---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import { controlClasses } from "../lib/field";
import Icon from "./Icon.astro";

export interface Props extends HTMLAttributes<"select"> {
	/** Marks the value as wrong (aria-invalid) and shows the danger border. */
	invalid?: boolean;
	/** Draws the open list with the kit's look where the browser can (appearance: base-select); elsewhere the browser's own list opens from the same closed field. */
	picker?: boolean;
	/** More classes for the <select>, merged with cn(). */
	class?: string;
}

const { invalid = false, picker = false, class: className, ...rest } = Astro.props;
// A native select with the kit's control look (Input's classes), no native arrow, and a chevron icon that lets clicks
// through to the select. One choice from a short list: the kit never draws a native multiple select (poor on a
// desktop); several choices are checkboxes (FilterChoice's option chips). The options go in the default slot. The
// wrapper is a grid, so the select fills a Field's column. Its attributes come first, then the kit's, so a caller's
// id, name and form read in the order it wrote them.
---

<div class="relative grid">
	<select {...rest} aria-invalid={invalid ? "true" : undefined} class={cn(controlClasses, "h-control", picker ? "select-picker flex items-center" : "appearance-none", "rounded-control ps-3.5 pe-10", className)}>
		<slot />
	</select>
	<Icon size="sm" class="pointer-events-none absolute end-3.5 top-1/2 -translate-y-1/2 text-muted">
		<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6l4 4 4-4" /></svg>
	</Icon>
</div>
