---
import { cn } from "../lib/cn";
import { stretchedLink } from "../lib/card";
import SeriesNav, { type SeriesNavRecipeProps } from "./SeriesNav.astro";

export type { SeriesPart } from "./SeriesNav.astro";

export interface Props extends SeriesNavRecipeProps {}

const props = Astro.props;
// Every part in order, in an <ol>, each row numbered (the number is shown muted and hidden from screen readers: the
// <ol> says it), on hairlines. The current part is text with aria-current="page"; a part with no href (not out yet)
// is muted text; every other title is a stretched link over its whole row (the <li> is relative; the link's ::after
// covers it, with the focus ring inset so the hairlines never cut it), and on a touch screen each row is at least
// 2.75rem tall, so even a one-character title has a 44 × 44px target. A current part is optional, so the same list
// serves a series index page. Only a part's own fields reach the markup.
---

<SeriesNav {...props} listClass={undefined}>
	<ol role="list" class="m-0 grid list-none p-0">
		{
			props.parts.map((part, i) => (
				<li
					value={i + 1}
					class="relative grid grid-cols-[2ch_minmax(0,1fr)] items-baseline gap-2 border-0 border-b-ui border-solid border-border py-3 first:border-t-ui pointer-coarse:min-h-[2.75rem]"
				>
					<span aria-hidden="true" class="text-small text-muted tabular-nums">
						{i + 1}
					</span>
					<span class="grid min-w-0 gap-0.5">
						{part.current ? (
							<span aria-current="page" class="font-medium text-fg text-balance [overflow-wrap:anywhere]">
								{part.title}
							</span>
						) : part.href ? (
							<a href={part.href} class={cn(stretchedLink, "text-fg text-balance [overflow-wrap:anywhere] after:rounded-control focus-visible:after:-outline-offset-2")}>
								{part.title}
							</a>
						) : (
							<span class="text-muted text-balance [overflow-wrap:anywhere]">{part.title}</span>
						)}
						{part.meta && <span class="text-small text-muted">{part.meta}</span>}
					</span>
				</li>
			))
		}
	</ol>
</SeriesNav>
