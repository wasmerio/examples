---
import { focusRing, touchBox } from "../lib/button";
import { cn } from "../lib/cn";
import Icon from "./Icon.astro";
import SeriesNav, { type SeriesNavRecipeProps } from "./SeriesNav.astro";

export type { SeriesPart } from "./SeriesNav.astro";

export interface Props extends SeriesNavRecipeProps {
	/** The previous link's label. Default "Previous part". */
	previousLabel?: string;
	/** The next link's label. Default "Next part". */
	nextLabel?: string;
	/** The link to the series page (href). Default "All parts". Shown only with href. */
	allLabel?: string;
}

const { previousLabel = "Previous part", nextLabel = "Next part", allLabel = "All parts", ...props } = Astro.props;
const at = props.parts.findIndex((p) => p.current);
if (at < 0) throw new Error("SeriesPager: one current part (a pager needs to know where it is)");
// A side shows only when that part is out (has a page).
const previous = at > 0 && props.parts[at - 1].href ? props.parts[at - 1] : undefined;
const next = at < props.parts.length - 1 && props.parts[at + 1].href ? props.parts[at + 1] : undefined;
const box = cn(
	"grid min-w-0 content-start gap-1 rounded-card border-ui border-solid border-border p-item text-fg no-underline hover:bg-surface-2 motion-ok:transition-colors motion-ok:duration-150",
	focusRing,
);
// The part before and the part after this one, as two boxes side by side from a 28rem series nav (@md/series), one
// above the other below; then "All parts" to the series page (a 44px box on a touch screen). Each box is one link: the
// label (small, muted) with an arrow, over the title. A missing side (the first or last part, or one not out yet) is
// left out, and the other keeps its own column: previous at the start, next at the end, its text aligned to its side,
// so the first and last parts look the same in every series. With one part there is no previous or next. Exactly one
// current part is needed.
---

<SeriesNav {...props} listClass={undefined}>
	{
		(previous || next) && (
			<div class="grid gap-item @md/series:grid-cols-2">
				{previous && (
					<a data-pager-prev href={previous.href} class={box}>
						<span class="inline-flex items-center gap-1.5 text-small text-muted">
							<Icon size="sm">
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3 5 8l5 5" /></svg>
							</Icon>
							{previousLabel}
						</span>
						<span class="font-medium text-balance [overflow-wrap:anywhere]">{previous.title}</span>
					</a>
				)}
				{next && (
					<a data-pager-next href={next.href} class={cn(box, "justify-items-end text-end @md/series:col-start-2")}>
						<span class="inline-flex items-center gap-1.5 text-small text-muted">
							{nextLabel}
							<Icon size="sm">
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m6 3 5 5-5 5" /></svg>
							</Icon>
						</span>
						<span class="font-medium text-balance [overflow-wrap:anywhere]">{next.title}</span>
					</a>
				)}
			</div>
		)
	}
	{
		props.href && (
			<p class="m-0 mt-item">
				<a href={props.href} class={cn("link-underline inline-flex items-center rounded-control text-small font-medium", touchBox, focusRing)}>{allLabel}</a>
			</p>
		)
	}
</SeriesNav>
