---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import { cn } from "../lib/cn";
import { layoutGap, type LayoutGap } from "../lib/layout";

export type SplitRatio = "1/1" | "2/1" | "1/2" | "3/2" | "2/3";

export interface Props extends HTMLAttributes<"div"> {
	/** Element to render. */
	as?: HTMLTag;
	/** The widths of the first and second child, side by side. */
	ratio?: SplitRatio;
	/** Puts the second child first when side by side. Stacked, the order stays the source order. */
	reverse?: boolean;
	/** Space between the two children: a spacing role. */
	gap?: LayoutGap;
	class?: string;
}

const { as: Tag = "div", ratio = "1/1", reverse = false, gap = "blocks", class: className, ...rest } = Astro.props;

// Each side grows by its share of the ratio. Class strings are written out in full so Tailwind can find them.
const ratios: Record<SplitRatio, string> = {
	"1/1": "[&>*]:grow",
	"2/1": "[&>:first-child]:grow-2 [&>:last-child]:grow",
	"1/2": "[&>:first-child]:grow [&>:last-child]:grow-2",
	"3/2": "[&>:first-child]:grow-3 [&>:last-child]:grow-2",
	"2/3": "[&>:first-child]:grow-2 [&>:last-child]:grow-3",
};
// Side by side while the Split itself is at least 40rem wide, stacked below that: each child's basis is
// 0 above 40rem and huge below it, so the row wraps. It measures its own width, not the screen's, so no
// media or container query: it is not a @container, and a part inside it keeps measuring its own.
---

<Tag
	class={cn(
		"flex flex-wrap [&>*]:min-w-0 [&>*]:basis-[calc((40rem_-_100%)*999)]",
		reverse && "flex-row-reverse",
		ratios[ratio],
		layoutGap[gap],
		className,
	)}
	{...rest}
>
	<slot />
</Tag>
