---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import { cn } from "../lib/cn";
import { layoutGap, type LayoutGap } from "../lib/layout";

export interface Props extends HTMLAttributes<"div"> {
	/** Element to render. */
	as?: HTMLTag;
	/** Space between children: a spacing role. */
	gap?: LayoutGap;
	class?: string;
}

const { as: Tag = "div", gap = "blocks", class: className, ...rest } = Astro.props;
---

<Tag class={cn("flex flex-col", layoutGap[gap], className)} {...rest}><slot /></Tag>
