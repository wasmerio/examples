---
import Stats, { type StatsRecipeProps } from "./Stats.astro";

export type { StatItem } from "./Stats.astro";

export interface Props extends StatsRecipeProps {}

const props = Astro.props;
// Each stat on a card surface (the Card's padding, edge, corners and shadow), as many columns as fit, each at least
// 12rem (one on a phone, two from a row of about 25rem); auto-fit drops empty columns, so a few cards share one row and
// more wrap (about five fit a 6xl row). The cards sit gap-cards apart (20px by default), as Features' cards. The
// recipe's own props come after the rest, so its layout always wins.
---

<Stats
	{...props}
	align="start"
	contentClass={undefined}
	headerClass={undefined}
	listClass="gap-cards grid-cols-[repeat(auto-fit,minmax(min(100%,12rem),1fr))]"
	itemClass="card-pad rounded-card border-card border-solid border-border bg-surface text-fg shadow-card"
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
</Stats>
