---
import Stats, { type StatsRecipeProps } from "./Stats.astro";

export type { StatItem } from "./Stats.astro";

export interface Props extends StatsRecipeProps {
	/** The header and each stat at the start, or centered. */
	align?: "start" | "center";
}

const { align = "start", ...props } = Astro.props;
// An open grid on the page: a hairline above each stat, as many columns as fit, each at least 9rem (one on a 320px
// phone, two from a row of about 20rem, so from about a 370px phone); auto-fit drops empty columns, so a few stats
// share one row and more wrap (about six fit a 6xl row). The recipe's own props come after the rest, so its layout
// always wins.
---

<Stats
	{...props}
	align={align}
	contentClass={undefined}
	headerClass={undefined}
	listClass="grid-cols-[repeat(auto-fit,minmax(min(100%,9rem),1fr))]"
	itemClass="border-0 border-t-ui border-solid border-border pt-item"
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
</Stats>
