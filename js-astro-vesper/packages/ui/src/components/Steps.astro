---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import type { SectionHeadingTag } from "../lib/heading";
import { uid } from "../lib/id";
import SectionHead from "./SectionHead.astro";

export interface Props extends HTMLAttributes<"section"> {
	/** The section heading. Without it there is no section and no header: a <div> holds only the list. */
	heading?: string;
	/** Turn one *phrase* in the heading into <em> (lib/emphasis.ts). Off by default: the heading shows as typed. */
	emphasis?: boolean;
	/** A short mark after the heading, such as "(12)". Shown beside the heading, outside it, so the heading's name stays plain. Shown only with a heading. */
	mark?: string;
	/** What the mark says to a screen reader, such as "12 projects". Without it, the mark is read as written. */
	markLabel?: string;
	/** One or two sentences under the heading. Shown only with a heading. */
	text?: string;
	/** Heading element. Step titles sit one level under it (childHeadingTag in lib/heading.ts). */
	headingTag?: SectionHeadingTag;
	/** For recipes: the alignment of the header (SectionHead) only; a recipe lays out its own list. */
	align?: "start" | "center";
	/** For recipes: the row that holds the header and the list. */
	contentClass?: string;
	/** For recipes: the header (SectionHead). */
	headerClass?: string;
	/** For recipes: the list of steps, such as its columns. */
	listClass?: string;
	class?: string;
}

/** A recipe's props: the shell's, less the ones that set the layout, which the recipe sets itself. */
export type StepsRecipeProps = Omit<Props, "align" | "contentClass" | "headerClass" | "listClass">;

const { heading, emphasis = false, mark, markLabel, text, headingTag = "h2", align = "start", contentClass, headerClass, listClass, class: className, ...rest } = Astro.props;
const headingId = heading ? uid("steps") : undefined;
const eyebrow = heading && Astro.slots.has("eyebrow") ? (await Astro.slots.render("eyebrow")).trim() : "";
const Root = heading ? "section" : "div";
// The steps family's shell (decisions 0013, 0015): with a heading, the region named by it, then SectionHead and one
// <ol role="list"> (one StepItem <li> each, from the recipe); without one, a plain <div>. A screen reader hears a
// list of N items, in order; each step's large number is hidden from it. The root is a named container (steps) for the
// recipes' columns; the list is inside it, so listClass can query it.
---

<Root aria-labelledby={headingId} class={cn("@container/steps", className)} {...rest}>
	<div data-steps-row class={cn("grid gap-blocks", contentClass)}>
		{
			heading && (
				<SectionHead data-steps-header heading={heading} emphasis={emphasis} mark={mark} markLabel={markLabel} text={text} headingTag={headingTag} id={headingId} align={align} class={headerClass}>
					{eyebrow && <Fragment slot="eyebrow" set:html={eyebrow} />}
				</SectionHead>
			)
		}
		<ol role="list" data-steps-list class={cn("m-0 grid min-w-0 list-none gap-blocks p-0", listClass)}>
			<slot />
		</ol>
	</div>
</Root>
