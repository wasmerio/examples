---
import { childHeadingTag, type ItemHeadingTag } from "../lib/heading";
import StepItemPart, { type StepsItem } from "./StepItem.astro";
import Steps, { type StepsRecipeProps } from "./Steps.astro";

export type { StepsItem } from "./StepItem.astro";

export interface Props extends StepsRecipeProps {
	/** The step title element when there is no heading. With a heading, titles sit one level under it. */
	itemHeadingTag?: ItemHeadingTag;
	items: StepsItem[];
	/** Where each step's meta sits: under the title (below, the default) or above it, as a timing line read first. A step's own metaPlacement wins. */
	metaPlacement?: "below" | "above";
	/** Each step's meta type and color, after its own classes. A step's own metaClass wins. */
	metaClass?: string;
}

const { itemHeadingTag = "h3", items, metaPlacement = "below", metaClass, ...props } = Astro.props;
const tag = childHeadingTag({ heading: props.heading, headingTag: props.headingTag, itemHeadingTag });
// Vertical: one line down the start edge of the list (a hairline on the <ol>, so no pseudo-element and no geometry to
// match), and each step a row beside it: the number in the step role, in the accent, as in StepsColumns, then the
// title, meta and text in a column at the running-text width. The number column is as wide as its number. With
// items-start the top of the number's box meets the top of the title's box (not its first baseline). The number and the
// text, and the steps (the shell's gap), sit a block apart. Only an item's own fields reach the part, so a CMS entry's
// other fields never reach the markup. The recipe's own props come after the rest, so its layout always wins.
---

<Steps
	{...props}
	align="start"
	contentClass={undefined}
	headerClass={undefined}
	listClass="border-0 border-s-ui border-solid border-border ps-blocks"
>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{
		items.map((item, i) => (
			<StepItemPart
				number={i + 1}
				title={item.title}
				meta={item.meta}
				text={item.text}
				headingTag={tag}
				metaPlacement={item.metaPlacement ?? metaPlacement}
				metaClass={item.metaClass ?? metaClass}
				class="grid-cols-[auto_minmax(0,1fr)] items-start gap-blocks"
			/>
		))
	}
</Steps>
