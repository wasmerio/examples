---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import type { SectionHeadingTag } from "../lib/heading";
import { uid } from "../lib/id";
import SectionHead from "./SectionHead.astro";

export interface Props extends HTMLAttributes<"section"> {
	/** The section heading. Without it there is no section and no header: a <div> holds only the people. */
	heading?: string;
	/** Turn one *phrase* in the heading into <em> (lib/emphasis.ts). Off by default: the heading shows as typed. */
	emphasis?: boolean;
	/** A short mark after the heading, such as "(12)". Shown beside the heading, outside it, so the heading's name stays plain. Shown only with a heading. */
	mark?: string;
	/** What the mark says to a screen reader, such as "12 projects". Without it, the mark is read as written. */
	markLabel?: string;
	/** One or two sentences under the heading. Shown only with a heading. */
	text?: string;
	/** Heading element. Each name sits one level under it (childHeadingTag in lib/heading.ts). */
	headingTag?: SectionHeadingTag;
	/** For recipes: the alignment of the header. */
	align?: "start" | "center";
	/** For recipes: the row that holds the header and the people. */
	contentClass?: string;
	/** For recipes: the header (SectionHead). */
	headerClass?: string;
	/** For recipes: the list of people (the <ul>). */
	listClass?: string;
	class?: string;
}

/** A recipe's props: the shell's, less the ones that set the layout, which the recipe sets itself. */
export type TeamRecipeProps = Omit<Props, "align" | "contentClass" | "headerClass" | "listClass">;

const { heading, emphasis = false, mark, markLabel, text, headingTag = "h2", align = "start", contentClass, headerClass, listClass, class: className, ...rest } = Astro.props;
const headingId = heading ? uid("team") : undefined;
const eyebrow = heading && Astro.slots.has("eyebrow") ? (await Astro.slots.render("eyebrow")).trim() : "";
// The people are rendered first, so an empty list (a recipe maps an empty array) counts as none, as in Posts.
const people = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";
const Root = heading ? "section" : "div";
// The team family's shell (decisions 0013, 0015): with a heading, the region named by it, then SectionHead and the
// people; without one, a plain <div>, so a page can put its own heading above it. The people sit in one <ul
// role="list"> (one <li> each, from the recipe), with a neutral base: each recipe sets the columns and gaps. With no
// people the list is left out, so no empty list is announced. The root
// is a named container (team), so the recipes' columns and the split follow the room the section has, not the page.
// SectionHead sits a block above the list.
---

<Root aria-labelledby={headingId} class={cn("@container/team", className)} {...rest}>
	<div data-team-row class={cn("grid gap-blocks", contentClass)}>
		{
			heading && (
				<SectionHead data-team-header heading={heading} emphasis={emphasis} mark={mark} markLabel={markLabel} text={text} headingTag={headingTag} id={headingId} align={align} class={headerClass}>
					{eyebrow && <Fragment slot="eyebrow" set:html={eyebrow} />}
				</SectionHead>
			)
		}
		{people && <ul role="list" data-team-list class={cn("m-0 grid min-w-0 list-none p-0", listClass)} set:html={people} />}
	</div>
</Root>
