---
import { childHeadingTag, type ItemHeadingTag } from "../lib/heading";
import { gridImageSizes, type ImageComponent } from "../lib/image";
import Team, { type TeamRecipeProps } from "./Team.astro";
import TeamMember, { type TeamMemberItem } from "./TeamMember.astro";

export type { TeamMemberItem } from "./TeamMember.astro";

export interface Props extends TeamRecipeProps {
	/** The name element when there is no heading. With a heading, names sit one level under it. */
	itemHeadingTag?: ItemHeadingTag;
	/** The people, in order. The quote field is not shown here (TeamSpotlight shows it). */
	items: TeamMemberItem[];
	/** Your image component, for every photo (Media's imageComponent): Astro's <Image>, or a small wrapper for your CMS. */
	imageComponent?: ImageComponent;
}

const { itemHeadingTag = "h3", items, imageComponent, ...props } = Astro.props;
const sizes = gridImageSizes(items.length);
const tag = childHeadingTag({ heading: props.heading, headingTag: props.headingTag, itemHeadingTag });
// People on the open page, each a large photo over the name and role: as many columns as fit, each at least 18rem
// (auto-fit). At 320px inside the usual padding, one column (the min() lets it shrink to the row); at 390, still one
// (342px); two from about 37rem (a tablet's row), and three from about 57rem (a 7xl page row holds three), so six people make two full rows of large
// photos. One or two people stretch to fill the row, so a small team does not leave a ragged end. The people are a
// cards gap apart across and a block apart down (the names under one row and the photos of the next need air). Only
// a person's own fields reach the part. Your image component, if given, draws every photo, with the grid's sizes hint
// for the number of items (gridImageSizes). The recipe's own props come after the rest, so its layout always wins.
---

<Team {...props} align="start" contentClass={undefined} headerClass={undefined} listClass="grid-cols-[repeat(auto-fit,minmax(min(100%,18rem),1fr))] gap-x-cards gap-y-blocks">
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{
		items.map((person) => (
			<li class="grid min-w-0">
				<TeamMember name={person.name} role={person.role} href={person.href} image={person.image} bio={person.bio} links={person.links} imageComponent={imageComponent} imageSizes={sizes} headingTag={tag} />
			</li>
		))
	}
</Team>
