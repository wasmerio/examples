---
import { childHeadingTag, type ItemHeadingTag } from "../lib/heading";
import Team, { type TeamRecipeProps } from "./Team.astro";
import TeamMember, { type TeamMemberItem } from "./TeamMember.astro";

export type { TeamMemberItem } from "./TeamMember.astro";

export interface Props extends TeamRecipeProps {
	/** The name element when there is no heading. With a heading, names sit one level under it. */
	itemHeadingTag?: ItemHeadingTag;
	/** The people, in order. Only the name, role, photo and links show here (a compact list); bio and quote do not. */
	items: TeamMemberItem[];
}

const { itemHeadingTag = "h3", items, ...props } = Astro.props;
const tag = childHeadingTag({ heading: props.heading, headingTag: props.headingTag, itemHeadingTag });
// From a 48rem team container: the header in a start column, the people in the end column, a group gap between.
// Below 48rem stacked, the header first. With no heading there is no header, so the people take the whole row. The
// people: one per row in a narrow box, each an Avatar beside the name and role, and two columns once the list has
// about 28rem. A container query never reads the element that is the container, so the list's columns read the team
// container: stacked (or with no header), the list is the whole row, so two columns from a 28rem team; side by side,
// the end column is 1.5/2.5 of the row less the gap, so from 48rem one column again and two from 56rem (an end column
// of about 31rem). items-start keeps the header at the top of its column. Only a person's own fields reach the part;
// no bio (a compact list).
const contentClass = props.heading ? "@3xl/team:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] @3xl/team:items-start @3xl/team:gap-x-group" : undefined;
const listClass = props.heading ? "gap-x-cards gap-y-item @md/team:grid-cols-2 @3xl/team:grid-cols-1 @4xl/team:grid-cols-2" : "gap-x-cards gap-y-item @md/team:grid-cols-2";
---

<Team {...props} align="start" contentClass={contentClass} headerClass={undefined} listClass={listClass}>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{
		items.map((person) => (
			<li class="grid min-w-0">
				<TeamMember variant="avatar" name={person.name} role={person.role} href={person.href} image={person.image} bio={undefined} links={person.links} headingTag={tag} />
			</li>
		))
	}
</Team>
