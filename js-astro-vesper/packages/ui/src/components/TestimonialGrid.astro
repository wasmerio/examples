---
import { cn } from "../lib/cn";
import { childHeadingTag, type ItemHeadingTag } from "../lib/heading";
import Card from "./Card.astro";
import Testimonial, { type TestimonialItem } from "./Testimonial.astro";
import Testimonials, { type TestimonialsRecipeProps } from "./Testimonials.astro";

export type { TestimonialItem } from "./Testimonial.astro";

export interface Props extends TestimonialsRecipeProps {
	/** The title element when there is no heading. With a heading, titles sit one level under it. */
	itemHeadingTag?: ItemHeadingTag;
	items: TestimonialItem[];
	/** For recipes: each card (the Card box), merged after the kit's classes, such as its own fill. */
	itemClass?: string;
}

const { itemHeadingTag = "h3", items, itemClass, ...props } = Astro.props;
const tag = childHeadingTag({ heading: props.heading, headingTag: props.headingTag, itemHeadingTag });
// The default slot is each card's head line (Testimonial's head slot: stars, a source), rendered once per card. As a
// function child, `{(item: YourItem, index) => …}`, it gets that card's item as passed, with all its fields
// (a rating, a link), and its index; only the quote's own fields reach the markup below. Plain content shows the same in every card. Astro passes arguments only to a function
// that is the default slot itself (a function inside <Fragment slot="head"> would run with none), hence the default
// slot. A card whose head renders empty has no head box.
const heads = Astro.slots.has("default") ? await Promise.all(items.map((item, i) => Astro.slots.render("default", [item, i]))) : [];
// Each quote on a Card, in the lead role and the body face at its normal weight, so the title (display type) leads the
// card; the quote above its caption: as many columns as fit, each at least 18rem, so one on a phone and more as the
// container widens (four from about 76rem). A card fills its row's height, so a row of cards lines up. The figure is a
// column that takes the card's free height, with the caption pushed to its bottom edge, so the people in a row line up,
// however long each quote is. The cards sit gap-cards apart (20px by default), as Features' cards. Only the quote's own
// fields reach the part, so a CMS entry's other fields never land on the figure. The recipe's own props come after the
// rest, so its layout always wins.
---

<Testimonials {...props} align="start" list contentClass={undefined} headerClass={undefined} listClass="gap-cards grid-cols-[repeat(auto-fit,minmax(min(100%,18rem),1fr))]">
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	{
		items.map(({ quote, name, role, company, meta, avatar, title }, i) => (
			<li class="grid min-w-0">
				<Card class={cn("h-full", itemClass)}>
					<Testimonial quote={quote} name={name} role={role} company={company} meta={meta} avatar={avatar} title={title} headingTag={tag} class="flex grow flex-col gap-item" quoteClass="text-lead text-pretty">
						{heads[i]?.trim() && <Fragment slot="head" set:html={heads[i]} />}
					</Testimonial>
				</Card>
			</li>
		))
	}
</Testimonials>
