---
import { displayType } from "../lib/display";
import { childHeadingTag, type ItemHeadingTag } from "../lib/heading";
import type { UiImage } from "../lib/image";
import Testimonial from "./Testimonial.astro";
import Testimonials, { type TestimonialsRecipeProps } from "./Testimonials.astro";

// The quote's fields are written out here, not taken from TestimonialItem: the props parser reads one base (the
// shell's recipe props), so a second base would drop quote and name from the props table.
export interface Props extends Omit<TestimonialsRecipeProps, "role" | "title"> {
	/** Plain text. */
	quote: string;
	/** Turn one *phrase* in the heading, and one in the quote, into <em> (lib/emphasis.ts). Off by default: both show as typed. */
	emphasis?: boolean;
	name: string;
	role?: string;
	company?: string;
	/** Short facts about the person, in place of role and company, such as ["Oak Park", "Lawn care"]: joined with a dot. */
	meta?: string[];
	/** Photo of the person. Without it, initials show. `false` hides the avatar. */
	avatar?: UiImage | false;
	/** A short title above the quote. */
	title?: string;
	/** The quote and its header at the start, or centered. */
	align?: "start" | "center";
	/** The title element when there is no heading. With a heading, the title sits one level under it. */
	itemHeadingTag?: ItemHeadingTag;
}

const { quote, emphasis = false, name, role, company, meta, avatar, title, align = "start", itemHeadingTag = "h3", tone = "page", ...props } = Astro.props;
const tag = childHeadingTag({ heading: props.heading, headingTag: props.headingTag, itemHeadingTag });
// One large quote on the open page: the quote in the quote role and display type (sized to the testimonials container,
// below the title role, so it never outweighs a section heading), at the narrow lead width, then the person. One quote
// is not a list, so it sits in a plain box. align moves the header, the quote and the caption together. The recipe's
// own props come after the rest, so its layout always wins.
---

<Testimonials {...props} tone={tone} emphasis={emphasis} align={align} list={false} contentClass={undefined} headerClass={undefined} listClass={undefined}>
	{Astro.slots.has("eyebrow") && <Fragment slot="eyebrow"><slot name="eyebrow" /></Fragment>}
	<Testimonial quote={quote} emphasis={emphasis} name={name} role={role} company={company} meta={meta} avatar={avatar} title={title} headingTag={tag} align={align} tone={tone} quoteClass={`text-quote ${displayType}`}>
		{Astro.slots.has("head") && <Fragment slot="head"><slot name="head" /></Fragment>}
		{Astro.slots.has("avatar") && <Fragment slot="avatar"><slot name="avatar" /></Fragment>}
		{Astro.slots.has("logo") && <Fragment slot="logo"><slot name="logo" /></Fragment>}
	</Testimonial>
</Testimonials>
