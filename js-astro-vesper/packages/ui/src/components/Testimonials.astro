---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import type { SectionHeadingTag } from "../lib/heading";
import { uid } from "../lib/id";
import SectionHead from "./SectionHead.astro";

export interface Props extends HTMLAttributes<"section"> {
	/** The section heading. Without it there is no section and no header: a <div> holds only the quotes. */
	heading?: string;
	/** Turn one *phrase* in the heading into <em> (lib/emphasis.ts). Off by default: the heading shows as typed. */
	emphasis?: boolean;
	/** A short mark after the heading, such as "(12)". Shown beside the heading, outside it, so the heading's name stays plain. Shown only with a heading. */
	mark?: string;
	/** What the mark says to a screen reader, such as "12 projects". Without it, the mark is read as written. */
	markLabel?: string;
	/** One or two sentences under the heading. Shown only with a heading. */
	text?: string;
	/** Heading element. A quote's title sits one level under it (childHeadingTag in lib/heading.ts). */
	headingTag?: SectionHeadingTag;
	/**
	 * page (default): the page's colors. inverse: on the inverse surface (Panel tone="inverse"): the heading, lead,
	 * names and bylines in its colors, and its focus ring.
	 */
	tone?: "page" | "inverse";
	/** For recipes: the alignment of the header. */
	align?: "start" | "center";
	/** For recipes: the quotes sit in one <ul role="list">; false for one quote, in a plain <div>. */
	list?: boolean;
	/** For recipes: the row that holds the header and the quotes. */
	contentClass?: string;
	/** For recipes: the header (SectionHead). */
	headerClass?: string;
	/** For recipes: the box that holds the quotes. */
	listClass?: string;
	class?: string;
}

/** A recipe's props: the shell's, less the ones that set the layout, which the recipe sets itself. */
export type TestimonialsRecipeProps = Omit<Props, "align" | "list" | "contentClass" | "headerClass" | "listClass">;

const { heading, emphasis = false, mark, markLabel, text, headingTag = "h2", tone = "page", align = "start", list = true, contentClass, headerClass, listClass, class: className, ...rest } = Astro.props;
const headingId = heading ? uid("testimonials") : undefined;
const eyebrow = heading && Astro.slots.has("eyebrow") ? (await Astro.slots.render("eyebrow")).trim() : "";
const Root = heading ? "section" : "div";
const inverse = tone === "inverse";
const List = list ? "ul" : "div";
// The testimonials family's shell (decisions 0013, 0015): with a heading, the region named by it, then SectionHead and
// the quotes; without one, a plain <div>, so a page can put its own heading above it. The quotes sit in one <ul
// role="list"> (one <li> each, from the recipe), or, for one quote, in a plain box. The root is a named container
// (testimonials): the quote's type role and the recipes' columns follow the room it has, not the page. The quotes are
// never the container, so listClass can query it. The list base is neutral: each recipe sets its own gap
// (TestimonialGrid's gap-cards between cards, as Features'). Under tone="inverse" the header names the inverse
// surface's colors and the root carries its focus ring; the quotes take the tone from the recipe.
---

<Root aria-labelledby={headingId} class={cn("@container/testimonials", inverse && "focus-on-inverse", className)} {...rest}>
	<div data-testimonials-row class={cn("grid gap-blocks", contentClass)}>
		{
			heading && (
				<SectionHead data-testimonials-header heading={heading} emphasis={emphasis} mark={mark} markLabel={markLabel} markClass={inverse ? "text-on-inverse-muted" : undefined} text={text} headingTag={headingTag} id={headingId} align={align} class={headerClass} headingClass={inverse ? "text-on-inverse" : undefined} leadClass={inverse ? "text-on-inverse-muted" : undefined}>
					{eyebrow && <Fragment slot="eyebrow" set:html={eyebrow} />}
				</SectionHead>
			)
		}
		<List role={list ? "list" : undefined} data-testimonials-list class={cn("m-0 grid min-w-0 list-none p-0", listClass)}>
			<slot />
		</List>
	</div>
</Root>
