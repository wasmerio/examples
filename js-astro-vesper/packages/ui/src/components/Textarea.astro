---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/cn";
import { controlClasses } from "../lib/field";

export interface Props extends HTMLAttributes<"textarea"> {
	/** Marks the value as wrong (aria-invalid) and shows the danger border. */
	invalid?: boolean;
	/** Initial text. */
	value?: string;
	class?: string;
}

const { rows = 5, invalid = false, value, class: className, ...rest } = Astro.props;
---

<textarea
	rows={rows}
	aria-invalid={invalid ? "true" : undefined}
	class={cn(
		controlClasses,
		// Two and a half control heights tall at least. Pill-shaped presets would clip a multi-line box, so the corner
		// (rounded-textarea) is capped at the card radius.
		"min-h-textarea resize-y rounded-textarea px-3.5 py-2.5",
		className,
	)}
	{...rest}
>{value}</textarea>
