---
/**
 * The shell of every design system page: the theme layout, a sub-nav, the
 * light and dark switch, the title and an intro, then the page itself.
 */
/// <reference path="./virtual.d.ts" />
import { Layout, settings } from "virtual:astronomic-system";
import FilterNav from "../components/FilterNav.astro";
import { cn } from "../lib/cn";
import { displayType } from "../lib/display";
import { systemHref } from "./paths.mjs";

export type SystemPageId = "" | "foundations" | "components" | "sections";

interface Props {
	title: string;
	intro: string;
	current: SystemPageId;
}

const { title, intro, current } = Astro.props;
const base = import.meta.env.BASE_URL;

const pages: { id: SystemPageId; label: string }[] = [
	{ id: "", label: "Overview" },
	{ id: "foundations", label: "Foundations" },
	{ id: "components", label: "Components" },
	{ id: "sections", label: "Sections" },
];
const nav = pages.map((page) => ({
	label: page.label,
	href: systemHref(base, settings.route, page.id),
	current: page.id === current,
}));
const modes = [
	{ id: "system", label: "System" },
	{ id: "light", label: "Light" },
	{ id: "dark", label: "Dark" },
];

// The checked mode is ink (fg and bg swapped), not accent.
const segment = cn(
	"relative inline-flex h-[calc(var(--ui-control-h)-8px)] cursor-pointer items-center rounded-control px-3 text-[0.875rem] leading-none text-muted",
	"transition-colors duration-150 hover:text-fg motion-reduce:transition-none",
	"has-checked:bg-fg has-checked:text-bg",
	"has-focus-visible:outline-2 has-focus-visible:outline-solid has-focus-visible:outline-offset-2 has-focus-visible:outline-accent",
);
const pageTitle = current ? `${title} · ${settings.name} design system` : `${settings.name} design system`;
---

<Layout title={pageTitle}>
	<!-- Apply the saved mode before the page paints. -->
	<script is:inline>
		try {
			const mode = localStorage.getItem("aui-theme");
			if (mode === "light" || mode === "dark") document.documentElement.dataset.theme = mode;
		} catch {}
	</script>
	<div data-system-page={current || "overview"} class="grid gap-12 pt-12 font-body text-fg md:pt-20">
		<header class="grid gap-8">
			<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
				<FilterNav items={nav} label={`${settings.name} design system`} />
				<fieldset data-system-mode class="m-0 flex items-center gap-2 border-0 p-0">
					<legend class="sr-only">Color mode</legend>
					<span class="text-[0.875rem] text-muted" aria-hidden="true">Mode</span>
					<div class="inline-flex gap-0.5 rounded-control border-ui border-solid border-border bg-surface p-0.5">
						{
							modes.map((mode) => (
								<label class={segment}>
									<input type="radio" name="system-mode" value={mode.id} class="sr-only" checked={mode.id === "system"} />
									{mode.label}
								</label>
							))
						}
					</div>
				</fieldset>
			</div>
			<div class="grid gap-4">
				<p class="m-0 text-[0.875rem] text-muted">{settings.name} design system</p>
				<h1 class={cn("m-0 text-[clamp(2.25rem,5vw,4.25rem)] leading-[1.02] text-balance", displayType)}>{title}</h1>
				<p class="m-0 max-w-[60ch] text-[1.125rem] text-muted">{intro}</p>
			</div>
		</header>
		<slot />
	</div>
</Layout>

<script>
	import "./mode.ts";
</script>
