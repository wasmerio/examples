---
/** /system/components: every shared component, with its states and variants. */
import ComponentSamples from "../samples/ComponentSamples.astro";
import { contents } from "../samples/catalog";
import SystemPage from "../SystemPage.astro";

const link =
	"rounded-control text-fg underline decoration-border decoration-ui underline-offset-[0.2em] transition-[text-decoration-color] duration-150 hover:decoration-fg focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none";
---

<SystemPage title="Components" intro="Every shared component, with its states and variants, and when to use it." current="components">
	<div class="grid gap-20">
		<nav aria-labelledby="sys-contents-h" class="grid gap-3">
			<p id="sys-contents-h" class="m-0 text-[0.875rem] font-semibold">On this page</p>
			<ul role="list" class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,9rem),1fr))] gap-x-6 gap-y-2 p-0 text-[0.9375rem]">
				{
					contents.map((item) => (
						<li>
							<a href={item.href} class={link}>
								{item.name}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<ComponentSamples />
	</div>
</SystemPage>
