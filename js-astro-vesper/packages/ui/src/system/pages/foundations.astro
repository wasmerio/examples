---
/**
 * /system/foundations: colors, type, prose, spacing and shape, the theme's
 * own tokens and extras. Values are filled in live by foundations.ts.
 */
/// <reference path="../virtual.d.ts" />
import { Extras, settings } from "virtual:astronomic-system";
import { cn } from "../../lib/cn";
import { displayType } from "../../lib/display";
import ProseSample from "../samples/ProseSample.astro";
import SystemPage from "../SystemPage.astro";
import { tokens } from "../tokens";

const colours = tokens.filter((t) => t.category === "colour");
const typeValues = ["--ui-display-weight", "--ui-display-track", "--ui-display-stretch", "--ui-display-case"];
const buttonValues = ["--ui-button-weight", "--ui-button-track", "--ui-button-case"];
const steps = [1, 2, 3, 4, 6, 8, 12, 16];
// Type and spacing roles (decision 0013), from the manifest. Class strings written out in full so Tailwind finds them.
const typeRoles: Record<string, string> = {
	"--ui-type-display": "text-display",
	"--ui-type-display-split": "text-display-split",
	"--ui-type-title": "text-title",
	"--ui-type-section": "text-section",
	"--ui-type-stat": "text-stat",
	"--ui-type-step": "text-step",
	"--ui-type-price": "text-price",
	"--ui-type-quote": "text-quote",
	"--ui-type-subhead": "text-subhead",
	"--ui-type-heading": "text-heading",
	"--ui-type-lead": "text-lead",
	"--ui-type-reading": "text-reading",
	"--ui-type-body": "text-body",
	"--ui-type-small": "text-small",
	"--ui-type-eyebrow": "text-eyebrow",
};
const roleTokens = tokens.filter((t) => t.name in typeRoles);
const spaceRoles = tokens.filter((t) => t.name.startsWith("--ui-space-"));
// Shape tokens, each drawn in a frame of the same height so the row lines up.
const shapes: { name: string; sample: string; utility?: string; use?: string }[] = [
	{ name: "--ui-radius-control", sample: "control", utility: "rounded-control" },
	{ name: "--ui-radius-card", sample: "card", utility: "rounded-card" },
	{ name: "--ui-border-w", sample: "border" },
	{ name: "--ui-button-border-w", sample: "button-border", use: "Button border width (optional, falls back to --ui-border-w)" },
	{ name: "--ui-shadow", sample: "shadow", utility: "shadow-card" },
	{ name: "--ui-control-h", sample: "height", use: "Control height" },
	{ name: "--ui-space", sample: "space", use: "The spacing unit" },
];

const sectionClass = "grid gap-8 border-t-ui border-solid border-fg pt-4";
const h2 = cn("m-0 text-[clamp(1.6rem,3.2vw,2.6rem)] leading-[1.05]", displayType);
const h3 = "m-0 text-[0.875rem] font-semibold";
const value = "font-mono text-[0.8125rem] text-muted [overflow-wrap:anywhere]";
---

<SystemPage
	title="Foundations"
	intro="The tokens behind the theme. Values are read live from the page, so they change with the mode and with your edits."
	current="foundations"
>
	<div class="grid gap-20">
		<section aria-labelledby="sys-colour" class={sectionClass}>
			<h2 id="sys-colour" class={h2}>Color</h2>
			<ul role="list" class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,13rem),1fr))] gap-x-6 gap-y-6 p-0 sm:gap-y-10">
				{
					colours.map((t) => (
						<li data-token={t.name} data-on={t.on} data-on-image={t.onImage ? "" : undefined} data-target={t.target} data-note={t.note} class="grid content-start gap-4 max-sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:gap-3">
							{t.swatch === false ? (
								<div aria-hidden="true" class="grid h-16 place-items-center rounded-card border-ui border-dashed border-border font-mono text-muted max-sm:h-auto max-sm:aspect-square">
									%
								</div>
							) : (
								<div
									class="h-16 rounded-card border-ui border-solid border-border text-accent-fg max-sm:h-auto max-sm:aspect-square"
									style={`background: var(${t.name}${t.fallback ? `, ${t.fallback}` : ""})`}
								/>
							)}
							<div class="grid gap-1 text-[0.9375rem]">
								<code class="font-mono text-[0.875rem] font-semibold">{t.name}</code>
								{t.utility && <code class={value}>{t.utility}</code>}
								<span class="text-muted">{t.use}</span>
								<span data-value class={value} />
								{t.on && <span data-contrast class="text-[0.875rem]" />}
							</div>
						</li>
					))
				}
			</ul>
		</section>

		<section aria-labelledby="sys-type" class={sectionClass}>
			<h2 id="sys-type" class={h2}>Type</h2>
			<div class="grid gap-10">
				<div class="grid gap-4 md:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] md:gap-10">
					<div class="grid content-start gap-2">
						<h3 class={h3}>Display</h3>
						<dl class="m-0 grid gap-1">
							{
								["--ui-font-display", ...typeValues].map((name) => (
									<div data-token={name} class="grid gap-0.5">
										<dt class="font-mono text-[0.8125rem]">{name}</dt>
										<dd data-value class={cn("m-0", value)} />
									</div>
								))
							}
						</dl>
					</div>
					<p class={cn("m-0 text-[clamp(2.25rem,6vw,4.5rem)] leading-[1] text-balance", displayType)}>Work that says what it does</p>
				</div>
				<div class="grid gap-4">
					<h3 class={h3}>Type roles <span class="font-normal text-muted">(display and title are times <code class="font-mono">--ui-display-scale</code>)</span></h3>
					<ul role="list" class="m-0 grid list-none gap-6 p-0">
						{
							roleTokens.map((t) => (
								<li data-token={t.name} class="grid items-baseline gap-2 md:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] md:gap-10">
									<div class="grid gap-0.5">
										<code class="font-mono text-[0.8125rem] font-semibold">{t.utility}</code>
										<span data-value class={value} />
									</div>
									<p class={cn("m-0 min-w-0 text-pretty", typeRoles[t.name], t.name === "--ui-type-display" || t.name === "--ui-type-display-split" || t.name === "--ui-type-title" || t.name === "--ui-type-section" || t.name === "--ui-type-stat" || t.name === "--ui-type-step" || t.name === "--ui-type-quote" || t.name === "--ui-type-price" ? displayType : "font-body")}>{t.use}</p>
								</li>
							))
						}
					</ul>
				</div>
				<div class="grid gap-4 md:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] md:gap-10">
					<div class="grid content-start gap-2">
						<h3 class={h3}>Body</h3>
						<dl class="m-0 grid gap-1">
							{
								["--ui-font-body", ...buttonValues].map((name) => (
									<div data-token={name} class="grid gap-0.5">
										<dt class="font-mono text-[0.8125rem]">{name}</dt>
										<dd data-value class={cn("m-0", value)} />
									</div>
								))
							}
						</dl>
					</div>
					<p class="m-0 max-w-[65ch] font-body text-[1.125rem] leading-[1.55]">
						Body text sets the pace of a page. It should read easily at length, hold a steady rhythm, and step back so
						the work and the headings can lead. This line runs long on purpose, so you can judge the measure.
					</p>
				</div>
			</div>
		</section>

		<section aria-labelledby="sys-prose" class={sectionClass}>
			<h2 id="sys-prose" class={h2}>Prose</h2>
			<ProseSample headingTag="h3" />
		</section>

		<section aria-labelledby="sys-space" class={sectionClass}>
			<h2 id="sys-space" class={h2}>Spacing and shape</h2>
			<div class="grid gap-12">
				<div class="grid gap-4">
					<h3 class={h3}>Spacing steps <span class="font-normal text-muted">(multiples of <code class="font-mono">--ui-space</code>)</span></h3>
					<ul role="list" class="m-0 grid max-w-xl list-none gap-3 p-0">
						{
							steps.map((n) => (
								<li data-measure class="grid grid-cols-[2rem_4.5rem_minmax(0,1fr)] items-center gap-4">
									<span class="font-mono text-[0.8125rem]">{n}</span>
									<span data-value class={value} />
									<span data-bar class="block h-3 max-w-full bg-fg" style={`width: calc(var(--ui-space) * ${n})`} />
								</li>
							))
						}
					</ul>
				</div>

				<div class="grid gap-4">
					<h3 class={h3}>Spacing roles <span class="font-normal text-muted">(py-section, gap-blocks, gap-item and every other spacing class)</span></h3>
					<ul role="list" class="m-0 grid max-w-xl list-none gap-3 p-0">
						{
							spaceRoles.map((t) => (
								<li data-measure class="grid grid-cols-[8rem_4.5rem_minmax(0,1fr)] items-center gap-4">
									<code class="font-mono text-[0.8125rem]">{t.name.replace("--ui-space-", "")}</code>
									<span data-value class={value} />
									<span data-bar class="block h-3 max-w-full bg-fg" style={`width: var(${t.name}${t.fallback ? `, ${t.fallback}` : ""})`} />
								</li>
							))
						}
					</ul>
				</div>

				<ul role="list" class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,10rem),1fr))] gap-x-4 gap-y-10 p-0 sm:gap-x-6">
					{
						shapes.map((t) => (
							<li data-token={t.name} class="grid content-start gap-3">
								<div class="flex h-24 items-end" aria-hidden="true">
									{t.sample === "control" && <div class="h-control w-full rounded-control border-ui border-solid border-fg" />}
									{t.sample === "card" && <div class="size-full rounded-card border-ui border-solid border-fg" />}
									{t.sample === "border" && <div class="w-full border-t-ui border-solid border-fg" />}
									{t.sample === "button-border" && <div class="w-full border-t-[length:var(--ui-button-border-w,var(--ui-border-w))] border-solid border-fg" />}
									{t.sample === "shadow" && <div class="size-full rounded-card bg-surface shadow-card" />}
									{t.sample === "height" && <div class="h-control w-full rounded-control bg-surface-2" />}
									{t.sample === "space" && <div class="size-(--ui-space) bg-fg" />}
								</div>
								<div class="grid gap-1">
									<code class="font-mono text-[0.875rem] font-semibold [overflow-wrap:anywhere]">{t.name}</code>
									{t.utility && <code class={value}>{t.utility}</code>}
									{t.use && <span class="text-[0.875rem] text-muted">{t.use}</span>}
									<span data-value class={value} />
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section aria-labelledby="sys-theme-tokens" class={sectionClass}>
			<h2 id="sys-theme-tokens" class={h2}>Theme tokens</h2>
			{
				settings.tokens.length ? (
					<div class="grid gap-4">
						<p class="m-0 max-w-[60ch] text-muted">
							Custom properties on <code class="font-mono">:root</code> that start with {settings.tokens.map((p, i) => (
								<>
									{i > 0 && ", "}
									<code class="font-mono">{p}</code>
								</>
							))}.
						</p>
						<div class="max-w-full overflow-x-auto">
							<table data-theme-tokens={JSON.stringify(settings.tokens)} class="w-full border-collapse text-left text-[0.9375rem]">
								<thead>
									<tr class="border-b-ui border-solid border-fg">
										<th scope="col" class="py-2 pr-6 font-semibold">Name</th>
										<th scope="col" class="py-2 font-semibold">Value</th>
									</tr>
								</thead>
								<tbody />
							</table>
						</div>
					</div>
				) : (
					<p class="m-0 text-muted">This theme lists no token prefixes. Set <code>tokens</code> in <code>astronomicSystem()</code> to show its own tokens here.</p>
				)
			}
		</section>

		<section aria-labelledby="sys-extras" class={sectionClass}>
			<h2 id="sys-extras" class={h2}>Theme extras</h2>
			<Extras />
		</section>
	</div>
</SystemPage>

<script>
	import "../foundations.ts";
</script>
