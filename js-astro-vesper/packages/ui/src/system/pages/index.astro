---
/**
 * /system: the overview. First every screen the theme lists in its screens
 * file, each as a live, scaled-down preview of the real page; then links to
 * the other design system pages.
 *
 * A preview is a desktop-width iframe shown at a quarter of its size: the
 * frame is 400% of its box, then scaled to 25%. So it always fills the card,
 * at any card width, and its own viewport stays desktop-wide (four times the
 * card). The frame is hidden from assistive tech and the tab order; the
 * screen's link is the way in.
 */
/// <reference path="../virtual.d.ts" />
import { screens as list, settings } from "virtual:astronomic-system";
import { focusRing } from "../../lib/button";
import { cn } from "../../lib/cn";
import { displayType } from "../../lib/display";
import { screenHref, systemHref } from "../paths.mjs";
import { checkScreens } from "../screens.mjs";
import SystemPage from "../SystemPage.astro";

const base = import.meta.env.BASE_URL;
const screens = list ? checkScreens(list, settings.route) : null;
const links = [
	{ page: "foundations", label: "Foundations", text: "Colors with live values and contrast, type, prose, spacing, shape and the theme's own tokens." },
	{ page: "components", label: "Components", text: "Every shared component with its states and variants." },
	{ page: "sections", label: "Sections", text: "The theme's own blocks, with its demo content." },
];

const intro = screens?.length
	? `Every screen ${settings.name} provides, as a live preview, then the colors, type, components and sections that make it up. Values are read live, so they follow your token edits and the light and dark modes.`
	: `The colors, type, components and sections that make up ${settings.name}. Values are read live, so they follow your token edits and the light and dark modes.`;

const heading = cn("m-0 text-[clamp(1.6rem,3.2vw,2.6rem)] leading-[1.05] text-balance", displayType);
const headRow = "flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t-ui border-solid border-fg pt-4";
// The name link covers the whole card (preview included) through its ::after.
const cardLink = cn(
	"text-fg no-underline decoration-ui underline-offset-[0.2em] group-hover:underline",
	"after:absolute after:inset-0 after:content-['']",
	"outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-4 focus-visible:after:outline-solid focus-visible:after:outline-accent",
);
---

<SystemPage title="Design system" intro={intro} current="">
	<div class="grid gap-16 md:gap-24">
		<section aria-labelledby="system-screens" class="grid gap-8">
			<div class={headRow}>
				<h2 id="system-screens" class={heading}>Screens</h2>
				{screens && <p class="m-0 text-[0.875rem] text-muted">{screens.length} {screens.length === 1 ? "screen" : "screens"}. Previews load as you scroll.</p>}
			</div>
			{
				screens?.length ? (
					<ul role="list" data-system-screens class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,17rem),1fr))] gap-x-8 gap-y-12 p-0">
						{screens.map((screen) => {
							const href = screenHref(base, screen.path);
							return (
								<li data-screen={href} data-screen-status={screen.status ?? 200} class="group relative grid content-start gap-4">
									<div
										aria-hidden="true"
										inert
										class="relative aspect-[16/10] overflow-hidden border-ui border-solid border-border bg-surface-2 transition-[border-color] duration-150 group-hover:border-fg motion-reduce:transition-none"
									>
										<iframe
											src={href}
											title={`Preview of ${screen.name}`}
											loading="lazy"
											tabindex="-1"
											class="pointer-events-none absolute top-0 left-0 block h-[400%] w-[400%] origin-top-left scale-25 border-0 bg-bg"
										/>
									</div>
									<div class="grid gap-1.5">
										<h3 class="m-0 font-body text-[1.2rem] leading-tight font-semibold">
											<a href={href} class={cardLink}>
												{screen.name}
											</a>
										</h3>
										<p class="m-0 font-mono text-[0.8125rem] text-muted [overflow-wrap:anywhere]">{screen.path}</p>
										<p class="m-0 text-muted">{screen.description}</p>
										{screen.note && (
											<p class="m-0 mt-1 border-l-2 border-solid border-fg pl-3 text-[0.875rem]">{screen.note}</p>
										)}
									</div>
								</li>
							);
						})}
					</ul>
				) : (
					<p class="m-0 text-muted">
						{screens ? (
							"The screens file lists no screens."
						) : (
							<>
								This theme has no screens file. Set <code>screens</code> in <code>astronomicSystem()</code> to show its pages
								here as live previews.
							</>
						)}
					</p>
				)
			}
		</section>

		<section aria-labelledby="system-pages" class="grid gap-2">
			<div class={headRow}>
				<h2 id="system-pages" class={heading}>The system</h2>
			</div>
			<ul role="list" class="m-0 grid list-none p-0">
				{
					links.map((link) => (
						<li class="border-b-ui border-solid border-border">
							<a
								href={systemHref(base, settings.route, link.page)}
								class={cn("group grid gap-2 py-6 no-underline md:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] md:items-baseline md:gap-10", focusRing)}
							>
								<span
									class={cn(
										"text-[clamp(1.35rem,2.4vw,1.9rem)] leading-[1.1] text-fg underline decoration-transparent decoration-ui underline-offset-[0.15em] transition-[text-decoration-color] duration-150 group-hover:decoration-current motion-reduce:transition-none",
										displayType,
									)}
								>
									{link.label}
								</span>
								<span class="text-muted">{link.text}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</SystemPage>
