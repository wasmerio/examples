---
/**
 * A sample of every shared component, with its variants and states. Used by
 * /system/components and by the apps/ui-demo page, so both show one source.
 * Ids start with `sys-` so they do not clash with the page around them.
 */
import AreaChips from "../../components/AreaChips.astro";
import Avatar from "../../components/Avatar.astro";
import Badge from "../../components/Badge.astro";
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
import CardMedia from "../../components/CardMedia.astro";
import CardOverlay from "../../components/CardOverlay.astro";
import CardSide from "../../components/CardSide.astro";
import Container from "../../components/Container.astro";
import CredentialsList from "../../components/CredentialsList.astro";
import CredentialsRows from "../../components/CredentialsRows.astro";
import CredentialsStrip from "../../components/CredentialsStrip.astro";
import CtaBand from "../../components/CtaBand.astro";
import CtaBandCentered from "../../components/CtaBandCentered.astro";
import CtaBandImage from "../../components/CtaBandImage.astro";
import CtaBandInline from "../../components/CtaBandInline.astro";
import CtaBandSplit from "../../components/CtaBandSplit.astro";
import DescriptionList from "../../components/DescriptionList.astro";
import EmergencyBanner from "../../components/EmergencyBanner.astro";
import Field from "../../components/Field.astro";
import Form from "../../components/Form.astro";
import FeatureGridCards from "../../components/FeatureGridCards.astro";
import FeatureGridIcons from "../../components/FeatureGridIcons.astro";
import FeatureGridSplit from "../../components/FeatureGridSplit.astro";
import FeatureRows from "../../components/FeatureRows.astro";
import FeatureItem from "../../components/FeatureItem.astro";
import Features from "../../components/Features.astro";
import FilterNav from "../../components/FilterNav.astro";
import Footer from "../../components/Footer.astro";
import FooterCentered from "../../components/FooterCentered.astro";
import FooterColumns from "../../components/FooterColumns.astro";
import FooterSimple from "../../components/FooterSimple.astro";
import Grid from "../../components/Grid.astro";
import GuaranteeStrip from "../../components/GuaranteeStrip.astro";
import Hero from "../../components/Hero.astro";
import HeroCentered from "../../components/HeroCentered.astro";
import HeroCover from "../../components/HeroCover.astro";
import HeroSplit from "../../components/HeroSplit.astro";
import Icon from "../../components/Icon.astro";
import IndexList from "../../components/IndexList.astro";
import IndexListColumns from "../../components/IndexListColumns.astro";
import IndexListSplit from "../../components/IndexListSplit.astro";
import IndexTable from "../../components/IndexTable.astro";
import IndexTableSplit from "../../components/IndexTableSplit.astro";
import IndexTableStacked from "../../components/IndexTableStacked.astro";
import Input from "../../components/Input.astro";
import LogoStrip from "../../components/LogoStrip.astro";
import LogoStripGrid from "../../components/LogoStripGrid.astro";
import LogoStripRow from "../../components/LogoStripRow.astro";
import Marquee from "../../components/Marquee.astro";
import MarqueeLogos from "../../components/MarqueeLogos.astro";
import MarqueeText from "../../components/MarqueeText.astro";
import MarqueeTitle from "../../components/MarqueeTitle.astro";
import Media from "../../components/Media.astro";
import Navbar from "../../components/Navbar.astro";
import NavbarBrandCenter from "../../components/NavbarBrandCenter.astro";
import NavbarCentered from "../../components/NavbarCentered.astro";
import NavbarSimple from "../../components/NavbarSimple.astro";
import NavbarStacked from "../../components/NavbarStacked.astro";
import Pagination from "../../components/Pagination.astro";
import Panel from "../../components/Panel.astro";
import PhoneLink from "../../components/PhoneLink.astro";
import Section from "../../components/Section.astro";
import Split from "../../components/Split.astro";
import Stack from "../../components/Stack.astro";
import Stats from "../../components/Stats.astro";
import StatsCards from "../../components/StatsCards.astro";
import StatsGrid from "../../components/StatsGrid.astro";
import StepItem from "../../components/StepItem.astro";
import Steps from "../../components/Steps.astro";
import StepsColumns from "../../components/StepsColumns.astro";
import StepsList from "../../components/StepsList.astro";
import Testimonial from "../../components/Testimonial.astro";
import TestimonialGrid from "../../components/TestimonialGrid.astro";
import TestimonialQuote from "../../components/TestimonialQuote.astro";
import Testimonials from "../../components/Testimonials.astro";
import Contact from "../../components/Contact.astro";
import ContactChannels from "../../components/ContactChannels.astro";
import ContactInfo from "../../components/ContactInfo.astro";
import ContactSplit from "../../components/ContactSplit.astro";
import MessageForm from "../../components/MessageForm.astro";
import Newsletter from "../../components/Newsletter.astro";
import NewsletterCentered from "../../components/NewsletterCentered.astro";
import NewsletterInline from "../../components/NewsletterInline.astro";
import SignupForm from "../../components/SignupForm.astro";
import PostCard from "../../components/PostCard.astro";
import PostGrid from "../../components/PostGrid.astro";
import PostList from "../../components/PostList.astro";
import Posts from "../../components/Posts.astro";
import Team from "../../components/Team.astro";
import TeamGrid from "../../components/TeamGrid.astro";
import TeamMember from "../../components/TeamMember.astro";
import TeamSplit from "../../components/TeamSplit.astro";
import Textarea from "../../components/Textarea.astro";
import VideoMedia from "../../components/VideoMedia.astro";
// The real estate parts: the listing card, filter, search and map families.
import Select from "../../components/Select.astro";
import { cn } from "../../lib/cn";
import { displayType } from "../../lib/display";
import { describedBy } from "../../lib/field";
import { childHeadingTag } from "../../lib/heading";
import { sampleSections, type SampleAttrs } from "./catalog";
import { mediaSample } from "./media-sample";
import ProseSample from "./ProseSample.astro";
import SampleIcon from "./SampleIcon.astro";
import SampleSection from "./SampleSection.astro";

interface Props {
	/** Element for the section headings. Headings inside the samples sit one level lower. */
	headingTag?: "h2" | "h3";
	class?: string;
	/** Extra attributes for each section's parts (SampleSection), for a page that styles them its own way. */
	attrs?: SampleAttrs;
	/** The page draws its own frame around each section's body: the samples drop their own borders. */
	framed?: boolean;
}

const { headingTag = "h2", class: className, attrs, framed = false } = Astro.props;
const Sub = headingTag === "h2" ? "h3" : "h4";
const section = (id: string) => {
	const found = sampleSections.find((s) => s.id === id);
	if (!found) throw new Error(`Unknown sample section: ${id}`);
	return found;
};

const links = [
	{ label: "Work", href: "#work", current: true, index: "1.0" },
	{ label: "Services", href: "#services" },
	{ label: "About", href: "#about" },
	{ label: "Journal", href: "#journal" },
];
const actions = [
	{ label: "Sign in", href: "#sign-in", variant: "ghost" as const },
	{ label: "Start a project", href: "#start", variant: "primary" as const },
];
const variants = ["primary", "secondary", "ghost"] as const;
const sizes = ["sm", "md", "lg"] as const;

const features = [
	{ n: "1", title: "Strategy", text: "We learn your clients, your offer, and what the site must do." },
	{ n: "2", title: "Design", text: "A clear look that fits your firm, tested on real content." },
	{ n: "3", title: "Build", text: "Fast pages, easy editing, and clean handover." },
];
const plans = [
	{ name: "Starter", price: "$4,800", per: "project", items: ["5 pages", "CMS setup", "2 weeks"], cta: "Choose Starter" },
	{ name: "Studio", price: "$9,500", per: "project", items: ["12 pages", "Case study system", "4 weeks"], cta: "Choose Studio", featured: true },
	{ name: "Retainer", price: "$1,200", per: "month", items: ["Ongoing changes", "Monthly report", "Priority help"], cta: "Talk to us" },
];

const awardColumns = [
	{ key: "award", label: "Award" },
	{ key: "project", label: "Project" },
	{ key: "year", label: "Year", align: "end" as const },
];
const awards = [
	{ cells: { award: "Site of the day", project: "Sample Studio", year: "2026" }, href: "#sys-indextable" },
	{ cells: { award: "Best small business site", project: "Sample Co.", year: "2025" } },
	{ cells: { award: "Typography honors", project: "Sample Group", year: "2024" } },
];
const clients = [
	{ name: "Northwind", href: "#northwind" },
	{ name: "Atlas Health" },
	{ name: "Fernhollow Savings" },
	{ name: "Kiln" },
	{ name: "Vela Energy" },
	{ name: "Ostra" },
];
const steps = [
	{ title: "Workshop", meta: "Week 1", text: "One day with your team. We agree on goals, audience and budget." },
	{ title: "Direction", meta: "Weeks 2–3", text: "Two design routes. You pick one, and we refine it with you." },
	{ title: "Build", meta: "Weeks 4–9", text: "Design and code in weekly rounds. You see real pages every Friday." },
	{ title: "Launch", meta: "Week 10", text: "We launch, train your editors, and hand over every source file." },
];
const topics = [
	{ label: "Brand and identity", href: "#sys-indexlist", meta: "14 projects" },
	{ label: "Websites", href: "#sys-indexlist", meta: "31 projects" },
	{ label: "Editorial and blogs", href: "#sys-indexlist", meta: "9 projects" },
	{ label: "Shops", meta: "Coming soon" },
];
const credentials = [
	{ term: "License", detail: "Sample license OH PL.000000", note: "Ohio plumbing contractor" },
	{ term: "Insured", detail: "General liability and workers' comp" },
	{ term: "Warranty", detail: "1 year on labor", note: "Parts by the maker's warranty" },
	{ term: "In business", detail: "Since 1998" },
];
const stats = [
	{ value: "+38%", label: "Inquiries in the first quarter" },
	{ value: "1.2s", label: "Largest paint on mobile" },
	{ value: "14", label: "Editors trained" },
	{ value: "0", label: "Support calls since launch" },
];
const quotes = [
	{ quote: "They shipped our new site in three weeks.", name: "Sample Person", role: "Head of marketing", company: "Sample Co.", title: "Launched in three weeks" },
	{ quote: "Our editors update every page themselves now, and nothing breaks.", name: "Sample Editor", role: "Editor", company: "Sample Studio" },
	{ quote: "Clear plans, real pages every Friday, and no surprises at launch.", name: "Sample Founder", role: "Founder", company: "Sample Group" },
];
// The kit ships no photo: the first person has the Media sample's picture, the rest show their initials.
const people = [
	{ name: "Ada Brook", role: "Founder and design lead", image: mediaSample },
	{ name: "Sam Okafor", role: "Lead developer" },
	{ name: "Lena Ruiz", role: "Content strategist" },
	{ name: "Tomás Vidal", role: "Project manager" },
];
// Made-up details: an example.com address and a US number from the range kept for fiction (555-0100 to 555-0199).
const contact = {
	email: "hello@example.com",
	phone: "+1 (312) 555-0147",
	address: ["Astronomic", "12 Orbit Lane", "Example City, IL 60601"],
	hours: [
		{ label: "Mon to Thu", value: "9 a.m. to 5:30 p.m." },
		{ label: "Fri", value: "9 a.m. to 3 p.m." },
	],
};
const channels = [
	{ title: "Sales", text: "A new site, or a quote for one.", href: "mailto:sales@example.com", label: "Email sales", icon: SampleIcon },
	{ title: "Support", text: "Questions about a site we built for you.", href: "mailto:support@example.com", label: "Email support", icon: SampleIcon },
	{ title: "Press", text: "Interviews, talks and pictures of the studio.", href: "mailto:press@example.com", label: "Email the press team", icon: SampleIcon },
];
// The kit ships no photo: the first post has the Media sample's picture, the others none. Dates are "YYYY-MM-DD".
const posts = [
	{
		href: "#post-launch-checklist",
		title: "A launch checklist for a small studio site",
		date: "2026-10-14",
		excerpt: "The twelve checks we run the week before a site goes live, from redirects to the contact form.",
		image: mediaSample,
		topic: { label: "Process", href: "#topic-process" },
		author: { name: "Ada Brook" },
		readingTime: "6 min read",
	},
	{
		href: "#post-editors",
		title: "Letting editors change pages without breaking them",
		date: "2026-09-30",
		excerpt: "How we set up the editing side so a new page never needs a developer.",
		topic: { label: "Editing", href: "#topic-editing" },
		author: { name: "Sam Okafor" },
	},
	{ href: "#post-fonts", title: "Choosing two fonts for a site", date: "2026-09-12", excerpt: "One for headings, one for text, and why we stop there.", topic: { label: "Design" } },
];
const facts = [
	{ term: "Client", detail: "Northwind Logistics" },
	{ term: "Year", detail: "2025" },
	{ term: "Services", detail: "Brand identity, Websites" },
	{ term: "Location", detail: "Portland, Oregon" },
];
const filters = [
	{ label: "All work", href: "#work", current: true },
	{ label: "Brand identity", href: "#brand" },
	{ label: "Websites", href: "#websites" },
	{ label: "Product design", href: "#product" },
	{ label: "Design support", href: "#support" },
];
const footerColumns = [
	{ heading: "Studio", links: [{ label: "Work", href: "#work" }, { label: "Services", href: "#services" }, { label: "About", href: "#about" }] },
	{ heading: "Read", links: [{ label: "Journal", href: "#journal" }, { label: "Careers", href: "#careers" }] },
];
const footerLinks = footerColumns.flatMap((column) => column.links);
const socials = [
	{ label: "Instagram", href: "https://instagram.com", target: "_blank" },
	{ label: "LinkedIn", href: "https://linkedin.com", target: "_blank" },
];
const pageHref = (n: number) => (n === 1 ? "#journal" : `#journal-page-${n}`);
const formError = "Enter an email address, like name@example.com.";

const frame = framed ? "overflow-hidden" : "overflow-hidden rounded-card border-ui border-solid border-border";
const subLabel = "m-0 mb-3 text-[0.875rem] font-semibold";
// A plain block for the layout samples: each helper places these, so its rhythm and columns show.
const block = "m-0 rounded-card bg-surface-2 p-4 text-sm text-muted";
const brandLink =
	"rounded-control text-inherit no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
---

<div class={cn("grid grid-cols-[minmax(0,1fr)] gap-20", className)}>
	<SampleSection section={section("navbar")} headingTag={headingTag} attrs={attrs}>
		<div class={frame}>
			<Navbar links={links} actions={actions} label="Astronomic">
				<a slot="brand" href="#" class={cn("flex items-center gap-2", brandLink)}>
					<span class="inline-block size-4.5 rounded-[calc(var(--ui-radius-card)/2)] bg-fg" aria-hidden="true"></span>
					Astronomic
				</a>
				<a slot="utilities" href="#search" aria-label="Search" class="inline-flex size-9 items-center justify-center rounded-control text-inherit">
					<Icon size="sm">
						<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round">
							<circle cx="7" cy="7" r="4.75" />
							<path d="M10.5 10.5L14 14" />
						</svg>
					</Icon>
				</a>
			</Navbar>
			<div class="grid max-w-160 gap-4 bg-bg px-6 py-10">
				<Sub class={cn(displayType, "m-0 text-[clamp(1.8rem,4.5vw,2.6rem)] leading-[1.08] text-balance")}>
					Websites for firms that care how they are seen.
				</Sub>
				<p class="m-0 max-w-[52ch] text-[1.05rem] text-muted">
					We plan, design, and build fast Astro sites for architects, consultants, and studios.
				</p>
				<div class="flex flex-wrap gap-3">
					<Button size="lg" href="#work">See our work</Button>
					<Button size="lg" variant="secondary" href="#call">Book a call</Button>
				</div>
			</div>
		</div>
	</SampleSection>

	<SampleSection section={section("navbar-recipes")} headingTag={headingTag} attrs={attrs}>
		<div class="grid gap-blocks">
			<div class={frame}>
				<NavbarSimple links={links} actions={actions} label="Astronomic, simple" class="border-b-0">
					<a slot="brand" href="#" class={brandLink}>Astronomic</a>
				</NavbarSimple>
			</div>
			<div class={frame}>
				<NavbarCentered links={links} actions={actions.slice(-1)} label="Astronomic, centered" class="border-b-0">
					<a slot="brand" href="#" class={brandLink}>Astronomic</a>
				</NavbarCentered>
			</div>
			<div class={frame}>
				<NavbarStacked links={[...links, { label: "Careers", href: "#careers" }, { label: "Contact", href: "#contact" }]} actions={actions} label="Astronomic, stacked" class="border-b-0">
					<a slot="brand" href="#" class={brandLink}>Astronomic</a>
				</NavbarStacked>
			</div>
			<div class={frame}>
				<NavbarBrandCenter links={links.slice(0, 3)} actions={actions.slice(-1)} label="Astronomic, brand in the middle" class="border-b-0">
					<a slot="brand" href="#" class={brandLink}>Astronomic</a>
				</NavbarBrandCenter>
			</div>
		</div>
	</SampleSection>

	<SampleSection section={section("navbarsimple-actions")} headingTag={headingTag} attrs={attrs}>
		<div class={frame}>
			<NavbarSimple links={links.map((l) => ({ ...l, current: l.label === "Journal" }))} label="Astronomic" class="border-b-0">
				<span slot="brand">Astronomic</span>
				<Fragment slot="actions">
					<Button size="sm" variant="secondary" tone="band" href="#subscribe">Subscribe</Button>
				</Fragment>
			</NavbarSimple>
		</div>
	</SampleSection>

	<SampleSection section={section("hero")} headingTag={headingTag} attrs={attrs}>
		<Hero
			heading="Brand and web design for firms that sell expertise."
			text="The shell sets the order: the eyebrow, the heading, this line, the actions, the default slot, then the media block."
			actions={[{ label: "Start a project", href: "#start" }, { label: "See our work", href: "#work" }]}
			headingTag={Sub}
			contentClass="items-center @3xl/hero:grid-cols-2"
		>
			<Badge slot="eyebrow" status="positive">Taking new projects</Badge>
			<p class="m-0 text-small text-muted">The default slot sits under the actions.</p>
			<Media slot="media" {...mediaSample} alt="" ratio="4/3" />
		</Hero>
	</SampleSection>

	<SampleSection section={section("hero-recipes")} headingTag={headingTag} attrs={attrs}>
		<div class="grid gap-section">
			<HeroSplit
				heading="Brand and web design for firms that sell expertise."
				text="We help consultancies and studios explain what they do, and win the clients they want."
				actions={[{ label: "Start a project", href: "#start" }, { label: "See our work", href: "#work" }]}
				headingTag={Sub}
			>
				<Badge slot="eyebrow" status="positive">Taking new projects</Badge>
			</HeroSplit>
			<HeroCentered
				heading="A studio for brands that would rather be clear than loud."
				text="Strategy, identity and websites, from the first call to the launch."
				actions={[{ label: "Start a project", href: "#start" }, { label: "See our work", href: "#work" }]}
				headingTag={Sub}
				image={{ src: mediaSample, alt: "" }}
			/>
			<HeroCover
				framed
				heading="Websites for studios that sell what they know."
				text="One small team, from the first call to the launch and after."
				actions={[{ label: "Start a project", href: "#start" }, { label: "See our work", href: "#work" }]}
				headingTag={Sub}
				image={{ src: mediaSample, alt: "" }}
			/>
		</div>
	</SampleSection>

	<SampleSection section={section("button")} headingTag={headingTag} attrs={attrs} note="Hover or tab to see hover and focus.">
		<div class="grid gap-4">
			{
				variants.map((variant) => (
					<div class="flex flex-wrap items-center gap-3">
						{sizes.map((size) => (
							<Button variant={variant} size={size}>
								{`${variant[0].toUpperCase()}${variant.slice(1)} ${size}`}
							</Button>
						))}
						<Button variant={variant} disabled>
							Disabled
						</Button>
					</div>
				))
			}
		</div>
		<div>
			<Sub class={subLabel}>Links as buttons</Sub>
			<div class="flex flex-wrap items-center gap-3">
				<Button href="#work">Primary link</Button>
				<Button href="#work" variant="secondary">Secondary link</Button>
				<Button href="#work" variant="ghost">Ghost link</Button>
				<Button href="#work" disabled>Disabled link</Button>
				<Button type="submit" variant="secondary" class="px-8">Submit, wider via class</Button>
			</div>
		</div>
	</SampleSection>

	<SampleSection section={section("card")} headingTag={headingTag} attrs={attrs}>
		<div class="grid gap-5 sm:grid-cols-3">
			{
				features.map((f) => (
					<Card as="article">
						<span class="grid size-9 place-items-center rounded-control bg-surface-2 font-bold text-fg">{f.n}</span>
						<Sub class={cn(displayType, "m-0 text-lg")}>{f.title}</Sub>
						<p class="m-0 text-[0.9375rem] text-muted">{f.text}</p>
					</Card>
				))
			}
		</div>
		<div class="grid gap-5 sm:grid-cols-3">
			{
				plans.map((p) => (
					<Card featured={p.featured} class="gap-4">
						<p class="m-0 text-sm font-semibold text-muted">
							{p.name}
							{p.featured && <span class="text-fg"> · Most chosen</span>}
						</p>
						<p class={cn(displayType, "m-0 text-4xl leading-none tabular-nums")}>
							{p.price}
							<span class="font-body text-sm font-normal tracking-normal [font-stretch:100%] normal-case text-muted"> / {p.per}</span>
						</p>
						<ul class="m-0 grid list-none gap-1.5 p-0 text-[0.9375rem]">
							{p.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
						<Button variant={p.featured ? "primary" : "secondary"} class="w-full">
							{p.cta}
						</Button>
					</Card>
				))
			}
		</div>
	</SampleSection>

	<SampleSection section={section("card-recipes")} headingTag={headingTag} attrs={attrs}>
		<div class="grid gap-5">
			<div class="grid gap-5 sm:grid-cols-2">
				<CardMedia
					image={{ src: mediaSample, alt: "" }}
					eyebrow="Case study"
					title="Kiln ceramics"
					text="A shop that sells out every launch, on a site the makers edit themselves."
					href="#work"
					viewText="Read the case study"
					headingTag={Sub}
				/>
				<CardOverlay image={{ src: mediaSample, alt: "" }} eyebrow="Portland" title="Fernhollow Savings offices" text="Wayfinding and a visitor site for a new head office." href="#work" headingTag={Sub} />
			</div>
			<CardSide
				image={{ src: mediaSample, alt: "" }}
				eyebrow="Journal"
				title="How we plan a ten-week build"
				text="Weekly rounds, real pages every Friday, and no surprises at launch."
				href="#journal"
				viewText="Read the article"
				headingTag={Sub}
			/>
		</div>
	</SampleSection>

	<SampleSection section={section("media")} headingTag={headingTag} attrs={attrs}>
		<div class="grid gap-5 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
			<Media src={mediaSample} alt="A still life: an arch and a white bowl on a shelf." caption="Studio still life, 16/9 with a caption." />
			<Media src={mediaSample} alt="" ratio="3/4" />
		</div>
		{/* The kit ships no video file: with no sources, VideoMedia shows its poster as a still, in the same frame. */}
		<VideoMedia class="mt-5 max-w-sm" sources={[]} poster={mediaSample} label="A still life: an arch and a white bowl on a shelf" shape="cut" ratio="4/3" caption="VideoMedia with no file yet: the poster, in a cut frame." />
	</SampleSection>

	<SampleSection section={section("features")} headingTag={headingTag} attrs={attrs}>
		<Features heading="What we do" text="The shell sets the order: the eyebrow, the heading, this line, then the list of FeatureItems." headingTag={Sub} listClass="@3xl/features:grid-cols-3">
			<Badge slot="eyebrow">Services</Badge>
			{features.map((f) => <FeatureItem title={f.title} text={f.text} headingTag={childHeadingTag({ heading: "What we do", headingTag: Sub })} />)}
		</Features>
	</SampleSection>

	<SampleSection section={section("features-recipes")} headingTag={headingTag} attrs={attrs}>
		<div class="grid gap-group">
			<FeatureGridCards heading="What we do" text="From the first call to the launch and after." items={features.map(({ title, text }) => ({ title, text }))} headingTag={Sub} />
