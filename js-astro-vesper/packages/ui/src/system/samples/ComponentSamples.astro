							<p class="m-0 max-w-[60ch] text-muted">The Section sets the space above and below, the Container the width and the side padding, the Stack the space between these blocks.</p>
						</Stack>
						<Grid cols={3} min="12rem">
							<p class={block}>Grid, three columns</p>
							<p class={block}>Fewer when narrow</p>
							<p class={block}>By its own width</p>
						</Grid>
						<Split ratio="3/2">
							<p class={block}>Split, 3/2: this side is wider</p>
							<p class={block}>Stacked when the Split is narrow</p>
						</Split>
						<Grid min="10rem" gap="item">
							{["Grid with min", "As many", "columns", "as fit", "each 10rem"].map((t) => <p class={block}>{t}</p>)}
						</Grid>
					</Stack>
				</Container>
			</Section>
			<Panel tone="inverse" as="div">
				<Container size="md">
					<p class={cn(displayType, "m-0 text-2xl text-on-inverse")}>A Panel, tone inverse</p>
					<p class="m-0 mt-item max-w-lead text-on-inverse-muted">An inset, rounded box around a Section: dark on a light page, light on a dark page.</p>
				</Container>
			</Panel>
		</div>
	</SampleSection>

