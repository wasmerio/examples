/**
 * The feature samples' icon: a small SVG component, as a buyer's own icon or one from an icon set would be. It takes
 * the props Icon gives it (aria-hidden) and strokes in the current color; Icon sets its size and line weight. The
 * kit ships no icon package.
 */
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" {...Astro.props}>
	<path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z" />
</svg>
