---
/** One sample section: a heading from the catalog, when to use each component, then the sample. */
import { cn } from "../../lib/cn";
import { displayType } from "../../lib/display";
import { entry, joinNames, type SampleAttrs, type SampleSection } from "./catalog";

interface Props {
	section: SampleSection;
	headingTag: "h2" | "h3";
	/** An extra line under the `when` lines. */
	note?: string;
	class?: string;
	/** Extra attributes for the section's parts, for a page that styles them its own way. */
	attrs?: SampleAttrs;
}

const { section, headingTag: Heading, note, class: className, attrs = {} } = Astro.props;
const entries = section.ids.map(entry);
const title = section.variant?.title ?? joinNames(entries.map((e) => e.name));
const anchor = `sys-${section.id}`;
const heading = cn(
	"m-0 leading-[1.05]",
	Heading === "h2" ? "text-[clamp(1.6rem,3.2vw,2.6rem)]" : "text-[clamp(1.3rem,2.4vw,1.9rem)]",
	displayType,
);
const line = "m-0 max-w-[60ch] text-muted";
---

<section
	id={anchor}
	aria-labelledby={`${anchor}-h`}
	class={cn("grid scroll-mt-8 gap-8 border-t-ui border-solid border-fg pt-4", className)}
	{...attrs.section}
>
	<div class="grid gap-2" {...attrs.head}>
		<Heading id={`${anchor}-h`} class={heading} {...attrs.title}>{title}</Heading>
		{
			section.variant ? (
				<p class={line}>{section.variant.note}</p>
			) : entries.length === 1 ? (
				<p class={line}>{entries[0].when}</p>
			) : (
				entries.map((e) => (
					<p class={line}>
						<span class="font-semibold text-fg">{e.name}:</span> {e.when}
					</p>
				))
			)
		}
		{note && <p class={line}>{note}</p>}
	</div>
	<div class="grid gap-8" {...attrs.body}><slot /></div>
</section>
