---
/**
 * An article's text with its table of contents (comp ".art-grid"). The rich text comes in the default slot and is
 * rendered once, here, so the h2 ids and the contents come from the same HTML in every source (theme-core's
 * `outline`; the rendered HTML is the source's own renderer output). With two or more h2s the contents sit beside the
 * text (above it up to 1100px); with fewer, the text alone. The `foot` slot follows the text in its column.
 *
 * A code block scrolls sideways when a line is longer than the column (comp "pre"), so each <pre> is a tab stop
 * (`tabindex="0"`): a keyboard reader can scroll it, and the site's focus ring shows (src/styles/prose.css).
 *
 * BodyProse sets the text and makes its photos links that open large in the page's lightbox.
 */
import { outline } from "@astronomic/theme-core/outline";
import { reservedIds } from "~/utils/ids";
import ArticleToc from "./ArticleToc.astro";
import BodyProse from "./BodyProse.astro";

const { html: outlined, items } = outline(await Astro.slots.render("default"), { reserved: reservedIds });
const html = outlined.replace(/<pre\b(?![^>]*\stabindex=)/g, '<pre tabindex="0"');
const toc = items.length >= 2 ? items : [];
---

<div data-toc={toc.length > 0 ? "" : undefined} class="v-art-grid">
	{toc.length > 0 && <ArticleToc items={toc} />}
	<div>
		<BodyProse>
			<Fragment set:html={html} />
		</BodyProse>
		<slot name="foot" />
	</div>
</div>
