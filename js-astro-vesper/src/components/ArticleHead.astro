---
/**
 * An article's head (comp ".art-head"): "All articles" back to the list, the meta line (the category, as a link to
 * its page, then the date, "Updated <date>" when the post has a later update, and the reading time, a slash between each; the slashes are hidden from screen readers,
 * which hear a comma), the title (h1), the summary as the lead, the tags; then the photo (the post's thumbnail) at the container's width, 21:9 (4:3 up to
 * 900px), with its top-end corner cut at 1.6 times the look's cut: the kit's Media with `shape="cut"` and the
 * theme's image component, so both sources keep their srcset. The photo opens large in the page's lightbox
 * (PhotoLink, which carries the box class v-art-fig). No photo: the head alone.
 */
import Media from "@astronomic/ui/components/Media.astro";
import { formatDate, isoDate } from "@astronomic/ui/lib/date.ts";
import type { ContentImage } from "~/content";
import { strings } from "~/theme.strings";
import { imageSizes } from "~/utils/layout";
import { articlesHref } from "~/utils/routes";
import Icon from "./Icon.astro";
import KitImage from "./KitImage.astro";
import PhotoLink from "./PhotoLink.astro";
import Sep from "./Sep.astro";
import TagList from "./TagList.astro";

interface Props {
	title: string;
	date?: Date;
	/** The update date to show: only one on a later day than `date` (theme-core's updatedAfter). */
	updated?: Date;
	/** Minutes to read. */
	minutes?: number;
	lead?: string;
	tags: { slug: string; label: string }[];
	/** The post's category and its page. */
	category?: { label: string; href: string };
	image?: ContentImage;
}

const { title, date, updated, minutes, lead, tags, category, image } = Astro.props;
const t = strings.article;
const dateText = date ? formatDate(date, strings.locale, { dateStyle: "long" }) : undefined;
---

<header>
	<a href={articlesHref()} data-art-back class="v-back">
		<Icon name="ui/arrow-left" />
		{t.back}
	</a>
	<div data-art-top>
		{
			(category || date || minutes) && (
				<p data-art-meta class="v-meta">
					{category && (
						<a href={category.href} data-art-cat class="v-cat">
							{category.label}
						</a>
					)}
					{category && date && <Sep />}
					{date && <time datetime={isoDate(date)}>{dateText}</time>}
					{date && updated && <Sep />}
					{date && updated && <time datetime={isoDate(updated)}>{t.updated(formatDate(updated, strings.locale, { dateStyle: "long" }))}</time>}
					{(category || date) && minutes && <Sep />}
					{minutes && <span>{t.minutes(minutes)}</span>}
				</p>
			)
		}
		<h1 class="v-display text-v-page">{title}</h1>
		{lead && <p data-art-lead class="m-0 max-w-lead text-v-lead text-v-body text-pretty">{lead}</p>}
		<TagList tags={tags} />
	</div>
	{
		image && (
			<PhotoLink image={image} class="v-art-fig">
				<Media
					src={image as never}
					alt={image.alt}
					width={image.width}
					height={image.height}
					shape="cut"
					cutCorner="top-end"
					imageComponent={KitImage}
					loading="eager"
					fetchpriority="high"
					sizes={imageSizes.container.sizes}
					ratioClass="aspect-[21/9] max-tablet:aspect-[4/3]"
				/>
			</PhotoLink>
		)
	}
</header>
