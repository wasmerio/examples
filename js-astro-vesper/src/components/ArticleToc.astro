---
/**
 * The article's table of contents (comp ".toc"): theme-core's OnThisPage list of the text's h2s, in a box that stays
 * in view under the floating nav beside the text; up to 1100px a filled card above it (v-toc).
 */
import OnThisPage from "@astronomic/theme-core/components/OnThisPage.astro";
import type { OutlineItem } from "@astronomic/theme-core/outline";
import { strings } from "~/theme.strings";

interface Props {
	items: OutlineItem[];
}

const { items } = Astro.props;
---

<div class="v-toc">
	<OnThisPage variant="list" items={items} label={strings.article.toc} />
</div>
