---
/**
 * The body of a list of posts: /articles and its later pages, a category, a tag. The head, the search form (when the
 * site searches), the category filter (All and each category with posts), the posts (h2 titles, under the page's h1)
 * and the pages. The posts are cards in two columns over the container's width (`articleList: "grid"`, the default),
 * or rows in the reading width (`"rows"`); the head, the search form and the filter keep the reading width either way.
 */
import SearchForm from "@astronomic/theme-core/components/SearchForm.astro";
import FilterNav, { type FilterItem } from "@astronomic/ui/components/FilterNav.astro";
import Pagination from "@astronomic/ui/components/Pagination.astro";
import { strings } from "~/theme.strings";
import { cn } from "~/utils/cn";
import { wrap } from "~/utils/layout";
import type { ArticleList } from "~/utils/config";
import { searchHref } from "~/utils/routes";
import type { PostRowItem } from "~/utils/view";
import ListHead from "./ListHead.astro";
import PostList from "./PostList.astro";

interface Props {
	title: string;
	lead?: string;
	posts: PostRowItem[];
	filters: FilterItem[];
	/** Show the search form (the site has search). */
	search: boolean;
	thumbs: boolean;
	/** `articleList` in src/theme.config.ts. */
	layout: ArticleList;
	current: number;
	total: number;
	href: (n: number) => string;
}

const { title, lead, posts, filters, search, thumbs, layout, current, total, href } = Astro.props;
const t = strings.articles;
---

<div class={wrap}>
	<ListHead title={title} lead={lead} />
	<div class={cn("v-page-body grid gap-8", layout === "rows" && "v-list")}>
		{(search || filters.length > 1) && (
			<div class="v-list grid gap-5">
				{search && <SearchForm variant="row" action={searchHref()} strings={t.search} />}
				{filters.length > 1 && <FilterNav items={filters} label={t.filter} class="v-filter" />}
			</div>
		)}
		<PostList posts={posts} thumbs={thumbs} layout={layout} headingTag="h2" class="mt-4" />
		<Pagination current={current} total={total} href={href} label={t.pagination} previousLabel={t.previous} nextLabel={t.next} pageLabel={t.page} class={cn("mt-8")} />
	</div>
</div>
