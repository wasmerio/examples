---
/**
 * The author box under an article (comp ".author"): the person's cut avatar (the theme's Avatar, 64px; initials with
 * no photo), the name, a line about them and a link to the about page (left out while there is no about page).
 */
import { strings } from "~/theme.strings";
import type { ContentImage } from "~/content";
import Avatar from "./Avatar.astro";
import Icon from "./Icon.astro";

interface Props {
	name: string;
	bio?: string;
	avatar?: ContentImage;
	/** The about page. */
	href?: string;
}

const { name, bio, avatar, href } = Astro.props;
---

<div class="v-author">
	<Avatar name={name} image={avatar} size="author" loading="lazy" />
	<div class="min-w-0">
		<p data-author-name>{name}</p>
		{bio && <p data-author-bio>{bio}</p>}
		{
			href && (
				<a href={href} data-author-link class="v-alink">
					{strings.article.about}
					<Icon name="ui/arrow" />
				</a>
			)
		}
	</div>
</div>
