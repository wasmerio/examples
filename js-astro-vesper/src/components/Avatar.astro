---
/**
 * The person's avatar (comp ".who img"; the author box's ".author img" with `size="author"`, 64px with a 14px cut): a
 * 40px square with its top-start corner cut (13px), the kit's Media with
 * shape="cut" and the theme's image. With no avatar in the settings, the person's initials on the surface, in the
 * same cut box. Decorative (the name sits beside it), so the image has an empty alt and the initials are hidden from
 * screen readers.
 */
import Media from "@astronomic/ui/components/Media.astro";
import type { ContentImage as Image } from "~/content";
import { cn } from "~/utils/cn";
import { imageSizes } from "~/utils/layout";
import KitImage from "./KitImage.astro";

interface Props {
	/** The person's name, for the initials. */
	name: string;
	image?: Image;
	/** The photo loads at once: the nav is at the top of every page. */
	loading?: "lazy" | "eager";
	/** "nav" (40px, the default) or "author" (64px). */
	size?: "nav" | "author";
	class?: string;
}

const { name, image, loading = "eager", size = "nav", class: className } = Astro.props;
/** Up to two initials: the first letter of the first and the last word ("Rowan Ellery" → "RE"). */
const words = name.trim().split(/\s+/).filter(Boolean);
const initials = (words.length > 1 ? [words[0], words.at(-1)!] : words).map((w) => [...w][0]?.toUpperCase() ?? "").join("");
const author = size === "author";
const box = cn(author ? "v-avatar-author size-v-author" : "v-avatar size-v-avatar", "shrink-0", className);
const sizes = author ? imageSizes.author.sizes : imageSizes.avatar.sizes;
---

{
	image ? (
		<Media src={image} alt="" ratio="1/1" shape="cut" cutCorner="top-start" imageComponent={KitImage} loading={loading} sizes={sizes} class={box} />
	) : (
		<span data-cut="top-start" aria-hidden="true" class={cn(box, "media-cut grid place-items-center rounded-media bg-surface-2 font-display text-v-role font-bold text-fg")}>
			{initials}
		</span>
	)
}
