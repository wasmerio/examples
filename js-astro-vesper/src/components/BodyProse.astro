---
/**
 * Rich text in the text column (`v-prose`, src/styles/prose.css), with its photos made into links that open large in
 * the page's lightbox (src/utils/lightbox-html.ts). The rich text comes in the default slot:
 * `<BodyProse><RichText value={body} /></BodyProse>`. The page sets `lightbox` on Base so the dialog is there.
 */
import Prose from "@astronomic/ui/components/Prose.astro";
import { cn } from "~/utils/cn";
import { lightboxHtml } from "~/utils/lightbox-html";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const html = lightboxHtml(await Astro.slots.render("default"));
---

<Prose class={cn("v-prose", className)}>
	<Fragment set:html={html} />
</Prose>
