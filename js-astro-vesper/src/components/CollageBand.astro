---
/**
 * The collage band on the home page (design "Signature details"; comp ".collage"): 4, 5 or 6 photos packed into one
 * rectangle with an even gutter, neighbors' cut corners facing each other, and only the hovered photo growing in
 * place. The layout (Mosaic, Row, Contact sheet) is `data-collage` on <html>; the count is `data-count` here; the
 * grids and corner maps are src/styles/collage.css. No photos, or a count with no packed layout (collageState): no
 * band. A build stops on a bad count first; a production server, which checks nothing, shows no band (fail closed).
 */
import { collageState } from "~/utils/setup";
import type { CollageItem } from "~/utils/view";
import CollagePhoto from "./CollagePhoto.astro";

interface Props {
	photos: CollageItem[];
	/** The band's accessible name. */
	label: string;
}

const { photos, label } = Astro.props;
---

{
	collageState(photos) === "ok" && (
		<section aria-label={label} data-count={photos.length} class="v-band">
			<div data-band-grid>
				{photos.map((photo, i) => (
					<CollagePhoto photo={photo} priority={i === 0} />
				))}
			</div>
		</section>
	)
}
