---
/**
 * Vesper's content image: theme-core's ContentImage with this source's image renderers (EmDash responsive media,
 * Astro local optimization), or a plain <img>. `widths` and `sizes` describe how wide the image shows (see
 * `imageSizes` in src/utils/layout.ts); `style` (a focal point's object-position) goes on the <img>.
 */
import ContentImage from "@astronomic/theme-core/components/ContentImage.astro";
import { useContent, type ContentImage as Image } from "~/content";

interface Props {
	image: Image;
	priority?: boolean;
	class?: string;
	widths?: readonly number[];
	sizes?: string;
	style?: string;
}
---

<ContentImage {...Astro.props} renderers={useContent(Astro).renderers.image} />
