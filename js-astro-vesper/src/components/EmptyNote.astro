---
/** The short line an optional page shows while it is on but has nothing in it yet ("Nothing here yet."). */
import { strings } from "~/theme.strings";
import { cn } from "~/utils/cn";

interface Props {
	class?: string;
}
---

<p class={cn("m-0 text-v-lead text-v-body", Astro.props.class)}>{strings.sections.empty}</p>
