---
/**
 * One icon from the theme's set (src/icons/*.svg; credits in src/icons/CREDITS.md), in `currentColor`, hidden from
 * screen readers: the link or button around it carries the name. `name` is the file's name (a social link's `icon`);
 * an unknown name shows the Website icon. The theme's own line icons for links and card headings sit in src/icons/ui/
 * and are named `ui/<name>` ("ui/arrow"). Size it with a class (size-v-icon).
 *
 * The set is the theme's own files, read at build time, so their markup goes in as written.
 */
import { cn } from "~/utils/cn";
import { iconSvg } from "~/utils/icons";

interface Props {
	name: string;
	class?: string;
}

const files = import.meta.glob<string>(["../icons/*.svg", "../icons/ui/*.svg"], { query: "?raw", import: "default", eager: true });
const icons = Object.fromEntries(Object.entries(files).map(([path, svg]) => [path.replace(/^\.\.\/icons\/|\.svg$/g, ""), svg.trim()]));

const { name, class: className } = Astro.props;
const svg = iconSvg(icons, name);
const markup = svg.replace(/^<svg\b/, `<svg aria-hidden="true" focusable="false" class="${cn("shrink-0", className)}"`);
---

<Fragment set:html={markup} />
