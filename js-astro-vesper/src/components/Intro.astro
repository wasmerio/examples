---
/**
 * The home intro (comp ".intro"): the headline as the page's h1 (its one *phrase* marked in the look's emphasis), the
 * bio as the lead, the Now line, and the person's labeled social links. The section is named by its headline.
 * Behind it, Trail map's contour lines and its map mark with the person's place (Topo, MapMark); the other looks hide
 * both, so a look set per request needs no other markup.
 */
import Emphasis from "@astronomic/ui/components/Emphasis.astro";
import { strings } from "~/theme.strings";
import { homeIds } from "~/utils/ids";
import { cn } from "~/utils/cn";
import { wrap } from "~/utils/layout";
import MapMark from "./MapMark.astro";
import NowLine from "./NowLine.astro";
import SocialLinks, { type SocialLinkItem } from "./SocialLinks.astro";
import Topo from "./Topo.astro";

interface Props {
	headline: string;
	bio?: string;
	/** The Now line: its chip (the Now page's name), the status, and the Now page while it is on. None: no line. */
	now?: { label: string; status: string; href?: string };
	socials: SocialLinkItem[];
	/** The person's place, for Trail map's map mark (the settings' `nowPlace`). */
	place?: string;
}

const { headline, bio, now, socials, place } = Astro.props;
const headingId = homeIds.intro;
---

<section aria-labelledby={headingId} class="v-intro">
	<Topo />
	<MapMark label={place} />
	<div class={wrap}>
		<h1 id={headingId} class="m-0 v-display text-v-title">
			<Emphasis text={headline} enabled />
		</h1>
		{bio && <p class="m-0 mt-7 max-w-lead text-v-lead text-v-body text-pretty">{bio}</p>}
		{now && <NowLine label={now.label} status={now.status} href={now.href} class="mt-6.5" />}
		<SocialLinks links={socials} label={strings.footer.elsewhere} class={cn("mt-7")} />
	</div>
</section>
