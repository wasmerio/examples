---
/**
 * A row of links to the sections of a long page (the Uses page's groups), under its head: pills on the strong
 * hairline as a post's tags (v-tags), each a 44px target, wrapping on narrow screens. A named nav landmark. The
 * sections they point at land clear of the floating nav (scroll-margin-top on each).
 */
import { cn } from "~/utils/cn";

interface Props {
	links: { label: string; href: string }[];
	label: string;
	class?: string;
}

const { links, label, class: className } = Astro.props;
---

<nav aria-label={label} data-jump class={cn("v-jump", className)}>
	<ul role="list" class="v-tags">
		{
			links.map((link) => (
				<li>
					<a href={link.href}>{link.label}</a>
				</li>
			))
		}
	</ul>
</nav>
