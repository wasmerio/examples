---
/**
 * Vesper's image component for the kit's parts (`imageComponent` on Media; the kit's ImageComponentProps in
 * @astronomic/ui/lib/image.ts). The kit draws the frame (and its cut corner); this draws the photo with
 * ContentImage, so EmDash and local images keep their srcset. Callers pass the whole ContentImage as the photo's src
 * (src={entry.image}). The kit's alt wins ("" for decorative photos), eager loading becomes priority, and the kit's
 * sizes hint is used, else the full width's. A fixed size in pixels ("40px") gets that width and its 2x and 3x; any
 * other hint the full width's set. The kit's style (a focalPoint's object-position) goes on the <img>.
 */
import type { ImageComponentProps } from "@astronomic/ui/lib/image.ts";
import type { ContentImage as Image } from "~/content";
import { imageSizes } from "~/utils/layout";
import ContentImage from "./ContentImage.astro";

type Props = ImageComponentProps;

const { src, alt, loading, sizes, class: className, style } = Astro.props;
if (typeof src === "string") throw new Error("KitImage: pass the ContentImage itself as the photo's src, as src={entry.image}");
const image = src as unknown as Image;
const fixed = Number(/^(\d+)px$/.exec(sizes ?? "")?.[1]);
const widths = fixed > 0 ? [fixed, fixed * 2, fixed * 3] : imageSizes.full.widths;
---

<ContentImage image={{ ...image, alt }} priority={loading === "eager"} class={className} widths={widths} sizes={sizes ?? imageSizes.full.sizes} style={style} />
