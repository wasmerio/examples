---
/**
 * The map mark at the top end of the home intro (comp ".mark"), shown only in Trail map and over 900px: a north
 * arrow beside a small label in the look's meta face (the person's place, the settings' `nowPlace`; none: the arrow
 * alone). Decoration only, as a map's corner mark: hidden from screen readers (the place is on the Now page). Clear
 * and Field notes keep it hidden (v-map-mark in src/styles/pages.css).
 */
interface Props {
	label?: string;
}

const { label } = Astro.props;
---

<div class="v-map-mark" aria-hidden="true">
	{label && <span class="v-meta">{label}</span>}
	<svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 2.5l4.5 17-4.5-3.5-4.5 3.5z"></path></svg>
</div>
