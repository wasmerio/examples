---
/**
 * A company's or a project's mark (comp ".logo"): a 40px tile with its top-end corner cut, the logo when there is
 * one, else the initials on one of the six tile colors. Decoration: the name sits beside it.
 */
import type { Mark } from "~/utils/view";
import { imageSizes } from "~/utils/layout";
import ContentImage from "./ContentImage.astro";

type Props = Mark;

const { logo, initials, tile } = Astro.props;
---

<span data-mark data-cut="top-end" data-tile={logo ? undefined : tile} aria-hidden="true" class="v-mark media-cut">
	{logo ? <ContentImage image={{ ...logo, alt: "" }} widths={imageSizes.mark.widths} sizes={imageSizes.mark.sizes} /> : initials}
</span>
