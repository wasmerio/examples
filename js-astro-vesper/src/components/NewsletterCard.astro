---
/**
 * The newsletter card (comp ".card" form), the Dispatch pattern: the kit's SignupForm posting straight to the
 * newsletter service (the setup reader's `newsletterState`: `newsletterAction`, with `newsletterOptions` for its field
 * names, hidden fields and honeypot), the email field and Subscribe on one row, and the note under it ("Join 2,140
 * readers."). With no usable action, or a placeholder one on a live site, the card becomes "Follow by RSS", a link to
 * the feed: never a broken form. On a placeholder action on a site that is not live, the form only pretends: it sends
 * nothing and says so (formSending), and with no script a line says so up front.
 */
import SignupForm from "@astronomic/ui/components/SignupForm.astro";
import { strings } from "~/theme.strings";
import { homeIds } from "~/utils/ids";
import { rssHref } from "~/utils/routes";
import type { NewsletterState } from "~/utils/setup";
import Icon from "./Icon.astro";

interface Props {
	/** The form, or "Follow by RSS" (src/utils/setup.ts, newsletterState). */
	state: NewsletterState;
	note?: string;
	/** The heading's id (the home page's by default; /system/sections shows a second card). */
	headingId?: string;
}

const { state, note, headingId = homeIds.newsletter } = Astro.props;
const t = strings.newsletter;
---

<section aria-labelledby={headingId} class="v-card">
	{
		state.kind === "form" ? (
			<>
				<h2 id={headingId} data-card-head>
					<Icon name="ui/mail" />
					{t.heading}
				</h2>
				<p data-card-text>{t.text}</p>
				<SignupForm
					{...state.props}
					layout="inline"
					labelHidden
					emailLabel={t.emailLabel}
					emailPlaceholder={t.emailPlaceholder}
					submitLabel={t.submit}
					class="mt-4.5"
				/>
				{note && <p data-card-note>{note}</p>}
				{state.demo && <noscript><p data-card-note>{t.demoSent}</p></noscript>}
			</>
		) : (
			<>
				<h2 id={headingId} data-card-head>
					<Icon name="rss" />
					{t.rssHeading}
				</h2>
				<p data-card-text>{t.rssText}</p>
				<a href={rssHref()} class="v-alink mt-3.5">
					{t.rssLink}
					<Icon name="ui/arrow" />
				</a>
			</>
		)
	}
</section>
