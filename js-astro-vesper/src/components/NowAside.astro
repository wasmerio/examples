---
/**
 * The photo beside the Now page's text (comp ".now-aside"): the page's image, 3:4, its top-end corner cut, through
 * the theme's image so both sources keep their srcset. Its alt text is the page's image alt; the page's
 * `imageCaption`, when set, is the short line under it (comp "Last weekend’s walk, 9.4 miles.").
 *
 * The photo opens large in the page's lightbox (PhotoLink; the page sets Base's `lightbox` when it does).
 * The caption sits under the link, not in it, so the link's name is the alt alone; the lightbox gets the caption by
 * attribute. The figure and caption classes are the kit Media's own, so the photo and its line look as before.
 */
import Media from "@astronomic/ui/components/Media.astro";
import type { ContentImage } from "~/content";
import { imageSizes } from "~/utils/layout";
import KitImage from "./KitImage.astro";
import PhotoLink from "./PhotoLink.astro";

interface Props {
	image: ContentImage;
	caption?: string;
}

const { image } = Astro.props;
const caption = Astro.props.caption?.trim() || undefined;
---

<div class="v-aside">
	{
		caption ? (
			<figure class="m-0 grid min-w-0 content-start gap-item">
				<PhotoLink image={image} caption={caption}>
					<Media src={image as never} alt={image.alt} width={image.width} height={image.height} ratio="3/4" shape="cut" cutCorner="top-end" imageComponent={KitImage} sizes={imageSizes.aside.sizes} />
				</PhotoLink>
				<figcaption class="text-small text-pretty text-muted">{caption}</figcaption>
			</figure>
		) : (
			<PhotoLink image={image}>
				<Media src={image as never} alt={image.alt} width={image.width} height={image.height} ratio="3/4" shape="cut" cutCorner="top-end" imageComponent={KitImage} sizes={imageSizes.aside.sizes} />
			</PhotoLink>
		)
	}
</div>
