---
/**
 * The Now line under the intro (comp ".now-line"): the cut chip (the Now page's name: "Now", or the settings'
 * `nowLabel`), the status (one plain line from the settings)
 * and an arrow. A link to the Now page while that page is on; plain text when it is off. The home page leaves it out
 * when the line is switched off (`nowLine` in src/theme.config.ts) or the status is empty.
 */
import { cn } from "~/utils/cn";
import Icon from "./Icon.astro";

interface Props {
	/** The chip's word: the Now page's name. */
	label: string;
	status: string;
	/** The Now page. Without it the line is plain text and has no arrow. */
	href?: string;
	class?: string;
}

const { label, status, href, class: className } = Astro.props;
const Tag = href ? "a" : "span";
---

<p class={cn("m-0", className)}>
	<Tag href={href} class="v-now-line">
		<span data-now-chip data-cut="top-start" class="media-cut">{label}</span>
		<span data-now-text>{status}</span>
		{href && <Icon name="ui/arrow" />}
	</Tag>
</p>
