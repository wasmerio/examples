---
/**
 * A page's head (comp ".p-head"): the h1 in the display face (its one *phrase*, if any, in the look's emphasis), the
 * lead line under it, and anything in the default slot after that (the Now page's stamp). At most 46rem wide.
 */
import Emphasis from "@astronomic/ui/components/Emphasis.astro";
import { cn } from "~/utils/cn";

interface Props {
	title: string;
	lead?: string;
	class?: string;
}

const { title, lead, class: className } = Astro.props;
---

<header class={cn("v-page-head", className)}>
	<h1 class="m-0 v-display text-v-page"><Emphasis text={title} enabled /></h1>
	{lead && <p data-head-lead class="m-0 max-w-lead text-v-lead text-v-body text-pretty">{lead}</p>}
	<slot />
</header>
