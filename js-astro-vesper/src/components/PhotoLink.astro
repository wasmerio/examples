---
/**
 * A photo that opens large in the page's lightbox (the kit's LightboxBar, set "photos"; Base's `lightbox`): the slot
 * (the kit's Media) inside a link to the large file (src/utils/lightbox-image.ts), so with no script the link opens
 * the file. The kit's Media has no link of its own, so the link goes around it: a figure inside a link is valid HTML.
 *
 * The box classes (the photo's spacing, its cut size) go on this component's `class`, never on the Media, so the link
 * is the box. The link's name is the photo's alt, so keep any visible caption outside it and pass its text as
 * `caption` (the kit reads it by attribute: the Media's own figure is inside the link here).
 *
 * Only a photo with alt words opens (a decorative photo would make a nameless link), only when its file is a safe web
 * address (safeImageUrl), and with `minWidth` only at that width or wider (the About photo): isTrigger, the same test
 * the page uses for its Base `lightbox` flag. Otherwise
 * the slot as it is, in a <div> when there is a `class`.
 */
import { getImage } from "astro:assets";
import { lightboxAttrs } from "@astronomic/ui/lib/lightbox.ts";
import type { ContentImage } from "~/content";
import { cn } from "~/utils/cn";
import { isTrigger, lightboxImage, type GetImage } from "~/utils/lightbox-image";

interface Props {
	image: ContentImage;
	/** The caption the lightbox shows (plain text). */
	caption?: string;
	/** The photo's box classes. */
	class?: string;
	/** Opens only at this width or wider (src/utils/lightbox-image.ts ABOUT_MIN_WIDTH). */
	minWidth?: number;
}

const { image, caption, class: className, minWidth } = Astro.props;
const large = isTrigger(image, { minWidth }) ? await lightboxImage(image, getImage as unknown as GetImage) : undefined;
const attrs = large && lightboxAttrs({ group: "photos", caption: caption?.trim() || undefined, srcset: large.srcset, sizes: large.sizes, width: large.width, height: large.height });
---

{
	large ? (
		<a href={large.href} {...attrs} class={cn("v-photo-link", className)}>
			<slot />
		</a>
	) : className ? (
		<div class={className}>
			<slot />
		</div>
	) : (
		<slot />
	)
}
