---
/**
 * One post in the article grid (`articleList: "grid"` in src/theme.config.ts): the kit's Card, open on the page as the
 * project cards, with the photo on top (the kit's Media, 16:10, one corner cut, through the theme's image so both
 * sources keep their srcset), then the date and the category, the title (its link stretched over the card; the
 * accent on hover) and the summary (three lines at most).
 *
 * A post with no photo gets a tile in the same place and shape, so every card in the grid has the same outline: the
 * accent on its soft tint (the Now chip's), with the post's category in the heading face over a small cut square, or
 * the square alone when the post has no category. The photo and the tile are decoration: the title names the post,
 * and the meta line says its category. With thumbnails off (`thumbs`), the card is text only: no photo, no tile, and
 * no image in the markup.
 */
import Card from "@astronomic/ui/components/Card.astro";
import Media from "@astronomic/ui/components/Media.astro";
import type { ItemHeadingTag } from "@astronomic/ui/lib/heading.ts";
import { formatDate, isoDate } from "@astronomic/ui/lib/date.ts";
import { strings } from "~/theme.strings";
import { imageSizes } from "~/utils/layout";
import type { PostRowItem } from "~/utils/view";
import KitImage from "./KitImage.astro";

interface Props {
	post: PostRowItem;
	/** The photo's (or the tile's) cut corner: the grid sets top-end in the first column, top-start in the second. */
	corner: "top-end" | "top-start";
	/** Show the photo, or the tile when there is none (`thumbnails` in src/theme.config.ts). */
	thumbs: boolean;
	/** The title's heading level: h2 under a list page's h1. */
	headingTag: ItemHeadingTag;
}

const { post, corner, thumbs, headingTag: Heading } = Astro.props;
const image = thumbs ? post.thumbnail : undefined;
---

<Card as="li" data-post data-post-card class="v-post-card gap-0 rounded-none border-0 bg-transparent shadow-none">
	{
		thumbs &&
			(image ? (
				<Media
					slot="media"
					src={image as never}
					alt=""
					width={image.width}
					height={image.height}
					ratio="16/10"
					shape="cut"
					cutCorner={corner}
					imageComponent={KitImage}
					sizes={imageSizes.card.sizes}
				/>
			) : (
				<div slot="media" data-post-tile data-cut={corner} aria-hidden="true" class="media-cut">
					<span data-post-tile-mark />
					{post.category && <span data-post-tile-label class="v-heading">{post.category}</span>}
				</div>
			))
	}
	{
		(post.date || post.category) && (
			<p data-post-meta class="v-meta">
				{post.date && <time datetime={isoDate(post.date)}>{formatDate(post.date, strings.locale, { dateStyle: "long" })}</time>}
				{post.category && <span class="v-cat">{post.category}</span>}
			</p>
		)
	}
	<Heading data-post-title class="v-heading">
		<a href={post.href}>{post.title}</a>
	</Heading>
	{post.summary && <p data-post-summary>{post.summary}</p>}
</Card>
