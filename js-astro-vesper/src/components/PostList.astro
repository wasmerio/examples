---
/**
 * A list of posts, newest first, in an ordered list. `rows` (comp ".posts"; the home page, and the article lists
 * with `articleList: "rows"`): one post per row, the thumbnails' cut corners alternating so neighbors face each other.
 * `grid` (the article lists' default): cards in two columns (one on phones), the cuts of the two columns facing each
 * other across the gutter. An empty list says so in a short line.
 */
import type { SectionHeadingTag } from "@astronomic/ui/lib/heading.ts";
import { strings } from "~/theme.strings";
import { cn } from "~/utils/cn";
import type { ArticleList } from "~/utils/config";
import type { PostRowItem } from "~/utils/view";
import PostCard from "./PostCard.astro";
import PostRow from "./PostRow.astro";

interface Props {
	posts: PostRowItem[];
	thumbs: boolean;
	headingTag: SectionHeadingTag;
	/** Rows (the default) or the card grid. */
	layout?: ArticleList;
	class?: string;
}

const { posts, thumbs, headingTag, layout = "rows", class: className } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class={cn("m-0 text-v-body", className)}>{strings.posts.empty}</p>
	) : layout === "grid" ? (
		<ol role="list" data-post-grid class={cn("v-post-grid", className)}>
			{posts.map((post, i) => (
				<PostCard post={post} corner={i % 2 === 0 ? "top-end" : "top-start"} thumbs={thumbs} headingTag={headingTag} />
			))}
		</ol>
	) : (
		<ol role="list" class={cn("v-posts", className)}>
			{posts.map((post, i) => (
				<PostRow post={post} corner={i % 2 === 0 ? "bottom-start" : "top-start"} thumbs={thumbs} headingTag={headingTag} />
			))}
		</ol>
	)
}
