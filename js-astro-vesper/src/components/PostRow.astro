---
/**
 * One post in a list (comp ".post"): the square thumbnail with one cut corner (`corner`: the list alternates
 * bottom-start and top-start, so the cuts of neighbors face each other), then the date and the category, the title
 * (two lines at most; its link stretches over the whole row), the summary (three lines at most) and "Read article"
 * (hidden from screen readers: the title is the link's name). With thumbnails off (`thumbs`), or a post with no
 * thumbnail, the row is text only and no image is in the markup.
 *
 * The thumbnail's layers (src/styles/collage.css, v-thumb): the edge, the mat and the photo, each with its own cut,
 * so a look's edge line and mat stay even along the slice. The photo is decoration: the title says what the post is.
 */
import type { SectionHeadingTag } from "@astronomic/ui/lib/heading.ts";
import { formatDate, isoDate } from "@astronomic/ui/lib/date.ts";
import { strings } from "~/theme.strings";
import { imageSizes } from "~/utils/layout";
import type { PostRowItem } from "~/utils/view";
import ContentImage from "./ContentImage.astro";
import Icon from "./Icon.astro";

interface Props {
	post: PostRowItem;
	/** The thumbnail's cut corner. */
	corner: "bottom-start" | "top-start";
	/** Show the thumbnail (`thumbnails` in src/theme.config.ts). */
	thumbs: boolean;
	/** The title's heading level: h3 under a section's h2 (the home), h2 under a page's h1 (a list page). */
	headingTag: SectionHeadingTag;
}

const { post, corner, thumbs, headingTag: Heading } = Astro.props;
const thumb = thumbs ? post.thumbnail : undefined;
---

<li data-post data-thumbed={thumb ? "" : undefined} class="v-post">
	{
		thumb && (
			<div class="v-thumb">
				<div data-thumb-edge data-cut={corner} class="media-cut">
					<div data-thumb-mat data-cut={corner} class="media-cut">
						<div data-thumb-photo data-cut={corner} class="media-cut">
							<ContentImage image={{ ...thumb, alt: "" }} widths={imageSizes.thumb.widths} sizes={imageSizes.thumb.sizes} />
						</div>
					</div>
				</div>
			</div>
		)
	}
	<div class="min-w-0">
		{
			(post.date || post.category) && (
				<p data-post-meta class="v-meta">
					{post.date && <time datetime={isoDate(post.date)}>{formatDate(post.date, strings.locale, { dateStyle: "long" })}</time>}
					{post.category && <span class="v-cat">{post.category}</span>}
				</p>
			)
		}
		<Heading data-post-title class="v-heading">
			<a href={post.href}>{post.title}</a>
		</Heading>
		{post.summary && <p data-post-summary>{post.summary}</p>}
		<span data-post-read class="v-alink" aria-hidden="true">
			{strings.posts.read}
			<Icon name="ui/arrow" />
		</span>
	</div>
</li>
