---
/**
 * Previous and next (comp ".pn"): the older and the newer post as two filled cards, the next one at the end. Either
 * may be missing (the oldest and the newest post).
 */
import { strings } from "~/theme.strings";
import Icon from "./Icon.astro";

type Item = { href: string; title: string };

interface Props {
	previous?: Item;
	next?: Item;
}

const { previous, next } = Astro.props;
const t = strings.article;
---

{
	(previous || next) && (
		<nav aria-label={t.more}>
			<ul role="list" class="v-pn">
				{previous && (
					<li data-pn="previous">
						<a href={previous.href} rel="prev">
							<span data-pn-label class="v-meta">
								<Icon name="ui/arrow-left" />
								{t.previous}
							</span>
							<span data-pn-title>{previous.title}</span>
						</a>
					</li>
				)}
				{next && (
					<li data-pn="next">
						<a href={next.href} rel="next">
							<span data-pn-label class="v-meta">
								{t.next}
								<Icon name="ui/arrow" />
							</span>
							<span data-pn-title>{next.title}</span>
						</a>
					</li>
				)}
			</ul>
		</nav>
	)
}
