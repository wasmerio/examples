---
/**
 * A project in the projects grid (comp ".proj"): the kit's Card, open on the page (no fill, edge or padding, as the
 * comp), with the photo in its media slot (the kit's Media, 16:10, one corner cut, through the theme's image so both
 * sources keep their srcset), then the mark beside the title (the card's one link, stretched over the card; the
 * accent on hover), the summary and a plain line that says the project has an outside link. A project with no photo is the same
 * card without media. The photo is decoration: the title names the project.
 */
import Card from "@astronomic/ui/components/Card.astro";
import Media from "@astronomic/ui/components/Media.astro";
import type { CutCorner } from "@astronomic/ui/lib/image.ts";
import type { ItemHeadingTag } from "@astronomic/ui/lib/heading.ts";
import { imageSizes } from "~/utils/layout";
import type { ProjectCardItem } from "~/utils/view";
import Icon from "./Icon.astro";
import KitImage from "./KitImage.astro";
import Mark from "./Mark.astro";

interface Props {
	project: ProjectCardItem;
	/** The photo's cut corner (the grid varies it, as the comp). */
	corner: CutCorner;
	headingTag: ItemHeadingTag;
}

const { project, corner, headingTag: Heading } = Astro.props;
const image = project.image;
---

<Card as="li" data-proj-card class="v-proj gap-0 rounded-none border-0 bg-transparent shadow-none">
	{
		image && (
			<Media
				slot="media"
				src={image as never}
				alt=""
				width={image.width}
				height={image.height}
				ratio="16/10"
				shape="cut"
				cutCorner={corner}
				imageComponent={KitImage}
				sizes={imageSizes.project.sizes}
			/>
		)
	}
	<div data-proj-row>
		<Mark logo={project.logo} initials={project.initials} tile={project.tile} />
		<Heading class="v-heading">
			<a href={project.href}>{project.title}</a>
		</Heading>
	</div>
	{project.summary && <p data-proj-text>{project.summary}</p>}
	{
		(project.link || project.year) && (
			<p data-proj-meta class="v-meta">
				{project.link && (
					<span>
						<Icon name="ui/link" />
						{project.link.label}
					</span>
				)}
				{project.year && <span>{project.year}</span>}
			</p>
		)
	}
</Card>
