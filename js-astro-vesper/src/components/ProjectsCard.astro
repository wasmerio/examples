---
/**
 * The Projects card (comp "Projects"): the featured projects (three at most), each with its mark, its name (a link to
 * its page over the whole row) and its line, then "All projects". The home page leaves it out while the Projects page
 * is off or there is no featured project.
 */
import { strings } from "~/theme.strings";
import { homeIds } from "~/utils/ids";
import { projectsHref } from "~/utils/routes";
import type { ProjectItem } from "~/utils/view";
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";

interface Props {
	projects: ProjectItem[];
}

const { projects } = Astro.props;
const t = strings.projects;
const headingId = homeIds.projects;
---

<section aria-labelledby={headingId} class="v-card">
	<h2 id={headingId} data-card-head>
		<Icon name="ui/box" />
		{t.heading}
	</h2>
	<ul role="list" class="v-mini">
		{
			projects.map((p) => (
				<li>
					<Mark logo={p.logo} initials={p.initials} tile={p.tile} />
					<a href={p.href}>{p.title}</a>
					{p.summary && <span data-mini-text>{p.summary}</span>}
				</li>
			))
		}
	</ul>
	<a href={projectsHref()} class="v-alink">
		{t.all}
		<Icon name="ui/arrow" />
	</a>
</section>
