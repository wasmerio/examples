---
/**
 * Vesper's rich text: theme-core's RichText with this source's renderers (Markdown, EmDash's Portable Text).
 */
import RichText from "@astronomic/theme-core/components/RichText.astro";
import { useContent, type RichText as Value } from "~/content";

interface Props {
	value: Value;
}
---

<RichText value={Astro.props.value} renderers={useContent(Astro).renderers.richText} />
