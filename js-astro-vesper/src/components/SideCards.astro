---
/**
 * The side cards beside the newest posts (comp ".side"): the newsletter (or Follow by RSS), Work and Projects, as
 * filled panels with no edge. The home page decides which show (src/utils/home.ts, homeCards).
 */
import { cn } from "~/utils/cn";
import type { NewsletterState } from "~/utils/setup";
import type { ProjectItem, WorkRow } from "~/utils/view";
import NewsletterCard from "./NewsletterCard.astro";
import ProjectsCard from "./ProjectsCard.astro";
import WorkCard from "./WorkCard.astro";

interface Props {
	/** The aside's accessible name. */
	label: string;
	newsletter: { state: NewsletterState; note?: string };
	/** The Work card, or none. */
	work?: { jobs: WorkRow[]; cvFile?: string };
	/** The Projects card, or none. */
	projects?: ProjectItem[];
	class?: string;
}

const { label, newsletter, work, projects, class: className } = Astro.props;
---

<aside aria-label={label} class={cn("v-side", className)}>
	<NewsletterCard {...newsletter} />
	{work && <WorkCard {...work} />}
	{projects && <ProjectsCard projects={projects} />}
</aside>
