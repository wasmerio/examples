---
/**
 * The site footer (comp "Footer"), on the kit's Footer shell, on the page with no rule above it (no divider lines):
 * the `footer` menu's links on the left (with the search page's and, while they are on, the design system's), the
 * person's social links as icons on the right (44px squares, each named for screen readers), then the last row:
 * "© year name." and the sample-content note while `sampleContent` is on, and "Built with Astronomic" with the
 * four-point star (`builtWith` in src/theme.config.ts) at the end. Up to 600px everything stacks on the start edge.
 */
import Footer from "@astronomic/ui/components/Footer.astro";
import { touchBox } from "@astronomic/ui/lib/button.ts";
import { relFor, type NavLink } from "@astronomic/ui/lib/nav.ts";
import { strings } from "~/theme.strings";
import { cn } from "~/utils/cn";
import { sectionSpace, wrap } from "~/utils/layout";
import SocialLinks, { type SocialLinkItem } from "./SocialLinks.astro";

interface Props {
	/** The `footer` menu's links, then the search and design system links. */
	links: NavLink[];
	socials: SocialLinkItem[];
	/** The name in the copyright line. */
	name: string;
	/** Show the sample-content note (the demo). */
	sampleContent?: boolean;
	/** Show the Built with Astronomic link. */
	builtWith?: boolean;
}

const { links, socials, name, sampleContent = false, builtWith = false } = Astro.props;
const t = strings.footer;
const year = new Date().getFullYear();
const link = "inline-flex min-h-11 items-center rounded-control px-2.5 text-v-nav text-v-body no-underline hover:text-fg hover:underline aria-[current=page]:text-fg aria-[current=page]:font-semibold";
---

<Footer
	class={cn(sectionSpace, "border-t-0")}
	contentClass={cn(wrap, "grid-cols-[minmax(0,1fr)_auto] items-start gap-x-12 gap-y-6 px-0 pt-6 pb-0 max-phone:grid-cols-1")}
>
	{
		links.length > 0 && (
			<nav aria-label={t.label}>
				<ul role="list" class="-ms-2.5 my-0 flex list-none flex-wrap gap-x-1 p-0">
					{links.map((item) => (
						<li>
							<a href={item.href} target={item.target} rel={relFor(item.target)} aria-current={item.current ? "page" : undefined} class={link}>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}
	<SocialLinks links={socials} label={t.elsewhere} iconOnly class="-me-2.5 justify-end max-phone:-ms-2.5 max-phone:me-0 max-phone:justify-start" />
	<div slot="bottom" class={cn(wrap, "flex flex-wrap items-center justify-between gap-x-6 gap-y-2 pt-6 pb-10 text-v-fine text-muted max-phone:flex-col max-phone:items-start")}>
		<p class="m-0 text-pretty">
			{t.copyright(year, name)}
			{sampleContent && <> {t.sampleContent}</>}
		</p>
		{
			builtWith && (
				<a href="https://astronomic.dev" class={cn("inline-flex items-center gap-1.75 rounded-control text-inherit no-underline hover:text-fg hover:underline", touchBox)}>
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" class="size-3.25 shrink-0">
						<path d="M12 0c.6 6.2 5.3 11.4 12 12-6.7.6-11.4 5.8-12 12-.6-6.2-5.3-11.4-12-12 6.7-.6 11.4-5.8 12-12z"></path>
					</svg>
					{t.builtWith}
				</a>
			)
		}
	</div>
</Footer>
