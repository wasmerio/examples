---
/**
 * The person's social links (comp ".socials"): each link an icon (19px, from the theme's set) and its label, 44px
 * tall, the body color, the text color and the surface on hover. The home intro shows them labeled; the footer
 * (`iconOnly`) shows the icons alone, each a 44px square whose label is for screen readers only. A list with an
 * accessible name ("Elsewhere"). A link opens where its target says (a new tab gets noopener).
 */
import { relFor } from "@astronomic/ui/lib/nav.ts";
import { cn } from "~/utils/cn";
import Icon from "./Icon.astro";

export type SocialLinkItem = { label: string; href: string; icon: string; target?: string };

interface Props {
	links: SocialLinkItem[];
	/** Accessible name of the list. */
	label: string;
	/** The footer's icons alone, each with its label for screen readers. */
	iconOnly?: boolean;
	class?: string;
}

const { links, label, iconOnly = false, class: className } = Astro.props;
---

{
	links.length > 0 && (
		<ul role="list" aria-label={label} class={cn("m-0 flex list-none flex-wrap gap-x-1 gap-y-1.5 p-0", iconOnly ? "gap-x-0" : "-ms-2.5", className)}>
			{links.map((link) => (
				<li>
					<a
						href={link.href}
						target={link.target}
						rel={relFor(link.target)}
						class={cn(
							"inline-flex min-h-11 items-center gap-2 rounded-control text-v-nav text-v-body no-underline hover:bg-surface hover:text-fg motion-safe:transition-colors motion-safe:duration-200",
							iconOnly ? "w-11 justify-center" : "px-2.5",
						)}
					>
						<Icon name={link.icon} class="size-v-icon" />
						<span class={iconOnly ? "sr-only" : undefined}>{link.label}</span>
					</a>
				</li>
			))}
		</ul>
	)
}
