---
/** A post's tags (comp ".tags"): pills linking to each tag's page; each a 44px target. */
import { strings } from "~/theme.strings";
import { tagHref } from "~/utils/routes";

interface Props {
	tags: { slug: string; label: string }[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul role="list" aria-label={strings.article.tags} class="v-tags">
			{tags.map((tag) => (
				<li>
					<a href={tagHref(tag.slug)}>{tag.label}</a>
				</li>
			))}
		</ul>
	)
}
