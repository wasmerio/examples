---
/**
 * The talks by year (comp ".yr-h", ".talk"): each year an h2 in a 148px rail beside its talks (above them up to
 * 900px), newest first. A talk: the event, the place and the date (a slash between each, read as a comma), the title (h3), its line, and the links to the
 * recording and the slides (each link's name ends with the talk's title for screen readers). Each year is a
 * section named by its heading.
 */
import { formatDate, isoDate } from "@astronomic/ui/lib/date.ts";
import { strings } from "~/theme.strings";
import type { TalkItem } from "~/utils/view";
import Icon from "./Icon.astro";
import Sep from "./Sep.astro";

interface Props {
	years: { year: number; talks: TalkItem[] }[];
}

const { years } = Astro.props;
const t = strings.speaking;
---

<div class="v-talks">
	{
		years.map(({ year, talks }) => (
			<section aria-labelledby={`talks-${year}`} data-talk-year>
				<h2 id={`talks-${year}`} class="v-heading">
					{year}
				</h2>
				<ul role="list">
					{talks.map((talk) => (
						<li data-talk>
							<p data-talk-meta class="v-meta">
								<span>{talk.event}</span>
								<Sep />
								{talk.place && (
									<>
										<span>{talk.place}</span>
										<Sep />
									</>
								)}
								<time datetime={isoDate(talk.date)}>{formatDate(talk.date, strings.locale, { dateStyle: "long" })}</time>
							</p>
							<h3 class="v-heading">{talk.title}</h3>
							{talk.summary && <p data-talk-text>{talk.summary}</p>}
							{(talk.video || talk.slides) && (
								<p data-talk-links>
									{talk.video && (
										<a href={talk.video} class="v-alink">
											<Icon name="ui/play" />
											{t.video}
											<span class="sr-only">: {talk.title}</span>
										</a>
									)}
									{talk.slides && (
										<a href={talk.slides} class="v-alink">
											{t.slides}
											<span class="sr-only">: {talk.title}</span>
											<Icon name="ui/arrow" />
										</a>
									)}
								</p>
							)}
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>
