---
/**
 * The uses items by group (comp ".ugroup"), across the content's full width (no page photo beside them). Each group is a section named by its heading (h2, the strongest type on the page under the h1) and reached by
 * its id (`id`, from its name: the jump links at the top of the page point at it, and it lands clear of the floating
 * nav). On wide screens the heading, and under it the group's photo when one of its items gives it one (4:3, one
 * corner cut, with its alt text), sit in a side column beside the items; up to 900px they stack above them. The items
 * are a description list with no lines between the rows: the name (the next weight down) in its own column beside the
 * note (the quietest: smaller, muted), stacked on phones. An item with a link adds it under the note: a text link in
 * the accent, or a button (`linkButton`), in the link's own words, else its address (src/styles/sections.css, v-uses).
 * An item with only a name keeps the list valid with an empty, hidden description.
 */
import Button from "@astronomic/ui/components/Button.astro";
import { touchBox } from "@astronomic/ui/lib/button.ts";
import Media from "@astronomic/ui/components/Media.astro";
import { imageSizes } from "~/utils/layout";
import type { UsesGroup } from "~/utils/view";
import Icon from "./Icon.astro";
import KitImage from "./KitImage.astro";

interface Props {
	groups: UsesGroup[];
}

const { groups } = Astro.props;
---

<div class="v-uses">
	{
		groups.map(({ group, id, image, items }) => (
			<section id={id} aria-labelledby={`${id}-heading`} data-uses-group>
				<div data-uses-side>
					<h2 id={`${id}-heading`} class="v-heading">
						{group}
					</h2>
					{image && (
						<Media
							src={image as never}
							alt={image.alt}
							width={image.width}
							height={image.height}
							ratio="4/3"
							shape="cut"
							cutCorner="top-end"
							imageComponent={KitImage}
							sizes={imageSizes.usesGroup.sizes}
							data-uses-photo
						/>
					)}
				</div>
				<dl>
					{items.map((item) => (
						<div data-uses-item>
							<dt>{item.name}</dt>
							{item.note && <dd data-uses-note>{item.note}</dd>}
							{/* A name alone still needs a description for valid markup: an empty one, hidden from layout and screen readers. */}
							{!item.note && !item.link && <dd hidden />}
							{item.link && (
								<dd data-uses-link>
									{item.link.button ? (
										<Button href={item.link.href} variant="secondary" size="sm" class={touchBox}>
											{item.link.label}
											<Icon name="ui/arrow" class="size-4" />
										</Button>
									) : (
										<a href={item.link.href} class="v-alink">
											{item.link.label}
											<Icon name="ui/arrow" />
										</a>
									)}
								</dd>
							)}
						</div>
					))}
				</dl>
			</section>
		))
	}
</div>
