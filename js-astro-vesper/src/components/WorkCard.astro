---
/**
 * The Work card (comp "Work"): the jobs in their order, each with its mark, the company over the role and the years
 * ("2022 – Now"), then "Download CV" when the settings name a CV file.
 */
import { buttonClasses } from "@astronomic/ui/lib/button.ts";
import { strings } from "~/theme.strings";
import { homeIds } from "~/utils/ids";
import { cn } from "~/utils/cn";
import type { WorkRow } from "~/utils/view";
import Icon from "./Icon.astro";
import WorkRows from "./WorkRows.astro";

interface Props {
	jobs: WorkRow[];
	/** The CV: a site path or a full URL. None: no button. */
	cvFile?: string;
}

const { jobs, cvFile } = Astro.props;
const t = strings.work;
const headingId = homeIds.work;
---

<section aria-labelledby={headingId} class="v-card">
	<h2 id={headingId} data-card-head>
		<Icon name="ui/briefcase" />
		{t.heading}
	</h2>
	{
		jobs.length > 0 && (
			<WorkRows jobs={jobs} />
		)
	}
	{
		cvFile && (
			<a href={cvFile} download data-card-action class={cn(buttonClasses({ variant: "secondary" }))}>
				{t.cv}
				<Icon name="ui/download" class="size-4" />
			</a>
		)
	}
</section>
