---
/**
 * The jobs as rows (comp ".roles"): each with its mark, the company (a link when the job has one) over the role, and
 * the years ("2022 – Now"). The Work card and the about page's work history.
 */
import type { WorkRow } from "~/utils/view";
import Mark from "./Mark.astro";

interface Props {
	jobs: WorkRow[];
}

const { jobs } = Astro.props;
---

<ol role="list" class="v-roles">
	{
		jobs.map((job) => (
			<li>
				<Mark logo={job.logo} initials={job.initials} tile={job.tile} />
				<span data-role-company>{job.href ? <a href={job.href}>{job.company}</a> : job.company}</span>
				<span data-role-name>{job.role}</span>
				<span data-role-years class="v-meta">
					{job.years}
				</span>
			</li>
		))
	}
</ol>
