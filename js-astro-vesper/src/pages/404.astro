---
/**
 * The not-found page: any address that does not exist. Plain: the heading, a line, and links home and to the
 * articles. Kept out of search results.
 */
import Icon from "~/components/Icon.astro";
import Base from "~/layouts/Base.astro";
import { strings } from "~/theme.strings";
import { articlesHref, homeHref } from "~/utils/routes";
import { wrap } from "~/utils/layout";
import { cn } from "~/utils/cn";

const t = strings.notFound;
---

<Base title={t.title} noindex>
	<div class={cn(wrap, "pt-22 pb-20 max-tablet:pt-14 max-tablet:pb-12")}>
		<h1 class="m-0 v-display text-v-page">{t.title}</h1>
		<p class="mt-6 max-w-lead text-v-lead text-v-body text-pretty">{t.text}</p>
		<p class="mt-6 flex flex-wrap gap-x-7 gap-y-2">
			<a href={homeHref()} class="v-alink">
				{t.home}
				<Icon name="ui/arrow" />
			</a>
			<a href={articlesHref()} class="v-alink">
				{t.articles}
				<Icon name="ui/arrow" />
			</a>
		</p>
	</div>
</Base>
