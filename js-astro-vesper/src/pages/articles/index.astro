---
/** Articles, page 1: the newest PER_PAGE posts, the category filter and the pages after them. */
import { collectionPageNode } from "@astronomic/theme-core/jsonld";
import ArticlesPage from "~/components/ArticlesPage.astro";
import { searchKind, useContent } from "~/content";
import Base from "~/layouts/Base.astro";
import { strings } from "~/theme.strings";
import { usedTerms } from "~/utils/articles";
import { getConfig } from "~/utils/config";
import { siteOrigin } from "~/utils/public-pages";
import { articlesHref, categoryHref, PER_PAGE, pageCount } from "~/utils/routes";
import { siteSettings } from "~/utils/setup";
import { toPostRow } from "~/utils/view";

const content = useContent(Astro);
const [{ items }, count, categories, settings] = await Promise.all([content.posts.list({ limit: PER_PAGE }), content.posts.count(), usedTerms(content, "category"), siteSettings(content)]);
const { config } = getConfig(settings);
const t = strings.articles;
const filters = [{ label: t.all, href: articlesHref(), current: true }, ...categories.map((c) => ({ label: c.label, href: categoryHref(c.slug) }))];
const jsonLd = collectionPageNode(siteOrigin(Astro), { path: articlesHref(), name: t.title, description: t.text });
---

<Base title={t.title} description={t.text} card jsonLd={jsonLd}>
	<ArticlesPage title={t.title} lead={t.text} posts={items.map(toPostRow)} filters={filters} search={!!searchKind(content)} thumbs={config.thumbnails} layout={config.articleList} current={1} total={pageCount(count)} href={articlesHref} />
</Base>
