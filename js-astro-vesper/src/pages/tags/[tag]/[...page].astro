---
/**
 * One tag's posts, every page (`/tags/film`, `/tags/film/page/2`), with the category filter (no category current).
 * A tag with no posts, or a page past the last, answers 404.
 */
import { collectionPageNode } from "@astronomic/theme-core/jsonld";
import ArticlesPage from "~/components/ArticlesPage.astro";
import { searchKind, useContent } from "~/content";
import Base from "~/layouts/Base.astro";
import { strings } from "~/theme.strings";
import { tagPaths, usedTerms } from "~/utils/articles";
import { getConfig } from "~/utils/config";
import { articlesHref, categoryHref, hasPage, PER_PAGE, pageCount, restPage, tagHref } from "~/utils/routes";
import { pageAt, siteOrigin } from "~/utils/public-pages";
import { siteSettings } from "~/utils/setup";
import { toPostRow } from "~/utils/view";

export const getStaticPaths = () => tagPaths(useContent());

const content = useContent(Astro);
const page = restPage(Astro.params.page);
const [tags, categories] = await Promise.all([usedTerms(content, "tag"), usedTerms(content, "category")]);
const tag = tags.find((x) => x.slug === Astro.params.tag);
if (!tag || !page || !hasPage(page, tag.count)) {
	return Astro.rewrite("/404");
}
const [{ items }, settings] = await Promise.all([content.posts.list({ tag: tag.slug, limit: PER_PAGE, offset: (page - 1) * PER_PAGE }), siteSettings(content)]);
const { config } = getConfig(settings);
const t = strings.articles;
// Its own share card only when it is a public page (src/utils/public-pages.ts): a term whose every post is hidden from
// search engines has none, so it shares the home card.
const card = page === 1 && (await pageAt(tagHref(tag.slug))) !== undefined;
const filters = [{ label: t.all, href: articlesHref() }, ...categories.map((c) => ({ label: c.label, href: categoryHref(c.slug) }))];
const title = t.tagTitle(tag.label);
const jsonLd = collectionPageNode(siteOrigin(Astro), { path: tagHref(tag.slug, page), name: page > 1 ? t.pageOf(title, page) : title, description: t.tagText(tag.label, tag.count) });
---

<Base title={page > 1 ? t.pageOf(title, page) : title} description={t.tagText(tag.label, tag.count)} jsonLd={jsonLd} card={card}>
	<ArticlesPage
		title={title}
		lead={t.tagText(tag.label, tag.count)}
		posts={items.map(toPostRow)}
		filters={filters}
		search={!!searchKind(content)}
		thumbs={config.thumbnails} layout={config.articleList}
		current={page}
		total={pageCount(tag.count)}
		href={(n) => tagHref(tag.slug, n)}
	/>
</Base>
