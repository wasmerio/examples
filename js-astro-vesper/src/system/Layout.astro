---
/** Wraps the design system pages in the Vesper layout, inside the page container (the system pages bring none). */
import Base from "../layouts/Base.astro";
import { cn } from "../utils/cn";
import { wrap } from "../utils/layout";

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<Base title={title} noindex><div class={cn(wrap, "pt-10")}><slot /></div></Base>
