---
/**
 * 阅读进度条：页眉底边 1px accent 细线，使用纯 CSS Scroll-Driven Animation (`animation-timeline: scroll(root block)`)
 * 与页面垂直滚动位置同步，零 JS；`prefers-reduced-motion: reduce` 下隐藏。
 */
---

<div class="wisp-progress" data-reading-progress aria-hidden="true"></div>

<style>
  @keyframes wisp-reading-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    .wisp-progress {
      /* 压在页眉底部的发丝线上：阅读进度就是书眉下沿的一条强调色线 */
      position: fixed;
      inset: calc(var(--wisp-header-h) - 1px) 0 auto 0;
      z-index: 21;
      height: 1px;
      background: var(--wisp-accent);
      transform: scaleX(0);
      transform-origin: left;
      pointer-events: none;
      opacity: 0;
    }
    :global([dir='rtl']) .wisp-progress {
      transform-origin: right;
    }
    @media (prefers-reduced-motion: no-preference) {
      .wisp-progress {
        opacity: 1;
        animation-name: wisp-reading-progress;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0% 100%;
      }
    }
    @media (forced-colors: active) {
      .wisp-progress {
        background: Highlight;
        forced-color-adjust: none;
      }
    }
  }
</style>
