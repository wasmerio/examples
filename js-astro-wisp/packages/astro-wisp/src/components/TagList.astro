---
/**
 * 标签列表：`#标签名` 文本链接，muted，hover 变 accent。无胶囊背景。
 */
import config from 'virtual:wisp/config';
import { slugify } from '../utils/taxonomy';
import { sitePath } from '../utils/paths';

export interface Props {
  /** 标签名（原文，链接时用 slugify + taxonomy.slugMap 生成 URL 段） */
  tags: string[];
  /** 链接前缀，默认 `/tags/` */
  base?: string;
  /** 额外 class */
  class?: string;
  /** 列表的无障碍名称，默认“标签” */
  label?: string;
}

const {
  tags,
  base = '/tags/',
  class: className,
  label = /^zh\b/i.test(config.site.lang) ? '标签' : 'Tags',
} = Astro.props;
const linkBase = sitePath(import.meta.env.BASE_URL, base);
---

{tags.length > 0 && (
  <ul class:list={['wisp-tags', className]} aria-label={label}>
    {tags.map((t) => (
      <li>
        <a href={`${linkBase}${slugify(t, config.taxonomy.slugMap)}/`}>#{t}</a>
      </li>
    ))}
  </ul>
)}

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    .wisp-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25em 0.9em;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .wisp-tags a {
      display: inline-flex;
      align-items: center;
      min-height: 2rem;
      color: var(--wisp-muted);
      transition: color 150ms;
    }
    .wisp-tags a:hover {
      color: var(--wisp-accent);
    }
    /* 触屏及窄屏：收紧换行行距，同时保持 ≥ 28px+ 触控命中区 */
    @media (pointer: coarse), (max-width: 47.99rem) {
      .wisp-tags {
        row-gap: 0.25rem;
      }
      .wisp-tags a {
        min-height: 1.75rem;
        padding-block: 0.25rem;
        margin-block: -0.125rem;
      }
    }
  }
</style>
