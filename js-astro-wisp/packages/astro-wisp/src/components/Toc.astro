---
/**
 * 文章目录。两种形态：
 * - `aside`：宽屏（≥ 60rem）右侧 sticky 栏，由 Post 布局放进侧栏；可收起（状态存 localStorage），
 *   h2 下的 h3 默认折叠，只展开当前阅读所在分组。栏顶是与系列栏成对的标题按钮「目录 ⌄」
 *   （收起后仍是这一行），篇目在下面独立滚动的 [data-rail-scroll] 里；
 * - `inline`：窄屏文首的 <details> 折叠目录（≥ 60rem 时由 Post 布局隐藏）。
 * 当前章节高亮由 IntersectionObserver 实现，同时作用于页面上所有目录实例；点击目录项立即高亮，
 * 滚到页面底部时高亮最后一节（最后几节往往到不了视口上部）。
 * 无 JS 时：目录完整展开，收起和折叠按钮不显示（`html[data-toc]` 由 Post 的内联脚本写入，作为 JS 可用的标记）。
 */
import type { MarkdownHeading } from 'astro';
import katex from 'katex';
import Icon from 'virtual:wisp/components/Icon';
import config from 'virtual:wisp/config';
import { parseInlineMath, plainInlineMath } from '../explainers/core/math';
import { escapeHtml, formatTitleHtml } from '../utils/title';

export interface Props {
  /** 已过滤好的标题（通常 depth 2–3） */
  headings: MarkdownHeading[];
  /** 形态，默认 `aside` */
  variant?: 'aside' | 'inline';
  /** 标题文字，默认“目录” */
  title?: string;
  /** 文章语言 */
  lang?: string;
}

const {
  headings,
  variant = 'aside',
  lang = config.site.lang,
  title = /^zh\b/i.test(lang) ? '目录' : 'Contents',
} = Astro.props;
const zh = /^zh\b/i.test(lang);
const collapseLabel = zh ? `收起${title}` : `Hide ${title.toLowerCase()}`;
const expandLabel = zh ? `展开${title}` : `Show ${title.toLowerCase()}`;
const minDepth = Math.min(...headings.map((h) => h.depth));
const list = headings.map((h) => ({ ...h, level: h.depth - minDepth }));

// aside：把 h3 归到前一个 h2 下
type Item = (typeof list)[number];
const groups: { head: Item; kids: Item[] }[] = [];
for (const h of list) {
  const last = groups[groups.length - 1];
  if (h.level > 0 && last) last.kids.push(h);
  else groups.push({ head: h, kids: [] });
}

// 章节编号：h2 为 1、2、3…，h3 为 1.1、1.2…；与正文 .prose h2/h3 的 CSS 计数器一致。
// 只在顶层是 h2 时编号（正文计数器同样只数 h2 及其下的 h3）。
const numberOn = minDepth === 2;
const numbers = new Map<string, string>();
{
  let a = 0;
  let b = 0;
  for (const h of list) {
    if (h.level === 0) {
      a += 1;
      b = 0;
      numbers.set(h.slug, String(a));
    } else if (a > 0) {
      b += 1;
      numbers.set(h.slug, `${a}.${b}`);
    }
  }
}
const no = (slug: string) => (numberOn ? numbers.get(slug) : undefined);

// 标题中的 $...$ 行内公式：正文已由 rehype-katex 渲染，目录链接需在构建时同样渲染，
// 否则侧边栏/折叠目录里显示原始 $...$ 源码。非公式段做 HTML 转义后经 set:html 输出。
function renderHeadingText(text: string): string {
  if (!config.features.math || !text.includes('$')) return formatTitleHtml(text);
  return parseInlineMath(text)
    .map((seg) => {
      if (seg.type === 'math') {
        try {
          return katex.renderToString(seg.value, { throwOnError: false });
        } catch {
          return escapeHtml(seg.value);
        }
      }
      return formatTitleHtml(seg.value);
    })
    .join('');
}
const subToggleLabel = (text: string) => {
  const clean = plainInlineMath(text);
  return zh ? `展开/收起「${clean}」小节` : `Toggle ${clean} subsections`;
};
---

{headings.length > 0 &&
  (variant === 'inline' ? (
    <nav aria-label={title}>
      <details class="wisp-toc wisp-toc-inline">
        <summary>
          <span class="wisp-toc-summary-label">{title}</span>
          <span class="wisp-toc-head-ico" aria-hidden="true">
            <Icon name="chevron-down" />
          </span>
        </summary>
        <ol>
          {list.map((h) => (
            <li data-level={h.level}>
              <a href={`#${h.slug}`} data-toc-link={h.slug}>
                {no(h.slug) && <span class="wisp-toc-no">{no(h.slug)}</span>}
                <span set:html={renderHeadingText(h.text)} />
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  ) : (
    <nav class="wisp-toc wisp-toc-aside" aria-label={title}>
      {/* 无 JS：静态标题行；有 JS：同一行换成可切换的按钮（与系列栏的标题行同尺寸、同一种 chevron） */}
      <p class="wisp-toc-title">
        <span class="wisp-toc-title-label">{title}</span>
      </p>
      <button
        type="button"
        class="wisp-toc-title wisp-toc-toggle"
        aria-expanded="true"
        aria-controls="wisp-toc-scroll"
        data-toc-toggle
        data-label-open={collapseLabel}
        data-label-closed={expandLabel}
        title={collapseLabel}
      >
        <span class="wisp-toc-title-label">{title}</span>
        <span class="wisp-toc-head-ico" aria-hidden="true">
          <Icon name="chevron-down" />
        </span>
      </button>
      <div id="wisp-toc-scroll" class="wisp-rail-scroll" data-rail-scroll>
        <ol id="wisp-toc-list">
          {groups.map(({ head, kids }, i) =>
            kids.length === 0 ? (
              <li>
                <a href={`#${head.slug}`} data-toc-link={head.slug}>
                  {no(head.slug) && <span class="wisp-toc-no">{no(head.slug)}</span>}
                  <span set:html={renderHeadingText(head.text)} />
                </a>
              </li>
            ) : (
              <li data-group>
                <div class="wisp-toc-row">
                  <a href={`#${head.slug}`} data-toc-link={head.slug}>
                    {no(head.slug) && <span class="wisp-toc-no">{no(head.slug)}</span>}
                    <span set:html={renderHeadingText(head.text)} />
                  </a>
                  <button
                    type="button"
                    class="wisp-toc-sub-toggle"
                    aria-expanded="false"
                    aria-controls={`wisp-toc-sub-${i}`}
                  >
                    <Icon name="chevron-right" class="wisp-toc-chev" />
                    <span class="sr-only">{subToggleLabel(head.text)}</span>
                  </button>
                </div>
                <ol id={`wisp-toc-sub-${i}`}>
                  {kids.map((k) => (
                    <li>
                      <a href={`#${k.slug}`} data-toc-link={k.slug}>
                        {no(k.slug) && <span class="wisp-toc-no">{no(k.slug)}</span>}
                        <span set:html={renderHeadingText(k.text)} />
                      </a>
                    </li>
                  ))}
                </ol>
              </li>
            ),
          )}
        </ol>
      </div>
    </nav>
  ))}

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    .wisp-toc {
      font-size: 0.875rem;
      line-height: 1.55;
    }
    .wisp-toc ol {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .wisp-toc li {
      margin: 0;
    }
    /* 编号 + 标题两列：编号等宽数字、muted 色（读者靠它找位置，是文字，不用 subtle），换行后标题悬挂对齐 */
    .wisp-toc a {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      padding-block: 0.3rem;
      color: var(--wisp-muted);
      transition: color 150ms;
    }
    .wisp-toc-no {
      flex: none;
      min-width: 1.25rem;
      color: var(--wisp-muted);
      font-size: 0.75rem;
      font-variant-numeric: tabular-nums;
      transition: color 150ms;
    }
    :is(li ol, li[data-level='1'], li[data-level='2']) .wisp-toc-no {
      min-width: 1.75rem;
    }
    .wisp-toc a:hover,
    .wisp-toc a:hover .wisp-toc-no {
      color: var(--wisp-fg);
    }
    .wisp-toc a[aria-current='true'] {
      color: var(--wisp-fg);
    }
    .wisp-toc a[aria-current='true'] .wisp-toc-no {
      color: var(--wisp-accent);
    }
    .wisp-toc :global(.wisp-toc-chev) {
      flex: none;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /*
     * 栏顶标题行：与系列栏的标题行是一对（0.875rem/600 墨色、2.5rem 高、同一吸顶位置、
     * 右端 1.75rem 方块里的 chevron：朝下 = 收起着，朝上 = 展开着）。
     * 静态 <p>（无 JS）和切换按钮共用这一套尺寸；收起后仍是这一行，文字「目录」不消失。
     */
    .wisp-toc-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: 100%;
      min-height: 2.5rem;
      margin: 0;
      padding: 0;
      color: var(--wisp-fg);
      font: inherit;
      font-weight: 600;
      font-size: 0.875rem;
      line-height: 1.4;
      text-align: start;
    }
    .wisp-toc-title-label {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .wisp-toc-toggle {
      border: 0;
      border-radius: 4px;
      background: none;
      cursor: pointer;
    }
    .wisp-toc-head-ico {
      display: inline-flex;
      flex: none;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      height: 1.75rem;
      margin-inline-start: auto;
      color: var(--wisp-muted);
      font-size: 1rem;
      transition: color 150ms;
    }
    .wisp-toc-toggle:hover .wisp-toc-head-ico {
      color: var(--wisp-accent);
    }
    .wisp-toc-toggle[aria-expanded='true'] .wisp-toc-head-ico :global(.wisp-icon) {
      transform: rotate(180deg);
    }
    .wisp-toc-sub-toggle {
      display: inline-flex;
      flex: none;
      align-items: center;
      justify-content: center;
      width: 1.5rem;
      height: 1.5rem;
      padding: 0;
      border: 0;
      border-radius: 3px;
      background: none;
      color: var(--wisp-muted);
      font-size: 0.875rem;
      cursor: pointer;
      transition: color 150ms;
    }
    .wisp-toc-sub-toggle:hover {
      color: var(--wisp-accent);
    }
    .wisp-toc-toggle:focus-visible,
    .wisp-toc-sub-toggle:focus-visible {
      outline: 2px solid var(--wisp-accent);
      outline-offset: 2px;
      border-radius: 2px;
    }
    .wisp-toc-sub-toggle[aria-expanded='true'] :global(.wisp-toc-chev) {
      transform: rotate(90deg);
    }

    .wisp-toc-aside ol {
      border-inline-start: 1px solid var(--wisp-border);
    }
    .wisp-toc-aside :global(#wisp-toc-list) {
      scroll-target-group: auto;
    }
    .wisp-toc-aside a {
      margin-inline-start: -1px;
      padding: 0.3rem 0.25rem 0.3rem calc(0.875rem - 1px);
      border-inline-start: 2px solid transparent;
      font-size: 0.8125rem;
      line-height: 1.5;
      transition:
        color 150ms,
        border-color 150ms;
    }
    .wisp-toc-aside a:target-current,
    .wisp-toc-aside a[aria-current='location'] {
      border-inline-start-color: var(--wisp-accent);
      color: var(--wisp-fg);
      font-weight: 500;
    }
    /*
     * 有小节的 h2：标题列 + 固定在栏右端的 1.5rem chevron 列。chevron 对齐标题第一行的中线
     * （0.3rem 上内边距 + 半个 0.8125rem×1.5 行高 − 半个按钮高），标题换行时也不跟着跑。
     */
    .wisp-toc-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 1.5rem;
      align-items: start;
      column-gap: 0.125rem;
    }
    .wisp-toc-row .wisp-toc-sub-toggle {
      margin-top: calc(0.3rem + 0.8125rem * 0.75 - 0.75rem);
    }
    .wisp-toc-aside li ol {
      border-inline-start: 0;
    }
    .wisp-toc-aside li ol a {
      padding-inline-start: calc(1.625rem - 1px);
      font-size: 0.78125rem;
    }

    /* 以下规则只在 JS 可用时生效（html[data-toc] 由 Post 内联脚本写入）；无 JS 时目录完整展开 */
    :global(html:not([data-toc])) .wisp-toc-sub-toggle {
      display: none;
    }
    :global(html[data-toc]) li[data-group]:not([data-open]) > ol {
      display: none;
    }
    :global(html:not([data-toc])) .wisp-toc-toggle,
    :global(html[data-toc]) .wisp-toc-aside > p.wisp-toc-title,
    :global(html[data-toc='collapsed']) #wisp-toc-scroll {
      display: none;
    }
    @media (prefers-reduced-motion: no-preference) {
      .wisp-toc :global(.wisp-toc-chev),
      .wisp-toc-head-ico :global(.wisp-icon) {
        transition: transform 150ms;
      }
    }

    .wisp-toc-inline {
      margin: 0 0 2.5rem;
      border-bottom: 1px solid var(--wisp-border);
    }
    .wisp-toc-inline::details-content {
      interpolate-size: allow-keywords;
      overflow: clip;
      contain: layout;
    }
    .wisp-toc-inline:not([open])::details-content {
      block-size: 0;
    }
    @media (prefers-reduced-motion: no-preference) {
      .wisp-toc-inline::details-content {
        transition:
          block-size 200ms var(--wisp-ease),
          content-visibility 200ms allow-discrete;
      }
      .wisp-toc-inline[open]::details-content {
        @starting-style {
          block-size: 0;
        }
      }
    }
    /* 窄屏折叠目录：标题在左、chevron 在右，与宽屏栏顶标题行同一种写法 */
    .wisp-toc-inline summary {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      gap: 0.5rem;
      cursor: pointer;
      color: var(--wisp-muted);
      font-size: 0.875rem;
      font-weight: 500;
      list-style: none;
      transition: color 150ms;
    }
    .wisp-toc-inline summary::-webkit-details-marker {
      display: none;
    }
    .wisp-toc-inline summary:hover,
    .wisp-toc-inline[open] summary {
      color: var(--wisp-fg);
    }
    .wisp-toc-inline summary:hover .wisp-toc-head-ico {
      color: var(--wisp-accent);
    }
    .wisp-toc-inline[open] summary .wisp-toc-head-ico :global(.wisp-icon) {
      transform: rotate(180deg);
    }
    .wisp-toc-inline > ol {
      /* 长文（二三十个小节）展开时与系列折叠列表一致限高滚动，避免把正文推出两三屏 */
      max-height: 60vh;
      overflow-y: auto;
      overscroll-behavior: contain;
      scroll-padding-block: 1.5rem;
      margin-inline: -0.375rem -0.625rem;
      padding: 0.125rem 0.625rem 0.75rem 0.375rem;
    }
    .wisp-toc-inline li {
      border-inline-start: 1px solid var(--wisp-border);
    }
    .wisp-toc-inline a {
      margin-inline-start: -1px;
      padding-inline: calc(0.875rem - 1px) 0.25rem;
      border-inline-start: 2px solid transparent;
      line-height: 1.5;
      transition:
        color 150ms,
        border-color 150ms;
    }
    .wisp-toc-inline a[aria-current='true'] {
      border-inline-start-color: var(--wisp-accent);
      font-weight: 500;
    }
    .wisp-toc-inline li[data-level='1'] a {
      padding-inline-start: calc(1.625rem - 1px);
      font-size: 0.78125rem;
    }
    .wisp-toc-inline li[data-level='2'] a {
      padding-inline-start: calc(2.375rem - 1px);
      font-size: 0.78125rem;
    }
    @media (pointer: coarse), (max-width: 47.99rem) {
      .wisp-toc-inline a {
        min-height: 2.75rem;
        padding-block: 0.625rem;
      }
    }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
  const sync = () => {
    if (!btn) return;
    const expanded = root.dataset.toc !== 'collapsed';
    btn.setAttribute('aria-expanded', String(expanded));
    const label = expanded ? btn.dataset.labelOpen : btn.dataset.labelClosed;
    if (label) btn.title = label;
  };
  sync();
  btn?.addEventListener('click', () => {
    const c = root.dataset.toc !== 'collapsed';
    root.dataset.toc = c ? 'collapsed' : 'open';
    try {
      localStorage.setItem('wisp-toc-collapsed', c ? '1' : '0');
    } catch {}
    sync();
  });

  const groups = [...document.querySelectorAll<HTMLElement>('li[data-group]')];
  const open = (li: HTMLElement, v: boolean) => {
    li.toggleAttribute('data-open', v);
    li.querySelector('button')!.setAttribute('aria-expanded', String(v));
  };
  groups.forEach((li) =>
    li.querySelector('button')!.addEventListener('click', () => {
      const v = !li.hasAttribute('data-open');
      open(li, v);
      li.toggleAttribute('data-manual', v);
    }),
  );

  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const heads = [...new Set(links.map((a) => a.dataset.tocLink!))]
    .map((id) => document.getElementById(id))
    .filter(Boolean) as HTMLElement[];
  // 侧栏目录独立滚动的那一层（标题行在它外面，不随篇目滚动）
  const box = document.querySelector<HTMLElement>('.wisp-toc-aside [data-rail-scroll]');
  let current = '';
  const revealActive = (a: HTMLElement) => {
    if (!box || !box.clientHeight) return;
    const c = box.getBoundingClientRect();
    const r = a.getBoundingClientRect();
    if (r.top < c.top + 8) box.scrollTop += r.top - c.top - 8;
    else if (r.bottom > c.bottom - 8) box.scrollTop += r.bottom - c.bottom + 8;
  };
  const set = (id: string) => {
    if (id === current) return;
    current = id;
    links.forEach((a) =>
      id && a.dataset.tocLink === id
        ? a.setAttribute('aria-current', 'location')
        : a.removeAttribute('aria-current'),
    );
    if (!id) {
      groups.forEach((li) => open(li, li.hasAttribute('data-manual')));
      return;
    }
    const a = box?.querySelector<HTMLElement>('[aria-current="location"]');
    if (!a) return;
    const g = a.closest('li[data-group]');
    groups.forEach((li) => open(li, li === g || li.hasAttribute('data-manual')));
    // 只滚动目录容器本身，不影响页面滚动
    revealActive(a);
  };
  if (heads.length) {
    // 点击目录项后：立即高亮被点的那一项，页面滚动停下之前不让 scrollend 改掉它
    let locked = false;
    let unlock = 0;
    const atBottom = () => innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
    const threshold = () =>
      Math.max(
        (parseFloat(getComputedStyle(root).scrollPaddingTop) || 80) + 40,
        innerHeight * 0.34,
      );
    const activeHeadingId = () => {
      if (atBottom()) return heads[heads.length - 1]!.id;
      const limit = threshold();
      if (heads[0]!.getBoundingClientRect().top > limit) return '';
      const nativeMatch = box?.querySelector<HTMLAnchorElement>('a:target-current');
      if (nativeMatch?.dataset.tocLink) {
        const targetEl = document.getElementById(nativeMatch.dataset.tocLink);
        if (targetEl && targetEl.getBoundingClientRect().top <= limit) {
          return nativeMatch.dataset.tocLink;
        }
      }
      const inBand = heads.find((h) => {
        const top = h.getBoundingClientRect().top;
        return top >= 0 && top <= limit;
      });
      if (inBand) return inBand.id;
      return heads.filter((h) => h.getBoundingClientRect().top < limit).pop()?.id ?? '';
    };
    const sync = () => {
      if (locked) return;
      set(activeHeadingId());
    };
    requestAnimationFrame(sync);
    addEventListener('scrollend', () => {
      if (locked) {
        requestAnimationFrame(() => {
          locked = false;
        });
        clearTimeout(unlock);
        return;
      }
      sync();
    });
    addEventListener('hashchange', () => {
      if (locked) return;
      const id = decodeURIComponent(location.hash.slice(1));
      if (id && heads.some((h) => h.id === id)) {
        set(id);
        return;
      }
      sync();
    });
    for (const a of links) {
      a.addEventListener('click', () => {
        const id = a.dataset.tocLink!;
        set(id);
        locked = true;
        clearTimeout(unlock);
        unlock = window.setTimeout(() => (locked = false), 1000);
        const target = document.getElementById(id);
        if (target) {
          if (!target.hasAttribute('tabindex')) target.tabIndex = -1;
          target.focus({ preventScroll: true });
        }
      });
    }
  }
</script>
