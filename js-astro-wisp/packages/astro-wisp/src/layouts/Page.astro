---
/**
 * 独立页面布局（关于页等）：标题 + 可选描述 + prose 正文。
 * hasMath 为真时按需引入 KaTeX 样式（与 Post 布局一致）。
 */
import Base from 'virtual:wisp/components/Base';
import config from 'virtual:wisp/config';
import katexCssUrl from '../styles/katex.css?url';
import diagramCssUrl from '../styles/diagram-figure.css?url';
import { Font } from 'astro:assets';

export interface Props {
  title: string;
  description?: string;
  lang?: string;
  /** 是否把默认插槽包在 .prose 中，默认 true；列表类页面可关闭 */
  prose?: boolean;
  /** remarkPluginFrontmatter.hasMath */
  hasMath?: boolean;
  /** remarkPluginFrontmatter.hasDiagram / hasHandDiagram（remark-diagram 写入） */
  hasDiagram?: boolean;
  hasHandDiagram?: boolean;
}

const {
  title,
  description,
  lang,
  prose = true,
  hasMath = false,
  hasDiagram = false,
  hasHandDiagram = false,
} = Astro.props;
---

<Base title={title} description={description} lang={lang}>
  <Fragment slot="head">
    {hasMath && config.features.math && <link rel="stylesheet" href={katexCssUrl} />}
    {(hasDiagram || hasHandDiagram) && <link rel="stylesheet" href={diagramCssUrl} />}
    {hasHandDiagram && config.hasExcalifont && (
      <Font cssVariable="--font-wisp-hand" preload={[{ subset: 'latin' }]} />
    )}
  </Fragment>
  <div class="wisp-container wisp-page">
    <header class="wisp-page-header">
      <h1>{title}</h1>
      {description && <p>{description}</p>}
    </header>
    {prose ? (
      <div class="prose">
        <slot />
      </div>
    ) : (
      <slot />
    )}
  </div>
</Base>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    .wisp-page {
      padding-top: 2.25rem;
    }
    @media (min-width: 48rem) {
      .wisp-page {
        padding-top: 3.5rem;
      }
    }
    .wisp-page-header {
      margin-bottom: 2.75rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--wisp-border);
    }
    .wisp-page-header h1 {
      margin: 0;
      font-size: clamp(1.75rem, 1.25rem + 1.8vw, 2.25rem);
      font-weight: 700;
      line-height: 1.3;
    }
    .wisp-page-header p {
      margin: 0.5rem 0 0;
      color: var(--wisp-muted);
    }
  }
</style>
