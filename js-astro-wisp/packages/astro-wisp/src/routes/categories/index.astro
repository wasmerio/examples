---
import Page from 'virtual:wisp/components/Page';
import config from 'virtual:wisp/config';
import { getCategories } from '../../utils/taxonomy';
import { sitePath } from '../../utils/paths';

const terms = await getCategories();
const zh = /^zh\b/i.test(config.site.lang);
---

<Page
  title={zh ? '分类' : 'Categories'}
  description={
    zh
      ? `共 ${terms.length} 个分类`
      : `${terms.length} ${terms.length === 1 ? 'category' : 'categories'}`
  }
  prose={false}
>
  {terms.length === 0 ? (
    <p class="empty">{zh ? '还没有分类。' : 'No categories yet.'}</p>
  ) : (
    <ul class="terms">
      {terms.map((t) => (
        <li>
          <a href={sitePath(import.meta.env.BASE_URL, `/categories/${t.slug}/`)}>{t.name}</a>
          <span class="n" aria-hidden="true">
            {t.count}
          </span>
          <span class="wisp-sr-only"> ({t.count})</span>
        </li>
      ))}
    </ul>
  )}
</Page>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    .terms {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem 1.75rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .terms a {
      color: var(--wisp-fg);
      transition: color 150ms;
    }
    .terms a:hover {
      color: var(--wisp-accent);
    }
    /* 触屏及窄屏：索引目录链接命中高度 ≥44px */
    @media (pointer: coarse), (max-width: 47.99rem) {
      .terms {
        row-gap: 0.25rem;
      }
      .terms li {
        display: inline-flex;
        align-items: center;
      }
      .terms a {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
      }
    }
    .n {
      margin-inline-start: 0.35em;
      color: var(--wisp-muted);
      font-size: 0.875rem;
      font-variant-numeric: tabular-nums;
    }
    .empty {
      color: var(--wisp-muted);
    }
  }
</style>
