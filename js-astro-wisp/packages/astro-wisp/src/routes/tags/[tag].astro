---
import type { GetStaticPaths } from 'astro';
import Base from 'virtual:wisp/components/Base';
import PostCard from 'virtual:wisp/components/PostCard';
import config from 'virtual:wisp/config';
import { getTags } from '../../utils/taxonomy';
import { getReadingTimes } from '../../utils/reading';
import { sitePath } from '../../utils/paths';

export const getStaticPaths = (async () => {
  const terms = await getTags();
  return terms.map((term) => ({ params: { tag: term.slug }, props: { term } }));
}) satisfies GetStaticPaths;

const { term } = Astro.props;
const times = await getReadingTimes(term.posts);
const zh = /^zh\b/i.test(config.site.lang);
---

<Base
  title={`#${term.name}`}
  description={
    zh
      ? `标签「${term.name}」下的 ${term.count} 篇文章`
      : `${term.count} ${term.count === 1 ? 'post' : 'posts'} tagged #${term.name}`
  }
>
  <div class="wisp-container tax">
    <header class="tax-header">
      <h1>#{term.name}</h1>
      <p>
        {zh ? `${term.count} 篇文章` : `${term.count} ${term.count === 1 ? 'post' : 'posts'}`} ·{' '}
        <a class="wisp-link" href={sitePath(import.meta.env.BASE_URL, '/tags/')}>
          {zh ? '全部标签' : 'All tags'}
        </a>
      </p>
    </header>
    <ul class="tax-list">
      {term.posts.map((post, i) => (
        <li>
          <PostCard post={post} readingTime={times[i]} headingLevel={2} />
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  /* 主题样式在 components 层：Tailwind 工具类与站点 customCss 总能覆盖 */
  @layer components {
    .tax {
      padding-top: 2.25rem;
    }
    @media (min-width: 48rem) {
      .tax {
        padding-top: 3.5rem;
      }
    }
    /* 与 Page 布局的页头同一规格：标题 + 说明，下方 1px rule */
    .tax-header {
      margin-bottom: 2.75rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--wisp-border);
    }
    .tax-header h1 {
      margin: 0;
      font-size: clamp(1.75rem, 1.25rem + 1.8vw, 2.25rem);
      font-weight: 700;
      line-height: 1.3;
    }
    .tax-header p {
      margin: 0.5rem 0 0;
      color: var(--wisp-muted);
    }
    @media (pointer: coarse), (max-width: 47.99rem) {
      .tax-header p a {
        padding-block: 0.8125rem;
        margin-block: -0.8125rem;
      }
    }
    /* 同级文章之间 1px rule（与分页列表一致） */
    .tax-list {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .tax-list > li {
      padding-block: 1.5rem;
    }
    .tax-list > li:first-child {
      padding-top: 0;
    }
    .tax-list > li + li {
      border-top: 1px solid var(--wisp-border);
    }
  }
</style>
