{
    "name": "firekylin",
    "bin": "pkg.js",
    "description": "A Simple & Fast Node Bloging Platform Base On ThinkJS 3.x & ReactJS & ES2015+",
    "version": "1.7.3",
    "author": "lizheming <i@imnerd.org>",
    "scripts": {
        "start": "node production.js",
        "cron:rss": "npm start -- \"admin/cron/rss\"",
        "cron:comment": "npm start -- \"crontab/sync_comment\""
    },
    "pre-commit": [
        "lint-break-on-errors"
    ],
    "dependencies": {
        "ali-oss": "^6.2.1",
        "aws-sdk": "^2.814.0",
        "cos-nodejs-sdk-v5": "^2.5.6",
        "dayjs": "^1.11.0",
        "feedparser": "^2.2.9",
        "form-data": "^2.3.1",
        "fs-extra": "^5.0.0",
        "highlight.js": "^11.11.1",
        "jszip": "^3.7.0",
        "ldapjs": "^1.0.2",
        "marked": "^18.0.3",
        "marked-alert": "^2.1.2",
        "marked-footnote": "^1.4.0",
        "marked-highlight": "^2.2.4",
        "mathjax": "^4.1.2",
        "nodemailer": "^6.6.1",
        "on-finished": "^2.3.0",
        "phpass": "^0.1.1",
        "push-to-firekylin": "^0.2.3",
        "qiniu": "^7.3.0",
        "request": "^2.87.0",
        "request-promise-native": "^1.0.5",
        "semver": "^5.5.0",
        "speakeasy": "^2.0.0",
        "think-cache": "^1.0.0",
        "think-cache-file": "^1.0.8",
        "think-logger3": "^1.0.0",
        "think-model": "^1.5.4",
        "think-model-mysql": "^1.0.0",
        "think-model-postgresql": "^1.1.6",
        "think-model-sqlite": "^2.0.1",
        "think-router-rest": "^1.0.4",
        "think-session": "^1.1.3",
        "think-session-file": "^1.0.5",
        "think-view": "^1.0.0",
        "think-view-nunjucks": "^1.0.1",
        "thinkjs": "^3.2.11",
        "turndown": "^7.2.4",
        "upyun": "^3.3.4",
        "wxr": "^0.1.2",
        "xml2js": "^0.4.19"
    },
    "repository": "",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "packageManager": "pnpm@11.0.9",
    "readmeFilename": "README.md",
    "pkg": {
        "assets": [
            "src/**/*",
            "view/**/*",
            "www/**/*",
            ".installed"
        ],
        "targets": [
            "node10-linux-x64",
            "node10-macos-x64",
            "node10-win-x64"
        ]
    }
}