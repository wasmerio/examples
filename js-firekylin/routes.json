{
  "version": 1,
  "database": {
    "kind": "mysql",
    "setup": [
      "node edgejs-install.js"
    ],
    "env": {
      "FK_DB_MODE": "mysql",
      "FK_DB_HOST": "{dbHost}",
      "FK_DB_PORT": "{dbPort}",
      "FK_DB_DATABASE": "{dbName}",
      "FK_DB_USER": "{dbUser}",
      "FK_DB_PASSWORD": "{dbPassword}",
      "FK_DB_PREFIX": "fk_",
      "FK_DB_ENCODING": "utf8mb4"
    }
  },
  "routes": [
    {
      "name": "homepage",
      "path": "/",
      "expect": {
        "status": [200],
        "contentType": "html",
        "bodyContains": ["Firekylin on EdgeJS"]
      }
    },
    {
      "name": "archives",
      "path": "/archives/",
      "expect": {
        "status": [200],
        "contentType": "html"
      }
    },
    {
      "name": "admin",
      "path": "/admin",
      "expect": {
        "status": [200],
        "contentType": "html"
      }
    }
  ]
}
