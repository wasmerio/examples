{
  "version": 1,
  "database": {
    "kind": "postgres",
    "env": {
      "CMD_DB_URL": "{dbUrl}",
      "CMD_SESSION_SECRET": "framework-test-session-secret",
      "CMD_HOST": "0.0.0.0",
      "CMD_PORT": "{port}",
      "CMD_ALLOW_ANONYMOUS": "true",
      "CMD_TOOBUSY_LAG": "10000",
      "NODE_ENV": "production"
    }
  },
  "routes": [
    {
      "name": "health",
      "path": "/_health",
      "expect": {
        "status": [200],
        "contentType": "any"
      }
    },
    {
      "name": "status",
      "path": "/status",
      "expect": {
        "status": [200],
        "contentType": "json"
      }
    },
    {
      "name": "homepage",
      "path": "/",
      "expect": {
        "status": [200],
        "contentType": "html",
        "bodyContains": ["HedgeDoc"]
      }
    }
  ]
}
