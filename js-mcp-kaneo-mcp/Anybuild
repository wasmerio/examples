load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {"start": "node server.mjs"},
    node_package_manager = "npm",
    node_server = "node",
    node_version = "24",
)

build = node_build(config)

node_serve(
    config,
    build,
    name = "js-mcp-kaneo-mcp",
)
