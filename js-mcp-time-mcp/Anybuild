load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {
        "start": "node server.mjs",
    },
    node_package_manager = "npm",
    node_server = "node",
    node_version = "24",
)

build = node_build(config)

node_serve(
    config,
    build,
    name = "js-mcp-time-mcp",
    build_post = [run('sh -c "if [ ! -f mcp-http/app.mjs ] && [ -d ../_shared/mcp-http/js ]; then mkdir -p mcp-http && cp -R ../_shared/mcp-http/js/. mcp-http/; fi"')],
)
