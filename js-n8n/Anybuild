# Serve the prebuilt wasmer/n8n package. Nothing is built here: the
# package is a runtime dependency, so its /n8n files are mounted at start.
load("//anybuild:serve.bzl", "build", "serve")
load("//anybuild/tools:node.bzl", "node_config")

config = node_config(schema = 1, node_version = "24", node_server = "node")

serve(
    config,
    build(steps = []),
    name = "n8n",
    serve_deps = [dep("node", "24"), dep("wasmer/n8n", "=2.48.4")],
    commands = {"start": "node /n8n/wasmer-start.cjs"},
)
