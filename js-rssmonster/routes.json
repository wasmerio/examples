{
  "version": 1,
  "database": {
    "kind": "mysql",
    "setup": [
      "node_modules/.bin/sequelize db:migrate",
      "node_modules/.bin/sequelize db:seed:all"
    ],
    "env": {
      "DB_HOSTNAME": "{dbHost}",
      "DB_PORT": "{dbPort}",
      "DB_DATABASE": "{dbName}",
      "DB_USERNAME": "{dbUser}",
      "DB_PASSWORD": "{dbPassword}",
      "NODE_ENV": "production"
    }
  },
  "routes": [
    {
      "name": "health",
      "path": "/api/health",
      "expect": {
        "status": [200],
        "contentType": "json"
      }
    },
    {
      "name": "homepage",
      "path": "/",
      "expect": {
        "status": [200],
        "contentType": "html",
        "bodyContains": ["RSSMonster"]
      }
    }
  ]
}
