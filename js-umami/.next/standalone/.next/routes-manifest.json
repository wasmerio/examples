      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/teams/:id/dashboard/edit",
      "destination": "/dashboard/edit",
      "statusCode": 307,
      "regex": "^(?!/_next)/teams(?:/([^/]+?))/dashboard/edit(?:/)?$"
    },
    {
      "source": "/teams/:id/dashboard",
      "destination": "/dashboard",
