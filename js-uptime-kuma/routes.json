{
  "version": 1,
  "serverReadyTimeoutMs": 180000,
  "database": {
    "kind": "mysql",
    "env": {
      "UPTIME_KUMA_DB_TYPE": "mariadb",
      "UPTIME_KUMA_DB_HOSTNAME": "{dbHost}",
      "UPTIME_KUMA_DB_PORT": "{dbPort}",
      "UPTIME_KUMA_DB_NAME": "{dbName}",
      "UPTIME_KUMA_DB_USERNAME": "{dbUser}",
      "UPTIME_KUMA_DB_PASSWORD": "{dbPassword}",
      "NODE_ENV": "production"
    }
  },
  "routes": [
    {
      "name": "entry-page-api",
      "path": "/api/entry-page",
      "expect": {
        "status": [200],
        "contentType": "json",
        "bodyContains": ["entryPage"]
      }
    },
    {
      "name": "setup",
      "path": "/setup",
      "expect": {
        "status": [200],
        "contentType": "html",
        "bodyContains": ["Uptime Kuma"]
      }
    },
    {
      "name": "homepage",
      "path": "/",
      "expect": {
        "status": [200],
        "contentType": "html",
        "bodyContains": ["Uptime Kuma"]
      }
    }
  ]
}
