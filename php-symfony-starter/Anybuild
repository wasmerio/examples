# Symfony Flex writes composer.json during dependency setup, so install after copying the source.
load("//anybuild/tools:php.bzl", "php_build", "php_commands", "php_config", "php_serve")

config = php_config(
    schema = 1,
    php_framework = "symfony",
    composer_enable = False,
    php_version = "8.3.29",
    php_public_dir = "public",
)

build = php_build(
    config,
    extra_use_deps = [dep("composer")],
    after_build = [
        env(COMPOSER_HOME = "/tmp", COMPOSER_FUND = "0", COMPOSER_ALLOW_SUPERUSER = "1"),
        run("composer install --no-dev --optimize-autoloader --ignore-platform-reqs --no-scripts --no-interaction", group = "install"),
    ],
    extra_ignore = ["vendor", "var"],
)

php_serve(config, build, name = "symfony-starter", commands = php_commands(config, build.app))
